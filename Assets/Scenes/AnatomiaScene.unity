  appName: ANATOMIA
  appFullTitle: A Gamified Mobile Application for Interactive Human Anatomy Learning
  appVersion: 1.0.0
  appDescription: ANATOMIA is a gamified mobile application that makes learning human
    anatomy interactive and engaging. Through 3D models, quizzes, points, and levels,
    it transforms traditional anatomy lessons into a fun and immersive learning experience
    for students, with tools that let teachers create classrooms and track progress.
  developerNames:
  - Abuyan, Christian D.
  - Acopio, Jorge Matthew M.
  - Alvaro, John Carl F.
  - Aquino, John Carlo D.
  compactWidthThreshold: 900
