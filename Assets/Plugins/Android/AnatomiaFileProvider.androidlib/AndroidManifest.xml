<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.anatomia3d.fileprovider">

    <application>
        <!-- Lets FileOpener hand a downloaded submission to the phone's viewer app
             (Adobe, WPS, Word, Excel, Google Docs...) through a content:// URI.
             Authority must stay in sync with FileOpener.AuthoritySuffix. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.anatomia.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/anatomia_file_paths" />
        </provider>
    </application>

</manifest>
