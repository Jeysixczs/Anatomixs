/* =========================================================
   Anatomia 3D - Admin Classroom Created (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient, so the pale background, the
   checkmark circle and the code display box gradients are all
   generated as Texture2D at runtime from
   AdminClassroomCreatedController. The colors below are flat
   fallbacks.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(240, 249, 248); /* fallback, overridden by gradient texture */
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    align-items: center;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 110px;
    padding-bottom: 60px;
    max-width: 100%;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- Success header ---------- */

.checkmark-circle
{
    width: 130px;
    height: 130px;
    border-radius: 65px;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
    justify-content: center;
    align-items: center;
    margin-bottom: 36px;
}

.checkmark-icon
{
    width: 56px;
    height: 44px;
    border-left-width: 8px;
    border-bottom-width: 8px;
    border-color: white;
    rotate: -45deg;
    margin-top: -8px;
}

.success-title
{
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    -unity-text-align: middle-center;
}

.success-subtitle
{
    font-size: 26px;
    color: rgb(138, 143, 163);
    margin-top: 10px;
    margin-bottom: 40px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Code Card ---------- */

.code-card
{
    width: 100%;
    background-color: white;
    border-radius: 32px;
    padding: 36px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    margin-bottom: 30px;
}

.code-card-label
{
    font-size: 24px;
    color: rgb(138, 143, 163);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.code-display-box
{
    background-color: rgb(220, 240, 234); /* fallback, overridden by gradient texture */
    border-radius: 20px;
    padding-top: 30px;
    padding-bottom: 30px;
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
}

.code-display-text
{
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(20, 30, 45);
    letter-spacing: 8px;
    -unity-text-align: middle-center;
}

.copy-code-button
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: white;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(224, 226, 232);
    padding-top: 22px;
    padding-bottom: 22px;
    margin: 0;
    margin-bottom: 28px;
}

.copy-code-button:hover
{
    background-color: rgb(248, 249, 251);
}

.copy-code-icon
{
    width: 26px;
    height: 26px;
    margin-right: 14px;
    border-width: 3px;
    border-color: rgb(31, 36, 48);
    border-radius: 4px;
}

.copy-code-label
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.code-card-divider
{
    height: 1px;
    background-color: rgba(0, 0, 0, 0.08);
    margin-bottom: 22px;
}

.detail-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.detail-label
{
    font-size: 24px;
    color: rgb(138, 143, 163);
}

.detail-value
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

/* ---------- Tip Box ---------- */

.tip-box
{
    width: 100%;
    flex-direction: row;
    align-items: flex-start;
    background-color: rgb(232, 242, 254);
    border-radius: 24px;
    padding: 24px;
    border-width: 1px;
    border-color: rgba(59, 130, 246, 0.18);
    margin-bottom: 36px;
}

.tip-icon
{
    font-size: 26px;
    margin-right: 14px;
    flex-shrink: 0;
}

.tip-text
{
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 22px;
    color: rgb(59, 100, 165);
    white-space: normal;
}

/* ---------- Go To Dashboard (gradient applied at runtime via C#) ---------- */

.go-to-dashboard-button
{
    width: 100%;
    border-radius: 28px;
    border-width: 0px;
    padding-top: 28px;
    padding-bottom: 28px;
    margin: 0;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
    -unity-font-style: bold;
    color: white;
    font-size: 32px;
    height: 118px;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .content-wrapper
{
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 80px;
}

.compact .checkmark-circle
{
    width: 100px;
    height: 100px;
    border-radius: 50px;
    margin-bottom: 26px;
}

.compact .checkmark-icon
{
    width: 42px;
    height: 32px;
    border-left-width: 6px;
    border-bottom-width: 6px;
}

.compact .success-title
{
    font-size: 32px;
}

.compact .success-subtitle
{
    font-size: 20px;
    margin-bottom: 30px;
}

.compact .code-card
{
    padding: 26px;
}

.compact .code-display-text
{
    font-size: 38px;
    letter-spacing: 5px;
}

.compact .copy-code-label,
.compact .detail-label,
.compact .detail-value
{
    font-size: 20px;
}

.compact .tip-text
{
    font-size: 18px;
}

.compact .go-to-dashboard-button
{
    font-size: 26px;
    padding-top: 22px;
    padding-bottom: 22px;
    height: 96px;
}


/* =========================================================
   STUDENT-STYLE THEME LAYER  (.anatomia-theme.theme-admin-created)
   ========================================================= */

.anatomia-theme.theme-admin-created.screen-root { background-color: rgb(244, 245, 250); background-image: url("project://database/Assets/UI/Theme/ambient-bg.png"); background-size: cover; background-position: center; background-repeat: no-repeat; }

.anatomia-theme.theme-admin-created .content-wrapper { padding: 120px 52px 100px 52px; align-items: center; max-width: 1100px; align-self: center; }

.anatomia-theme.theme-admin-created .checkmark-circle { width: 190px; height: 190px; border-radius: 95px; background-color: var(--success); background-image: none; margin-bottom: 40px; }

.anatomia-theme.theme-admin-created .success-title { font-size: 54px; letter-spacing: -0.8px; color: var(--ink); -unity-text-align: middle-center; }
.anatomia-theme.theme-admin-created .success-subtitle { font-size: 28px; color: var(--ink-3); margin-top: 10px; margin-bottom: 48px; -unity-text-align: middle-center; white-space: normal; }

.anatomia-theme.theme-admin-created .code-card
{
    width: 100%;
    padding: 44px;
    border-radius: 44px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

.anatomia-theme.theme-admin-created .code-card-label { font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; color: var(--ink-3); -unity-text-align: middle-center; }

.anatomia-theme.theme-admin-created .code-display-box
{
    background-color: var(--accent-soft);
    background-image: none;
    border-width: 0;
    border-radius: 34px;
    padding: 36px 20px;
    margin: 18px 0 24px 0;
    align-items: center;
    justify-content: center;
}
.anatomia-theme.theme-admin-created .code-display-text { font-size: 74px; -unity-font-style: bold; letter-spacing: 8px; color: var(--accent); -unity-text-align: middle-center; }

.anatomia-theme.theme-admin-created .copy-code-button
{
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 100px;
    padding: 18px 40px;
    margin: 0;
}
.anatomia-theme.theme-admin-created .copy-code-button:hover { border-color: var(--accent); }
.anatomia-theme.theme-admin-created .copy-code-icon { width: 34px; height: 34px; margin-right: 14px; border-width: 0; background-size: contain; background-position: center; background-repeat: no-repeat; }
.anatomia-theme.theme-admin-created .copy-code-label { font-size: 28px; -unity-font-style: bold; color: var(--ink); }

.anatomia-theme.theme-admin-created .code-card-divider { background-color: var(--line); margin: 36px 0 12px 0; }
.anatomia-theme.theme-admin-created .detail-label { font-size: 26px; color: var(--ink-3); }
.anatomia-theme.theme-admin-created .detail-value { font-size: 28px; -unity-font-style: bold; color: var(--ink); }

.anatomia-theme.theme-admin-created .tip-box
{
    width: 100%;
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--warn-soft);
    border-width: 0;
    border-radius: 32px;
    padding: 30px;
    margin-top: 24px;
}
.anatomia-theme.theme-admin-created .tip-icon { font-size: 32px; margin-right: 18px; }
.anatomia-theme.theme-admin-created .tip-text { font-size: 24px; color: var(--ink-2); white-space: normal; flex-grow: 1; flex-shrink: 1; }

.anatomia-theme.theme-admin-created .go-to-dashboard-button
{
    width: 100%;
    margin: 36px 0 0 0;
    padding: 30px;
    border-width: 0;
    border-radius: 54px;
    background-color: var(--accent);
    background-image: none;
    color: white;
    font-size: 31px;
    -unity-font-style: bold;
}
.anatomia-theme.theme-admin-created .go-to-dashboard-button:hover { background-color: var(--accent-strong); }
.anatomia-theme.theme-admin-created .go-to-dashboard-button:active { background-color: var(--accent-press); }

.anatomia-theme.theme-admin-created.compact .content-wrapper { padding: 90px 40px 80px 40px; }
.anatomia-theme.theme-admin-created.compact .checkmark-circle { width: 150px; height: 150px; border-radius: 75px; }
.anatomia-theme.theme-admin-created.compact .success-title { font-size: 44px; }
.anatomia-theme.theme-admin-created.compact .code-card { padding: 32px; border-radius: 36px; }
.anatomia-theme.theme-admin-created.compact .code-display-text { font-size: 58px; letter-spacing: 6px; }
.anatomia-theme.theme-admin-created.compact .tip-text { font-size: 21px; }
