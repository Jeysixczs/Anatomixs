/* =========================================================
   Anatomia 3D - Admin Create Classroom (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient, so the header and submit
   button gradients are generated as Texture2D at runtime from
   AdminCreateClassroomController. The colors below are flat
   fallbacks.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 44px;
    padding-right: 44px;
    padding-top: 90px;
    padding-bottom: 50px;
    flex-shrink: 0;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
}

.back-button
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 30px;
    flex-shrink: 0;
}

.back-button:hover
{
    background-color: rgba(255, 255, 255, 0.28);
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.header-subtitle
{
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
    word-wrap: break-word;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 0;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

/* ---------- Form Card ---------- */

.form-card
{
    background-color: white;
    border-radius: 32px;
    margin-left: 50px;
    margin-right: 50px;
    margin-top: -30px;
    margin-bottom: 60px;
    padding: 40px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.form-card-title
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.form-card-subtitle
{
    font-size: 24px;
    color: rgb(138, 143, 163);
    margin-top: 6px;
    margin-bottom: 30px;
    white-space: normal;
}

.field-label
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 12px;
}

.field-label-spaced
{
    margin-top: 26px;
}

.text-field
{
    font-size: 26px;
    color: rgb(31, 36, 48);
    margin: 0;
}

.text-field > .unity-text-field__input
{
    background-color: rgb(240, 241, 245);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    border-radius: 20px;
    padding: 22px 24px;
    -unity-text-align: upper-left;
}

.text-area > .unity-text-field__input
{
    min-height: 120px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.field-error
{
    font-size: 22px;
    color: rgb(220, 38, 38);
    margin-top: 8px;
}

/* ---------- Info Box ---------- */

.info-box
{
    background-color: rgb(240, 249, 244);
    border-radius: 24px;
    padding: 26px;
    border-width: 1px;
    border-color: rgba(16, 185, 129, 0.18);
    margin-top: 30px;
    margin-bottom: 32px;
}

.info-box-title
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 14px;
}

.info-bullet-list
{
    flex-direction: column;
}

.info-bullet-item
{
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

.info-bullet-dot
{
    font-size: 22px;
    color: rgb(16, 150, 105);
    margin-right: 10px;
    flex-shrink: 0;
}

.info-bullet-text
{
    font-size: 22px;
    color: rgb(80, 85, 105);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

/* ---------- Status label ---------- */

.status-label
{
    font-size: 22px;
    color: rgb(120, 123, 140);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

/* ---------- Submit Button (gradient applied at runtime via C#) ---------- */

.create-classroom-button
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 24px;
    border-width: 0px;
    padding-top: 26px;
    padding-bottom: 26px;
    margin: 0;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
}

.create-classroom-icon
{
    width: 30px;
    height: 30px;
    margin-right: 14px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
}

.create-classroom-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 66px;
    padding-bottom: 40px;
}

.compact .header-title
{
    font-size: 36px;
}

.compact .header-subtitle
{
    font-size: 22px;
}

.compact .back-button
{
    width: 68px;
    height: 68px;
    border-radius: 34px;
    margin-right: 20px;
}

.compact .back-icon
{
    width: 32px;
    height: 32px;
}

.compact .form-card
{
    margin-left: 34px;
    margin-right: 34px;
    padding: 28px;
}

.compact .form-card-title
{
    font-size: 26px;
}

.compact .form-card-subtitle
{
    font-size: 20px;
    margin-bottom: 22px;
}

.compact .field-label
{
    font-size: 20px;
}

.compact .text-field
{
    font-size: 22px;
}

.compact .info-box
{
    padding: 20px;
    margin-top: 22px;
    margin-bottom: 24px;
}

.compact .info-box-title
{
    font-size: 20px;
}

.compact .info-bullet-text
{
    font-size: 18px;
}

.compact .create-classroom-label
{
    font-size: 24px;
}

.compact .create-classroom-button
{
    padding-top: 20px;
    padding-bottom: 20px;
}

/* ---------- Utility ---------- */

.hidden
{
    display: none;
}
