}

.compact .view-all-close-icon
{
    width: 26px;
    height: 26px;
}

.compact .view-all-list
{
    margin: 28px 34px 60px 34px;
}

/* ---------- Extra Small Layout (Use C# to toggle this class) ---------- */

.extra-small .header
{
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 60px;
    padding-bottom: 50px;
}

.extra-small .header-top-row
{
    margin-bottom: 30px;
}

.extra-small .welcome-title
{
    font-size: 26px;
}

.extra-small .welcome-subtitle
{
    font-size: 34px;
}

.extra-small .level-card
{
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
    margin-top: 8px;
}

.extra-small .level-text
{
    font-size: 22px;
}

.extra-small .level-caption
{
    font-size: 18px;
}

.extra-small .stats-row
{
    padding-left: 24px;
    padding-right: 24px;
    margin-top: -30px;
}

.extra-small .stats-row-spaced
{
    margin-top: 14px;
}

.extra-small .stat-card
{
    padding: 22px;
    min-width: 80px;
}

.extra-small .stat-card-left
{
    margin-right: 8px;
}

.extra-small .stat-card-right
{
    margin-left: 8px;
}

.extra-small .stat-value
{
    font-size: 34px;
}

.extra-small .stat-label
{
    font-size: 18px;
}

.extra-small .stat-icon
{
    width: 44px;
    height: 44px;
}

.extra-small .quick-actions-card
{
    margin-left: 24px;
    margin-right: 24px;
    padding: 30px;
    margin-top: 22px;
}

.extra-small .recent-activity-card
{
    margin-left: 24px;
    margin-right: 24px;
    padding: 30px;
    margin-top: 22px;
    margin-bottom: 50px;
}

.extra-small .action-button
{
    width: 47%;
    min-width: 80px;
    height: 130px;
    margin-bottom: 14px;
}

.extra-small .action-button-left
{
    margin-right: 8px;
}

.extra-small .action-button-right
{
    margin-left: 8px;
}

.extra-small .action-icon
{
    width: 46px;
    height: 46px;
}

.extra-small .action-label
{
    font-size: 24px;
}

.extra-small .section-title
{
    font-size: 28px;
    margin-bottom: 24px;
}

.extra-small .recent-activity-title
{
    margin-bottom: 0;
}

.extra-small .recent-activity-header
{
    margin-bottom: 22px;
}

.extra-small .view-all-inline-button
{
    font-size: 18px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 16px;
}

.extra-small .actions-row
{
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.extra-small .stat-card-spacer
{
    display: none;
}

.extra-small .activity-item
{
    padding: 16px 18px;
    margin-bottom: 10px;
    border-radius: 20px;
}

.extra-small .activity-icon
{
    width: 44px;
    height: 44px;
    margin-right: 16px;
}

.extra-small .activity-title
{
    font-size: 20px;
}

.extra-small .activity-time
{
    font-size: 18px;
}

.extra-small .activity-points
{
    font-size: 18px;
    padding: 8px 14px;
    border-radius: 14px;
}
.compact .activity-kind-label { font-size: 16px; }
.extra-small .activity-kind-label { font-size: 14px; letter-spacing: 1px; }
