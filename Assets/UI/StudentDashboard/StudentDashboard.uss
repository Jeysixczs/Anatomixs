    padding: 26px;
}

.compact .join-classroom-icon-box
{
    width: 72px;
    height: 72px;
    border-radius: 36px;
    margin-right: 22px;
}

.compact .join-classroom-icon-emoji
{
    font-size: 32px;
}

.compact .join-classroom-title
{
    font-size: 28px;
}

.compact .join-classroom-subtitle
{
    font-size: 20px;
}

.compact .join-classroom-button
{
    font-size: 24px;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-left: 14px;
}

.compact .stats-row
{
    padding-left: 34px;
    padding-right: 34px;
    margin-top: -34px;
}

.compact .stats-row-spaced
{
    margin-top: 20px;
}

.compact .stat-card
{
    padding: 28px;
}

.compact .stat-card-left
{
    margin-right: 10px;
}

.compact .stat-card-right
{
    margin-left: 10px;
}

.compact .stat-value
{
    font-size: 40px;
}

.compact .stat-label
{
    font-size: 20px;
}

.compact .stat-icon
{
    width: 52px;
    height: 52px;
}

.compact .quick-actions-card
{
    margin-left: 34px;
