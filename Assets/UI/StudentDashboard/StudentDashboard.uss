    padding: 40px;
    margin-top: 28px;
    margin-bottom: 60px;
}

.compact .action-button
{
    height: 155px;
}

.compact .action-button-left
{
    margin-right: 10px;
}

.compact .action-button-right
{
    margin-left: 10px;
}

.compact .action-icon
{
    width: 54px;
