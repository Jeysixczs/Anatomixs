}

.extra-small .level-card
{
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 24px;
    margin-top: 8px;
}

.extra-small .level-text
{
    font-size: 22px;
}

.extra-small .level-caption
{
    font-size: 18px;
}

.extra-small .stats-row
{
    padding-left: 24px;
    padding-right: 24px;
    margin-top: -30px;
}

.extra-small .stats-row-spaced
{
    margin-top: 14px;
}

.extra-small .stat-card
{
    padding: 22px;
    min-width: 80px;
}

.extra-small .stat-card-left
{
    margin-right: 8px;
}

.extra-small .stat-card-right
{
    margin-left: 8px;
}

.extra-small .stat-value
{
    font-size: 34px;
}

.extra-small .stat-label
{
    font-size: 18px;
}

.extra-small .stat-icon
{
    width: 44px;
    height: 44px;
}

.extra-small .quick-actions-card
{
    margin-left: 24px;
    margin-right: 24px;
    padding: 30px;
    margin-top: 22px;
}

.extra-small .recent-activity-card
{
    margin-left: 24px;
    margin-right: 24px;
    padding: 30px;
    margin-top: 22px;
    margin-bottom: 50px;
}

.extra-small .action-button
{
    width: 47%;
    min-width: 80px;
    height: 130px;
    margin-bottom: 14px;
}

.extra-small .action-button-left
{
    margin-right: 8px;
}

.extra-small .action-button-right
{
    margin-left: 8px;
}

.extra-small .action-icon
{
    width: 46px;
    height: 46px;
}

.extra-small .action-label
{
    font-size: 24px;
}

.extra-small .section-title
{
    font-size: 28px;
    margin-bottom: 24px;
}

.extra-small .actions-row
{
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.extra-small .stat-card-spacer
{
    display: none;
}

.extra-small .activity-item
{
    padding-top: 18px;
    padding-bottom: 18px;
}

.extra-small .activity-icon
{
    width: 42px;
    height: 42px;
    border-radius: 21px;
    margin-right: 16px;
}

.extra-small .activity-title
{
    font-size: 19px;
}

.extra-small .activity-time
{
    font-size: 17px;
}

.extra-small .activity-points
{
    font-size: 19px;
}