/* =========================================================
   Anatomia 3D - Student Dashboard (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(234,243,251);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

/* Target the Unity vertical scroller element */
.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}
.unity-scroll-view__vertical-scroller{
    width:0;
    visibility: hidden;
    
}
.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.unity-scroll-view__content-container{
    height:100%;
}

/* CRITICAL FIX: Reset the translate transform on the content container */
.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 0;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

/* ---------- Header ---------- */

.header
{
    width: 100%;
    background-color: rgb(142,45,226);
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 80px;
    padding-bottom: 70px;
    flex-shrink: 0;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 44px;
}

.icon-button
{
    width: 60px;
    height: 60px;
    background-color: transparent;
    border-width: 0px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
    flex-shrink: 0;
}

.icon-menu
{
    background-image: url("project://database/Assets/UI/Icons/menu-icon.png");
}

/* Same circular-avatar look as StudentProfile.uss's .avatar/.avatar-initials -
   photo (Cloudinary secure_url) or initials fallback, populated at runtime by
   StudentDashboardController.ApplyAvatar(). */
.profile-avatar-button
{
    border-radius: 62px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.6);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    padding: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.profile-avatar-initials
{
    font-size: 48px;
    -unity-font-style: bold;
    color: white;
}

.icon-logout
{
    background-image: url("project://database/Assets/UI/Icons/exit-logo.png");
}

.header-title-block
{
    flex-grow: 1;
    margin-left: 24px;
    margin-right: 16px;
}

.welcome-title
{
    font-size: 38px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 6px;
}

.welcome-subtitle
{
    font-size: 50px;
    color: white;
}

/* ---------- Level Card ---------- */

.level-card
{
    background-color: rgba(255,255,255,0.16);
    border-radius: 32px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 38px;
    padding-bottom: 38px;
    margin-top: 16px;
}

.classroom-card-archived
{
    opacity: 0.6;
}

.classroom-archived-badge
{
    padding: 8px 18px;
    margin-left: 12px;
    border-radius: 20px;
    background-color: rgba(150, 155, 168, 0.18);
    border-width: 1px;
    border-color: rgba(150, 155, 168, 0.35);
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(110, 115, 128);
}

.view-classroom-button-disabled
{
    opacity: 0.5;
}

.level-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 24px;
}

.level-text
{
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

.progress-track
{
    width: 100%;
    height: 16px;
    background-color: rgba(255,255,255,0.3);
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill
{
    height: 100%;
    background-color: rgb(20,20,20);
    border-radius: 10px;
}

.level-caption
{
    font-size: 26px;
    color: rgba(255,255,255,0.85);
    margin-top: 20px;
}

/* ---------- Join a Classroom ---------- */

.join-classroom-card
{
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-radius: 32px;
    margin-left: 50px;
    margin-right: 50px;
    margin-top: -36px;
    margin-bottom: 24px;
    padding: 34px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.join-classroom-icon-box
{
    width: 90px;
    height: 90px;
    border-radius: 46px;
    background-color: rgb(13,148,136);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 28px;
}

.join-classroom-icon-emoji
{
    font-size: 40px;
    -unity-text-align: middle-center;
}

.join-classroom-text
{
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.join-classroom-title
{
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
}

.join-classroom-subtitle
{
    font-size: 24px;
    color: rgb(138,143,163);
    margin-top: 4px;
    white-space: normal;
}

.join-classroom-button
{
    background-color: rgb(17,17,20);
    border-radius: 26px;
    border-width: 0px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 20px;
    padding-bottom: 20px;
    margin-left: 20px;
    flex-shrink: 0;
    -unity-font-style: bold;
    color: white;
    font-size: 28px;
}

/* ---------- Stat Cards ---------- */

.stats-row
{
    flex-direction: row;
    justify-content: space-between;
    padding-left: 50px;
    padding-right: 50px;
    margin-top: -40px;
    margin-bottom: 0px;
}

.stats-row-spaced
{
    margin-top: 24px;
    margin-bottom: 0px;
}

.stat-card
{
    flex: 1;
    background-color: white;
    border-radius: 32px;
    padding: 36px;
    flex-shrink: 0;
    min-width: 0;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

/* Left card in a row */
.stat-card-left
{
    margin-right: 14px;
}

/* Right card in a row */
.stat-card-right
{
    margin-left: 14px;
}

/* Half width card (points card) - matches quizzes card */
.stat-card-half
{
    flex: 1;
    margin-right: 0;
    margin-left: 0;
}

.stat-card-spacer
{
    flex: 1;
    min-width: 0;
}

.stat-icon
{
    width: 62px;
    height: 62px;
    border-radius: 18px;
    margin-bottom: 22px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
}

.icon-book
{
    background-image: url("project://database/Assets/UI/Icons/book-icon.png");
}

.icon-target
{
    background-image: url("project://database/Assets/UI/Icons/target-icon.png");
}

.icon-trophy
{
    background-image: url("project://database/Assets/UI/Icons/trophy-icon.png");
}

.stat-value
{
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
    margin-bottom: 8px;
}

.stat-label
{
    font-size: 24px;
    color: rgb(138,143,163);
    white-space: normal;
}

/* ---------- Quick Actions ---------- */

.quick-actions-card
{
    background-color: white;
    border-radius: 40px;
    margin-left: 50px;
    margin-right: 50px;
    padding: 52px;
    margin-top: 36px;
    margin-bottom: 0px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.section-title
{
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
    margin-bottom: 36px;
}

.actions-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 28px;
}

.action-button
{
    flex: 1;
    height: 180px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-radius: 28px;
    border-width: 0px;
    min-width: 0;
    border-width: 2px;
    border-color: rgba(255,255,255,0.2);
}

.action-button-left
{
    margin-right: 14px;
}

.action-button-right
{
    margin-left: 14px;
}

.action-icon
{
    width: 62px;
    height: 62px;
    margin-bottom: 18px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
}

.icon-cube
{
    background-image: url("project://database/Assets/UI/Icons/brain-icon.png");
}

.icon-quiz
{
    background-image: url("project://database/Assets/UI/Icons/takequiz-icon.png");
}

.icon-badge
{
    background-image: url("project://database/Assets/UI/Icons/badges-icon.png");
}

.icon-progress
{
    background-image: url("project://database/Assets/UI/Icons/progress-icon.png");
}

.action-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

.action-blue
{
    background-color: rgb(37,99,235);
}

.action-purple
{
    background-color: rgb(147,51,234);
}

.action-gold
{
    background-color: rgb(217,119,6);
}

.action-green
{
    background-color: rgb(22,163,74);
}

/* ---------- Recent Activity ---------- */

.recent-activity-card
{
    background-color: white;
    border-radius: 44px;
    margin-left: 50px;
    margin-right: 50px;
    padding: 48px 44px 28px 44px;
    margin-top: 36px;
    margin-bottom: 70px;
    min-height: 260px;
    border-width: 1px;
    border-color: rgba(15,23,42,0.06);
}

.recent-activity-list
{
    flex-direction: column;
}

/* ---------- Activity Items ---------- */

.activity-item
{
    flex-direction: row;
    align-items: center;
    padding: 26px 4px;
    margin-bottom: 0px;
    border-radius: 0px;
    background-color: rgba(0,0,0,0);
    border-bottom-width: 2px;
    border-bottom-color: rgb(238,241,247);
}

.activity-item:hover
{
    background-color: rgb(248,249,252);
}

.activity-item-last
{
    border-bottom-width: 0px;
}

.activity-icon
{
    width: 64px;
    height: 64px;
    margin-right: 28px;
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
}

.activity-content
{
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 18px;
    justify-content: center;
}

.activity-title
{
    font-size: 28px;
    color: rgb(24,28,38);
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.activity-time
{
    font-size: 22px;
    color: rgb(138,143,163);
}

.activity-points
{
    font-size: 24px;
    color: rgb(21,128,61);
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-left: 14px;
    padding: 10px 22px;
    border-radius: 30px;
    background-color: rgb(220,252,231);
    -unity-text-align: middle-center;
}

/* ---------- Activity kinds (icon glyph + tile color + type label) ---------- */

.activity-kind-quiz
{
    background-image: url("project://database/Assets/UI/Icons/quiz-icon.png");
    -unity-background-image-tint-color: rgb(37,99,235);
}

.activity-kind-badge
{
    background-image: url("project://database/Assets/UI/Icons/trophy-white-icon.png");
    -unity-background-image-tint-color: rgb(147,51,234);
}

.activity-kind-join
{
    background-image: url("project://database/Assets/UI/Icons/classroom-icon.png");
    -unity-background-image-tint-color: rgb(217,119,6);
}

.activity-kind-label
{
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
    color: rgb(37,99,235);
}

.activity-kind-label-quiz  { color: rgb(37,99,235); }
.activity-kind-label-badge { color: rgb(147,51,234); }
.activity-kind-label-join  { color: rgb(217,119,6); }

/* ---------- Utility ---------- */

.hidden
{
    display: none;
}

/* ---------- Recent Activity: View All trigger ---------- */

.recent-activity-header
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 36px;
}

.recent-activity-title
{
    margin-bottom: 0;
}

.view-all-inline-button
{
    background-color: rgba(37, 99, 235, 0.1);
    border-width: 0px;
    border-radius: 22px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    margin: 0;
    flex-shrink: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
    -unity-text-align: middle-center;
}

.view-all-inline-button:hover
{
    background-color: rgba(37, 99, 235, 0.18);
}

/* =========================================================
   Modal Overlay (floating panels layered on screen-root,
   same pattern as the Admin dashboard's classrooms View All)
   ========================================================= */

.modal-overlay
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 20, 28, 0.55);
    justify-content: flex-end;
    align-items: stretch;
}

.modal-card
{
    background-color: rgb(234, 243, 251);
    padding: 0;
    max-height: 85%;
}

/* ---------- Recent Activity: View All overlay (full screen) ---------- */

.view-all-card
{
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-height: 100%;
}

.view-all-header
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding-top: 118px;
    padding-left: 50px;
    padding-right: 40px;
    padding-bottom: 40px;
    background-color: rgb(234, 243, 251);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.07);
}

.view-all-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.view-all-close-button
{
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background-color: white;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    font-size: 28px;
    color: rgb(90, 95, 110);
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.view-all-close-button:hover
{
    background-color: rgb(248, 249, 251);
}

.view-all-close-icon
{
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/UI/Icons/close-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(90, 95, 110);
}

.view-all-scroll
{
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    padding: 0;
    margin: 0;
    -unity-overflow-scrolling: touch;
}

.view-all-list
{
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;

    background-color: white;
    border-radius: 40px;
    margin: 40px 50px 80px 50px;
    padding: 20px 30px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.view-all-list .activity-item
{
    flex-grow: 0;
    flex-shrink: 0;
}

.view-all-no-results
{
    width: 100%;
    align-items: center;
    padding-top: 60px;
}

/* ---------- Compact Layout (Use C# to toggle this class) ---------- */

