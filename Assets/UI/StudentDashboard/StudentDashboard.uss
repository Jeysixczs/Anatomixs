}

.compact .action-label
{
    font-size: 28px;
}

.compact .section-title
{
    font-size: 32px;
    margin-bottom: 28px;
}

.compact .recent-activity-title
{
    margin-bottom: 0;
}

.compact .icon-button
{
    width: 50px;
    height: 50px;
}

.compact .header-title-block
{
    margin-left: 18px;
}

.compact .actions-row
{
    margin-bottom: 22px;
}

.compact .activity-item
{
    padding: 20px 4px;
    margin-bottom: 0px;
    border-radius: 0px;
}

.compact .activity-icon
{
    width: 54px;
    height: 54px;
    margin-right: 22px;
}

.compact .activity-title
{
    font-size: 20px;
