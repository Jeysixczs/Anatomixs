    padding-left: 30px;
    padding-right: 30px;
    padding-top: 16px;
    padding-bottom: 16px;
    margin-left: 14px;
}

.compact .stats-row
{
    padding-left: 34px;
    padding-right: 34px;
    margin-top: -34px;
}

.compact .stats-row-spaced
{
    margin-top: 20px;
}

.compact .stat-card
{
    padding: 28px;
}

.compact .stat-card-left
{
    margin-right: 10px;
}

.compact .stat-card-right
{
    margin-left: 10px;
}

.compact .stat-value
{
    font-size: 40px;
}

.compact .stat-label
{
    font-size: 20px;
}

.compact .stat-icon
{
    width: 52px;
    height: 52px;
}

.compact .quick-actions-card
{
    margin-left: 34px;
    margin-right: 34px;
    padding: 40px;
    margin-top: 28px;
}

.compact .recent-activity-card
{
    margin-left: 34px;
    margin-right: 34px;
    padding: 40px;
    margin-top: 28px;
    margin-bottom: 60px;
}

.compact .action-button
{
    height: 155px;
}

.compact .action-button-left
{
    margin-right: 10px;
}

.compact .action-button-right
{
    margin-left: 10px;
}

.compact .action-icon
{
    width: 54px;
    height: 54px;
}

.compact .action-label
{
    font-size: 28px;
}

.compact .section-title
{
    font-size: 32px;
    margin-bottom: 28px;
}

.compact .icon-button
{
    width: 50px;
    height: 50px;
}

.compact .header-title-block
{
    margin-left: 18px;
}

.compact .actions-row
{
    margin-bottom: 22px;
}

.compact .activity-item
{
    padding-top: 20px;
    padding-bottom: 20px;
}

.compact .activity-icon
{
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 18px;
}

.compact .activity-title
{
    font-size: 20px;
}

.compact .activity-time
{
    font-size: 18px;
}

.compact .activity-points
{
    font-size: 20px;
}

/* ---------- Extra Small Layout (Use C# to toggle this class) ---------- */

.extra-small .header
{
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 60px;
    padding-bottom: 50px;
}

.extra-small .header-top-row
{
    margin-bottom: 30px;
}

.extra-small .welcome-title
{
    font-size: 26px;
}

.extra-small .welcome-subtitle
