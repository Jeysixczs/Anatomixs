<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StudentDashboard/StudentDashboard.uss?fileID=7433441132597879392&amp;guid=aae9f4de504d9f240900c8a586fb8998&amp;type=3#StudentDashboard"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaLayout.uss"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme theme-dashboard screen-root">
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <ui:VisualElement name="content-wrapper" class="content-wrapper">

                <!-- 1. Editorial header: utilities on the first line, big greeting below -->
                <ui:VisualElement name="header" class="header">
                    <ui:VisualElement name="header-top-row" class="header-top-row">
                        <ui:Button name="profile-button" class="profile-avatar-button">
                            <ui:Label name="profile-initials-label" text="" class="profile-avatar-initials"/>
                        </ui:Button>
                        <ui:Button name="notification-button" class="icon-button icon-logout" style="background-image: url(&quot;project://database/Assets/UI/Icons/notification-icon.png?fileID=2800000&amp;guid=2ec670fa8b34f0344ab02290e1015ebc&amp;type=3#notification-icon&quot;);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="header-title-block" class="header-title-block">
                        <ui:Label text="Welcome back!" class="welcome-title"/>
                        <ui:Label name="student-name-label" text="Jeysi" class="welcome-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 2. Bento row A: level (wide) | stats stacked (narrow) -->
                <ui:VisualElement class="bento-row bento-row-top">
                    <ui:VisualElement name="level-card" class="level-card bento-w3 bento-l">
                        <ui:VisualElement class="level-row">
                            <ui:Label name="current-level-label" text="Level 5" class="level-text"/>
                            <ui:Label name="next-level-label" text="Level 6" class="level-text"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="level-bottom">
                            <ui:VisualElement class="progress-track">
                                <ui:VisualElement name="progress-fill" class="progress-fill" style="width: 62%;"/>
                            </ui:VisualElement>
                            <ui:Label name="points-to-next-label" text="350 points to next level" class="level-caption"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="stats-row" class="stats-row bento-w2 bento-r">
                        <ui:VisualElement name="quizzes-card" class="stat-card stat-card-left">
                            <ui:VisualElement class="stat-icon stat-icon-blue icon-book" style="background-image: url(&quot;project://database/Assets/UI/Icons/quiz-black-icon.png?fileID=2800000&amp;guid=5f4d5118721f3fa4d84099d7ee4d0cf0&amp;type=3#quiz-black-icon&quot;);"/>
                            <ui:VisualElement class="stat-text">
                                <ui:Label name="quizzes-value-label" text="24" class="stat-value"/>
                                <ui:Label text="Quizzes Completed" class="stat-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="points-card" class="stat-card stat-card-right">
                            <ui:VisualElement class="stat-icon stat-icon-purple icon-trophy" style="background-image: url(&quot;project://database/Assets/UI/Icons/trophy-black-icon.png?fileID=2800000&amp;guid=86cf8116800ab33499fdcb875badace8&amp;type=3#trophy-black-icon&quot;);"/>
                            <ui:VisualElement class="stat-text">
                                <ui:Label name="points-value-label" text="1250" class="stat-value"/>
                                <ui:Label text="Total Points" class="stat-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 3. Bento body: actions + join -->
                <ui:VisualElement name="quick-actions-card" class="quick-actions-card">
                    <ui:Label text="Quick Actions" class="section-title"/>

                    <!-- Row B: Explore 3D (tall hero tile) | two stacked tiles -->
                    <ui:VisualElement class="bento-row">
                        <ui:Button name="explore-3d-button" class="action-button action-blue action-button-left action-primary bento-w3 bento-l">
                            <ui:VisualElement class="action-icon icon-cube"/>
                            <ui:Label text="Explore 3D" class="action-label"/>
                        </ui:Button>
                        <ui:VisualElement class="bento-stack bento-w2 bento-r">
                            <ui:Button name="classroom-hub-button" class="action-button action-purple action-button-right action-tile">
                                <ui:VisualElement class="action-icon icon-classroom-hub" style="background-image: url(&quot;project://database/Assets/UI/Icons/classroom-icon.png?fileID=2800000&amp;guid=5739fd750ddf3d64c8795b29466ce716&amp;type=3#classroom-icon&quot;);"/>
                                <ui:Label text="Classroom Hub" class="action-label"/>
                            </ui:Button>
                            <ui:Button name="progress-button" class="action-button action-green action-button-right action-tile action-tile-last">
                                <ui:VisualElement class="action-icon icon-progress"/>
                                <ui:Label text="Progress" class="action-label"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Row C: Badges (narrow) | Join (wide) -->
                    <ui:VisualElement class="bento-row bento-row-last">
                        <ui:Button name="badges-button" class="action-button action-gold action-button-left action-tile bento-w2 bento-l">
                            <ui:VisualElement class="action-icon icon-badge" style="background-image: url(&quot;project://database/Assets/UI/Icons/trophy-white-icon.png?fileID=2800000&amp;guid=fcabf8ec9e546d54ea2c70e9d8b581d4&amp;type=3#trophy-white-icon&quot;);"/>
                            <ui:Label text="Badges" class="action-label"/>
                        </ui:Button>
                        <ui:VisualElement name="join-classroom-card" class="join-classroom-card bento-w3 bento-r">
                            <ui:VisualElement name="join-classroom-icon-box" class="join-classroom-icon-box">
                                <ui:Label text="" class="join-classroom-icon-emoji" style="background-image: url(&quot;project://database/Assets/UI/Icons/users-icon.png?fileID=2800000&amp;guid=283e313d0909bc04882c7217209f7b5f&amp;type=3#users-icon&quot;);"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="join-classroom-text" class="join-classroom-text">
                                <ui:Label text="Join a Classroom" class="join-classroom-title"/>
                                <ui:Label text="Connect with your teacher" class="join-classroom-subtitle"/>
                            </ui:VisualElement>
                            <ui:Button name="join-classroom-button" text="Join" class="join-classroom-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 4. Feed -->
                <ui:VisualElement name="recent-activity-card" class="recent-activity-card">
                    <ui:VisualElement name="recent-activity-header" class="recent-activity-header">
                        <ui:Label text="Recent Activity" class="section-title recent-activity-title"/>
                        <ui:Button name="recent-activity-view-all-button" text="View All" class="view-all-inline-button hidden"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="recent-activity-list" class="recent-activity-list"/>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="recent-activity-view-all-overlay" class="modal-overlay hidden">
            <ui:VisualElement name="recent-activity-view-all-card" class="modal-card view-all-card">
                <ui:VisualElement name="recent-activity-view-all-header" class="view-all-header">
                    <ui:VisualElement class="view-all-title-block">
                        <ui:Label text="Recent Activity" class="view-all-title"/>
                        <ui:Label text="Your latest quizzes, badges and classrooms" class="view-all-subtitle"/>
                    </ui:VisualElement>
                    <ui:Button name="recent-activity-view-all-close-button" class="view-all-close-button">
                        <ui:VisualElement picking-mode="Ignore" class="view-all-close-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="recent-activity-view-all-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="view-all-scroll">
                    <ui:VisualElement name="recent-activity-view-all-no-results" class="view-all-no-results hidden">
                        <ui:VisualElement picking-mode="Ignore" class="view-all-empty-tile">
                            <ui:VisualElement picking-mode="Ignore" class="view-all-empty-icon"/>
                        </ui:VisualElement>
                        <ui:Label text="No recent activity yet" class="view-all-empty-title"/>
                        <ui:Label text="Take a quiz or earn a badge and it will show up here." class="view-all-empty-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="recent-activity-view-all-list" class="recent-activity-list view-all-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
