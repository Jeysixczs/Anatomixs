/* =========================================================
   Anatomia 3D - Quiz Screen
   Reference canvas: 1080 x 1920 (portrait)
   Gradients are painted at runtime onto elements carrying
   the "gradient-target" class (see QuizScreenController.cs)
   ========================================================= */

.quiz-root {
    flex-grow: 1;
    background-color: rgb(234, 240, 241);
}

/* ---------------- HEADER ---------------- */

.header {
    /* background painted at runtime via generated gradient texture */
    padding: 40px 32px 28px 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
}

.header-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.icon-button {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 0;
}

.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.28);
}

.badges-row {
    flex-direction: row;
}

.pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.22);
    border-radius: 18px;
    padding: 8px 16px;
    margin-left: 12px;
}

.pill-icon {
    font-size: 16px;
    margin-right: 6px;
    color: rgb(255, 255, 255);
}

.pill-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.progress-track {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.35);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 14px;
}

.progress-fill {
    height: 6px;
    width: 16%;
    background-color: rgb(17, 24, 39);
    border-radius: 3px;
}

.question-counter {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.92);
}

/* ---------------- CARD ---------------- */

.body-scroll {
    flex-grow: 1;
}

.card {
    background-color: rgb(255, 255, 255);
    margin: -24px 24px 24px 24px;
    padding: 28px 24px;
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.04);
}

.card-top-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 14px;
}

.type-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(59, 130, 246);
    letter-spacing: 1px;
}

.quiz-label {
    font-size: 14px;
    color: rgb(148, 163, 184);
}

.question-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(17, 24, 39);
    white-space: normal;
    margin-bottom: 24px;
}

.answer-container {
    flex-grow: 1;
}

.helper-text {
    font-size: 15px;
    color: rgb(107, 114, 128);
    margin-bottom: 12px;
}

/* ---------------- OPTION ROWS (Multiple Choice / True-False) ---------------- */

.option-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(229, 231, 235);
    border-radius: 14px;
    padding: 18px 20px;
    margin-bottom: 14px;
}

.option-row:hover {
    border-color: rgb(191, 219, 254);
}

.option-row--selected {
    border-color: rgb(59, 130, 246);
    background-color: rgb(239, 246, 255);
}

.radio-outer {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(203, 213, 225);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
}

.option-row--selected .radio-outer {
    border-color: rgb(59, 130, 246);
}

.radio-inner {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(17, 24, 39);
    display: none;
}

.option-row--selected .radio-inner {
    display: flex;
}

.option-label {
    font-size: 18px;
    color: rgb(30, 41, 59);
}

/* ---------------- CHECKBOX ROWS (Multiple Identification) ---------------- */

.checkbox-outer {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(203, 213, 225);
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
}

.option-row--selected .checkbox-outer {
    background-color: rgb(17, 24, 39);
    border-color: rgb(17, 24, 39);
}

.checkbox-check {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    display: none;
}

.option-row--selected .checkbox-check {
    display: flex;
}

/* ---------------- TEXT INPUTS (Identification / Enumeration / Image Based) ---------------- */

.answer-text-field {
    margin-bottom: 14px;
}

.answer-text-field > .unity-text-field__input {
    background-color: rgb(243, 244, 246);
    border-width: 1px;
    border-color: rgb(229, 231, 235);
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 17px;
    color: rgb(17, 24, 39);
}

.answer-text-field > .unity-text-field__input:focus {
    border-color: rgb(59, 130, 246);
}

/* ---------------- IMAGE BASED ---------------- */

.image-frame {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(229, 231, 235);
    border-radius: 14px;
    align-items: center;
    justify-content: center;
    height: 260px;
    margin-bottom: 20px;
    overflow: hidden;
}

.quiz-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.arrow-marker {
    position: absolute;
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------------- ACTION BUTTON ---------------- */

.action-button {
    /* background painted at runtime via generated gradient texture */
    margin: 8px 24px 28px 24px;
    height: 64px;
    border-radius: 16px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.action-button--disabled {
    opacity: 0.55;
}

/* ---------------- COMPACT BREAKPOINT (narrow / small devices) ---------------- */

.compact .question-text {
    font-size: 20px;
}

.compact .option-row {
    padding: 14px 16px;
}

.compact .card {
    padding: 20px 18px;
    margin: -20px 16px 16px 16px;
}

.compact .action-button {
    height: 56px;
    margin: 6px 16px 20px 16px;
}
