/* =========================================================
   Anatomia 3D - Admin (Teacher) Profile (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 100px;
    padding-bottom: 50px;
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 40px;
}

.back-button
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 30px;
    flex-shrink: 0;
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.header-subtitle
{
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
    word-wrap: break-word;
}

/* ---------- Profile Summary Card ---------- */

.profile-summary-card
{
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 28px;
    padding: 30px;
}

.avatar
{
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.6);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 28px;
}

.avatar-initials
{
    font-size: 46px;
    -unity-font-style: bold;
    color: white;
}

.profile-summary-text
{
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.profile-name
{
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.profile-email
{
    font-size: 24px;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 4px;
    white-space: normal;
    word-wrap: break-word;
}

.role-badge
{
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.22);
    border-radius: 18px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-top: 14px;
}

.role-badge-label
{
    font-size: 22px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 0;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

/* ---------- Stat Row (mirrors Dashboard's stat cards, 3-up) ---------- */

.stats-row
{
    flex-direction: row;
    justify-content: space-between;
    padding-left: 50px;
    padding-right: 50px;
    margin-top: 30px;
    margin-bottom: 10px;
}

.stat-card
{
    flex: 1;
    background-color: white;
    border-radius: 26px;
    padding: 24px;
    flex-shrink: 0;
    min-width: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    align-items: flex-start;
}

.stat-card-left
{
    margin-right: 8px;
}

.stat-card-mid
{
    margin-right: 8px;
}

.stat-card-right
{
    margin-left: 0;
}

.stat-icon
{
    width: 44px;
    height: 44px;
    border-radius: 14px;
    margin-bottom: 14px;
    justify-content: center;
    align-items: center;
}

.stat-icon-glyph
{
    font-size: 22px;
    -unity-text-align: middle-center;
}

.stat-icon-blue { background-color: rgb(37, 99, 235); }
.stat-icon-orange { background-color: rgb(217, 119, 6); }
.stat-icon-purple { background-color: rgb(147, 51, 234); }

.stat-value
{
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 4px;
}

.stat-label
{
    font-size: 18px;
    color: rgb(138, 143, 163);
    white-space: normal;
}

/* ---------- Menu Cards ---------- */

.section-title
{
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    padding-left: 50px;
    padding-right: 50px;
    margin-top: 26px;
    margin-bottom: 16px;
}

.menu-card
{
    background-color: white;
    border-radius: 28px;
    margin-left: 50px;
    margin-right: 50px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.menu-item
{
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0px;
    padding: 22px;
    margin: 0;
    border-radius: 0;
}

.menu-item:hover
{
    background-color: rgba(0, 0, 0, 0.03);
}

.menu-divider
{
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
    margin-left: 22px;
    margin-right: 22px;
}

.menu-icon-box
{
    width: 60px;
    height: 60px;
    border-radius: 18px;
    margin-right: 24px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.menu-icon-blue { background-color: rgb(37, 99, 235); }
.menu-icon-orange { background-color: rgb(217, 119, 6); }
.menu-icon-green { background-color: rgb(22, 163, 74); }
.menu-icon-purple { background-color: rgb(147, 51, 234); }
.menu-icon-gray { background-color: rgb(148, 153, 168); }
.menu-icon-red { background-color: rgb(220, 38, 38); }

.menu-icon-glyph
{
    font-size: 26px;
    color: white;
    -unity-text-align: middle-center;
}

.menu-item-label
{
    font-size: 28px;
    color: rgb(31, 36, 48);
    flex-grow: 1;
}

.menu-chevron
{
    width: 16px;
    height: 16px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-color: rgb(190, 193, 204);
    rotate: 45deg;
    flex-shrink: 0;
    margin-right: 6px;
}

/* ---------- Log Out ---------- */

.logout-button
{
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-radius: 28px;
    margin-left: 50px;
    margin-right: 50px;
    margin-top: 30px;
    padding: 22px;
    border-width: 1px;
    border-color: rgba(220, 38, 38, 0.15);
}

.logout-button:hover
{
    background-color: rgba(220, 38, 38, 0.04);
}

.logout-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(220, 38, 38);
}

.version-label
{
    font-size: 20px;
    color: rgb(160, 165, 178);
    -unity-text-align: middle-center;
    margin-top: 26px;
    margin-bottom: 50px;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 70px;
    padding-bottom: 40px;
}

.compact .header-top-row
{
    margin-bottom: 28px;
}

.compact .header-title
{
    font-size: 36px;
}

.compact .header-subtitle
{
    font-size: 22px;
}

.compact .back-button
{
    width: 68px;
    height: 68px;
    border-radius: 34px;
    margin-right: 20px;
}

.compact .back-icon
{
    width: 32px;
    height: 32px;
}

.compact .profile-summary-card
{
    padding: 22px;
}

.compact .avatar
{
    width: 90px;
    height: 90px;
    border-radius: 45px;
    margin-right: 20px;
}

.compact .avatar-initials
{
    font-size: 36px;
}

.compact .profile-name
{
    font-size: 28px;
}

.compact .profile-email
{
    font-size: 20px;
}

.compact .role-badge-label
{
    font-size: 18px;
}

.compact .stats-row
{
    padding-left: 34px;
    padding-right: 34px;
}

.compact .stat-card
{
    padding: 18px;
}

.compact .stat-value
{
    font-size: 28px;
}

.compact .stat-label
{
    font-size: 16px;
}

.compact .section-title
{
    font-size: 24px;
    padding-left: 34px;
    padding-right: 34px;
}

.compact .menu-card,
.compact .logout-button
{
    margin-left: 34px;
    margin-right: 34px;
}

.compact .menu-item-label,
.compact .logout-label
{
    font-size: 24px;
}

.compact .menu-icon-box
{
    width: 50px;
    height: 50px;
    margin-right: 18px;
}

.compact .menu-icon-glyph
{
    font-size: 22px;
}

.compact .stat-icon-glyph
{
    font-size: 18px;
}
