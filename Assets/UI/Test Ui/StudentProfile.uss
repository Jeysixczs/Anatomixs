/* =========================================================
   Anatomia 3D - Student Profile (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 69px;
    border-bottom-right-radius: 69px;
    padding-left: 57px;
    padding-right: 57px;
    padding-top: 115px;
    padding-bottom: 57px;
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 46px;
}

.back-button
{
    width: 101px;
    height: 101px;
    border-radius: 51px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 34px;
    flex-shrink: 0;
}

.back-icon
{
    width: 46px;
    height: 46px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 51px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.header-subtitle
{
    font-size: 30px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 7px;
    white-space: normal;
    word-wrap: break-word;
}

/* ---------- Profile Summary Card ---------- */

.profile-summary-card
{
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.16);
    border-radius: 32px;
    padding: 34px;
}

.avatar
{
    width: 138px;
    height: 138px;
    border-radius: 69px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.6);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 32px;
}

.avatar-initials
{
    font-size: 53px;
    -unity-font-style: bold;
    color: white;
}

.profile-summary-text
{
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.profile-name
{
    font-size: 39px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.profile-email
{
    font-size: 28px;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 5px;
    white-space: normal;
    word-wrap: break-word;
}

.level-badge
{
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.22);
    border-radius: 21px;
    padding-left: 23px;
    padding-right: 23px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 16px;
}

.level-badge-label
{
    font-size: 25px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 0;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

/* ---------- Stat Row (mirrors Dashboard's stat cards, 3-up) ---------- */

.stats-row
{
    flex-direction: row;
    justify-content: space-between;
    padding-left: 57px;
    padding-right: 57px;
    margin-top: 34px;
    margin-bottom: 12px;
}

.stat-card
{
    flex: 1;
    background-color: white;
    border-radius: 30px;
    padding: 28px;
    flex-shrink: 0;
    min-width: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    align-items: flex-start;
}

.stat-card-left
{
    margin-right: 9px;
}

.stat-card-mid
{
    margin-right: 9px;
}

.stat-card-right
{
    margin-left: 0;
}

.stat-icon
{
    width: 51px;
    height: 51px;
    border-radius: 16px;
    margin-bottom: 16px;
    justify-content: center;
    align-items: center;
}

.stat-icon-glyph
{
    font-size: 25px;
    -unity-text-align: middle-center;
}

.stat-icon-blue { background-color: rgb(37, 99, 235); }
.stat-icon-orange { background-color: rgb(217, 119, 6); }
.stat-icon-purple { background-color: rgb(147, 51, 234); }

.stat-value
{
    font-size: 39px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 5px;
}

.stat-label
{
    font-size: 21px;
    color: rgb(138, 143, 163);
    white-space: normal;
}

/* ---------- Menu Cards ---------- */

.section-title
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    padding-left: 57px;
    padding-right: 57px;
    margin-top: 30px;
    margin-bottom: 18px;
}

.menu-card
{
    background-color: white;
    border-radius: 32px;
    margin-left: 57px;
    margin-right: 57px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.menu-item
{
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0px;
    padding: 25px;
    margin: 0;
    border-radius: 0;
}

.menu-item:hover
{
    background-color: rgba(0, 0, 0, 0.03);
}

.menu-divider
{
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
    margin-left: 25px;
    margin-right: 25px;
}

.menu-icon-box
{
    width: 69px;
    height: 69px;
    border-radius: 21px;
    margin-right: 28px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.menu-icon-blue { background-color: rgb(37, 99, 235); }
.menu-icon-orange { background-color: rgb(217, 119, 6); }
.menu-icon-green { background-color: rgb(22, 163, 74); }
.menu-icon-purple { background-color: rgb(147, 51, 234); }
.menu-icon-gray { background-color: rgb(148, 153, 168); }
.menu-icon-red { background-color: rgb(220, 38, 38); }

.menu-icon-glyph
{
    font-size: 30px;
    color: white;
    -unity-text-align: middle-center;
}

.menu-item-label
{
    font-size: 32px;
    color: rgb(31, 36, 48);
    flex-grow: 1;
}

.menu-chevron
{
    width: 18px;
    height: 18px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-color: rgb(190, 193, 204);
    rotate: 45deg;
    flex-shrink: 0;
    margin-right: 7px;
}

/* ---------- Log Out ---------- */

.logout-button
{
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-radius: 32px;
    margin-left: 57px;
    margin-right: 57px;
    margin-top: 34px;
    padding: 25px;
    border-width: 1px;
    border-color: rgba(220, 38, 38, 0.15);
}

.logout-button:hover
{
    background-color: rgba(220, 38, 38, 0.04);
}

.logout-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(220, 38, 38);
}

.version-label
{
    font-size: 23px;
    color: rgb(160, 165, 178);
    -unity-text-align: middle-center;
    margin-top: 30px;
    margin-bottom: 57px;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 39px;
    padding-right: 39px;
    padding-top: 80px;
    padding-bottom: 46px;
}

.compact .header-top-row
{
    margin-bottom: 32px;
}

.compact .header-title
{
    font-size: 41px;
}

.compact .header-subtitle
{
    font-size: 25px;
}

.compact .back-button
{
    width: 78px;
    height: 78px;
    border-radius: 39px;
    margin-right: 23px;
}

.compact .back-icon
{
    width: 37px;
    height: 37px;
}

.compact .profile-summary-card
{
    padding: 25px;
}

.compact .avatar
{
    width: 103px;
    height: 103px;
    border-radius: 52px;
    margin-right: 23px;
}

.compact .avatar-initials
{
    font-size: 41px;
}

.compact .profile-name
{
    font-size: 32px;
}

.compact .profile-email
{
    font-size: 23px;
}

.compact .level-badge-label
{
    font-size: 21px;
}

.compact .stats-row
{
    padding-left: 39px;
    padding-right: 39px;
}

.compact .stat-card
{
    padding: 21px;
}

.compact .stat-value
{
    font-size: 32px;
}

.compact .stat-label
{
    font-size: 18px;
}

.compact .section-title
{
    font-size: 28px;
    padding-left: 39px;
    padding-right: 39px;
}

.compact .menu-card,
.compact .logout-button
{
    margin-left: 39px;
    margin-right: 39px;
}

.compact .menu-item-label,
.compact .logout-label
{
    font-size: 28px;
}

.compact .menu-icon-box
{
    width: 57px;
    height: 57px;
    margin-right: 21px;
}

.compact .menu-icon-glyph
{
    font-size: 25px;
}

.compact .stat-icon-glyph
{
    font-size: 21px;
}
