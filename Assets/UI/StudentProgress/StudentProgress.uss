/* =========================================================
   Anatomia 3D - Progress Tracker (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(234,243,251);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 100px;
    padding-bottom: 50px;
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
}

.back-button
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 30px;
    flex-shrink: 0;
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.header-subtitle
{
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    min-height: 0;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 40px;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

.section-title
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
    margin-bottom: 24px;
}

/* ---------- Level Progress Card ---------- */

.level-progress-card
{
    background-color: white;
    border-radius: 32px;
    padding: 40px;
    margin-bottom: 30px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.level-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 20px;
}

.level-block
{
    flex-direction: column;
}

.level-block-right
{
    align-items: flex-end;
}

.level-number
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
}

.level-caption-small
{
    font-size: 20px;
    color: rgb(138,143,163);
    margin-top: 4px;
}

.progress-track
{
    width: 100%;
    height: 16px;
    background-color: rgb(230,233,240);
    border-radius: 8px;
    overflow: hidden;
}

.progress-fill
{
    height: 100%;
    background-color: rgb(20,20,20);
    border-radius: 8px;
}

.level-caption
{
    font-size: 22px;
    color: rgb(138,143,163);
    margin-top: 16px;
}

/* ---------- Level Roadmap Card ---------- */

.level-roadmap-card
{
    background-color: white;
    border-radius: 32px;
    padding: 40px;
    margin-bottom: 30px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.level-roadmap-subtitle
{
    font-size: 20px;
    color: rgb(138,143,163);
    margin-top: -16px;
    margin-bottom: 24px;
}

.level-roadmap-list
{
    flex-direction: column;
}

.level-roadmap-item
{
    flex-direction: row;
    align-items: center;
    padding: 18px 20px;
    border-radius: 20px;
    background-color: rgb(246,248,251);
    margin-bottom: 14px;
    border-width: 2px;
    border-color: transparent;
}

.level-roadmap-badge
{
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(230,233,240);
    justify-content: center;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.level-roadmap-badge-number
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(110,115,133);
}

.level-roadmap-text-col
{
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.level-roadmap-title
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
    white-space: normal;
}

.level-roadmap-points
{
    font-size: 20px;
    color: rgb(138,143,163);
    margin-top: 4px;
    white-space: normal;
}

.level-roadmap-status
{
    font-size: 18px;
    -unity-font-style: bold;
    padding: 8px 16px;
    border-radius: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    background-color: rgb(230,233,240);
    color: rgb(110,115,133);
}

/* Current level: highlighted card + blue badge/pill */
.level-roadmap-item-current
{
    background-color: rgba(37,99,235,0.08);
    border-color: rgb(37,99,235);
}

.level-roadmap-item-current .level-roadmap-badge
{
    background-color: rgb(37,99,235);
}

.level-roadmap-item-current .level-roadmap-badge-number
{
    color: white;
}

.level-roadmap-item-current .level-roadmap-status
{
    background-color: rgb(37,99,235);
    color: white;
}

/* Already-reached levels below the current one: green badge/pill */
.level-roadmap-item-completed .level-roadmap-badge
{
    background-color: rgb(22,163,74);
}

.level-roadmap-item-completed .level-roadmap-badge-number
{
    color: white;
}

.level-roadmap-item-completed .level-roadmap-status
{
    background-color: rgba(22,163,74,0.14);
    color: rgb(22,163,74);
}

/* Not-yet-reached levels: muted */
.level-roadmap-item-locked
{
    opacity: 0.85;
}

/* ---------- Stat Cards ---------- */

.stats-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 0px;
}

.stats-row-spaced
{
    margin-top: 20px;
}

.stat-card
{
    flex: 1;
    background-color: white;
    border-radius: 28px;
    padding: 28px;
    flex-shrink: 0;
    min-width: 0;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.stat-card-left
{
    margin-right: 10px;
}

.stat-card-right
{
    margin-left: 10px;
}

.stat-icon
{
    width: 52px;
    height: 52px;
    border-radius: 16px;
    margin-bottom: 18px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
    justify-content: center;
    align-items: center;
}

.stat-icon-glyph
{
    font-size: 26px;
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.stat-icon-blue { background-color: rgb(37,99,235); }
.stat-icon-green { background-color: rgb(22,163,74); }
.stat-icon-purple { background-color: rgb(147,51,234); }
.stat-icon-gold { background-color: rgb(217,119,6); }

.icon-book
{
    background-image: url("project://database/Assets/UI/Icons/book-icon.png");
}

.icon-target
{
    background-image: url("project://database/Assets/UI/Icons/target-icon.png");
}

.icon-trophy
{
    background-image: url("project://database/Assets/UI/Icons/trophy-icon.png");
}

.icon-badge
{
    background-image: url("project://database/Assets/UI/Icons/badges-icon.png");
}

.stat-value
{
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
    margin-bottom: 6px;
}

.stat-label
{
    font-size: 20px;
    color: rgb(138,143,163);
    white-space: normal;
}

/* ---------- Tab Toggle ---------- */

.tab-toggle
{
    flex-direction: row;
    background-color: rgb(228,231,238);
    border-radius: 28px;
    padding: 6px;
    margin-top: 30px;
    margin-bottom: 30px;
}

.tab-button
{
    flex: 1;
    height: 68px;
    border-radius: 22px;
    border-width: 0px;
    background-color: transparent;
    color: rgb(110,115,133);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tab-button-active
{
    background-color: white;
    color: rgb(31,36,48);
}

/* ---------- Tab Panel ---------- */

.tab-panel
{
    width: 100%;
}

.hidden
{
    display: none;
}

/* ---------- Weekly Chart Card ---------- */

.weekly-chart-card
{
    background-color: white;
    border-radius: 32px;
    padding: 40px;
    margin-bottom: 30px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.chart-area
{
    flex-direction: row;
    height: 320px;
}

.chart-y-axis
{
    flex-direction: column;
    justify-content: space-between;
    width: 60px;
    height: 100%;
    margin-right: 12px;
}

.chart-axis-label
{
    font-size: 18px;
    color: rgb(150,155,168);
}

.chart-bars-row
{
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    align-items: flex-end;
    justify-content: space-between;
    border-left-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(232,234,240);
    border-bottom-color: rgb(232,234,240);
    padding-left: 10px;
}

.bar-col
{
    flex: 1;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    margin-left: 6px;
    margin-right: 6px;
}

.chart-bar
{
    width: 100%;
    max-width: 40px;
    background-color: rgb(147,51,234);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.chart-x-axis
{
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
    padding-left: 72px;
}

.chart-day-label
{
    flex: 1;
    font-size: 20px;
    color: rgb(110,115,133);
    -unity-text-align: middle-center;
}

/* ---------- Category Card ---------- */

.category-card
{
    background-color: white;
    border-radius: 32px;
    padding: 40px;
    margin-bottom: 40px;
    border-width: 1px;
    border-color: rgba(0,0,0,0.05);
}

.category-item
{
    margin-bottom: 30px;
}

.category-item-last
{
    margin-bottom: 0px;
}

.category-header-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 14px;
}

.category-name
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
}

.category-count
{
    font-size: 22px;
    color: rgb(138,143,163);
}

/* ---------- Take Posttest button (Pretest / Posttest card) ----------
   Solid blue (same blue as the header gradient's end colour) with a darker
   bottom edge so it reads as a raised, tappable button. Deliberately does NOT set
   "display", so the .hidden class (display: none) keeps working. */

.baseline-cta-button
{
    height: 100px;
    margin-top: 34px;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 0;
    padding-bottom: 0;
    border-radius: 30px;
    border-width: 0px;
    border-bottom-width: 6px;
    border-bottom-color: rgb(29,78,216);
    background-color: rgb(37,99,235);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.baseline-cta-button:hover
{
    background-color: rgb(59,130,246);
}

.baseline-cta-button:active
{
    background-color: rgb(29,78,216);
    border-bottom-color: rgb(30,64,175);
    scale: 0.98 0.98;
}

.baseline-cta-icon
{
    width: 38px;
    height: 38px;
    margin-right: 16px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/book-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.baseline-cta-label
{
    color: white;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.category-progress-row
{
    flex-direction: row;
    align-items: center;
}

.category-track
{
    flex-grow: 1;
    height: 14px;
    background-color: rgb(230,233,240);
    border-radius: 7px;
    overflow: hidden;
    margin-right: 16px;
}

.category-fill
{
    height: 100%;
    background-color: rgb(20,20,20);
    border-radius: 7px;
}

.category-percent
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(37,99,235);
    width: 70px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 70px;
    padding-bottom: 40px;
}

.compact .header-title
{
    font-size: 36px;
}

.compact .header-subtitle
{
    font-size: 22px;
}

.compact .back-button
{
    width: 68px;
    height: 68px;
    border-radius: 34px;
    margin-right: 20px;
}

.compact .back-icon
{
    width: 32px;
    height: 32px;
}

.compact .content-wrapper
{
    padding: 26px;
}

.compact .section-title
{
    font-size: 26px;
    margin-bottom: 18px;
}

.compact .level-progress-card
{
    padding: 28px;
    border-radius: 26px;
}

.compact .level-number
{
    font-size: 26px;
}

.compact .level-caption-small
{
    font-size: 18px;
}

.compact .level-caption
{
    font-size: 19px;
}

.compact .level-roadmap-card
{
    padding: 28px;
    border-radius: 26px;
}

.compact .level-roadmap-subtitle
{
    font-size: 18px;
}

.compact .level-roadmap-item
{
    padding: 14px 16px;
}

.compact .level-roadmap-badge
{
    width: 50px;
    height: 50px;
    border-radius: 25px;
    margin-right: 14px;
}

.compact .level-roadmap-badge-number
{
    font-size: 20px;
}

.compact .level-roadmap-title
{
    font-size: 20px;
}

.compact .level-roadmap-points
{
    font-size: 17px;
}

.compact .level-roadmap-status
{
    font-size: 16px;
    padding: 6px 12px;
}

.compact .stat-card
{
    padding: 22px;
}

.compact .stat-card-left
{
    margin-right: 8px;
}

.compact .stat-card-right
{
    margin-left: 8px;
}

.compact .stat-value
{
    font-size: 34px;
}

.compact .stat-label
{
    font-size: 18px;
}

.compact .stat-icon
{
    width: 44px;
    height: 44px;
}

.compact .stat-icon-glyph
{
    font-size: 21px;
}

.compact .tab-button
{
    font-size: 20px;
    height: 58px;
}

.compact .baseline-cta-button
{
    height: 88px;
}

.compact .baseline-cta-label
{
    font-size: 26px;
}

.compact .weekly-chart-card,
.compact .category-card
{
    padding: 26px;
    border-radius: 26px;
}

.compact .chart-area
{
    height: 260px;
}

.compact .chart-axis-label
{
    font-size: 16px;
}

.compact .chart-day-label
{
    font-size: 17px;
}

.compact .chart-x-axis
{
    padding-left: 58px;
}

.compact .category-name
{
    font-size: 22px;
}

.compact .category-count
{
    font-size: 19px;
}

.compact .category-percent
{
    font-size: 20px;
    width: 58px;
}
