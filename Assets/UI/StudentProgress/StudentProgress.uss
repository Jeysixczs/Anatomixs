/* =========================================================
   Anatomia 3D - Progress Tracker (redesign)
   Reference canvas: 1080 x 1920 (portrait phone).
   Layout: fixed slim header | scroll: level hero, 2x2 stat tiles,
   tabs (Activity / Skills / Levels).
   Everything is scoped under .anatomia-theme.theme-progress so it out-ranks the shared
   Quiet Glass theme. Nothing here affects other screens.
   ========================================================= */

.anatomia-theme.theme-progress.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

.hidden { display: none; }

/* ---------- Header (fixed) ---------- */

.anatomia-theme.theme-progress .header
{
    flex-shrink: 0;
    flex-direction: column;
    padding: 84px 40px 12px 40px;
}

.anatomia-theme.theme-progress .header-top-row { flex-direction: row; align-items: center; margin-bottom: 8px; }

.anatomia-theme.theme-progress .back-button
{
    width: 88px;
    height: 88px;
    min-width: 88px;
    border-radius: 44px;
    margin: 0 28px 0 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.back-icon
{
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }
.anatomia-theme.theme-progress .header-title { font-size: 50px; white-space: nowrap; }
.anatomia-theme.theme-progress .header-subtitle { font-size: 26px; margin-top: 2px; white-space: nowrap; }

/* ---------- Scroll ---------- */

.screen-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; -unity-overflow-scrolling: touch; }
.screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport { flex-grow: 1; min-height: 0; height: 100%; }
.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    position: relative;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

.anatomia-theme.theme-progress .content-wrapper
{
    flex-direction: column;
    flex-shrink: 0;
    padding: 16px 40px 100px 40px;
}

.anatomia-theme.theme-progress .section-title { font-size: 36px; -unity-font-style: bold; color: var(--ink); margin: 0 0 4px 0; }
.anatomia-theme.theme-progress .section-subtitle { font-size: 26px; color: var(--ink-3); margin: 0 0 28px 0; white-space: normal; }

/* ---------- Level hero: solid accent card ---------- */

.anatomia-theme.theme-progress .level-hero
{
    flex-direction: column;
    padding: 40px;
    margin-bottom: 24px;
    border-radius: 40px;
    background-color: var(--accent);
    border-width: 0;
}

.anatomia-theme.theme-progress .hero-caption { font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; color: rgba(255,255,255,0.7); }
.anatomia-theme.theme-progress .hero-caption-right { -unity-text-align: upper-right; }

.anatomia-theme.theme-progress .level-row { flex-direction: row; justify-content: space-between; align-items: flex-end; margin: 6px 0 30px 0; }
.anatomia-theme.theme-progress .level-block { flex-direction: column; align-items: flex-start; }
.anatomia-theme.theme-progress .level-block-right { align-items: flex-end; }

.anatomia-theme.theme-progress .level-number { font-size: 76px; -unity-font-style: bold; color: white; letter-spacing: -1.5px; margin-top: 2px; }

.anatomia-theme.theme-progress .level-title-pill
{
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(255,255,255,0.2);
    border-radius: 100px;
    padding: 6px 22px;
    margin-top: 8px;
}

.anatomia-theme.theme-progress .level-next-number { font-size: 34px; -unity-font-style: bold; color: white; margin-top: 4px; }
.anatomia-theme.theme-progress .level-caption-small { font-size: 24px; color: rgba(255,255,255,0.75); margin-top: 2px; }

.anatomia-theme.theme-progress .level-hero .progress-track { width: 100%; height: 20px; border-radius: 10px; background-color: rgba(255,255,255,0.25); overflow: hidden; }
.anatomia-theme.theme-progress .level-hero .progress-fill { height: 100%; border-radius: 10px; background-color: white; }
.anatomia-theme.theme-progress .level-caption { font-size: 26px; color: white; margin-top: 18px; }

/* ---------- Stat tiles ---------- */

.anatomia-theme.theme-progress .stats-row { flex-direction: row; margin-bottom: 16px; }

.anatomia-theme.theme-progress .stat-tile
{
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 24px;
    border-radius: 30px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

.anatomia-theme.theme-progress #quizzes-card, .anatomia-theme.theme-progress #points-card { margin-right: 8px; }
.anatomia-theme.theme-progress #avg-score-card, .anatomia-theme.theme-progress #badges-card { margin-left: 8px; }

.stat-tile-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 24px;
    background-color: var(--accent-soft);
    justify-content: center;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.stat-tile-icon
{
    width: 40px;
    height: 40px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.icon-quizzes { background-image: url("project://database/Assets/UI/Icons/quiz-iconss.png"); }
.icon-target { background-image: url("project://database/Assets/UI/Icons/target-iconss.png"); }
.icon-points { background-image: url("project://database/Assets/UI/Icons/total-points-icon.png"); }
.icon-badges { background-image: url("project://database/Assets/UI/Icons/reward-icon-black.png"); }

.stat-tile-text { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-progress .stat-value { font-size: 44px; -unity-font-style: bold; color: var(--ink); letter-spacing: -0.5px; margin: 0; }
.anatomia-theme.theme-progress .stat-label { font-size: 22px; color: var(--ink-3); white-space: nowrap; margin: 0; }

/* ---------- Tabs: 3 equal pills ---------- */

.anatomia-theme.theme-progress .tab-toggle
{
    flex-direction: row;
    margin: 16px 0 28px 0;
    padding: 0;
    background-color: rgba(0,0,0,0);
}

.anatomia-theme.theme-progress .tab-button
{
    flex-grow: 1;
    flex-basis: 0;
    height: 84px;
    margin: 0 6px;
    padding: 0 8px;
    border-radius: 42px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    color: var(--ink-2);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.anatomia-theme.theme-progress .tab-button:hover { background-color: var(--surface-hover); color: var(--ink); }

.anatomia-theme.theme-progress .tab-button-active,
.anatomia-theme.theme-progress .tab-button-active:hover
{
    background-color: var(--accent);
    border-color: var(--accent);
    color: white;
}

.anatomia-theme.theme-progress .tab-panel { width: 100%; flex-direction: column; }

/* ---------- Shared card ---------- */

.anatomia-theme.theme-progress .weekly-chart-card,
.anatomia-theme.theme-progress .category-card,
.anatomia-theme.theme-progress .level-roadmap-card
{
    padding: 40px;
    border-radius: 36px;
    margin-bottom: 24px;
}

/* ---------- Weekly chart ---------- */

.anatomia-theme.theme-progress .chart-area { flex-direction: row; height: 360px; }
.anatomia-theme.theme-progress .chart-y-axis { flex-direction: column; justify-content: space-between; width: 64px; height: 100%; margin-right: 8px; }
.anatomia-theme.theme-progress .chart-axis-label { font-size: 20px; color: var(--ink-3); -unity-text-align: middle-left; }

.anatomia-theme.theme-progress .chart-bars-row
{
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    align-items: flex-end;
    justify-content: space-between;
    border-left-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: var(--line-strong);
    padding: 0;
}

.chart-gridline { position: absolute; left: 0; right: 0; height: 1px; background-color: var(--line); }

.anatomia-theme.theme-progress .bar-col { flex-grow: 1; flex-basis: 0; height: 100%; align-items: center; justify-content: flex-end; margin: 0 8px; }

.anatomia-theme.theme-progress .chart-bar
{
    width: 100%;
    max-width: 48px;
    min-height: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    background-color: var(--accent);
}

.anatomia-theme.theme-progress .chart-x-axis { flex-direction: row; margin-top: 16px; padding-left: 72px; }
.anatomia-theme.theme-progress .chart-day-label { flex-grow: 1; flex-basis: 0; font-size: 22px; color: var(--ink-3); -unity-text-align: middle-center; margin: 0 8px; }

/* ---------- Skills: category tiles ---------- */

.anatomia-theme.theme-progress .category-item
{
    padding: 26px 28px;
    margin-bottom: 14px;
    border-radius: 28px;
    background-color: var(--sunken);
    border-bottom-width: 0;
}

.anatomia-theme.theme-progress .category-item-last { margin-bottom: 0; }

.anatomia-theme.theme-progress .category-header-row { flex-direction: row; align-items: center; justify-content: flex-start; margin-bottom: 18px; }

.category-icon-box
{
    width: 60px;
    height: 60px;
    border-radius: 20px;
    background-color: var(--surface-solid);
    justify-content: center;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.category-icon
{
    width: 32px;
    height: 32px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.icon-skeletal { background-image: url("project://database/Assets/UI/Icons/skeletal-icon.png"); }
.icon-muscular { background-image: url("project://database/Assets/UI/Icons/muscular-icon.png"); }
.icon-nervous { background-image: url("project://database/Assets/UI/Icons/brain-icon.png"); }
.icon-cardio { background-image: url("project://database/Assets/UI/Icons/cardio-icon.png"); }

.anatomia-theme.theme-progress .category-name { font-size: 32px; -unity-font-style: bold; color: var(--ink); flex-grow: 1; }
.anatomia-theme.theme-progress .category-count { font-size: 22px; color: var(--ink-3); }

.anatomia-theme.theme-progress .category-progress-row { flex-direction: row; align-items: center; }
.anatomia-theme.theme-progress .category-track { flex-grow: 1; height: 18px; border-radius: 9px; background-color: var(--track); overflow: hidden; margin-right: 20px; }
.anatomia-theme.theme-progress .category-fill { height: 100%; border-radius: 9px; background-color: var(--accent); }
.anatomia-theme.theme-progress .category-percent { font-size: 28px; -unity-font-style: bold; color: var(--accent); width: 120px; flex-shrink: 0; -unity-text-align: middle-right; }

/* ---------- Pretest / Posttest ---------- */

.anatomia-theme.theme-progress .baseline-grid { flex-direction: row; }

.anatomia-theme.theme-progress .baseline-tile
{
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    padding: 28px;
    margin-right: 8px;
    border-radius: 28px;
    background-color: var(--sunken);
}

.anatomia-theme.theme-progress .baseline-tile-last { margin-right: 0; margin-left: 8px; background-color: var(--accent-soft); }

.anatomia-theme.theme-progress .baseline-caption { font-size: 22px; -unity-font-style: bold; letter-spacing: 2px; color: var(--ink-3); margin-bottom: 8px; }
.anatomia-theme.theme-progress .baseline-tile-last .baseline-caption { color: var(--accent); }
.anatomia-theme.theme-progress .baseline-score { font-size: 30px; -unity-font-style: bold; color: var(--ink); white-space: normal; }

.anatomia-theme.theme-progress .baseline-improvement
{
    align-self: flex-start;
    margin-top: 22px;
    padding: 10px 26px;
    border-radius: 100px;
    background-color: var(--success-soft);
    color: var(--success);
    font-size: 26px;
    -unity-font-style: bold;
}

.anatomia-theme.theme-progress .baseline-cta-button
{
    height: 96px;
    margin: 28px 0 0 0;
    padding: 0 40px;
    border-width: 0;
    border-radius: 48px;
    background-color: var(--accent);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.anatomia-theme.theme-progress .baseline-cta-button:hover { background-color: var(--accent-strong); }
.anatomia-theme.theme-progress .baseline-cta-button:active { background-color: var(--accent-press); }
.anatomia-theme.theme-progress .baseline-cta-label { color: white; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; }

/* ---------- Level roadmap (rows are built in C#) ---------- */

.anatomia-theme.theme-progress .level-roadmap-list { flex-direction: column; }

.anatomia-theme.theme-progress .level-roadmap-item
{
    flex-direction: row;
    align-items: center;
    padding: 22px 24px;
    margin-bottom: 12px;
    border-radius: 28px;
    background-color: var(--sunken);
    border-width: 2px;
    border-color: rgba(0,0,0,0);
}

.anatomia-theme.theme-progress .level-roadmap-badge
{
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: var(--track);
    justify-content: center;
    align-items: center;
    margin-right: 22px;
    flex-shrink: 0;
}

.anatomia-theme.theme-progress .level-roadmap-badge-number { font-size: 30px; -unity-font-style: bold; color: var(--ink-3); }
.anatomia-theme.theme-progress .level-roadmap-text-col { flex-grow: 1; flex-direction: column; min-width: 0; }
.anatomia-theme.theme-progress .level-roadmap-title { font-size: 32px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-progress .level-roadmap-points { font-size: 24px; color: var(--ink-3); margin-top: 2px; white-space: normal; }

.anatomia-theme.theme-progress .level-roadmap-status
{
    font-size: 22px;
    -unity-font-style: bold;
    padding: 8px 20px;
    border-radius: 100px;
    flex-shrink: 0;
    background-color: var(--track);
    color: var(--ink-3);
}

.anatomia-theme.theme-progress .level-roadmap-item-current { background-color: var(--accent-soft); border-color: var(--accent); }
.anatomia-theme.theme-progress .level-roadmap-item-current .level-roadmap-badge { background-color: var(--accent); }
.anatomia-theme.theme-progress .level-roadmap-item-current .level-roadmap-badge-number { color: white; }
.anatomia-theme.theme-progress .level-roadmap-item-current .level-roadmap-status { background-color: var(--accent); color: white; }

.anatomia-theme.theme-progress .level-roadmap-item-completed .level-roadmap-badge { background-color: var(--success); }
.anatomia-theme.theme-progress .level-roadmap-item-completed .level-roadmap-badge-number { color: white; }
.anatomia-theme.theme-progress .level-roadmap-item-completed .level-roadmap-status { background-color: var(--success-soft); color: var(--success); }

.anatomia-theme.theme-progress .level-roadmap-item-locked { opacity: 0.8; }

/* =========================================================
   Compact (narrow phones) - toggled by the controller
   ========================================================= */

.anatomia-theme.theme-progress.compact .header { padding: 72px 32px 8px 32px; }
.anatomia-theme.theme-progress.compact .back-button { width: 76px; height: 76px; min-width: 76px; border-radius: 38px; margin-right: 22px; }
.anatomia-theme.theme-progress.compact .header-title { font-size: 40px; }
.anatomia-theme.theme-progress.compact .content-wrapper { padding: 12px 28px 90px 28px; }
.anatomia-theme.theme-progress.compact .level-hero { padding: 30px; border-radius: 32px; }
.anatomia-theme.theme-progress.compact .level-number { font-size: 60px; }
.anatomia-theme.theme-progress.compact .stat-tile { padding: 18px; }
.anatomia-theme.theme-progress.compact .stat-tile-icon-box { width: 62px; height: 62px; border-radius: 20px; margin-right: 14px; }
.anatomia-theme.theme-progress.compact .stat-value { font-size: 36px; }
.anatomia-theme.theme-progress.compact .stat-label { font-size: 19px; }
.anatomia-theme.theme-progress.compact .tab-button { height: 72px; font-size: 24px; }
.anatomia-theme.theme-progress.compact .weekly-chart-card, .anatomia-theme.theme-progress.compact .category-card, .anatomia-theme.theme-progress.compact .level-roadmap-card { padding: 28px; border-radius: 28px; }
.anatomia-theme.theme-progress.compact .chart-area { height: 290px; }
.anatomia-theme.theme-progress.compact .category-item { padding: 20px; }
.anatomia-theme.theme-progress.compact .baseline-score { font-size: 26px; }
.anatomia-theme.theme-progress.compact .level-roadmap-title { font-size: 28px; }
