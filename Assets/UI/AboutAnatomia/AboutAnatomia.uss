/* =========================================================
   Anatomia 3D - About (student)   Reference canvas: 1080 x 1920
   Loaded AFTER AnatomiaTheme.uss. Overwrite the old file in place so the
   GUID referenced by the UXML stays valid.

   LAYOUT
     top bar  : fixed, back button + title (always reachable while scrolling)
     identity : centered logo tile, app name, tagline
     sections : sentence-case title above a white card
     credits  : developer + author rows with dividers

   The controller builds the developer rows in code with these classes:
   developer-row, developer-row-last, developer-avatar,
   developer-avatar-initials, developer-name-label, menu-divider.
   ========================================================= */

.anatomia-theme.about-root
{
    width: 100%;
    height: 100%;
    flex-direction: column;
}

/* ---------- Top bar ---------- */
.anatomia-theme.about-root .about-topbar
{
    flex-direction: row;
    align-items: center;
    padding: 76px 28px 12px 28px;
    background-color: rgba(0, 0, 0, 0);
}

.anatomia-theme.about-root .about-back
{
    width: 84px;
    height: 84px;
    margin: 0 20px 0 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 42px;
    background-color: var(--surface);
}
.anatomia-theme.about-root .about-back:hover { background-color: var(--surface-hover); }

.anatomia-theme.about-root .back-icon
{
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}

.anatomia-theme.about-root .about-title
{
    margin: 0;
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: -0.5px;
    color: var(--ink);
}

/* ---------- Scroll area ---------- */
.anatomia-theme.about-root .screen-scroll
{
    flex-grow: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    -unity-overflow-scrolling: touch;
}

/* ---------- Scrollbar: slim rounded overlay (no layout width) ----------
   Sits over the right edge, only the thumb is prominent, arrow buttons removed. */
.anatomia-theme.about-root .screen-scroll .unity-scroller--vertical
{
    position: absolute;
    right: 5px;
    top: 10px;
    bottom: 10px;
    width: 10px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.anatomia-theme.about-root .screen-scroll .unity-scroller__low-button,
.anatomia-theme.about-root .screen-scroll .unity-scroller__high-button,
.anatomia-theme.about-root .screen-scroll #unity-dragger-border { display: none; }
.anatomia-theme.about-root .screen-scroll .unity-scroller--vertical #unity-tracker
{
    width: 10px;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--sunken);
}
.anatomia-theme.about-root .screen-scroll .unity-scroller--vertical #unity-dragger
{
    width: 10px;
    min-height: 90px;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--accent-soft);
    transition-property: background-color;
    transition-duration: 0.15s;
}
.anatomia-theme.about-root .screen-scroll .unity-scroller--vertical #unity-dragger:hover { background-color: var(--accent); }
.anatomia-theme.about-root .screen-scroll .unity-scroller--vertical #unity-dragger:active { background-color: var(--accent-strong); }
.anatomia-theme.about-root .screen-scroll #unity-content-container
{
    margin: 0;
    padding: 0;
    align-items: stretch;
}

.anatomia-theme.about-root .about-page
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    padding: 4px 28px 56px 28px;
}

/* ---------- Identity ---------- */
.anatomia-theme.about-root .about-identity { align-items: center; padding: 8px 0 32px 0; }

.anatomia-theme.about-root .about-logo
{
    width: 132px;
    height: 132px;
    margin-bottom: 22px;
    border-radius: 42px;
    border-width: 1px;
    border-color: var(--line-strong);
    background-color: var(--surface-solid);
    background-image: url("project://database/Assets/UI/Icons/Anatomia-logo.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.anatomia-theme.about-root .about-app-name
{
    margin: 0;
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.anatomia-theme.about-root .about-app-tagline
{
    max-width: 700px;
    margin: 10px 0 0 0;
    font-size: 28px;
    color: var(--ink-3);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Sections ---------- */
.anatomia-theme.about-root .about-section-title
{
    margin: 0 0 12px 6px;
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--ink);
}
.anatomia-theme.about-root .about-section-spaced { margin-top: 30px; }

.anatomia-theme.about-root .about-card
{
    padding: 28px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 36px;
}
.anatomia-theme.about-root .about-card-list { padding: 4px 0; }

.anatomia-theme.about-root .about-text
{
    margin: 0;
    font-size: 29px;
    color: var(--ink-2);
    white-space: normal;
}
.anatomia-theme.about-root .about-text-gap { margin-top: 18px; }

/* ---------- Citations ---------- */
.anatomia-theme.about-root .about-quote
{
    margin-top: 18px;
    padding: 20px 24px;
    border-left-width: 6px;
    border-left-color: var(--accent);
    border-radius: 20px;
    background-color: var(--accent-faint);
}
.anatomia-theme.about-root .about-quote-text
{
    margin: 0;
    font-size: 28px;
    -unity-font-style: italic;
    color: var(--ink);
    white-space: normal;
}

.anatomia-theme.about-root .about-caption
{
    margin: 22px 0 0 0;
    font-size: 23px;
    -unity-font-style: bold;
    color: var(--ink-3);
}

.anatomia-theme.about-root .about-sources
{
    margin-top: 22px;
    padding: 22px 24px;
    border-radius: 24px;
    background-color: var(--sunken);
}
.anatomia-theme.about-root .about-source-label
{
    margin: 0 0 6px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ink-3);
}
.anatomia-theme.about-root .about-source-label-spaced { margin-top: 18px; }
.anatomia-theme.about-root .about-link
{
    margin: 0;
    font-size: 25px;
    color: var(--accent);
    white-space: normal;
}

.anatomia-theme.about-root .about-badge
{
    align-self: flex-start;
    margin: 0 0 16px 0;
    padding: 8px 22px;
    border-radius: 24px;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
}

/* ---------- Developers (rows are generated by the controller) ---------- */
.anatomia-theme.about-root .developers-list,
.anatomia-theme.about-root .credits-list { width: 100%; flex-direction: column; }

.anatomia-theme.about-root .developer-row
{
    flex-direction: row;
    align-items: center;
    padding: 14px 24px;
}
.anatomia-theme.about-root .developer-row-last { padding-bottom: 14px; }

.anatomia-theme.about-root .developer-avatar
{
    width: 72px;
    height: 72px;
    margin-right: 26px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-radius: 36px;
    background-color: var(--accent-soft);
}
.anatomia-theme.about-root .developer-avatar-initials
{
    margin: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--accent);
}
.anatomia-theme.about-root .developer-name-label
{
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    font-size: 31px;
    color: var(--ink);
    white-space: normal;
}

.anatomia-theme.about-root .menu-divider,
.anatomia-theme.about-root .credit-divider
{
    height: 1px;
    margin: 0 24px;
    background-color: var(--line);
}

/* ---------- Authors ---------- */
.anatomia-theme.about-root .credit-row { flex-direction: column; padding: 16px 24px; }
.anatomia-theme.about-root .credit-name
{
    margin: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
}
.anatomia-theme.about-root .credit-role
{
    margin: 4px 0 0 0;
    font-size: 25px;
    color: var(--ink-3);
    white-space: normal;
}

/* ---------- Footer ---------- */
.anatomia-theme.about-root .version-label
{
    margin-top: 36px;
    font-size: 24px;
    color: var(--ink-3);
    -unity-text-align: middle-center;
}

/* ---------- Compact (narrow phones) ---------- */
.anatomia-theme.about-root.compact .about-topbar { padding: 68px 20px 10px 20px; }
.anatomia-theme.about-root.compact .about-back { width: 76px; height: 76px; border-radius: 38px; }
.anatomia-theme.about-root.compact .about-title { font-size: 40px; }
.anatomia-theme.about-root.compact .about-page { padding: 2px 20px 44px 20px; }
.anatomia-theme.about-root.compact .about-logo { width: 112px; height: 112px; border-radius: 36px; margin-bottom: 18px; }
.anatomia-theme.about-root.compact .about-app-name { font-size: 52px; }
.anatomia-theme.about-root.compact .about-app-tagline { font-size: 26px; }
.anatomia-theme.about-root.compact .about-section-title { font-size: 29px; }
.anatomia-theme.about-root.compact .about-card { padding: 22px; border-radius: 30px; }
.anatomia-theme.about-root.compact .about-card-list { padding: 2px 0; }
.anatomia-theme.about-root.compact .about-text { font-size: 27px; }
.anatomia-theme.about-root.compact .about-quote-text { font-size: 26px; }
.anatomia-theme.about-root.compact .about-link { font-size: 22px; }
.anatomia-theme.about-root.compact .developer-row,
.anatomia-theme.about-root.compact .credit-row { padding-left: 20px; padding-right: 20px; }
.anatomia-theme.about-root.compact .developer-avatar { width: 64px; height: 64px; border-radius: 32px; margin-right: 22px; }
.anatomia-theme.about-root.compact .developer-avatar-initials { font-size: 23px; }
.anatomia-theme.about-root.compact .developer-name-label { font-size: 28px; }
.anatomia-theme.about-root.compact .credit-name { font-size: 27px; }
.anatomia-theme.about-root.compact .credit-role { font-size: 23px; }
.anatomia-theme.about-root.compact .menu-divider,
.anatomia-theme.about-root.compact .credit-divider { margin-left: 20px; margin-right: 20px; }
