<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StudentQuizScreen/QuizScreen.uss"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss"/>
    <ui:VisualElement name="quiz-root" class="anatomia-theme theme-quiz quiz-root">

        <ui:VisualElement name="header" class="header">
            <ui:VisualElement name="header-top-row" class="header-top-row">
                <ui:Button name="close-button" class="icon-button">
                    <ui:VisualElement picking-mode="Ignore" class="icon-button-glyph"/>
                </ui:Button>
                <ui:VisualElement name="badges-row" class="badges-row">
                    <ui:VisualElement name="timer-pill" class="pill">
                        <ui:VisualElement name="timer-icon" picking-mode="Ignore" class="pill-icon pill-icon--timer"/>
                        <ui:Label name="timer-label" text="10:00" class="pill-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="points-pill" class="pill">
                        <ui:VisualElement name="points-icon" picking-mode="Ignore" class="pill-icon pill-icon--points"/>
                        <ui:Label name="points-label" text="10 pts" class="pill-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="question-counter-label" text="Question 1 of 6" class="question-counter"/>
            <ui:VisualElement name="progress-track" class="progress-track">
                <ui:VisualElement name="progress-fill" class="progress-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="card-wrapper" class="card-wrapper">
            <ui:VisualElement name="card" class="card">
                <ui:VisualElement name="card-top-row" class="card-top-row">
                    <ui:Label name="type-label" text="MULTIPLE CHOICE" class="type-label"/>
                    <ui:Label name="quiz-label" text="Quiz 1" class="quiz-label"/>
                </ui:VisualElement>
                <ui:Label name="question-text-label" text="Question goes here" class="question-text"/>
                <ui:ScrollView name="answer-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="answer-scroll">
                    <ui:VisualElement name="answer-container" class="answer-container"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="action-row" class="action-row">
            <ui:Button name="prev-button" class="prev-button hidden">
                <ui:VisualElement picking-mode="Ignore" class="prev-button-icon"/>
                <ui:Label picking-mode="Ignore" text="Previous" class="prev-button-label"/>
            </ui:Button>
            <ui:Button name="action-button" text="Next Question" class="action-button"/>
        </ui:VisualElement>

        <ui:VisualElement name="blocked-overlay" class="blocked-overlay hidden">
            <ui:VisualElement name="blocked-card" class="blocked-card">
                <ui:VisualElement picking-mode="Ignore" class="blocked-icon blocked-icon-lock"/>
                <ui:Label name="blocked-message-label" text="" class="blocked-message"/>
                <ui:Button name="blocked-back-button" text="Back" class="blocked-back-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="exit-confirm-overlay" class="blocked-overlay hidden">
            <ui:VisualElement name="exit-confirm-card" class="blocked-card">
                <ui:VisualElement picking-mode="Ignore" class="blocked-icon blocked-icon-exit"/>
                <ui:Label text="Exit Quiz?" class="exit-confirm-title"/>
                <ui:Label name="exit-confirm-message-label" text="Any questions you haven&apos;t answered yet will be marked incorrect. Submit your answers and exit now?" class="blocked-message"/>
                <ui:VisualElement name="exit-confirm-button-row" class="exit-confirm-button-row">
                    <ui:Button name="exit-cancel-button" text="Cancel" class="exit-cancel-button"/>
                    <ui:Button name="exit-submit-button" text="Submit &amp; Exit" class="exit-submit-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loading-overlay" class="loading-overlay hidden">
            <ui:VisualElement name="loading-card" class="loading-card">
                <ui:VisualElement name="loading-spinner" class="loading-spinner"/>
                <ui:Label name="loading-message-label" text="Submitting your quiz..." class="loading-message"/>
                <ui:Label name="loading-submessage-label" text="" class="loading-submessage hidden"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
