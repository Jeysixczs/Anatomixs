.option-row--selected .radio-outer {
    border-color: rgb(59, 130, 246);
}

.radio-inner {
    width: 15px;
    height: 15px;
    border-radius: 8px;
    background-color: rgb(17, 24, 39);
    display: none;
}

.option-row--selected .radio-inner {
    display: flex;
}

.option-label {
    font-size: 27px;
    color: rgb(30, 41, 59);
}

