.option-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(229, 231, 235);
    border-radius: 21px;
    padding: 27px 30px;
    margin-bottom: 21px;
}

.option-row:hover {
    border-color: rgb(191, 219, 254);
}

.option-row--selected {
    border-color: rgb(59, 130, 246);
    background-color: rgb(239, 246, 255);
}

