/* =========================================================
   Anatomia 3D - Quiz Screen v2 "Focus"
   Reference canvas: 1080 x 1920 (portrait).
   Loaded BEFORE AnatomiaTheme.uss, so every rule is scoped under
   .anatomia-theme.theme-quiz.quiz-root to out-rank the theme's shared quiz rules.

   LAYOUT
     header : close button + timer / points pills, then "Question X of Y"
              and a thick progress bar - all flat on the ambient background
     card   : type chip + quiz name, big question text, scrolling answers
     action : Previous (outlined, 1/3) + Next / Submit (accent, 2/3),
              pinned to the bottom so the button never jumps around
   Element names and every class the controller creates at runtime
   (option-row, radio-*, checkbox-*, helper-text, answer-text-field,
   view-model-button ...) are unchanged.
   ========================================================= */

.anatomia-theme.theme-quiz.quiz-root
{
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
}

/* ---------------- HEADER ---------------- */
.anatomia-theme.theme-quiz.quiz-root .header
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    padding: 84px 48px 26px 48px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}
.anatomia-theme.theme-quiz.quiz-root .header-top-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 40px; }

.anatomia-theme.theme-quiz.quiz-root .icon-button
{
    width: 84px;
    height: 84px;
    border-radius: 42px;
    font-size: 32px;
    padding: 0;
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
}

.anatomia-theme.theme-quiz.quiz-root .icon-button-glyph
{
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/UI/Icons/close-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}

.anatomia-theme.theme-quiz.quiz-root .badges-row { flex-direction: row; }
.anatomia-theme.theme-quiz.quiz-root .pill
{
    flex-direction: row;
    align-items: center;
    min-height: 84px;
    margin-left: 16px;
    padding: 0 30px 0 24px;
    border-radius: 42px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}
.anatomia-theme.theme-quiz.quiz-root .pill-icon
{
    width: 40px;
    height: 40px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink-2);
}
.anatomia-theme.theme-quiz.quiz-root .pill-icon--timer { background-image: url("project://database/Assets/UI/Icons/time-limit.png"); }
.anatomia-theme.theme-quiz.quiz-root .pill-icon--points
{
    background-image: url("project://database/Assets/UI/Icons/trophy-white-icon.png");
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-quiz.quiz-root .pill-label { margin: 0; font-size: 31px; -unity-font-style: bold; color: var(--ink); }

/* Applied by the controller once the countdown drops under a minute. */
.anatomia-theme.theme-quiz.quiz-root .pill--danger { background-color: var(--danger-soft); border-color: var(--danger); }
.anatomia-theme.theme-quiz.quiz-root .pill--danger .pill-label { color: var(--danger); }
.anatomia-theme.theme-quiz.quiz-root .pill--danger .pill-icon--timer { -unity-background-image-tint-color: var(--danger); }

.anatomia-theme.theme-quiz.quiz-root .question-counter { margin: 0 0 16px 4px; font-size: 27px; -unity-font-style: bold; color: var(--ink-2); letter-spacing: 0.3px; }

.anatomia-theme.theme-quiz.quiz-root .progress-track { height: 14px; margin: 0; border-radius: 7px; overflow: hidden; background-color: var(--track); }
.anatomia-theme.theme-quiz.quiz-root .progress-fill { height: 14px; width: 16%; border-radius: 7px; background-color: var(--accent); }

/* ---------------- CARD ---------------- */
.anatomia-theme.theme-quiz.quiz-root .card-wrapper
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 18px 40px 24px 40px;
}
/* The card hugs its content and shrinks when it can't fit; only the answer
   list scrolls, so the question text stays fixed. */
.anatomia-theme.theme-quiz.quiz-root .card
{
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    padding: 44px 38px 30px 38px;
    border-radius: 48px;
    overflow: hidden;
}

.anatomia-theme.theme-quiz.quiz-root .answer-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.anatomia-theme.theme-quiz.quiz-root .answer-scroll > .unity-scroll-view__content-viewport { overflow: hidden; }
.anatomia-theme.theme-quiz.quiz-root .answer-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport { flex-grow: 1; height: 100%; }
.anatomia-theme.theme-quiz.quiz-root .answer-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    flex-grow: 0;
    height: auto;
    min-height: 0;
    justify-content: flex-start;
    align-items: stretch;
}

.anatomia-theme.theme-quiz.quiz-root .card-top-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 30px; }
.anatomia-theme.theme-quiz.quiz-root .type-label
{
    margin: 0;
    padding: 9px 24px;
    border-radius: 100px;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--accent);
    background-color: var(--accent-soft);
}
.anatomia-theme.theme-quiz.quiz-root .quiz-label { margin: 0 0 0 16px; font-size: 23px; color: var(--ink-3); -unity-text-align: middle-right; white-space: normal; flex-shrink: 1; }

.anatomia-theme.theme-quiz.quiz-root .question-text
{
    margin: 0 0 38px 0;
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: -0.5px;
    color: var(--ink);
    white-space: normal;
}

.anatomia-theme.theme-quiz.quiz-root .answer-container { flex-grow: 1; }
.anatomia-theme.theme-quiz.quiz-root .helper-text { margin: 0 0 20px 4px; font-size: 24px; color: var(--ink-3); white-space: normal; }

/* ---------------- OPTION ROWS (Multiple Choice / True-False) ---------------- */
.anatomia-theme.theme-quiz.quiz-root .option-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
    padding: 30px 32px;
    border-width: 2px;
    border-radius: 30px;
    background-color: var(--surface-solid);
    border-color: var(--line-strong);
}
.anatomia-theme.theme-quiz.quiz-root .option-row:hover { border-color: var(--ink-4); }
.anatomia-theme.theme-quiz.quiz-root .option-row--selected { border-width: 3px; padding: 29px 31px; border-color: var(--accent); background-color: var(--accent-faint); }

.anatomia-theme.theme-quiz.quiz-root .radio-outer
{
    width: 44px;
    height: 44px;
    margin-right: 26px;
    flex-shrink: 0;
    border-width: 3px;
    border-radius: 22px;
    border-color: var(--ink-4);
    align-items: center;
    justify-content: center;
}
.anatomia-theme.theme-quiz.quiz-root .option-row--selected .radio-outer { border-color: var(--accent); }
.anatomia-theme.theme-quiz.quiz-root .radio-inner { width: 22px; height: 22px; border-radius: 11px; background-color: var(--accent); display: none; }
.anatomia-theme.theme-quiz.quiz-root .option-row--selected .radio-inner { display: flex; }

.anatomia-theme.theme-quiz.quiz-root .checkbox-outer
{
    width: 44px;
    height: 44px;
    margin-right: 26px;
    flex-shrink: 0;
    border-width: 3px;
    border-radius: 14px;
    border-color: var(--ink-4);
    background-color: var(--surface-solid);
    align-items: center;
    justify-content: center;
}
.anatomia-theme.theme-quiz.quiz-root .option-row--selected .checkbox-outer { background-color: var(--accent); border-color: var(--accent); }
.anatomia-theme.theme-quiz.quiz-root .checkbox-check
{
    width: 26px;
    height: 26px;
    margin: 0;
    display: none;
    background-image: url("project://database/Assets/UI/Icons/check-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}
.anatomia-theme.theme-quiz.quiz-root .option-row--selected .checkbox-check { display: flex; }

.anatomia-theme.theme-quiz.quiz-root .option-label { margin: 0; flex-shrink: 1; font-size: 32px; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-quiz.quiz-root .option-row--selected .option-label { -unity-font-style: bold; }

/* ---------------- TEXT INPUTS (Identification / Enumeration / Image Based) ---------------- */
.anatomia-theme.theme-quiz.quiz-root .answer-text-field { margin: 0 0 18px 0; }
.anatomia-theme.theme-quiz.quiz-root .answer-text-field > .unity-text-field__input,
.anatomia-theme.theme-quiz.quiz-root .answer-text-field > #unity-text-input
{
    min-height: 104px;
    padding: 0 32px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 30px;
    background-color: var(--sunken);
    color: var(--ink);
    font-size: 32px;
    -unity-text-align: middle-left;
}
.anatomia-theme.theme-quiz.quiz-root .answer-text-field > .unity-text-field__input:hover,
.anatomia-theme.theme-quiz.quiz-root .answer-text-field > #unity-text-input:hover { background-color: var(--track); }
.anatomia-theme.theme-quiz.quiz-root .answer-text-field > .unity-text-field__input:focus,
.anatomia-theme.theme-quiz.quiz-root .answer-text-field > #unity-text-input:focus { border-color: var(--accent); background-color: var(--surface-solid); }

/* ---------------- IMAGE BASED ---------------- */
.anatomia-theme.theme-quiz.quiz-root .image-frame
{
    height: 420px;
    margin-bottom: 24px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 30px;
    background-color: var(--sunken);
}
.anatomia-theme.theme-quiz.quiz-root .quiz-image { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.anatomia-theme.theme-quiz.quiz-root .arrow-marker { position: absolute; width: 60px; height: 60px; -unity-background-scale-mode: scale-to-fit; }

.anatomia-theme.theme-quiz.quiz-root .view-model-button
{
    height: 92px;
    margin: 0 0 22px 0;
    padding: 0 32px;
    border-width: 0;
    border-radius: 46px;
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 28px;
    -unity-font-style: bold;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.anatomia-theme.theme-quiz.quiz-root .view-model-button:hover { background-color: var(--accent); color: white; }
.anatomia-theme.theme-quiz.quiz-root .view-model-icon
{
    width: 38px;
    height: 38px;
    margin-right: 16px;
    background-image: url("project://database/Assets/UI/Icons/bone-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-quiz.quiz-root .view-model-button:hover .view-model-icon { -unity-background-image-tint-color: white; }
.anatomia-theme.theme-quiz.quiz-root .view-model-label { margin: 0; padding: 0; font-size: 28px; -unity-font-style: bold; }

/* ---------------- ACTION ROW ---------------- */
.anatomia-theme.theme-quiz.quiz-root .action-row
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-direction: row;
    margin: 0;
    padding: 6px 40px 56px 40px;
}
.anatomia-theme.theme-quiz.quiz-root .action-button
{
    flex-grow: 2;
    flex-basis: 0;
    height: 112px;
    margin: 0;
    border-width: 0;
    border-radius: 56px;
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}
.anatomia-theme.theme-quiz.quiz-root .action-button--disabled { opacity: 1; }
.anatomia-theme.theme-quiz.quiz-root .prev-button
{
    flex-grow: 1;
    flex-basis: 0;
    height: 112px;
    margin: 0 16px 0 0;
    border-radius: 56px;
    font-size: 30px;
    -unity-font-style: bold;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.anatomia-theme.theme-quiz.quiz-root .prev-button.hidden { display: none; }
.anatomia-theme.theme-quiz.quiz-root .prev-button-icon
{
    width: 30px;
    height: 30px;
    margin-right: 14px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}
.anatomia-theme.theme-quiz.quiz-root .prev-button:hover .prev-button-icon { -unity-background-image-tint-color: var(--accent); }
.anatomia-theme.theme-quiz.quiz-root .prev-button-label { margin: 0; padding: 0; font-size: 30px; -unity-font-style: bold; }

/* ---------------- UTILITY ---------------- */
.anatomia-theme.theme-quiz.quiz-root .hidden { display: none; }
.hidden { display: none; }

/* ---------------- OVERLAYS ---------------- */
.anatomia-theme.theme-quiz.quiz-root .blocked-overlay,
.anatomia-theme.theme-quiz.quiz-root .loading-overlay
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    padding: 52px;
    justify-content: center;
    align-items: center;
    background-color: rgba(15, 18, 28, 0.6);
}
.anatomia-theme.theme-quiz.quiz-root .blocked-overlay.hidden,
.anatomia-theme.theme-quiz.quiz-root .loading-overlay.hidden { display: none; }

.anatomia-theme.theme-quiz.quiz-root .blocked-card
{
    width: 100%;
    max-width: 760px;
    padding: 56px 44px 44px 44px;
    align-items: center;
    border-radius: 48px;
}
.anatomia-theme.theme-quiz.quiz-root .blocked-icon
{
    width: 84px;
    height: 84px;
    margin: 0 0 24px 0;
    align-self: center;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.anatomia-theme.theme-quiz.quiz-root .blocked-icon-lock
{
    background-image: url("project://database/Assets/UI/Icons/lock-icon.png");
    -unity-background-image-tint-color: var(--danger);
}
.anatomia-theme.theme-quiz.quiz-root .blocked-icon-exit
{
    background-image: url("project://database/Assets/UI/Icons/exit-logo-black.png");
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-quiz.quiz-root .blocked-message { margin: 0 0 40px 0; font-size: 32px; color: var(--ink-2); -unity-text-align: middle-center; white-space: normal; }
.anatomia-theme.theme-quiz.quiz-root .blocked-back-button
{
    width: 100%;
    height: 104px;
    margin: 0;
    padding: 0 48px;
    border-width: 0;
    border-radius: 52px;
    background-color: var(--accent);
    color: white;
    font-size: 30px;
    -unity-font-style: bold;
}
.anatomia-theme.theme-quiz.quiz-root .blocked-back-button:hover { background-color: var(--accent-strong); }

.anatomia-theme.theme-quiz.quiz-root .exit-confirm-title { margin: 0 0 14px 0; font-size: 42px; -unity-font-style: bold; letter-spacing: -0.5px; color: var(--ink); -unity-text-align: middle-center; }
.anatomia-theme.theme-quiz.quiz-root .exit-confirm-button-row { flex-direction: row; width: 100%; }
.anatomia-theme.theme-quiz.quiz-root .exit-cancel-button,
.anatomia-theme.theme-quiz.quiz-root .exit-submit-button
{
    flex-grow: 1;
    flex-basis: 0;
    height: 104px;
    padding: 0 24px;
    border-radius: 52px;
    font-size: 29px;
    -unity-font-style: bold;
}
.anatomia-theme.theme-quiz.quiz-root .exit-cancel-button { margin: 0 8px 0 0; }
.anatomia-theme.theme-quiz.quiz-root .exit-submit-button { margin: 0 0 0 8px; }

.anatomia-theme.theme-quiz.quiz-root .loading-card { max-width: 640px; padding: 56px 52px; align-items: center; border-radius: 48px; }
.anatomia-theme.theme-quiz.quiz-root .loading-spinner
{
    width: 72px;
    height: 72px;
    margin-bottom: 30px;
    border-width: 7px;
    border-radius: 36px;
    border-top-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-bottom-color: var(--accent-soft);
}
.anatomia-theme.theme-quiz.quiz-root .loading-message { margin: 0; font-size: 31px; -unity-font-style: bold; color: var(--ink); -unity-text-align: middle-center; white-space: normal; }
.anatomia-theme.theme-quiz.quiz-root .loading-submessage { margin: 12px 0 0 0; font-size: 23px; color: var(--ink-3); -unity-text-align: middle-center; white-space: normal; }
.anatomia-theme.theme-quiz.quiz-root .loading-submessage.hidden { display: none; }

/* =========================================================
   COMPACT (toggled by the controller on narrow panels)
   ========================================================= */
.anatomia-theme.theme-quiz.quiz-root.compact .header { padding: 64px 28px 20px 28px; }
.anatomia-theme.theme-quiz.quiz-root.compact .header-top-row { margin-bottom: 28px; }
.anatomia-theme.theme-quiz.quiz-root.compact .icon-button { width: 68px; height: 68px; border-radius: 34px; font-size: 26px; }
.anatomia-theme.theme-quiz.quiz-root.compact .icon-button-glyph { width: 28px; height: 28px; }
.anatomia-theme.theme-quiz.quiz-root.compact .pill { min-height: 68px; margin-left: 10px; padding: 0 22px 0 18px; border-radius: 34px; }
.anatomia-theme.theme-quiz.quiz-root.compact .pill-icon { width: 30px; height: 30px; margin-right: 8px; }
.anatomia-theme.theme-quiz.quiz-root.compact .pill-label { font-size: 25px; }
.anatomia-theme.theme-quiz.quiz-root.compact .question-counter { font-size: 23px; }
.anatomia-theme.theme-quiz.quiz-root.compact .card-wrapper { padding: 12px 24px 16px 24px; }
.anatomia-theme.theme-quiz.quiz-root.compact .card { padding: 30px 26px 22px 26px; border-radius: 38px; }
.anatomia-theme.theme-quiz.quiz-root.compact .card-top-row { margin-bottom: 22px; }
.anatomia-theme.theme-quiz.quiz-root.compact .type-label { font-size: 18px; padding: 7px 18px; }
.anatomia-theme.theme-quiz.quiz-root.compact .question-text { font-size: 33px; margin-bottom: 28px; }
.anatomia-theme.theme-quiz.quiz-root.compact .option-row { padding: 22px 24px; border-radius: 26px; }
.anatomia-theme.theme-quiz.quiz-root.compact .option-row--selected { padding: 21px 23px; }
.anatomia-theme.theme-quiz.quiz-root.compact .radio-outer,
.anatomia-theme.theme-quiz.quiz-root.compact .checkbox-outer { width: 36px; height: 36px; margin-right: 20px; }
.anatomia-theme.theme-quiz.quiz-root.compact .radio-outer { border-radius: 18px; }
.anatomia-theme.theme-quiz.quiz-root.compact .radio-inner { width: 18px; height: 18px; border-radius: 9px; }
.anatomia-theme.theme-quiz.quiz-root.compact .option-label { font-size: 27px; }
.anatomia-theme.theme-quiz.quiz-root.compact .answer-text-field > .unity-text-field__input,
.anatomia-theme.theme-quiz.quiz-root.compact .answer-text-field > #unity-text-input { min-height: 88px; font-size: 28px; }
.anatomia-theme.theme-quiz.quiz-root.compact .image-frame { height: 320px; }
.anatomia-theme.theme-quiz.quiz-root.compact .view-model-button { height: 78px; font-size: 24px; }
.anatomia-theme.theme-quiz.quiz-root.compact .action-row { padding: 4px 24px 36px 24px; }
.anatomia-theme.theme-quiz.quiz-root.compact .action-button,
.anatomia-theme.theme-quiz.quiz-root.compact .prev-button { height: 94px; border-radius: 47px; font-size: 27px; }
.anatomia-theme.theme-quiz.quiz-root.compact .prev-button-label { font-size: 27px; }
.anatomia-theme.theme-quiz.quiz-root.compact .prev-button-icon { width: 26px; height: 26px; }
.anatomia-theme.theme-quiz.quiz-root.compact .blocked-icon { width: 72px; height: 72px; }
.anatomia-theme.theme-quiz.quiz-root.compact .exit-confirm-title { font-size: 34px; }
.anatomia-theme.theme-quiz.quiz-root.compact .exit-cancel-button,
.anatomia-theme.theme-quiz.quiz-root.compact .exit-submit-button { height: 88px; font-size: 25px; }
