    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.progress-track {
    height: 9px;
    background-color: rgba(255, 255, 255, 0.35);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 21px;
}

.progress-fill {
    height: 9px;
    width: 16%;
    background-color: rgb(17, 24, 39);
    border-radius: 5px;
}

.question-counter {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.92);
}

/* ---------------- CARD ---------------- */

.card-wrapper {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 24px 36px 36px 36px;
}

.card {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(255, 255, 255);
    padding: 42px 36px;
    border-radius: 36px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.04);
    overflow: hidden;
}

/* Only the answer options scroll - the card itself (question text, type
   label, etc.) stays fixed in place under the header. This ScrollView is
   sized by min-height:0 + flex-grow:1 so it fills whatever room is left in
   the card after the question text, and only becomes draggable once the
   options genuinely overflow that space (touch-scroll-type=Clamped). */
.answer-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.answer-scroll > .unity-scroll-view__content-viewport {
    overflow: hidden;
}

/* Same fix as before: stop Unity's ScrollView from stretching/centering its
   internal content-container - let it hug the answer rows and top-align them. */
.answer-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport {
    flex-grow: 1;
    height: 100%;
}

.answer-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    flex-grow: 0;
    height: auto;
    min-height: 0;
    justify-content: flex-start;
    align-items: stretch;
}

.card-top-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 21px;
}

.type-label {
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(59, 130, 246);
    letter-spacing: 1.5px;
}

.quiz-label {
    font-size: 21px;
    color: rgb(148, 163, 184);
}

.question-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(17, 24, 39);
    white-space: normal;
    margin-bottom: 36px;
}

.answer-container {
    flex-grow: 1;
}

.helper-text {
    font-size: 22px;
    color: rgb(107, 114, 128);
    margin-bottom: 18px;
}

