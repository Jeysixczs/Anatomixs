    flex-shrink: 1;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(234, 240, 241);
}

/* ---------------- HEADER ---------------- */

.header {
    /* background painted at runtime via generated gradient texture */
    padding: 60px 48px 42px 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
}

.header-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 42px;
