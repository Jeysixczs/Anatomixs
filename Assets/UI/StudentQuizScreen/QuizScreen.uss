.checkbox-outer {
    width: 33px;
    height: 33px;
    border-radius: 9px;
    border-width: 3px;
    border-color: rgb(203, 213, 225);
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    margin-right: 24px;
}

.option-row--selected .checkbox-outer {
    background-color: rgb(17, 24, 39);
    border-color: rgb(17, 24, 39);
}

.checkbox-check {
    color: rgb(255, 255, 255);
    font-size: 21px;
    -unity-font-style: bold;
    display: none;
}

.option-row--selected .checkbox-check {
    display: flex;
}

/* ---------------- TEXT INPUTS (Identification / Enumeration / Image Based) ---------------- */

.answer-text-field {
    margin-bottom: 21px;
}

.answer-text-field > .unity-text-field__input {
    background-color: rgb(243, 244, 246);
    border-width: 2px;
    border-color: rgb(229, 231, 235);
    border-radius: 18px;
    padding: 24px 27px;
    font-size: 26px;
    color: rgb(17, 24, 39);
}

.answer-text-field > .unity-text-field__input:focus {
    border-color: rgb(59, 130, 246);
}

/* ---------------- IMAGE BASED ---------------- */

.image-frame {
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(229, 231, 235);
    border-radius: 21px;
    align-items: center;
    justify-content: center;
    height: 390px;
    margin-bottom: 30px;
    overflow: hidden;
}

.quiz-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.arrow-marker {
    position: absolute;
    width: 60px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------------- ACTION BUTTON ---------------- */

.action-row {
    flex-direction: row;
    margin: 12px 36px 42px 36px;
}

.action-button {
    /* background painted at runtime via generated gradient texture */
    flex-grow: 1;
    flex-basis: 0;
    height: 96px;
    border-radius: 24px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 27px;
    -unity-font-style: bold;
}

.action-button--disabled {
    opacity: 0.55;
}

.prev-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 96px;
    margin: 0 18px 0 0;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(203, 213, 225);
    background-color: rgb(255, 255, 255);
    color: rgb(30, 41, 59);
    font-size: 27px;
    -unity-font-style: bold;
}

.prev-button:hover {
    background-color: rgb(243, 244, 246);
}

.prev-button.hidden {
    display: none;
}

/* ---------------- UTILITY ---------------- */

.hidden {
    display: none;
}

/* ---------------- BLOCKED OVERLAY (deadline passed / attempts used up) ---------------- */

.blocked-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 18, 28, 0.72);
    justify-content: center;
    align-items: center;
    padding: 53px;
}

.blocked-card {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 54px 42px;
    align-items: center;
    max-width: 720px;
}

.blocked-icon {
    font-size: 64px;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.blocked-message {
    font-size: 32px;
    color: rgb(31, 36, 48);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 36px;
}

.blocked-back-button {
    background-color: rgb(31, 36, 48);
    margin: 0;
    padding: 0 48px;
    height: 90px;
    border-radius: 24px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 27px;
    -unity-font-style: bold;
}

/* ---------------- COMPACT BREAKPOINT (narrow / small devices) ---------------- */

.compact .question-text {
    font-size: 30px;
}

.compact .option-row {
    padding: 21px 24px;
}

.compact .card-wrapper {
    padding: 16px 24px 24px 24px;
}

.compact .card {
    padding: 30px 27px;
}

.compact .action-row {
    margin: 9px 24px 30px 24px;
}

.compact .action-button,
.compact .prev-button {
    height: 84px;
}

/* ---------------- IMAGE BASED (View on 3D Model button) ---------------- */

.view-model-button {
    height: 78px;
    margin: 0 0 21px 0;
    border-radius: 21px;
    border-width: 0;
    background-color: rgb(59, 130, 246);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

.view-model-button:hover {
    background-color: rgb(37, 99, 235);
}

.compact .view-model-button {
    height: 66px;
    font-size: 21px;
}

/* ---------------- EXIT CONFIRM OVERLAY (close-button tap mid-quiz) ---------------- */

.exit-confirm-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(17, 24, 39);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.exit-confirm-button-row {
    flex-direction: row;
    width: 100%;
}

.exit-cancel-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 9px 0 0;
    padding: 0 24px;
    height: 90px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(229, 231, 235);
    background-color: rgb(255, 255, 255);
    color: rgb(31, 36, 48);
    font-size: 27px;
    -unity-font-style: bold;
}

.exit-cancel-button:hover {
    background-color: rgb(243, 244, 246);
}

.exit-submit-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 0 0 9px;
    padding: 0 24px;
    height: 90px;
    border-radius: 24px;
    border-width: 0;
    background-color: rgb(59, 130, 246);
    color: rgb(255, 255, 255);
    font-size: 27px;
    -unity-font-style: bold;
}

.exit-submit-button:hover {
    background-color: rgb(37, 99, 235);
}

.compact .exit-confirm-title {
    font-size: 30px;
}

.compact .exit-cancel-button,
.compact .exit-submit-button {
    height: 78px;
    font-size: 24px;
}
