<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminDashboard/AdminDashboard.uss?fileID=7433441132597879392&amp;guid=52586ffcf29bb3141b7297cdb3317ab1&amp;type=3#AdminDashboard"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss?fileID=7433441132597879392&amp;guid=f3df4a0ff9d42424986b13ce625d35c9&amp;type=3#AnatomiaTheme"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaLayout.uss?fileID=7433441132597879392&amp;guid=104bac896b87c0e4db3bd9b3134cf7a2&amp;type=3#AnatomiaLayout"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme theme-admin screen-root">
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <ui:VisualElement name="header" class="header">
                <ui:VisualElement name="header-top-row" class="header-top-row">
                    <ui:Button name="profile-button" class="profile-avatar-button">
                        <ui:Label name="profile-initials-label" text="" class="profile-avatar-initials"/>
                    </ui:Button>
                    <ui:Button name="logout-button" class="logout-button">
                        <ui:VisualElement class="logout-icon icon-logout"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="header-text" class="header-title-block">
                    <ui:Label text="Teacher Dashboard" class="header-title"/>
                    <ui:Label name="header-subtitle-label" text="Welcome back, Teacher" class="header-subtitle"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-wrapper" class="content-wrapper">
                <ui:VisualElement class="bento-row bento-row-top">
                    <ui:Button name="create-classroom-button" class="create-classroom-header-button bento-w3 bento-l">
                        <ui:Label text="+" class="create-classroom-plus"/>
                        <ui:Label text="Create New Classroom" class="create-classroom-header-label"/>
                    </ui:Button>
                    <ui:VisualElement name="header-stats-row" class="header-stats-row bento-w2 bento-r">
                        <ui:VisualElement name="classrooms-stat-card" class="glass-stat-card glass-stat-card-left">
                            <ui:Label name="classrooms-count-label" text="0" class="glass-stat-value"/>
                            <ui:Label text="Classrooms" class="glass-stat-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="students-stat-card" class="glass-stat-card glass-stat-card-mid">
                            <ui:Label name="students-count-label" text="0" class="glass-stat-value"/>
                            <ui:Label text="Students" class="glass-stat-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="My Classrooms" class="section-title"/>
                <ui:VisualElement name="classrooms-section" class="classrooms-section">
                    <ui:VisualElement name="classrooms-empty-state" class="classrooms-empty-state">
                        <ui:VisualElement class="empty-state-icon-box">
                            <ui:VisualElement class="empty-state-icon empty-state-icon-students"/>
                        </ui:VisualElement>
                        <ui:Label text="No classrooms yet" class="empty-state-text"/>
                        <ui:Label text="Create your first classroom to invite students." class="empty-state-subtext"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="classrooms-list" class="classrooms-list hidden"/>
                    <ui:Button name="classrooms-view-all-button" text="View All Classrooms" class="view-all-button hidden"/>
                </ui:VisualElement>
                <ui:Label text="Quick Actions" class="section-title section-title-spaced"/>
                <ui:VisualElement name="quick-actions-row" class="quick-actions-row">
                    <ui:Button name="manage-quizzes-button" class="quick-action-card quick-action-card-left">
                        <ui:VisualElement class="quick-action-icon-circle quick-action-icon-blue">
                            <ui:VisualElement class="quick-action-icon icon-book"/>
                        </ui:VisualElement>
                        <ui:Label text="Manage Quizzes" class="quick-action-title"/>
                    </ui:Button>
                    <ui:Button name="view-analytics-button" class="quick-action-card quick-action-card-right">
                        <ui:VisualElement class="quick-action-icon-circle quick-action-icon-orange">
                            <ui:VisualElement class="quick-action-icon icon-chart"/>
                        </ui:VisualElement>
                        <ui:Label text="View Analytics" class="quick-action-title"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="gamification-button" class="gamification-card">
                    <ui:VisualElement class="quick-action-icon-circle quick-action-icon-green">
                        <ui:VisualElement class="quick-action-icon icon-ribbon"/>
                    </ui:VisualElement>
                    <ui:Label text="Gamification Configuration" class="gamification-title"/>
                </ui:Button>
                <ui:VisualElement name="recent-activity-header" class="recent-activity-header section-title-spaced">
                    <ui:Label text="Student Activity" class="section-title recent-activity-title"/>
                    <ui:Button name="recent-activity-view-all-button" text="View All" class="view-all-inline-button hidden"/>
                </ui:VisualElement>
                <ui:VisualElement name="recent-activity-card" class="recent-activity-card">
                    <ui:Label name="recent-activity-empty-label" text="No student activity yet" class="recent-activity-empty-label"/>
                    <ui:VisualElement name="recent-activity-list" class="recent-activity-list hidden"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="classrooms-view-all-overlay" class="modal-overlay hidden">
            <ui:VisualElement name="classrooms-view-all-card" class="modal-card view-all-card">
                <ui:VisualElement name="view-all-header" class="view-all-header">
                    <ui:Label text="All Classrooms" class="view-all-title"/>
                    <ui:Button name="classrooms-view-all-close-button" class="view-all-close-button">
                        <ui:VisualElement picking-mode="Ignore" class="view-all-close-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="view-all-search-row" class="view-all-search-row">
                    <ui:VisualElement name="view-all-search-field-wrapper" class="view-all-search-field-wrapper">
                        <ui:Label text="" class="view-all-search-icon icon-search"/>
                        <ui:TextField name="classrooms-view-all-search-field" placeholder-text="Search classrooms" class="view-all-search-field"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="classrooms-view-all-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="view-all-scroll">
                    <ui:VisualElement name="classrooms-view-all-no-results" class="view-all-no-results hidden">
                        <ui:Label text="No classrooms match your search" class="empty-state-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="classrooms-view-all-list" class="classrooms-list view-all-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="recent-activity-view-all-overlay" class="modal-overlay hidden">
            <ui:VisualElement name="recent-activity-view-all-card" class="modal-card view-all-card">
                <ui:VisualElement name="recent-activity-view-all-header" class="view-all-header">
                    <ui:Label text="Student Activity" class="view-all-title"/>
                    <ui:Button name="recent-activity-view-all-close-button" class="view-all-close-button">
                        <ui:VisualElement picking-mode="Ignore" class="view-all-close-icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="recent-activity-view-all-search-row" class="view-all-search-row">
                    <ui:VisualElement name="recent-activity-view-all-search-field-wrapper" class="view-all-search-field-wrapper" style="border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px;">
                        <ui:Label text="" class="view-all-search-icon icon-search"/>
                        <ui:TextField name="recent-activity-view-all-search-field" placeholder-text="Search student activity" class="view-all-search-field"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="recent-activity-view-all-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="view-all-scroll">
                    <ui:VisualElement name="recent-activity-view-all-no-results" class="view-all-no-results hidden">
                        <ui:Label text="No student activity matches your search" class="empty-state-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="recent-activity-view-all-list" class="recent-activity-list view-all-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
