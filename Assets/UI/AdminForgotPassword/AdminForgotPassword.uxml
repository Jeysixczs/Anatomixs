<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminLogin/AdminLogin.uss"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="screen-container" class="screen-container">
            <ui:ScrollView name="scroll-view" class="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement name="
pper" class="content-wrapper">
                    <ui:VisualElement name="logo-circle" class="logo-circle">
                        <ui:VisualElement name="logo-icon" class="logo-icon icon-shield"/>
                    </ui:VisualElement>
                    <ui:Label name="app-title" text="Forgot Password" class="app-title"/>
                    <ui:Label name="app-subtitle" text="Enter your admin email to reset your password" class="app-subtitle"/>
                    <ui:VisualElement name="reset-card" class="reset-card">
                        <ui:Label text="Admin Email" class="field-label"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-email"/>
                            <ui:TextField name="email-field" placeholder-text="admin@anatomylearn.com" hide-placeholder-on-focus="true" class="input-field"/>
                        </ui:VisualElement>
                        <ui:Label name="email-error" text="Please enter a valid email address" class="field-error hidden"/>

                        <ui:Label name="success-message-label" text="&#10003; Password reset link sent to your email." class="success-message hidden"/>

                        <ui:Button name="send-reset-link-button" text="Send Reset Link" class="send-reset-link-button"/>
                        <ui:Label name="status-label" text="" class="status-label hidden"/>
                    </ui:VisualElement>
                    <ui:Button name="back-to-admin-login-button" text="← Back to Admin Login" class="back-to-admin-link"/>
                    <ui:Label name="footer-warning-label" text="This is a restricted area. All access attempts are logged and monitored." class="footer-warning-label"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
