/* =========================================================
   Anatomia 3D - Admin Forgot Password (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient support, so the dark purple
   screen background, the shield logo circle and the "Send Reset
   Link" button gradients are all applied at runtime from
   AdminForgotPasswordController.ApplyGradients() (see
   BuildGradientTexture). The colors below are flat fallbacks so
   the screen still looks correct in the UI Builder preview
   before the controller runs. Matches AdminLogin.uss.
   ========================================================= */

/* ---------- Full Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;

    flex-grow: 1;

    justify-content: center;
    align-items: center;

    background-color: rgb(24, 12, 39); /* deep purple/black fallback, overridden by gradient texture */
}

/* ---------- Center Container ---------- */

.screen-container
{
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding-left: 80px;
    padding-right: 80px;
    padding-top: 100px;
    padding-bottom: 100px;
}

/* ---------- Main Column ---------- */

.content-wrapper
{
    width: 100%;
    max-width: 900px;
    flex-grow: 1;
    justify-content: center;
    align-items: stretch;
    flex-direction: column;
}

/* ---------- Logo ---------- */

.logo-circle
{
    width: 190px;
    height: 190px;

    align-self: center;

    border-radius: 95px;

    background-color: rgb(180, 45, 200); /* fallback, gradient applied at runtime */

    justify-content: center;
    align-items: center;

    margin-bottom: 40px;
}

.logo-icon
{
    width: 84px;
    height: 84px;
}

.icon-shield
{
    background-image: url("project://database/Assets/UI/Icons/shield-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

/* ---------- Title ---------- */

.app-title
{
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255,255,255);
    -unity-text-align: middle-center;

    margin-bottom: 12px;
}

.app-subtitle
{
    font-size: 28px;
    color: rgb(196,182,214);
    -unity-text-align: middle-center;
    white-space: normal;

    margin-bottom: 55px;
}

/* ---------- Card ---------- */

.reset-card
{
    width: 100%;

    background-color: rgba(255,255,255,0.06);

    border-width: 2px;
    border-color: rgba(255,255,255,0.12);

    border-radius: 44px;

    padding-left: 55px;
    padding-right: 55px;
    padding-top: 55px;
    padding-bottom: 45px;

    margin-bottom: 45px;
}

/* ---------- Labels ---------- */

.field-label
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(230,225,240);

    margin-bottom: 14px;
}

.field-error
{
    font-size: 24px;
    color: rgb(255,120,170);

    margin-top: 10px;
    white-space: normal;
}

.hidden
{
    display: none;
}

/* ---------- Input Container ---------- */

.input-container
{
    width: 100%;

    height: 112px;

    flex-direction: row;

    align-items: center;

    background-color: rgba(255,255,255,0.05);

    border-radius: 26px;

    border-width: 2px;
    border-color: rgba(255,255,255,0.14);

    padding-left: 30px;
    padding-right: 20px;
}

.input-container-focused
{
    border-color: rgb(200,60,210);
    border-width: 2px;
}

/* ---------- Icons ---------- */

.input-icon
{
    width: 38px;
    height: 38px;

    margin-right: 20px;
    flex-shrink: 0;

    -unity-background-image-tint-color: rgb(180,168,204);
}

.icon-email
{
    background-image: url("project://database/Assets/UI/Icons/email-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* ---------- TextField ---------- */

.input-field
{
    flex-grow: 1;

    font-size: 32px;

    color: rgb(240,236,248);

    background-color: transparent;

    border-width: 0;
}

.input-field > #unity-text-input
{
    background-color: transparent;
    border-width: 0;
    color: rgb(240,236,248);
}

/* ---------- Success Message ---------- */

.success-message
{
    font-size: 26px;
    color: rgb(120,220,170);

    -unity-text-align: middle-center;
    white-space: normal;

    margin-top: 10px;
    margin-bottom: 20px;
}

/* ---------- Send Reset Link Button ---------- */

.send-reset-link-button
{
    width: 100%;
    height: 116px;

    margin-top: 34px;

    background-color: rgb(160,45,210); /* fallback, gradient applied at runtime */

    color: white;

    border-radius: 26px;

    border-width: 0;

    font-size: 34px;
    -unity-font-style: bold;
}

.send-reset-link-button:hover
{
    opacity: 0.92;
}

.send-reset-link-button:disabled
{
    opacity: 0.6;
}

/* ---------- Status ---------- */

.status-label
{
    margin-top: 24px;

    font-size: 26px;

    color: rgb(255,140,190);

    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Back to Admin Login ---------- */

.back-to-admin-link
{
    align-self: center;

    background-color: transparent;

    border-width: 0;

    color: rgb(216,150,240);

    font-size: 30px;

    -unity-font-style: bold;

    margin-top: 6px;
}

.back-to-admin-link:hover
{
    opacity: 0.8;
}

/* ---------- Footer Warning ---------- */

.footer-warning-label
{
    margin-top: 50px;

    font-size: 22px;

    color: rgb(140,128,158);

    -unity-text-align: middle-center;

    white-space: normal;

    max-width: 720px;

    align-self: center;
}

/* =========================================================
   COMPACT MODE
   ========================================================= */

.compact .content-wrapper
{
    max-width: 760px;
}

.compact .logo-circle
{
    width: 150px;
    height: 150px;

    border-radius: 75px;
}

.compact .logo-icon
{
    width: 66px;
    height: 66px;
}

.compact .app-title
{
    font-size: 42px;
}

.compact .app-subtitle
{
    font-size: 24px;
}

.compact .reset-card
{
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 36px;
}

.compact .field-label
{
    font-size: 26px;
}

.compact .input-container
{
    height: 96px;
}

.compact .input-field
{
    font-size: 28px;
}

.compact .input-field > #unity-text-input
{
    font-size: 28px;
}

.compact .send-reset-link-button
{
    height: 102px;
    font-size: 30px;
}

.compact .success-message
{
    font-size: 22px;
}

.compact .back-to-admin-link
{
    font-size: 26px;
}

.compact .footer-warning-label
{
    font-size: 20px;
}
