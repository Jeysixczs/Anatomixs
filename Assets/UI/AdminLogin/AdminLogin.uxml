<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss?fileID=7433441132597879392&amp;guid=f3df4a0ff9d42424986b13ce625d35c9&amp;type=3#AnatomiaTheme"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaAuth.uss?fileID=7433441132597879392&amp;guid=7b1848b4e2e9bc34fbd3c5e0e140870d&amp;type=3#AnatomiaAuth"/>
    <Style src="project://database/Assets/UI/AdminLogin/AdminLogin.uss?fileID=7433441132597879392&amp;guid=44e0350b50f34f64993663515ae5925d&amp;type=3#AdminLogin"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme auth-root theme-admin-auth screen-root fit-screen">
        <ui:VisualElement picking-mode="Ignore" class="auth-top-gradient"/>
        <ui:VisualElement name="screen-container" class="screen-container">
            <ui:VisualElement name="scroll-view" class="scroll-view">
                <ui:VisualElement name="content-wrapper" class="content-wrapper">
                    <ui:VisualElement class="auth-hero">
                        <ui:VisualElement class="auth-hero-inner">
                            <ui:VisualElement class="auth-brand">
                                <ui:VisualElement name="logo-circle" class="logo-circle">
                                    <ui:VisualElement name="logo-icon" picking-mode="Ignore" class="logo-icon icon-shield"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label text="TEACHER ACCESS" class="admin-chip"/>
                            <ui:Label name="app-title" text="Welcome&#10;" class="auth-headline"/>
                            <ui:Label name="app-subtitle" text="Sign in to manage your classrooms, quizzes and student progress." class="app-subtitle"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="auth-card-wrap">
                        <ui:VisualElement name="login-card" class="auth-card">
                            <ui:Label text="Teacher email" class="field-label"/>
                            <ui:VisualElement class="input-container">
                                <ui:TextField name="admin-email-field" placeholder-text="Enter your email" hide-placeholder-on-focus="true" class="input-field"/>
                            </ui:VisualElement>
                            <ui:Label name="email-error" text="Please enter a valid admin email" class="field-error hidden"/>
                            <ui:VisualElement class="field-label-row">
                                <ui:Label text="Password" class="field-label"/>
                                <ui:Button name="forgot-password-button" text="Forgot password?" class="forgot-password-link"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="input-container">
                                <ui:TextField name="password-field" password="true" placeholder-text="Enter your password" hide-placeholder-on-focus="true" class="input-field input-field-with-right-icon"/>
                                <ui:Button name="toggle-password-button" class="input-icon-button icon-eye"/>
                            </ui:VisualElement>
                            <ui:Label name="password-error" text="Password is required" class="field-error hidden"/>
                            <ui:Button name="secure-login-button" text="Sign in" class="sign-in-button secure-login-button"/>
                            <ui:VisualElement class="divider-row">
                                <ui:VisualElement class="divider-line"/>
                                <ui:Label text="Or" class="divider-text"/>
                                <ui:VisualElement class="divider-line"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="social-row">
                                <ui:Button name="google-signin-button" class="google-button">
                                    <ui:VisualElement picking-mode="Ignore" class="icon-google"/>
                                    <ui:Label text="Sign in with Google" picking-mode="Ignore" class="google-button-text"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:Label name="status-label" text="" class="status-label hidden"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="create-account-row" class="auth-foot">
                        <ui:VisualElement class="auth-foot-row">
                            <ui:Label text="Don&apos;t have an admin account?" class="auth-foot-text"/>
                            <ui:Button name="navigate-to-create-account-button" text="Create account" class="auth-foot-link"/>
                        </ui:VisualElement>
                        <ui:Button name="back-to-student-login-button" text="Back to student login" class="back-to-student-link"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
