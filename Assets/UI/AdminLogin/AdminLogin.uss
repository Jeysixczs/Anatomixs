/* =========================================================
   Anatomia 3D - Admin auth overlay (Login / Forgot Password / Create Account)
   Reference canvas: 1080 x 1920.

   These three screens now use the SAME light "Soft Gradient" system as the
   student auth screens: AnatomiaTheme.uss + AnatomiaAuth.uss are loaded first,
   and this file only adds what is admin-specific:

     - shield badge (logo-circle) and the "TEACHER ..." chip
     - muted security note / restricted-area footer
     - "Back to student login" link

   Load order in every admin auth UXML: AnatomiaTheme -> AnatomiaAuth -> this file.
   Equal-specificity rules here win because this file loads last.
   AdminForgotPassword.uss and AdminCreateAccount.uss are no longer referenced.
   ========================================================= */

/* ---------- Shield badge (replaces the old purple gradient circle) ---------- */
.anatomia-theme.auth-root .auth-brand
{
    margin-bottom: 34px;
}

.anatomia-theme.auth-root .auth-brand .logo-circle
{
    width: 132px;
    height: 132px;
    margin: 0;
    border-radius: 66px;
    border-width: 2px;
    border-color: rgba(43, 109, 255, 0.18);
    background-color: var(--accent-soft);
    background-image: none;
    justify-content: center;
    align-items: center;
}

.anatomia-theme.auth-root .logo-icon
{
    width: 62px;
    height: 62px;
}

.anatomia-theme.auth-root .icon-shield
{
    background-image: url("project://database/Assets/UI/Icons/shield-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

/* Smaller badge on the long Create Account form */
.anatomia-theme.auth-root .auth-brand-small { margin-bottom: 26px; }
.anatomia-theme.auth-root .auth-brand-small .logo-circle { width: 104px; height: 104px; border-radius: 52px; }
.anatomia-theme.auth-root .auth-brand-small .logo-icon { width: 48px; height: 48px; }

/* ---------- Role chip ---------- */
.anatomia-theme.auth-root .admin-chip
{
    align-self: center;
    margin: 0 0 22px 0;
    padding: 9px 28px;
    border-radius: 30px;
    background-color: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

/* ---------- Security note (Login) ---------- */
.anatomia-theme.auth-root .encryption-row
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
}

.anatomia-theme.auth-root .encryption-dot
{
    width: 14px;
    height: 14px;
    margin-right: 14px;
    border-radius: 7px;
    background-color: var(--success);
}

.anatomia-theme.auth-root .encryption-text
{
    font-size: 22px;
    color: var(--ink-3);
}

/* ---------- Footer links ---------- */
.anatomia-theme.auth-root .back-to-student-link
{
    align-self: center;
    margin: 24px 0 0 0;
    padding: 10px 28px;
    border-width: 0;
    border-radius: 28px;
    font-size: 24px;
    -unity-font-style: normal;
    color: var(--ink-3);
    background-color: rgba(0, 0, 0, 0);
}
.anatomia-theme.auth-root .back-to-student-link:hover { color: var(--accent); background-color: rgba(0, 0, 0, 0); }

.anatomia-theme.auth-root .footer-warning-label
{
    width: 100%;
    max-width: 720px;
    align-self: center;
    margin: 36px 0 0 0;
    font-size: 22px;
    color: var(--ink-3);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Responsive (classes toggled by the controllers) ---------- */
.anatomia-theme.auth-root.compact .auth-brand { margin-bottom: 26px; }
.anatomia-theme.auth-root.compact .auth-brand .logo-circle { width: 108px; height: 108px; border-radius: 54px; }
.anatomia-theme.auth-root.compact .auth-brand-small .logo-circle { width: 88px; height: 88px; border-radius: 44px; }
.anatomia-theme.auth-root.compact .logo-icon { width: 50px; height: 50px; }
.anatomia-theme.auth-root.compact .auth-brand-small .logo-icon { width: 40px; height: 40px; }
.anatomia-theme.auth-root.compact .admin-chip { font-size: 19px; margin-bottom: 16px; }
.anatomia-theme.auth-root.compact .encryption-row { margin-top: 30px; }
.anatomia-theme.auth-root.compact .back-to-student-link { font-size: 22px; }
.anatomia-theme.auth-root.compact .footer-warning-label { margin-top: 26px; font-size: 20px; }

.anatomia-theme.auth-root.landscape .auth-brand,
.anatomia-theme.auth-root.landscape .admin-chip { display: none; }
.anatomia-theme.auth-root.landscape .footer-warning-label { margin-top: 12px; font-size: 18px; }
.anatomia-theme.auth-root.landscape .encryption-row { margin-top: 14px; }
.anatomia-theme.auth-root.landscape .back-to-student-link { margin-top: 6px; }

.anatomia-theme.auth-root.ultra-compact .admin-chip { letter-spacing: 2px; padding: 8px 22px; }
.anatomia-theme.auth-root.ultra-compact .encryption-text { font-size: 19px; }
.anatomia-theme.auth-root.ultra-compact .footer-warning-label { font-size: 18px; }
