/* =========================================================
   Anatomia 3D - Student Achievements v2 "Trophy Shelf"
   Reference canvas: 1080 x 1920 (portrait).
   Loaded BEFORE AnatomiaTheme.uss, so every rule is scoped under
   .anatomia-theme.theme-achievements to out-rank the theme's shared rules.

   LAYOUT
     header : back button + title on the ambient background (no slab)
     tiles  : Total points (solid accent) + Badges earned, side by side
     list   : one rounded card per badge - icon tile, title, status and a
              progress bar. Earned = gold icon + green bar + "Completed";
              locked = muted card, lock icon, accent bar + count footer.
   Badge cards are built at runtime by the controller; all of its class
   names (badge-card, badge-icon-box, badge-icon-gold, progress-fill ...)
   are styled below and unchanged.
   ========================================================= */

.anatomia-theme.theme-achievements
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- ScrollView ---------- */
.anatomia-theme.theme-achievements .screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    -unity-overflow-scrolling: touch;
}
.anatomia-theme.theme-achievements .screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.anatomia-theme.theme-achievements .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}
.anatomia-theme.theme-achievements .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Header ---------- */
.anatomia-theme.theme-achievements .header
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-shrink: 0;
    flex-direction: column;
    padding: 96px 48px 20px 48px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}
.anatomia-theme.theme-achievements .header-top-row { flex-direction: row; align-items: center; margin-bottom: 44px; }
.anatomia-theme.theme-achievements .back-button
{
    width: 88px;
    height: 88px;
    margin: 0 28px 0 0;
    flex-shrink: 0;
    border-radius: 44px;
    justify-content: center;
    align-items: center;
}
.anatomia-theme.theme-achievements .back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}
.anatomia-theme.theme-achievements .header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }
.anatomia-theme.theme-achievements .header-title { margin: 0; font-size: 56px; -unity-font-style: bold; letter-spacing: -1.5px; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-achievements .header-subtitle { margin: 6px 0 0 0; font-size: 27px; color: var(--ink-3); white-space: normal; }

/* ---------- Summary tiles ---------- */
.anatomia-theme.theme-achievements .summary-card
{
    flex-direction: row;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
.anatomia-theme.theme-achievements .summary-row
{
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 36px 36px 34px 36px;
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 44px;
    background-color: var(--surface);
}
.anatomia-theme.theme-achievements .summary-row-points { margin-right: 12px; border-width: 0; background-color: var(--accent); }
.anatomia-theme.theme-achievements .summary-row-badges { margin-left: 12px; }
.anatomia-theme.theme-achievements .summary-label { margin: 0 0 10px 0; font-size: 25px; -unity-font-style: bold; color: var(--ink-3); }
.anatomia-theme.theme-achievements .summary-value { margin: 0; font-size: 64px; -unity-font-style: bold; letter-spacing: -2px; color: var(--ink); }
.anatomia-theme.theme-achievements .summary-row-points .summary-label { color: rgba(255, 255, 255, 0.78); }
.anatomia-theme.theme-achievements .summary-row-points .summary-value { color: white; }
.anatomia-theme.theme-achievements .summary-divider { display: none; }

/* ---------- Content ---------- */
.anatomia-theme.theme-achievements .content-wrapper
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0 48px 80px 48px;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
}
.anatomia-theme.theme-achievements .section-title { margin: 44px 0 22px 6px; font-size: 32px; -unity-font-style: bold; letter-spacing: -0.3px; color: var(--ink); }
.anatomia-theme.theme-achievements .badge-list { flex-direction: column; width: 100%; padding: 0; }
.anatomia-theme.theme-achievements .badge-list-bottom-padded { padding-bottom: 40px; }

/* ---------- Badge cards ---------- */
.anatomia-theme.theme-achievements .badge-card
{
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin: 0 0 20px 0;
    padding: 32px;
    border-radius: 44px;
    background-color: var(--surface-solid);
}
.anatomia-theme.theme-achievements .badge-card-locked { background-color: var(--sunken); border-color: rgba(0, 0, 0, 0); }

.anatomia-theme.theme-achievements .badge-icon-box
{
    width: 120px;
    height: 120px;
    margin: 0 30px 0 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-radius: 40px;
}
.anatomia-theme.theme-achievements .badge-icon-gold { background-color: var(--warn-soft); }
.anatomia-theme.theme-achievements .badge-icon-locked { background-color: var(--track); }
.anatomia-theme.theme-achievements .badge-icon-emoji { margin: 0; font-size: 58px; -unity-text-align: middle-center; }
.anatomia-theme.theme-achievements .badge-lock-icon
{
    width: 46px;
    height: 46px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Icons/lock-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink-3);
}

.anatomia-theme.theme-achievements .badge-info { flex-grow: 1; flex-direction: column; min-width: 0; }
.anatomia-theme.theme-achievements .badge-title { margin: 0; font-size: 36px; -unity-font-style: bold; letter-spacing: -0.4px; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-achievements .badge-title-locked { color: var(--ink-2); }
.anatomia-theme.theme-achievements .badge-status { margin: 6px 0 0 0; font-size: 25px; white-space: normal; }
.anatomia-theme.theme-achievements .badge-status-unlocked { color: var(--success); }
.anatomia-theme.theme-achievements .badge-status-locked { color: var(--ink-3); }

.anatomia-theme.theme-achievements .badge-progress-row { flex-direction: row; align-items: center; width: 100%; margin-top: 20px; }
.anatomia-theme.theme-achievements .progress-track
{
    flex-grow: 1;
    min-width: 0;
    height: 18px;
    border-radius: 9px;
    position: relative;
    overflow: hidden;
    background-color: var(--track);
}
.anatomia-theme.theme-achievements .progress-fill { position: absolute; left: 0; top: 0; bottom: 0; height: 100%; border-radius: 9px; background-color: var(--accent); }
.anatomia-theme.theme-achievements .progress-fill-complete { background-color: var(--success); }
.anatomia-theme.theme-achievements .progress-fill-locked { background-color: var(--accent); }
.anatomia-theme.theme-achievements .progress-label { margin: 0 0 0 20px; flex-shrink: 0; font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-right; }
.anatomia-theme.theme-achievements .progress-label-complete { color: var(--success); }

.anatomia-theme.theme-achievements .badge-progress-footer-row { flex-direction: row; justify-content: space-between; margin-top: 12px; }
.anatomia-theme.theme-achievements .progress-footer-label { margin: 0; font-size: 23px; color: var(--ink-3); }
.anatomia-theme.theme-achievements .progress-footer-label-right { -unity-text-align: middle-right; -unity-font-style: bold; color: var(--ink-2); }

/* =========================================================
   COMPACT (toggled by the controller below 900 px width)
   ========================================================= */
.anatomia-theme.theme-achievements.compact .header { padding: 72px 28px 16px 28px; }
.anatomia-theme.theme-achievements.compact .header-top-row { margin-bottom: 30px; }
.anatomia-theme.theme-achievements.compact .back-button { width: 72px; height: 72px; border-radius: 36px; margin-right: 20px; }
.anatomia-theme.theme-achievements.compact .back-icon { width: 32px; height: 32px; }
.anatomia-theme.theme-achievements.compact .header-title { font-size: 44px; }
.anatomia-theme.theme-achievements.compact .header-subtitle { font-size: 23px; }
.anatomia-theme.theme-achievements.compact .summary-row { padding: 26px 26px 24px 26px; border-radius: 36px; }
.anatomia-theme.theme-achievements.compact .summary-row-points { margin-right: 8px; }
.anatomia-theme.theme-achievements.compact .summary-row-badges { margin-left: 8px; }
.anatomia-theme.theme-achievements.compact .summary-label { font-size: 22px; margin-bottom: 6px; }
.anatomia-theme.theme-achievements.compact .summary-value { font-size: 50px; }
.anatomia-theme.theme-achievements.compact .content-wrapper { padding: 0 28px 60px 28px; }
.anatomia-theme.theme-achievements.compact .section-title { margin: 34px 0 18px 4px; font-size: 28px; }
.anatomia-theme.theme-achievements.compact .badge-card { padding: 24px; border-radius: 36px; margin-bottom: 16px; }
.anatomia-theme.theme-achievements.compact .badge-icon-box { width: 92px; height: 92px; border-radius: 30px; margin-right: 22px; }
.anatomia-theme.theme-achievements.compact .badge-icon-emoji { font-size: 44px; }
.anatomia-theme.theme-achievements.compact .badge-lock-icon { width: 38px; height: 38px; }
.anatomia-theme.theme-achievements.compact .badge-title { font-size: 30px; }
.anatomia-theme.theme-achievements.compact .badge-status { font-size: 21px; }
.anatomia-theme.theme-achievements.compact .badge-progress-row { margin-top: 14px; }
.anatomia-theme.theme-achievements.compact .progress-track { height: 14px; border-radius: 7px; }
.anatomia-theme.theme-achievements.compact .progress-fill { border-radius: 7px; }
.anatomia-theme.theme-achievements.compact .progress-label { font-size: 22px; margin-left: 14px; }
.anatomia-theme.theme-achievements.compact .progress-footer-label { font-size: 20px; }
