/* =========================================================
   Anatomia 3D - Admin Classroom Detail (Unity 6 UI Toolkit)
   Re-laid out to match StudentClassroomDetail: slim fixed header,
   one-card stats strip, section bar, and a right-hand hamburger drawer
   instead of the five-button tab switcher.
   Loaded BEFORE Theme/AnatomiaTheme.uss (second <Style> in the UXML), which
   supplies the design tokens, ambient background and card surfaces.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

.content-wrapper
{
    width: 100%;
    flex-direction: column;
}

/* ---------- Header (fixed, slim) ---------- */

.anatomia-theme.theme-admin-classroom .header
{
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 84px;
    padding-bottom: 12px;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.anatomia-theme.theme-admin-classroom .back-button
{
    width: 88px;
    height: 88px;
    min-width: 88px;
    border-radius: 44px;
    margin: 0 28px 0 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.back-icon
{
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.header-title-block
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.anatomia-theme.theme-admin-classroom .header-title
{
    font-size: 44px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.anatomia-theme.theme-admin-classroom .header-subtitle
{
    font-size: 26px;
    margin-top: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.archived-badge
{
    align-self: flex-start;
    margin-top: 8px;
    padding: 4px 18px;
    border-radius: 18px;
    background-color: var(--warn-soft);
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--warn);
}

/* ---------- Classroom code chip (sits between title row and stats) ---------- */

.code-chip
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding: 10px 12px 10px 28px;
    border-radius: 28px;
    background-color: var(--accent-faint);
    border-width: 1px;
    border-color: var(--accent-soft);
}

.code-chip-text
{
    flex-direction: row;
    align-items: baseline;
    flex-shrink: 1;
    min-width: 0;
}

.code-chip-caption
{
    font-size: 24px;
    color: var(--ink-3);
    margin-right: 18px;
}

.code-chip-value
{
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--accent);
}

.anatomia-theme.theme-admin-classroom .copy-code-icon-button
{
    width: 72px;
    height: 72px;
    min-width: 72px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 36px;
    background-color: var(--accent);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.anatomia-theme.theme-admin-classroom .copy-code-icon-button:hover { background-color: var(--accent-strong); }
.anatomia-theme.theme-admin-classroom .copy-code-icon-button:active { background-color: var(--accent-press); }

.copy-code-icon
{
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/UI/Icons/copy-white.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* ---------- Stats strip: one card, three equal cells ---------- */

.stats-strip
{
    flex-direction: row;
    align-items: stretch;
    border-radius: 32px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

.stat-cell
{
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 22px 8px;
}

.stat-cell-border
{
    border-left-width: 1px;
    border-left-color: var(--line);
}

.stat-cell-value
{
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--ink);
    letter-spacing: -0.5px;
}

.stat-cell-value-accent { color: var(--accent); }

.stat-cell-label
{
    font-size: 22px;
    color: var(--ink-3);
    margin-top: 2px;
    white-space: nowrap;
}

.compact .stat-cell { padding: 16px 6px; }
.compact .stat-cell-value { font-size: 36px; }
.compact .stat-cell-label { font-size: 19px; }

/* ---------- Hamburger button ---------- */

.anatomia-theme.theme-admin-classroom .menu-button
{
    width: 88px;
    height: 88px;
    min-width: 88px;
    border-radius: 44px;
    margin: 0 0 0 20px;
    padding: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    background-color: var(--accent-soft);
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.anatomia-theme.theme-admin-classroom .menu-button:hover { background-color: rgba(91, 76, 219, 0.2); }
.anatomia-theme.theme-admin-classroom .menu-button:active { background-color: var(--accent); }
.anatomia-theme.theme-admin-classroom .menu-button:active .menu-bar { background-color: white; }

.menu-bars
{
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    width: 38px;
    height: 32px;
}

.menu-bar { height: 5px; border-radius: 3px; background-color: var(--accent); }
.menu-bar-long { width: 38px; }
.menu-bar-short { width: 24px; margin: 7px 0; }

.close-icon
{
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/UI/Icons/close-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink-2);
}

/* ---------- Section bar ---------- */

.section-bar
{
    flex-shrink: 0;
    flex-direction: column;
    padding: 8px 40px 16px 40px;
}

.section-bar-title
{
    font-size: 54px;
    -unity-font-style: bold;
    color: var(--ink);
    letter-spacing: -0.8px;
}

.section-bar-hint
{
    font-size: 24px;
    color: var(--ink-3);
    margin-top: 2px;
}

/* ---------- Drawer ---------- */

.drawer-scrim
{
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(22, 24, 38, 0.5);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.drawer-scrim-on { opacity: 1; }

.drawer-panel
{
    position: absolute;
    top: 0; bottom: 0; right: 0;
    width: 84%;
    max-width: 760px;
    padding: 88px 28px 36px 28px;
    background-color: rgb(250, 250, 253);
    border-top-left-radius: 52px;
    border-bottom-left-radius: 52px;
    flex-direction: column;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-cubic;
}

.drawer-closed { translate: 105% 0; }

.drawer-profile
{
    flex-direction: row;
    align-items: center;
    padding: 24px 20px 24px 24px;
    margin-bottom: 8px;
    border-radius: 36px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    flex-shrink: 0;
}

.drawer-profile-tile
{
    width: 96px;
    height: 96px;
    border-radius: 30px;
    background-color: var(--accent);
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.drawer-profile-icon
{
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/UI/Icons/classroom-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.drawer-profile-text { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }

.drawer-classroom-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.drawer-instructor-label
{
    font-size: 24px;
    color: var(--ink-3);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.anatomia-theme.theme-admin-classroom .drawer-close-button
{
    width: 72px;
    height: 72px;
    min-width: 72px;
    margin: 0 0 0 12px;
    padding: 0;
    border-width: 0;
    border-radius: 36px;
    background-color: var(--sunken);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.anatomia-theme.theme-admin-classroom .drawer-close-button:hover { background-color: var(--track); }
.anatomia-theme.theme-admin-classroom .drawer-close-button:active { background-color: var(--line-strong); }

.drawer-scroll { flex-grow: 1; flex-shrink: 1; padding: 0 4px; }

.drawer-group-caption
{
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ink-3);
    letter-spacing: 3px;
    margin: 28px 0 12px 20px;
}

.anatomia-theme.theme-admin-classroom .drawer-item
{
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 108px;
    margin: 0 0 6px 0;
    padding: 0 20px 0 14px;
    border-width: 0;
    border-radius: 34px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.anatomia-theme.theme-admin-classroom .drawer-item:hover { background-color: var(--sunken); }
.anatomia-theme.theme-admin-classroom .drawer-item:active { background-color: var(--accent-soft); }

.drawer-item-tile
{
    width: 76px;
    height: 76px;
    border-radius: 24px;
    background-color: var(--sunken);
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.drawer-item-icon
{
    width: 38px;
    height: 38px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink-2);
}

.drawer-item-label { font-size: 33px; -unity-font-style: bold; color: var(--ink); white-space: nowrap; }

.anatomia-theme.theme-admin-classroom .drawer-item.tab-button-active,
.anatomia-theme.theme-admin-classroom .drawer-item.tab-button-active:hover
{
    background-color: var(--accent-soft);
    border-width: 0;
}

.anatomia-theme.theme-admin-classroom .drawer-item.tab-button-active .drawer-item-tile { background-color: var(--accent); }
.anatomia-theme.theme-admin-classroom .drawer-item.tab-button-active .drawer-item-icon { -unity-background-image-tint-color: white; }
.anatomia-theme.theme-admin-classroom .drawer-item.tab-button-active .drawer-item-label { color: var(--accent); }

/* Footer actions */
.drawer-footer { flex-shrink: 0; flex-direction: column; }

.anatomia-theme.theme-admin-classroom .drawer-footer-button
{
    flex-shrink: 0;
    height: 96px;
    margin: 12px 4px 0 4px;
    border-width: 0;
    border-radius: 34px;
    background-color: var(--sunken);
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--ink);
}

.anatomia-theme.theme-admin-classroom .drawer-footer-button:hover { background-color: var(--track); }

/* Lock / Unlock classroom: warning tone, sits above "Back" */
.anatomia-theme.theme-admin-classroom .archive-button
{
    flex-shrink: 0;
    height: 96px;
    margin: 12px 4px 0 4px;
    padding: 0 30px;
    border-width: 0;
    border-radius: 34px;
    background-color: var(--danger-soft);
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--danger);
}

.anatomia-theme.theme-admin-classroom .archive-button:hover { background-color: rgba(204, 64, 64, 0.16); }

/* ---------- Tab content ---------- */

.tab-panel { flex-direction: column; }

.hidden { display: none; }

.section-title-first { margin-top: 8px; }

/* ---------- Body components (rows, forms, dialogs) - recoloured to theme tokens ---------- */

/* =========================================================
   Anatomia 3D - Admin Classroom Detail (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient support, so the header
   gradient is generated at runtime from
   AdminClassroomDetailController.ApplyHeaderGradient(). The
   colors below are flat fallbacks.
   ========================================================= */

/* ---------- Screen ---------- */

/* ---------- Header ---------- */

/* ---------- Archive Confirmation Dialog ---------- */

.dialog-overlay
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 20, 28, 0.55);
    justify-content: center;
    align-items: center;
    padding: 60px;
}

.dialog-card
{
    width: 100%;
    max-width: 780px;
    background-color: white;
    border-radius: 37px;
    padding: 47px;
}

.dialog-title
{
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
    margin-bottom: 18px;
}

.dialog-message
{
    font-size: 29px;
    color: var(--ink-2);
    white-space: normal;
    margin-bottom: 42px;
}

.dialog-button-row
{
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-button
{
    height: 96px;
    padding-left: 40px;
    padding-right: 40px;
    margin-left: 20px;
    border-radius: 24px;
    border-width: 0;
    font-size: 30px;
    -unity-font-style: bold;
}

.dialog-button-secondary
{
    background-color: var(--sunken);
    color: var(--ink-2);
}

.dialog-button-secondary:hover
{
    background-color: var(--track);
}

.dialog-button-danger
{
    background-color: var(--danger);
    color: white;
}

.dialog-button-danger:hover
{
    background-color: var(--danger);
}

.dialog-button-primary
{
    background-color: var(--accent);
    color: white;
}

.dialog-button-primary:hover
{
    background-color: var(--accent-strong);
}

/* ---------- Edit classroom dialog ---------- */

.edit-field-label
{
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--ink-2);
    margin: 22px 0 8px 4px;
}

.edit-field-hint
{
    font-size: 24px;
    color: var(--ink-3);
    white-space: normal;
    margin: 12px 4px 0 4px;
}

.edit-dialog-error
{
    font-size: 26px;
    color: var(--danger);
    white-space: normal;
    margin: 16px 4px 0 4px;
}

.edit-dialog-button-row
{
    margin-top: 36px;
}

/* ---------- Classroom Code Box ---------- */

.copy-code-icon
{
    width: 39px;
    height: 39px;
    background-image: url("project://database/Assets/UI/Icons/copy-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    position: relative;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Stat Row ---------- */

/* ---------- Tab Switcher ---------- */

/* ---------- Tab Panels / Cards ---------- */

.panel-card-subtitle-tight
{
    margin-bottom: 0;
}

/* ---------- Students: Empty State ---------- */

.empty-state
{
    align-items: center;
    padding-top: 66px;
    padding-bottom: 66px;
}

.empty-icon
{
    width: 85px;
    height: 85px;
    margin-bottom: 26px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.icon-users-gray
{
    background-image: url("project://database/Assets/UI/Icons/users-icon.png");
    -unity-background-image-tint-color: var(--ink-4);
}

.icon-announce-gray
{
    background-image: url("project://database/Assets/UI/Icons/announce-icon.png");
    -unity-background-image-tint-color: var(--ink-4);
}

.empty-title
{
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 12px;
}

.empty-subtitle
{
    font-size: 32px;
    color: var(--ink-3);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 39px;
    max-width: 688px;
}

.copy-classroom-code-button
{
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 112px;
    padding-left: 39px;
    padding-right: 39px;
    background-color: white;
    border-width: 2px;
    border-color: var(--line-strong);
    border-radius: 26px;
}

.copy-classroom-code-button:hover
{
    background-color: rgb(248, 248, 250);
}

.copy-classroom-code-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-left: 18px;
}

/* ---------- Students: List (populated state, rows built in C#) ---------- */

.students-list-card
{
    padding: 26px;
}

.students-list
{
    flex-direction: column;
}

.student-row
{
    flex-direction: row;
    align-items: center;
    padding: 20px 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.student-row-last
{
    border-bottom-width: 0;
}

.student-avatar
{
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background-color: var(--accent-soft);
    justify-content: center;
    align-items: center;
    margin-right: 26px;
    flex-shrink: 0;
}

.student-avatar-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--accent);
}

.student-info
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.student-name-label
{
    font-size: 33px;
    -unity-font-style: bold;
    color: var(--ink);
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.student-meta-label
{
    font-size: 26px;
    color: var(--ink-3);
    margin-top: 6px;
}

.student-points-label
{
    font-size: 33px;
    -unity-font-style: bold;
    color: var(--accent);
    flex-shrink: 0;
}

.student-remove-button
{
    flex-shrink: 0;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0 0 0 26px;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--danger);
}

.student-remove-button:hover
{
    color: var(--danger);
}

/* ---------- Quizzes: List (populated state, rows built in C#) ---------- */

.quizzes-list
{
    flex-direction: column;
}

.quiz-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.quiz-row-last
{
    border-bottom-width: 0;
    padding-bottom: 6px;
}

.quiz-row-text
{
    flex-direction: column;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 26px;
}

.quiz-row-title
{
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
}

.quiz-row-subject
{
    font-size: 28px;
    color: var(--ink-3);
    margin-top: 6px;
}

/* ---------- Toggle Switch (reusable) ---------- */

.toggle-switch
{
    width: 126px;
    height: 71px;
    border-radius: 36px;
    background-color: var(--track);
    border-width: 0;
    padding: 0;
    flex-shrink: 0;
    justify-content: center;
}

.toggle-switch:hover
{
    opacity: 0.9;
}

.toggle-on
{
    background-color: var(--accent);
}

.toggle-knob
{
    width: 59px;
    height: 59px;
    border-radius: 29px;
    background-color: white;
    margin-left: 7px;
    transition-property: margin-left;
    transition-duration: 0.15s;
}

.toggle-on .toggle-knob
{
    margin-left: 62px;
}

/* ---------- Analytics: Performance Overview ---------- */

.overview-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.overview-row-last
{
    border-bottom-width: 0;
    padding-bottom: 0;
}

.overview-label
{
    font-size: 32px;
    color: var(--ink-2);
}

.overview-value
{
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--ink);
}

/* ---------- Analytics: Top Performers ---------- */

.top-performers-header-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
}

.top-performers-text-block
{
    flex-direction: column;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 21px;
}

.show-to-students-toggle-block
{
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.show-to-students-label
{
    font-size: 24px;
    color: var(--ink-3);
    margin-top: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 185px;
}

.top-performers-empty-state
{
    align-items: center;
    padding-top: 36px;
    padding-bottom: 36px;
}

.top-performers-empty-text
{
    font-size: 38px;
    color: var(--ink-3);
}

.top-performers-list
{
    flex-direction: column;
    margin-bottom: 14px;
}

.performer-row
{
    flex-direction: row;
    align-items: center;
    padding: 18px 14px;
    border-radius: 24px;
    margin-bottom: 14px;
    background-color: var(--sunken);
}

.performer-row-gold
{
    background-color: rgb(254, 249, 224);
}

.performer-row-silver
{
    background-color: var(--sunken);
}

.performer-row-bronze
{
    background-color: rgb(253, 237, 220);
}

.performer-rank-badge
{
    width: 66px;
    height: 66px;
    border-radius: 34px;
    background-color: rgb(210, 213, 222);
    justify-content: center;
    align-items: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.performer-rank-badge-gold
{
    background-color: rgb(234, 179, 8);
}

.performer-rank-badge-silver
{
    background-color: rgb(148, 163, 184);
}

.performer-rank-badge-bronze
{
    background-color: rgb(180, 111, 51);
}

.performer-rank-label
{
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
}

.performer-avatar
{
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: var(--accent-soft);
    justify-content: center;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.performer-avatar-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--accent);
}

.performer-name-label
{
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--ink);
    flex-grow: 1;
}

.performer-points-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--accent);
    flex-shrink: 0;
}

/* ---------- Announcements ---------- */

.announcement-field-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--ink-2);
    margin-bottom: 14px;
}

.announcement-field-label-spaced
{
    margin-top: 32px;
}

.announcement-input
{
    background-color: var(--sunken);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 21px;
    font-size: 32px;
    color: var(--ink);
}

/* Unity's built-in TextField draws its own inner input element - flatten it
   so the field reads as one seamless box matching the app's card style. */
.announcement-input > .unity-text-field__input,
.announcement-input > .unity-base-text-field__input
{
    background-color: transparent;
    border-width: 0;
    padding: 14px 16px;
    font-size: 32px;
    color: var(--ink);
}

.announcement-textarea
{
    min-height: 238px;
}

.announcement-textarea > .unity-text-field__input,
.announcement-textarea > .unity-base-text-field__input
{
    min-height: 238px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.post-announcement-button
{
    align-self: flex-end;
    height: 112px;
    padding-left: 45px;
    padding-right: 45px;
    margin-top: 39px;
    background-color: var(--accent);
    border-width: 0;
    border-radius: 24px;
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
}

.post-announcement-button:hover
{
    background-color: var(--accent-strong);
}

.announcements-section-title
{
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: 24px;
}

.announcements-list
{
    flex-direction: column;
}

.announcement-card
{
    background-color: white;
    border-radius: 28px;
    padding: 37px;
    margin-bottom: 24px;
    border-width: 1px;
    border-color: var(--line);
}

.announcement-header-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.announcement-title-label
{
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--ink);
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    margin-right: 16px;
}

.announcement-date-label
{
    font-size: 28px;
    color: var(--ink-3);
    flex-shrink: 0;
}

.announcement-body-label
{
    font-size: 36px;
    color: var(--ink-2);
    white-space: normal;
    margin-bottom: 18px;
}

.announcement-delete-button
{
    align-self: flex-end;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--danger);
}

.announcement-delete-button:hover
{
    color: var(--danger);
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .dialog-card
{
    padding: 34px;
}

.compact .empty-title
{
    font-size: 26px;
}

.compact .empty-subtitle
{
    font-size: 22px;
}

.compact .announcement-field-label
{
    font-size: 24px;
}

.compact .announcement-input > .unity-text-field__input,
.compact .announcement-input > .unity-base-text-field__input
{
    font-size: 25px;
    padding: 10px 12px;
}

.compact .announcement-textarea,
.compact .announcement-textarea > .unity-text-field__input,
.compact .announcement-textarea > .unity-base-text-field__input
{
    min-height: 172px;
}

.compact .post-announcement-button
{
    height: 85px;
    font-size: 26px;
    padding-left: 34px;
    padding-right: 34px;
}

.compact .announcements-section-title
{
    font-size: 28px;
}

.compact .announcement-title-label
{
    font-size: 28px;
}

.compact .announcement-body-label
{
    font-size: 24px;
}

.compact .student-remove-button
{
    font-size: 22px;
    margin-left: 16px;
}

/* =========================================================
   Materials tab (teacher uploads)
   ========================================================= */

.material-description-input
{
    min-height: 170px;
}

.material-choose-button
{
    height: 104px;
    margin-top: 32px;
    background-color: rgb(240, 253, 244);
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 24px;
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--accent-strong);
}

.material-choose-button:hover
{
    background-color: rgb(220, 252, 231);
}

.material-selected-file
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
    padding: 24px;
    background-color: var(--sunken);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 21px;
}

.material-selected-file-text
{
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 20px;
}

.material-file-name
{
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
}

.material-file-meta
{
    font-size: 26px;
    color: var(--ink-3);
    margin-top: 4px;
    white-space: normal;
}

.material-hint
{
    font-size: 24px;
    color: var(--ink-3);
    margin-top: 18px;
    white-space: normal;
}

.material-status-label
{
    font-size: 28px;
    margin-top: 20px;
    white-space: normal;
    color: var(--ink-2);
}

.material-status-error
{
    color: var(--danger);
}

.material-status-success
{
    color: var(--accent-strong);
}

.material-card-actions
{
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 22px;
}

.material-open-button
{
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0 40px 0 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--accent-strong);
    height: 96px;
}

.material-open-button:hover
{
    color: rgb(21, 128, 61);
}

.material-card-delete
{
    align-self: auto;
}


/* =========================================================
   TAB CONTENT REDESIGN - Analytics / Quizzes / Announcements / Materials
   Mirrors the student classroom detail: section titles, left-accent cards,
   tonal pills, icon tiles, and rank-tinted leaderboard rows.
   Scoped under .anatomia-theme.theme-admin-classroom so it out-ranks the rules above and the shared theme.
   ========================================================= */

/* ---- shared ---- */

.anatomia-theme.theme-admin-classroom .section-title { font-size: 34px; -unity-font-style: bold; color: var(--ink); margin: 8px 0 18px 4px; }
.anatomia-theme.theme-admin-classroom .section-title-first { margin-top: 12px; }
.anatomia-theme.theme-admin-classroom .section-subtitle { font-size: 26px; color: var(--ink-3); margin: -10px 0 22px 4px; white-space: normal; }
.section-block { flex-direction: column; }

.anatomia-theme.theme-admin-classroom .panel-card { padding: 36px; border-radius: 32px; margin-bottom: 24px; }
.anatomia-theme.theme-admin-classroom .panel-card-title { font-size: 36px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-admin-classroom .panel-card-subtitle { font-size: 26px; color: var(--ink-3); margin-top: 4px; margin-bottom: 12px; white-space: normal; }
.anatomia-theme.theme-admin-classroom .panel-card-subtitle-tight { margin-bottom: 0; }

.anatomia-theme.theme-admin-classroom .empty-state { padding: 56px 40px; align-items: center; }
.anatomia-theme.theme-admin-classroom .empty-icon { width: 72px; height: 72px; margin-bottom: 20px; -unity-background-image-tint-color: var(--ink-4); }
.anatomia-theme.theme-admin-classroom .empty-title { font-size: 34px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-admin-classroom .empty-subtitle { font-size: 28px; max-width: 560px; color: var(--ink-3); white-space: normal; -unity-text-align: middle-center; margin-top: 8px; }

/* ---- icon tiles (used by compose cards, metric tiles, trophy) ---- */

.compose-header { flex-direction: row; align-items: center; margin-bottom: 28px; }
.compose-text { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }

.compose-icon-box,
.trophy-icon-box,
.metric-icon-box
{
    width: 84px;
    height: 84px;
    min-width: 84px;
    border-radius: 26px;
    background-color: var(--accent-soft);
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.compose-icon,
.trophy-icon,
.metric-icon
{
    width: 40px;
    height: 40px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.icon-compose-announce { background-image: url("project://database/Assets/UI/Icons/bell-icon.png"); }
.icon-compose-material { background-image: url("project://database/Assets/UI/Icons/open-book.png"); }
.trophy-icon { background-image: url("project://database/Assets/UI/Icons/trophy-icon.png"); }
.icon-metric-points { background-image: url("project://database/Assets/UI/Icons/total-points-icon.png"); }
.icon-metric-quizzes { background-image: url("project://database/Assets/UI/Icons/check-icon.png"); }
.icon-metric-score { background-image: url("project://database/Assets/UI/Icons/progress-icon.png"); }
.icon-metric-students { background-image: url("project://database/Assets/UI/Icons/student-icon.png"); }

/* ---- forms ---- */

.anatomia-theme.theme-admin-classroom .announcement-field-label { font-size: 26px; -unity-font-style: bold; color: var(--ink-2); margin-bottom: 10px; }
.anatomia-theme.theme-admin-classroom .announcement-field-label-spaced { margin-top: 24px; }

.anatomia-theme.theme-admin-classroom .announcement-input > .unity-text-field__input,
.anatomia-theme.theme-admin-classroom .announcement-input > .unity-base-text-field__input
{
    min-height: 92px;
    padding: 0 28px;
    font-size: 30px;
    color: var(--ink);
    background-color: var(--sunken);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 26px;
}

.anatomia-theme.theme-admin-classroom .announcement-input:focus > .unity-text-field__input,
.anatomia-theme.theme-admin-classroom .announcement-input:focus > .unity-base-text-field__input
{
    border-color: var(--accent);
    background-color: var(--surface-solid);
}

.anatomia-theme.theme-admin-classroom .announcement-textarea > .unity-text-field__input,
.anatomia-theme.theme-admin-classroom .announcement-textarea > .unity-base-text-field__input
{
    min-height: 200px;
    padding: 22px 28px;
    white-space: normal;
}

.anatomia-theme.theme-admin-classroom .material-description-input > .unity-text-field__input,
.anatomia-theme.theme-admin-classroom .material-description-input > .unity-base-text-field__input
{
    min-height: 150px;
    padding: 22px 28px;
    white-space: normal;
}

.anatomia-theme.theme-admin-classroom .post-announcement-button
{
    height: 100px;
    margin-top: 32px;
    border-width: 0;
    border-radius: 50px;
    background-color: var(--accent);
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

.anatomia-theme.theme-admin-classroom .post-announcement-button:hover { background-color: var(--accent-strong); }
.anatomia-theme.theme-admin-classroom .post-announcement-button:active { background-color: var(--accent-press); }

.anatomia-theme.theme-admin-classroom .material-choose-button
{
    height: 100px;
    margin-top: 32px;
    border-width: 2px;
    border-color: var(--accent-soft);
    border-radius: 50px;
    background-color: var(--accent-faint);
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--accent);
}

.anatomia-theme.theme-admin-classroom .material-choose-button:hover { background-color: var(--accent-soft); border-color: var(--accent); }

.anatomia-theme.theme-admin-classroom .material-selected-file
{
    margin-top: 20px;
    padding: 22px 24px;
    border-radius: 24px;
    background-color: var(--accent-faint);
    border-width: 1px;
    border-color: var(--accent-soft);
}

.anatomia-theme.theme-admin-classroom .material-file-name { font-size: 28px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-admin-classroom .material-file-meta { font-size: 24px; color: var(--ink-3); margin-top: 4px; white-space: normal; }
.anatomia-theme.theme-admin-classroom .material-hint { font-size: 24px; color: var(--ink-3); margin-top: 18px; white-space: normal; }
.anatomia-theme.theme-admin-classroom .material-status-label { font-size: 26px; margin-top: 14px; white-space: normal; }
.anatomia-theme.theme-admin-classroom .material-status-error { color: var(--danger); }
.anatomia-theme.theme-admin-classroom .material-status-success { color: var(--success); }

/* Quiet destructive text-button -> tonal red pill */
.anatomia-theme.theme-admin-classroom .announcement-delete-button
{
    flex-shrink: 0;
    height: 64px;
    margin: 0;
    padding: 0 28px;
    border-width: 0;
    border-radius: 32px;
    background-color: var(--danger-soft);
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--danger);
}

.anatomia-theme.theme-admin-classroom .announcement-delete-button:hover { background-color: rgba(204, 64, 64, 0.18); }

/* ---- toggle (accent when on) ---- */

.anatomia-theme.theme-admin-classroom .toggle-switch { background-color: var(--track); }
.anatomia-theme.theme-admin-classroom .toggle-on { background-color: var(--accent); }

/* ---- QUIZZES: left-accent card = tag + status pill / title / actions ---- */

.anatomia-theme.theme-admin-classroom .quizzes-list { flex-direction: column; }

.anatomia-theme.theme-admin-classroom .quiz-card
{
    flex-direction: column;
    padding: 34px 34px 30px 38px;
    border-radius: 30px;
    margin-bottom: 20px;
    border-left-width: 8px;
    border-left-color: var(--accent);
}

.anatomia-theme.theme-admin-classroom .quiz-card-off { border-left-color: var(--ink-4); }

.anatomia-theme.theme-admin-classroom .quiz-card-header-row { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 14px; }

.anatomia-theme.theme-admin-classroom .quiz-subject-tag
{
    flex-shrink: 1;
    min-width: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--accent);
    letter-spacing: 1.2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.anatomia-theme.theme-admin-classroom .quiz-card-off .quiz-subject-tag { color: var(--ink-3); }

.anatomia-theme.theme-admin-classroom .quiz-status-pill
{
    flex-shrink: 0;
    margin-left: 16px;
    padding: 8px 20px;
    border-radius: 100px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--success);
    background-color: var(--success-soft);
}

.anatomia-theme.theme-admin-classroom .quiz-status-pill-off { color: var(--ink-3); background-color: var(--sunken); }

.anatomia-theme.theme-admin-classroom .quiz-card-title { font-size: 38px; -unity-font-style: bold; color: var(--ink); white-space: normal; margin-bottom: 4px; }

.anatomia-theme.theme-admin-classroom .quiz-card-bottom-row
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 22px;
    padding-top: 24px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.anatomia-theme.theme-admin-classroom .quiz-card-bottom-text { font-size: 26px; color: var(--ink-3); flex-shrink: 1; margin-right: 16px; }
.quiz-card-actions { flex-direction: row; align-items: center; flex-shrink: 0; }

.anatomia-theme.theme-admin-classroom .quiz-retake-button
{
    flex-shrink: 0;
    height: 72px;
    margin: 0 24px 0 0;
    padding: 0 30px;
    border-width: 0;
    border-radius: 36px;
    background-color: var(--accent-soft);
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--accent);
}

.anatomia-theme.theme-admin-classroom .quiz-retake-button:hover { background-color: var(--accent); color: white; }

/* ---- ANALYTICS: metric tiles ---- */

.metric-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 4px; }

.anatomia-theme.theme-admin-classroom .metric-tile
{
    width: 48.5%;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px;
    margin-bottom: 20px;
    border-radius: 30px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

.anatomia-theme.theme-admin-classroom .metric-icon-box { width: 72px; height: 72px; min-width: 72px; border-radius: 22px; margin: 0 0 22px 0; }
.anatomia-theme.theme-admin-classroom .metric-icon { width: 34px; height: 34px; }
.anatomia-theme.theme-admin-classroom .metric-value { font-size: 54px; -unity-font-style: bold; color: var(--ink); letter-spacing: -0.8px; }
.anatomia-theme.theme-admin-classroom .metric-label { font-size: 24px; color: var(--ink-3); margin-top: 2px; white-space: normal; }

/* leaderboard header + "show to students" setting row */

.anatomia-theme.theme-admin-classroom .top-performers-header-row { flex-direction: row; align-items: center; justify-content: flex-start; margin-bottom: 24px; }
.anatomia-theme.theme-admin-classroom .top-performers-text-block { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 0; }

.setting-row
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 22px 26px;
    margin-bottom: 24px;
    border-radius: 26px;
    background-color: var(--sunken);
}

.setting-text { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 20px; }
.setting-title { font-size: 30px; -unity-font-style: bold; color: var(--ink); }
.setting-hint { font-size: 23px; color: var(--ink-3); margin-top: 2px; white-space: normal; }

.anatomia-theme.theme-admin-classroom .top-performers-empty-state { align-items: center; padding: 28px 0; }
.anatomia-theme.theme-admin-classroom .top-performers-empty-text { font-size: 28px; color: var(--ink-3); }
.anatomia-theme.theme-admin-classroom .top-performers-list { flex-direction: column; }

.anatomia-theme.theme-admin-classroom .performer-row
{
    flex-direction: row;
    align-items: center;
    padding: 22px 26px 22px 18px;
    margin-bottom: 12px;
    border-radius: 28px;
    background-color: var(--sunken);
}

.anatomia-theme.theme-admin-classroom .performer-row-gold { background-color: rgb(254, 247, 214); }
.anatomia-theme.theme-admin-classroom .performer-row-silver { background-color: rgb(238, 241, 246); }
.anatomia-theme.theme-admin-classroom .performer-row-bronze { background-color: rgb(252, 238, 224); }

.anatomia-theme.theme-admin-classroom .performer-rank-badge
{
    width: 60px;
    height: 60px;
    border-radius: 30px;
    margin-right: 14px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
}

.anatomia-theme.theme-admin-classroom .performer-rank-badge-gold { background-color: rgb(234, 179, 8); }
.anatomia-theme.theme-admin-classroom .performer-rank-badge-silver { background-color: rgb(148, 163, 184); }
.anatomia-theme.theme-admin-classroom .performer-rank-badge-bronze { background-color: rgb(205, 127, 50); }

.anatomia-theme.theme-admin-classroom .performer-rank-label { font-size: 30px; -unity-font-style: bold; color: var(--ink-3); }
.anatomia-theme.theme-admin-classroom .performer-rank-badge-gold .performer-rank-label,
.anatomia-theme.theme-admin-classroom .performer-rank-badge-silver .performer-rank-label,
.anatomia-theme.theme-admin-classroom .performer-rank-badge-bronze .performer-rank-label { color: white; }

.anatomia-theme.theme-admin-classroom .performer-avatar
{
    width: 80px;
    height: 80px;
    border-radius: 40px;
    margin-right: 22px;
    background-color: var(--surface-solid);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.anatomia-theme.theme-admin-classroom .performer-avatar-label { font-size: 28px; -unity-font-style: bold; color: var(--accent); }
.anatomia-theme.theme-admin-classroom .performer-name-label { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 34px; -unity-font-style: bold; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.anatomia-theme.theme-admin-classroom .performer-points-label { flex-shrink: 0; margin-left: 16px; font-size: 34px; -unity-font-style: bold; color: var(--accent); }
.anatomia-theme.theme-admin-classroom .performer-row-gold .performer-points-label { color: rgb(161, 98, 7); }
.anatomia-theme.theme-admin-classroom .performer-row-silver .performer-points-label { color: rgb(75, 85, 99); }
.anatomia-theme.theme-admin-classroom .performer-row-bronze .performer-points-label { color: rgb(194, 65, 12); }

/* ---- ANNOUNCEMENTS: left-accent card, date pill, delete ---- */

.anatomia-theme.theme-admin-classroom .announcements-list { flex-direction: column; }

.anatomia-theme.theme-admin-classroom .announcement-card
{
    flex-direction: column;
    padding: 32px 32px 28px 36px;
    border-radius: 28px;
    margin-bottom: 18px;
    border-left-width: 8px;
    border-left-color: var(--accent);
}

.anatomia-theme.theme-admin-classroom .announcement-header-row { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.anatomia-theme.theme-admin-classroom .announcement-title-label { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 34px; -unity-font-style: bold; color: var(--ink); white-space: normal; }

.anatomia-theme.theme-admin-classroom .announcement-date-label
{
    flex-shrink: 0;
    margin-left: 16px;
    padding: 6px 18px;
    border-radius: 100px;
    font-size: 22px;
    color: var(--ink-3);
    background-color: var(--sunken);
}

.anatomia-theme.theme-admin-classroom .announcement-body-label { font-size: 30px; color: var(--ink-2); white-space: normal; }

.anatomia-theme.theme-admin-classroom .announcement-card .announcement-delete-button
{
    align-self: flex-end;
    margin-top: 22px;
}

/* ---- MATERIALS: type badge | title + meta | Open ---- */

.anatomia-theme.theme-admin-classroom .materials-list { flex-direction: column; }

.anatomia-theme.theme-admin-classroom .material-card
{
    flex-direction: column;
    padding: 32px;
    border-radius: 30px;
    margin-bottom: 18px;
}

.anatomia-theme.theme-admin-classroom .material-card-header-row { flex-direction: row; align-items: center; }

.anatomia-theme.theme-admin-classroom .material-type-badge
{
    width: 92px;
    min-width: 92px;
    height: 92px;
    margin-right: 24px;
    border-radius: 26px;
    background-color: var(--accent-soft);
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.anatomia-theme.theme-admin-classroom .material-card-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-admin-classroom .material-title-label { font-size: 34px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-admin-classroom .material-meta-label { font-size: 24px; color: var(--ink-3); margin-top: 4px; white-space: normal; }

.anatomia-theme.theme-admin-classroom .material-description-label
{
    font-size: 28px;
    color: var(--ink-2);
    margin-top: 24px;
    padding-top: 22px;
    border-top-width: 1px;
    border-top-color: var(--line);
    white-space: normal;
}

.anatomia-theme.theme-admin-classroom .material-card-actions { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 20px; }

.anatomia-theme.theme-admin-classroom .material-open-button
{
    height: 72px;
    min-width: 132px;
    margin: 0;
    padding: 0 34px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 36px;
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 28px;
    -unity-font-style: bold;
}

.anatomia-theme.theme-admin-classroom .material-open-button:hover { background-color: var(--accent); color: white; }
.anatomia-theme.theme-admin-classroom .material-open-button:active { background-color: var(--accent-strong); color: white; }

.anatomia-theme.theme-admin-classroom .material-card .material-card-delete { align-self: flex-end; margin-top: 22px; }

/* ---- compact ---- */

.compact .metric-value { font-size: 44px; }
.compact .metric-tile { padding: 24px; }
.compact .quiz-card-title { font-size: 32px; }
.compact .material-title-label,
.compact .announcement-title-label { font-size: 30px; }
.compact .material-type-badge { width: 72px; min-width: 72px; height: 72px; font-size: 20px; }

/* Icons for the Allow Retake modal (built in AdminRetakeExamModal.cs). Size and tint are set from code. */
.rt-icon
{
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.rt-icon-close { background-image: url("project://database/Assets/UI/Icons/close-icon.png"); }
.rt-icon-reset { background-image: url("project://database/Assets/UI/Icons/reset-icon.png"); }
.rt-icon-check { background-image: url("project://database/Assets/UI/Icons/check-icon.png"); }
.rt-icon-attempt { background-image: url("project://database/Assets/UI/Icons/attempt-icon.png"); }
.rt-icon-deadline { background-image: url("project://database/Assets/UI/Icons/deadline-icon.png"); }


/* ---------- Overview tab ---------- */

.overview-info-card { padding-top: 12px; padding-bottom: 12px; }

.overview-info-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.overview-info-row-last { border-bottom-width: 0; }

.overview-info-label { font-size: 30px; color: var(--ink-3); flex-shrink: 0; margin-right: 24px; }

.overview-info-value
{
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--ink);
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-right;
}

.overview-status-pill
{
    padding: 8px 26px;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 28px;
    -unity-font-style: bold;
}

.overview-status-pill-locked
{
    background-color: var(--danger-soft);
    color: var(--danger);
}

.overview-section-header
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.overview-section-title { flex-grow: 1; flex-shrink: 1; }

.overview-see-all-button
{
    background-color: transparent;
    border-width: 0;
    padding: 8px 0 8px 16px;
    margin: 0 0 8px 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--accent);
}

.overview-empty-card { align-items: center; padding-top: 40px; padding-bottom: 40px; }

.overview-material-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.overview-material-row-last { border-bottom-width: 0; }
.overview-material-text { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 20px; }
.overview-material-title { font-size: 34px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.overview-material-meta { font-size: 26px; color: var(--ink-3); margin-top: 4px; }
