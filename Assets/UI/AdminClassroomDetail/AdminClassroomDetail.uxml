<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminClassroomDetail/AdminClassroomDetail.uss?fileID=7433441132597879392&amp;guid=0dd03073bf038894296fcb6901a75053&amp;type=3#AdminClassroomDetail"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss?fileID=7433441132597879392&amp;guid=f3df4a0ff9d42424986b13ce625d35c9&amp;type=3#AnatomiaTheme"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme theme-admin-classroom screen-root">
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement name="header-top-row" class="header-top-row">
                <ui:Button name="back-button" class="back-button">
                    <ui:VisualElement class="back-icon"/>
                </ui:Button>
                <ui:VisualElement name="header-title-block" class="header-title-block">
                    <ui:Label name="classroom-name-label" text="Anatomi" class="header-title"/>
                    <ui:Label text="Teacher view" class="header-subtitle"/>
                    <ui:Label name="archived-badge-label" text="Locked" class="archived-badge hidden"/>
                </ui:VisualElement>
                <ui:Button name="menu-button" class="menu-button">
                    <ui:VisualElement picking-mode="Ignore" class="menu-bars">
                        <ui:VisualElement picking-mode="Ignore" class="menu-bar menu-bar-long"/>
                        <ui:VisualElement picking-mode="Ignore" class="menu-bar menu-bar-short"/>
                        <ui:VisualElement picking-mode="Ignore" class="menu-bar menu-bar-long"/>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="classroom-code-box" class="code-chip">
                <ui:VisualElement class="code-chip-text">
                    <ui:Label text="Class code" class="code-chip-caption"/>
                    <ui:Label name="classroom-code-label" text="YG7XYYHJ" class="code-chip-value"/>
                </ui:VisualElement>
                <ui:Button name="copy-code-button" class="copy-code-icon-button" style="background-color: rgb(255, 255, 255);">
                    <ui:VisualElement picking-mode="Ignore" class="copy-code-icon"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="header-stats-row" class="stats-strip">
                <ui:VisualElement class="stat-cell">
                    <ui:Label name="students-value-label" text="0" class="stat-cell-value"/>
                    <ui:Label text="Students" class="stat-cell-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-cell stat-cell-border">
                    <ui:Label name="avg-score-value-label" text="0%" class="stat-cell-value stat-cell-value-accent"/>
                    <ui:Label text="Avg score" class="stat-cell-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-cell stat-cell-border">
                    <ui:Label name="quizzes-done-value-label" text="0" class="stat-cell-value"/>
                    <ui:Label text="Quizzes done" class="stat-cell-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="section-bar" class="section-bar">
            <ui:Label name="section-title-label" text="Overview" class="section-bar-title"/>
            <ui:Label text="Tap the menu to switch section" class="section-bar-hint"/>
        </ui:VisualElement>
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <ui:VisualElement name="content-wrapper" class="content-wrapper">
                <ui:VisualElement name="overview-panel" class="tab-panel">
                    <ui:Label text="Classroom Info" class="section-title section-title-first"/>
                    <ui:VisualElement name="overview-info-card" class="panel-card overview-info-card">
                        <ui:VisualElement class="overview-info-row">
                            <ui:Label text="Name" class="overview-info-label"/>
                            <ui:Label name="overview-name-value" text="-" class="overview-info-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="overview-info-row">
                            <ui:Label text="Section" class="overview-info-label"/>
                            <ui:Label name="overview-section-value" text="-" class="overview-info-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="overview-info-row">
                            <ui:Label text="Class code" class="overview-info-label"/>
                            <ui:Label name="overview-code-value" text="-" class="overview-info-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="overview-info-row">
                            <ui:Label text="Teacher" class="overview-info-label"/>
                            <ui:Label name="overview-teacher-value" text="-" class="overview-info-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="overview-info-row overview-info-row-last">
                            <ui:Label text="Status" class="overview-info-label"/>
                            <ui:Label name="overview-status-pill" text="Active" class="overview-status-pill" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="Quick Stats" class="section-title"/>
                    <ui:VisualElement name="overview-metric-grid" class="metric-grid">
                        <ui:VisualElement class="metric-tile">
                            <ui:VisualElement class="metric-icon-box">
                                <ui:VisualElement class="metric-icon icon-metric-quizzes"/>
                            </ui:VisualElement>
                            <ui:Label name="overview-quizzes-value" text="0" class="metric-value"/>
                            <ui:Label text="Quizzes published" class="metric-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-tile">
                            <ui:VisualElement class="metric-icon-box">
                                <ui:VisualElement class="metric-icon icon-metric-points"/>
                            </ui:VisualElement>
                            <ui:Label name="overview-points-value" text="0" class="metric-value"/>
                            <ui:Label text="Points earned" class="metric-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="overview-section-header">
                        <ui:Label text="Top Students" class="section-title overview-section-title"/>
                        <ui:Button name="overview-see-analytics-button" text="See all" class="overview-see-all-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-card">
                        <ui:VisualElement name="overview-top-empty" class="top-performers-empty-state">
                            <ui:Label text="No student data yet" class="top-performers-empty-text"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="overview-top-list" class="top-performers-list hidden"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="overview-section-header">
                        <ui:Label text="Latest Announcement" class="section-title overview-section-title"/>
                        <ui:Button name="overview-see-announcements-button" text="See all" class="overview-see-all-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="overview-announcement-empty" class="panel-card overview-empty-card">
                        <ui:Label text="No announcements yet" class="top-performers-empty-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="overview-announcement-host" class="hidden"/>
                    <ui:VisualElement class="overview-section-header">
                        <ui:Label text="Recent Materials" class="section-title overview-section-title"/>
                        <ui:Button name="overview-see-materials-button" text="See all" class="overview-see-all-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="overview-materials-empty" class="panel-card overview-empty-card">
                        <ui:Label text="No materials yet" class="top-performers-empty-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="overview-materials-host" class="panel-card hidden"/>
                </ui:VisualElement>
                <ui:VisualElement name="students-panel" class="tab-panel hidden">
                    <ui:VisualElement name="students-empty-state" class="panel-card empty-state">
                        <ui:VisualElement class="empty-icon icon-users-gray" style="background-image: url(&quot;project://database/Assets/UI/Icons/empty-icon.png?fileID=2800000&amp;guid=1868d052d7c3e484ea032e01e5091786&amp;type=3#empty-icon&quot;);"/>
                        <ui:Label text="No students yet" class="empty-title"/>
                        <ui:Label text="Share the classroom code with students to get started" class="empty-subtitle"/>
                        <ui:Button name="copy-classroom-code-button" class="copy-classroom-code-button">
                            <ui:VisualElement class="copy-code-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/copy-icon.png?fileID=2800000&amp;guid=efea9607a1058144f9b78865cdeecaca&amp;type=3#copy-icon&quot;);"/>
                            <ui:Label text="Copy Classroom Code" class="copy-classroom-code-label"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="students-list-card" class="panel-card students-list-card hidden">
                        <ui:VisualElement name="students-list" class="students-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="quizzes-panel" class="tab-panel hidden">
                    <ui:VisualElement name="quizzes-empty-state" class="panel-card empty-state hidden">
                        <ui:VisualElement class="empty-icon icon-gray" style="background-image: url(&quot;project://database/Assets/UI/Icons/empty-icon.png?fileID=2800000&amp;guid=1868d052d7c3e484ea032e01e5091786&amp;type=3#empty-icon&quot;);"/>
                        <ui:Label text="No quizzes yet" class="empty-title"/>
                        <ui:Label text="Create a quiz from the dashboard to publish it to this classroom" class="empty-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="quizzes-card" class="section-block hidden">
                        <ui:Label text="Your Quizzes" class="section-title section-title-first"/>
                        <ui:Label text="Switch a quiz on to make it available to this classroom." class="section-subtitle"/>
                        <ui:VisualElement name="quizzes-list" class="quizzes-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="analytics-panel" class="tab-panel hidden">
                    <ui:Label text="Class Performance" class="section-title section-title-first"/>
                    <ui:Label text="Class-wide statistics" class="section-subtitle"/>
                    <ui:VisualElement name="performance-overview-card" class="metric-grid">
                        <ui:VisualElement class="metric-tile">
                            <ui:VisualElement class="metric-icon-box">
                                <ui:VisualElement class="metric-icon icon-metric-points"/>
                            </ui:VisualElement>
                            <ui:Label name="total-points-value-label" text="0" class="metric-value"/>
                            <ui:Label text="Points earned" class="metric-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-tile">
                            <ui:VisualElement class="metric-icon-box">
                                <ui:VisualElement class="metric-icon icon-metric-quizzes"/>
                            </ui:VisualElement>
                            <ui:Label name="total-quizzes-value-label" text="0" class="metric-value"/>
                            <ui:Label text="Quizzes completed" class="metric-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-tile">
                            <ui:VisualElement class="metric-icon-box">
                                <ui:VisualElement class="metric-icon icon-metric-score"/>
                            </ui:VisualElement>
                            <ui:Label name="analytics-avg-score-value-label" text="0%" class="metric-value"/>
                            <ui:Label text="Average score" class="metric-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="metric-tile">
                            <ui:VisualElement class="metric-icon-box">
                                <ui:VisualElement class="metric-icon icon-metric-students"/>
                            </ui:VisualElement>
                            <ui:Label name="active-students-value-label" text="0" class="metric-value"/>
                            <ui:Label text="Active students" class="metric-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="top-performers-card" class="panel-card">
                        <ui:VisualElement class="top-performers-header-row">
                            <ui:VisualElement class="trophy-icon-box">
                                <ui:VisualElement class="trophy-icon"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="top-performers-text-block">
                                <ui:Label text="Leaderboard" class="panel-card-title"/>
                                <ui:Label text="Students ranked by points" class="panel-card-subtitle panel-card-subtitle-tight"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="setting-row">
                            <ui:VisualElement class="setting-text">
                                <ui:Label text="Show to students" class="setting-title"/>
                                <ui:Label text="Students can see the ranking in their Leaderboard tab." class="setting-hint"/>
                            </ui:VisualElement>
                            <ui:Button name="show-to-students-toggle" class="toggle-switch">
                                <ui:VisualElement class="toggle-knob"/>
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement name="top-performers-empty-state" class="top-performers-empty-state">
                            <ui:Label text="No student data yet" class="top-performers-empty-text"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="top-performers-list" class="top-performers-list hidden"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="announcements-panel" class="tab-panel hidden">
                    <ui:VisualElement name="announcement-compose-card" class="panel-card">
                        <ui:VisualElement class="compose-header">
                            <ui:VisualElement class="compose-icon-box">
                                <ui:VisualElement class="compose-icon icon-compose-announce"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="compose-text">
                                <ui:Label text="Post an Announcement" class="panel-card-title"/>
                                <ui:Label text="Share updates with everyone in this classroom." class="panel-card-subtitle panel-card-subtitle-tight"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Title" class="announcement-field-label"/>
                        <ui:TextField name="announcement-title-field" max-length="120" class="announcement-input"/>
                        <ui:Label text="Message" class="announcement-field-label announcement-field-label-spaced"/>
                        <ui:TextField name="announcement-body-field" multiline="true" max-length="2000" class="announcement-input announcement-textarea"/>
                        <ui:Button name="post-announcement-button" text="Post Announcement" class="post-announcement-button"/>
                    </ui:VisualElement>
                    <ui:Label text="Announcement History" class="section-title"/>
                    <ui:VisualElement name="announcements-empty-state" class="panel-card empty-state">
                        <ui:VisualElement class="empty-icon icon-gray" style="background-image: url(&quot;project://database/Assets/UI/Icons/empty-icon.png?fileID=2800000&amp;guid=1868d052d7c3e484ea032e01e5091786&amp;type=3#empty-icon&quot;);"/>
                        <ui:Label text="No announcements yet" class="empty-title"/>
                        <ui:Label text="Announcements you post will show up here, and on students&apos; Overview tab." class="empty-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="announcements-list" class="announcements-list hidden"/>
                </ui:VisualElement>
                <ui:VisualElement name="materials-panel" class="tab-panel hidden">
                    <ui:VisualElement name="material-compose-card" class="panel-card">
                        <ui:VisualElement class="compose-header">
                            <ui:VisualElement class="compose-icon-box">
                                <ui:VisualElement class="compose-icon icon-compose-material"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="compose-text">
                                <ui:Label text="Upload a Material" class="panel-card-title"/>
                                <ui:Label text="Share a module or lesson file with this classroom." class="panel-card-subtitle panel-card-subtitle-tight"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Title" class="announcement-field-label"/>
                        <ui:TextField name="material-title-field" max-length="120" class="announcement-input"/>
                        <ui:Label text="Description (optional)" class="announcement-field-label announcement-field-label-spaced"/>
                        <ui:TextField name="material-description-field" multiline="true" max-length="500" class="announcement-input material-description-input"/>
                        <ui:Button name="material-choose-file-button" text="Choose File" class="material-choose-button"/>
                        <ui:VisualElement name="material-selected-file-panel" class="material-selected-file hidden">
                            <ui:VisualElement class="material-selected-file-text">
                                <ui:Label name="material-selected-file-name" class="material-file-name"/>
                                <ui:Label name="material-selected-file-size" class="material-file-meta"/>
                            </ui:VisualElement>
                            <ui:Button name="material-clear-file-button" text="Remove" class="announcement-delete-button"/>
                        </ui:VisualElement>
                        <ui:Label text="PDF, Word, PowerPoint, Excel, TXT, CSV or image files up to 100 MB." class="material-hint"/>
                        <ui:Label name="material-status-label" class="material-status-label hidden"/>
                        <ui:Button name="upload-material-button" text="Upload Material" class="post-announcement-button"/>
                    </ui:VisualElement>
                    <ui:Label text="Uploaded Materials" class="section-title"/>
                    <ui:VisualElement name="materials-empty-state" class="panel-card empty-state">
                        <ui:VisualElement class="empty-icon icon-gray" style="background-image: url(&quot;project://database/Assets/UI/Icons/empty-icon.png?fileID=2800000&amp;guid=1868d052d7c3e484ea032e01e5091786&amp;type=3#empty-icon&quot;);"/>
                        <ui:Label text="No materials yet" class="empty-title"/>
                        <ui:Label text="Files you upload will show up here, and on students&apos; Materials tab." class="empty-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="materials-list" class="materials-list hidden"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="drawer-scrim" class="drawer-scrim hidden"/>
        <ui:VisualElement name="drawer-panel" class="drawer-panel drawer-closed">
            <ui:VisualElement class="drawer-profile">
                <ui:VisualElement class="drawer-profile-tile">
                    <ui:VisualElement class="drawer-profile-icon"/>
                </ui:VisualElement>
                <ui:VisualElement class="drawer-profile-text">
                    <ui:Label name="drawer-classroom-label" text="Classroom" class="drawer-classroom-label"/>
                    <ui:Label text="Manage classroom" class="drawer-instructor-label"/>
                </ui:VisualElement>
                <ui:Button name="drawer-close-button" class="drawer-close-button">
                    <ui:VisualElement picking-mode="Ignore" class="close-icon"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="drawer-scroll" class="drawer-scroll">
                <ui:Label text="CLASSROOM" class="drawer-group-caption"/>
                <ui:Button name="overview-tab-button" class="drawer-item tab-button-active">
                    <ui:VisualElement picking-mode="Ignore" class="drawer-item-tile">
                        <ui:VisualElement picking-mode="Ignore" class="drawer-item-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/open-book.png?fileID=2800000&amp;guid=1b3291bdc5f5e2a4e9d7e8f765dcacc2&amp;type=3#open-book&quot;);"/>
                    </ui:VisualElement>
                    <ui:Label picking-mode="Ignore" text="Overview" class="drawer-item-label"/>
                </ui:Button>
                <ui:Label text="PEOPLE" class="drawer-group-caption"/>
                <ui:Button name="students-tab-button" class="drawer-item">
                    <ui:VisualElement picking-mode="Ignore" class="drawer-item-tile">
                        <ui:VisualElement picking-mode="Ignore" class="drawer-item-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/student-icon.png?fileID=2800000&amp;guid=ea5b6ac4141decf4a953e4fdcf22155f&amp;type=3#student-icon&quot;);"/>
                    </ui:VisualElement>
                    <ui:Label picking-mode="Ignore" text="Students" class="drawer-item-label"/>
                </ui:Button>
                <ui:Button name="analytics-tab-button" class="drawer-item">
                    <ui:VisualElement picking-mode="Ignore" class="drawer-item-tile">
                        <ui:VisualElement picking-mode="Ignore" class="drawer-item-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/chart-icon.png?fileID=2800000&amp;guid=a442228a8c2aba742ac8e32ca5ba4f83&amp;type=3#chart-icon&quot;);"/>
                    </ui:VisualElement>
                    <ui:Label picking-mode="Ignore" text="Analytics" class="drawer-item-label"/>
                </ui:Button>
                <ui:Label text="CONTENT" class="drawer-group-caption"/>
                <ui:Button name="quizzes-tab-button" class="drawer-item">
                    <ui:VisualElement picking-mode="Ignore" class="drawer-item-tile">
                        <ui:VisualElement picking-mode="Ignore" class="drawer-item-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/quiz-icon.png?fileID=2800000&amp;guid=94d1609b9c3ba5c45a6b760d524ff279&amp;type=3#quiz-icon&quot;);"/>
                    </ui:VisualElement>
                    <ui:Label picking-mode="Ignore" text="Quizzes" class="drawer-item-label"/>
                </ui:Button>
                <ui:Button name="announcements-tab-button" class="drawer-item">
                    <ui:VisualElement picking-mode="Ignore" class="drawer-item-tile">
                        <ui:VisualElement picking-mode="Ignore" class="drawer-item-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/bell-icon.png?fileID=2800000&amp;guid=3985c6163c357bf4aa154283b2e0e7c7&amp;type=3#bell-icon&quot;);"/>
                    </ui:VisualElement>
                    <ui:Label picking-mode="Ignore" text="Announcements" class="drawer-item-label"/>
                </ui:Button>
                <ui:Button name="materials-tab-button" class="drawer-item">
                    <ui:VisualElement picking-mode="Ignore" class="drawer-item-tile">
                        <ui:VisualElement picking-mode="Ignore" class="drawer-item-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/open-book.png?fileID=2800000&amp;guid=1b3291bdc5f5e2a4e9d7e8f765dcacc2&amp;type=3#open-book&quot;);"/>
                    </ui:VisualElement>
                    <ui:Label picking-mode="Ignore" text="Materials" class="drawer-item-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="drawer-footer">
                <ui:Button name="edit-details-button" text="Edit Details" class="drawer-footer-button"/>
                <ui:Button name="archive-button" text="Lock Classroom" class="archive-button"/>
                <ui:Button name="drawer-back-button" text="Back to Dashboard" class="drawer-footer-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="archive-dialog-overlay" class="dialog-overlay hidden">
            <ui:VisualElement name="archive-dialog-card" class="dialog-card">
                <ui:Label name="archive-dialog-title-label" text="Archive Classroom" class="dialog-title"/>
                <ui:Label name="archive-dialog-message-label" text="Are you sure you want to archive this classroom? Archived classrooms will no longer accept student access." class="dialog-message"/>
                <ui:VisualElement name="archive-dialog-button-row" class="dialog-button-row">
                    <ui:Button name="archive-dialog-cancel-button" text="Cancel" class="dialog-button dialog-button-secondary"/>
                    <ui:Button name="archive-dialog-confirm-button" text="Archive" class="dialog-button dialog-button-danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="edit-dialog-overlay" class="dialog-overlay hidden">
            <ui:VisualElement name="edit-dialog-card" class="dialog-card">
                <ui:Label text="Edit Classroom" class="dialog-title"/>
                <ui:Label text="Classroom Code *" class="edit-field-label"/>
                <ui:TextField name="edit-code-field" max-length="60" class="announcement-input"/>
                <ui:Label text="Classroom Name *" class="edit-field-label"/>
                <ui:TextField name="edit-name-field" max-length="120" class="announcement-input"/>
                <ui:Label text="Section *" class="edit-field-label"/>
                <ui:TextField name="edit-section-field" max-length="40" class="announcement-input"/>
                <ui:Label name="edit-dialog-error-label" text="" class="edit-dialog-error hidden"/>
                <ui:VisualElement name="edit-dialog-button-row" class="dialog-button-row edit-dialog-button-row">
                    <ui:Button name="edit-dialog-cancel-button" text="Cancel" class="dialog-button dialog-button-secondary"/>
                    <ui:Button name="edit-dialog-save-button" text="Save" class="dialog-button dialog-button-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="unenroll-dialog-overlay" class="dialog-overlay hidden">
            <ui:VisualElement name="unenroll-dialog-card" class="dialog-card">
                <ui:Label name="unenroll-dialog-title-label" text="Remove Student" class="dialog-title"/>
                <ui:Label name="unenroll-dialog-message-label" text="Remove this student from this classroom? Their points and quiz history in this classroom will be lost. This can&apos;t be undone." class="dialog-message"/>
                <ui:VisualElement name="unenroll-dialog-button-row" class="dialog-button-row">
                    <ui:Button name="unenroll-dialog-cancel-button" text="Cancel" class="dialog-button dialog-button-secondary"/>
                    <ui:Button name="unenroll-dialog-confirm-button" text="Remove" class="dialog-button dialog-button-danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
