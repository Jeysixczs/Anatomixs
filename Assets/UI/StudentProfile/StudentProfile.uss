/* =========================================================
   Anatomia 3D - Student Profile (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   Layout: gradient header with a centered avatar block, a stats card
   that floats over the header's bottom edge, then grouped menu cards.
   ========================================================= */

/* ---------- Screen ---------- */
.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */
.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 100px;
    padding-bottom: 120px;   /* room for the stats card that overlaps the bottom edge */
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 44px;
}

.back-button
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 30px;
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    flex-shrink: 0;
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.header-subtitle
{
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
    word-wrap: break-word;
}

/* ---------- Profile summary (centered) ---------- */
.profile-summary-card
{
    flex-direction: column;
    align-items: center;
    background-color: transparent;
    padding: 0;
}

.avatar
{
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 6px;
    border-color: rgba(255, 255, 255, 0.9);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 28px;
    overflow: hidden;
}

.avatar-initials
{
    font-size: 76px;
    -unity-font-style: bold;
    color: white;
}

.profile-name
{
    font-size: 48px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    word-wrap: break-word;
    max-width: 100%;
}

.profile-email
{
    font-size: 28px;
    color: rgba(255, 255, 255, 0.82);
    -unity-text-align: middle-center;
    margin-top: 6px;
    white-space: normal;
    word-wrap: break-word;
    max-width: 100%;
}

.level-badge
{
    align-self: center;
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 30px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 12px;
    padding-bottom: 12px;
    margin-top: 22px;
}

.level-badge-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- ScrollView ---------- */
.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */
.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 0;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

/* ---------- Stats card (one white card, three columns, floats over the header) ---------- */
.stats-row
{
    flex-direction: row;
    margin-left: 50px;
    margin-right: 50px;
    margin-top: -72px;
    margin-bottom: 12px;
    background-color: white;
    border-radius: 40px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    padding-top: 36px;
    padding-bottom: 36px;
}

.stat-card
{
    flex: 1;
    flex-shrink: 0;
    min-width: 0;
    background-color: transparent;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-left-width: 0;
}

.stat-card-mid,
.stat-card-right
{
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.07);
}

.stat-icon
{
    width: 72px;
    height: 72px;
    border-radius: 22px;
    margin-bottom: 16px;
    justify-content: center;
    align-items: center;
}

.stat-icon-glyph
{
    width: 40px;
    height: 40px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.stat-icon-blue   { background-color: rgb(226, 236, 254); }
.stat-icon-orange { background-color: rgb(254, 240, 218); }
.stat-icon-purple { background-color: rgb(240, 228, 254); }

.stat-value
{
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.stat-label
{
    font-size: 24px;
    color: rgb(138, 143, 163);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Menu ---------- */
.section-title
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(138, 143, 163);
    padding-left: 66px;
    padding-right: 66px;
    margin-top: 40px;
    margin-bottom: 18px;
}

.menu-card
{
    background-color: white;
    border-radius: 40px;
    margin-left: 50px;
    margin-right: 50px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.menu-item
{
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0px;
    padding: 24px;
    margin: 0;
    border-radius: 28px;
}

.menu-item:hover
{
    background-color: rgba(0, 0, 0, 0.03);
}

.menu-item:active
{
    background-color: rgba(0, 0, 0, 0.06);
}

.menu-divider
{
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
    margin-left: 128px;
    margin-right: 24px;
}

.menu-icon-box
{
    width: 80px;
    height: 80px;
    border-radius: 24px;
    margin-right: 28px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.menu-icon-blue   { background-color: rgb(226, 236, 254); }
.menu-icon-orange { background-color: rgb(254, 240, 218); }
.menu-icon-green  { background-color: rgb(220, 244, 228); }
.menu-icon-purple { background-color: rgb(240, 228, 254); }
.menu-icon-gray   { background-color: rgb(236, 238, 243); }
.menu-icon-red    { background-color: rgb(254, 226, 226); }

.menu-icon-glyph
{
    width: 42px;
    height: 42px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.menu-item-label
{
    font-size: 34px;
    color: rgb(31, 36, 48);
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.menu-chevron
{
    width: 22px;
    height: 22px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-color: rgb(190, 193, 204);
    rotate: 45deg;
    flex-shrink: 0;
    margin-right: 10px;
}

/* ---------- Log Out ---------- */
.logout-button
{
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 245, 245);
    border-radius: 40px;
    margin-left: 50px;
    margin-right: 50px;
    margin-top: 36px;
    margin-bottom: 0;
    padding: 24px;
    border-width: 1px;
    border-color: rgba(220, 38, 38, 0.18);
}

.logout-button:hover
{
    background-color: rgb(254, 236, 236);
}

.logout-button:active
{
    background-color: rgb(254, 226, 226);
}

.logout-label
{
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(220, 38, 38);
}

.version-label
{
    font-size: 24px;
    color: rgb(160, 165, 178);
    -unity-text-align: middle-center;
    margin-top: 36px;
    margin-bottom: 72px;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */
.compact .header
{
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 80px;
    padding-bottom: 100px;
}

.compact .header-top-row
{
    margin-bottom: 32px;
}

.compact .header-title
{
    font-size: 38px;
}

.compact .header-subtitle
{
    font-size: 24px;
}

.compact .back-button
{
    width: 76px;
    height: 76px;
    border-radius: 38px;
    margin-right: 24px;
}

.compact .back-icon
{
    width: 34px;
    height: 34px;
}

.compact .avatar
{
    width: 160px;
    height: 160px;
    border-radius: 80px;
    margin-bottom: 22px;
}

.compact .avatar-initials
{
    font-size: 60px;
}

.compact .profile-name
{
    font-size: 40px;
}

.compact .profile-email
{
    font-size: 24px;
}

.compact .level-badge-label
{
    font-size: 24px;
}

.compact .stats-row
{
    margin-left: 40px;
    margin-right: 40px;
    margin-top: -60px;
    padding-top: 28px;
    padding-bottom: 28px;
}

.compact .stat-icon
{
    width: 60px;
    height: 60px;
    border-radius: 18px;
}

.compact .stat-icon-glyph
{
    width: 34px;
    height: 34px;
}

.compact .stat-value
{
    font-size: 38px;
}

.compact .stat-label
{
    font-size: 20px;
}

.compact .section-title
{
    font-size: 22px;
    padding-left: 52px;
    margin-top: 32px;
}

.compact .menu-card,
.compact .logout-button
{
    margin-left: 40px;
    margin-right: 40px;
}

.compact .menu-item
{
    padding: 20px;
}

.compact .menu-icon-box
{
    width: 68px;
    height: 68px;
    border-radius: 20px;
    margin-right: 22px;
}

.compact .menu-icon-glyph
{
    width: 36px;
    height: 36px;
}

.compact .menu-divider
{
    margin-left: 108px;
}

.compact .menu-item-label,
.compact .logout-label
{
    font-size: 30px;
}

.compact .version-label
{
    font-size: 20px;
}
