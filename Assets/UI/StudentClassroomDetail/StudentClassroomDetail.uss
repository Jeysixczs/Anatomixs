/* =========================================================
   Anatomia 3D - Student Classroom Detail (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient support, so the header
   gradient is generated at runtime from
   StudentClassroomDetailController.ApplyHeaderGradient(). The
   color below is a flat fallback.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Archived-blocked state ----------
   Shown instead of the classroom's content when
   ClassroomDetailRecord.IsArchived is true - see
   StudentClassroomDetailController.LoadClassroomContent(). */

.archived-blocked-panel
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(243, 244, 248);
    justify-content: center;
    align-items: center;
    padding: 80px;
}

.archived-blocked-icon
{
    width: 110px;
    height: 110px;
    margin-bottom: 34px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.archived-blocked-title
{
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.archived-blocked-message
{
    font-size: 32px;
    color: rgb(150, 155, 168);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 640px;
    margin-bottom: 48px;
}

.anatomia-theme.theme-classroom-detail .archived-blocked-back-button
{
    height: 104px;
    padding-left: 56px;
    padding-right: 56px;
    background-color: var(--accent);
    border-width: 0;
    border-radius: 52px;
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

.anatomia-theme.theme-classroom-detail .archived-blocked-back-button:hover
{
    background-color: var(--accent-strong);
}

.anatomia-theme.theme-classroom-detail .archived-blocked-back-button:active
{
    background-color: var(--accent-press);
}

/* ---------- Header (fixed, slim) ----------
   Header + tab bar live OUTSIDE the content ScrollView, so navigation is
   always one tap away. The header is kept short: back + title on one row,
   two stat chips on the next. */

.anatomia-theme.theme-classroom-detail .header
{
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 84px;
    padding-bottom: 12px;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.anatomia-theme.theme-classroom-detail .back-button
{
    width: 88px;
    height: 88px;
    min-width: 88px;
    border-radius: 44px;
    margin: 0 28px 0 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.back-icon
{
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.header-text
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.anatomia-theme.theme-classroom-detail .header-title
{
    font-size: 44px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.anatomia-theme.theme-classroom-detail .header-subtitle
{
    font-size: 26px;
    margin-top: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- Stat chips (replace the two tall glass cards) ---------- */









/* ---------- Stats strip: one card, three equal cells ---------- */

.stats-strip
{
    flex-direction: row;
    align-items: stretch;
    border-radius: 32px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

.stat-cell
{
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 22px 8px;
}

.stat-cell-border
{
    border-left-width: 1px;
    border-left-color: var(--line);
}

.stat-cell-value
{
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--ink);
    letter-spacing: -0.5px;
}

.stat-cell-value-accent
{
    color: var(--accent);
}

.stat-cell-label
{
    font-size: 22px;
    color: var(--ink-3);
    margin-top: 2px;
    white-space: nowrap;
}

.compact .stat-cell
{
    padding: 16px 6px;
}

.compact .stat-cell-value
{
    font-size: 36px;
}

.compact .stat-cell-label
{
    font-size: 19px;
}

/* ---------- Hamburger button: tonal circle, 3 bars (short middle bar, right-aligned) ---------- */

.anatomia-theme.theme-classroom-detail .menu-button
{
    width: 88px;
    height: 88px;
    min-width: 88px;
    border-radius: 44px;
    margin: 0 0 0 20px;
    padding: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    background-color: var(--accent-soft);
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.anatomia-theme.theme-classroom-detail .menu-button:hover { background-color: rgba(91, 76, 219, 0.2); }
.anatomia-theme.theme-classroom-detail .menu-button:active { background-color: var(--accent); }
.anatomia-theme.theme-classroom-detail .menu-button:active .menu-bar { background-color: white; }

.menu-bars
{
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    width: 38px;
    height: 32px;
}

.menu-bar
{
    height: 5px;
    border-radius: 3px;
    background-color: var(--accent);
}

.menu-bar-long { width: 38px; }
.menu-bar-short { width: 24px; margin: 7px 0; }

.close-icon
{
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/UI/Icons/close-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink-2);
}

/* ---------- Section bar (shows where you are) ---------- */

.section-bar
{
    flex-shrink: 0;
    flex-direction: column;
    padding: 8px 40px 16px 40px;
}

.section-bar-title
{
    font-size: 54px;
    -unity-font-style: bold;
    color: var(--ink);
    letter-spacing: -0.8px;
}

.section-bar-hint
{
    font-size: 24px;
    color: var(--ink-3);
    margin-top: 2px;
}

/* ---------- Drawer ---------- */

.drawer-scrim
{
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(22, 24, 38, 0.5);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.drawer-scrim-on { opacity: 1; }

.drawer-panel
{
    position: absolute;
    top: 0; bottom: 0; right: 0;
    width: 84%;
    max-width: 760px;
    padding: 88px 28px 36px 28px;
    background-color: rgb(250, 250, 253);
    border-top-left-radius: 52px;
    border-bottom-left-radius: 52px;
    flex-direction: column;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.26s;
    transition-timing-function: ease-out-cubic;
}

.drawer-closed { translate: 105% 0; }

/* Classroom identity card at the top of the drawer */
.drawer-profile
{
    flex-direction: row;
    align-items: center;
    padding: 24px 20px 24px 24px;
    margin-bottom: 8px;
    border-radius: 36px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    flex-shrink: 0;
}

.drawer-profile-tile
{
    width: 96px;
    height: 96px;
    border-radius: 30px;
    background-color: var(--accent);
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.drawer-profile-icon
{
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/UI/Icons/classroom-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.drawer-profile-text
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.drawer-classroom-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.drawer-instructor-label
{
    font-size: 24px;
    color: var(--ink-3);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.anatomia-theme.theme-classroom-detail .drawer-close-button
{
    width: 72px;
    height: 72px;
    min-width: 72px;
    margin: 0 0 0 12px;
    padding: 0;
    border-width: 0;
    border-radius: 36px;
    background-color: var(--sunken);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.anatomia-theme.theme-classroom-detail .drawer-close-button:hover { background-color: var(--track); }
.anatomia-theme.theme-classroom-detail .drawer-close-button:active { background-color: var(--line-strong); }

.drawer-scroll
{
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0 4px;
}

.drawer-group-caption
{
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--ink-3);
    letter-spacing: 3px;
    margin: 28px 0 12px 20px;
}

.anatomia-theme.theme-classroom-detail .drawer-item
{
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 108px;
    margin: 0 0 6px 0;
    padding: 0 20px 0 14px;
    border-width: 0;
    border-radius: 34px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.anatomia-theme.theme-classroom-detail .drawer-item:hover { background-color: var(--sunken); }
.anatomia-theme.theme-classroom-detail .drawer-item:active { background-color: var(--accent-soft); }

.drawer-item-tile
{
    width: 76px;
    height: 76px;
    border-radius: 24px;
    background-color: var(--sunken);
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.drawer-item-icon
{
    width: 38px;
    height: 38px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink-2);
}

.drawer-item-label
{
    font-size: 33px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: nowrap;
}

/* Active section: tinted row, solid accent tile with white icon */
.anatomia-theme.theme-classroom-detail .drawer-item.tab-button-active,
.anatomia-theme.theme-classroom-detail .drawer-item.tab-button-active:hover
{
    background-color: var(--accent-soft);
    border-width: 0;
}

.anatomia-theme.theme-classroom-detail .drawer-item.tab-button-active .drawer-item-tile { background-color: var(--accent); }
.anatomia-theme.theme-classroom-detail .drawer-item.tab-button-active .drawer-item-icon { -unity-background-image-tint-color: white; }
.anatomia-theme.theme-classroom-detail .drawer-item.tab-button-active .drawer-item-label { color: var(--accent); }

/* Footer action */
.anatomia-theme.theme-classroom-detail .drawer-footer-button
{
    flex-shrink: 0;
    height: 96px;
    margin: 12px 4px 0 4px;
    padding: 0 40px;
    border-radius: 48px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line-strong);
    color: var(--ink);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.anatomia-theme.theme-classroom-detail .drawer-footer-button:hover { border-color: var(--accent); color: var(--accent); }
.anatomia-theme.theme-classroom-detail .drawer-footer-button:active { background-color: var(--accent-soft); border-color: var(--accent); color: var(--accent); }

/* ---------- Content ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.screen-scroll .unity-scroller--vertical
{
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    position: relative;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

.anatomia-theme.theme-classroom-detail .content-wrapper
{
    flex-direction: column;
    flex-shrink: 0;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 16px;
    padding-bottom: 80px;
}

/* ---------- Tab Panels / Cards ---------- */

.tab-panel
{
    flex-direction: column;
}

.hidden
{
    display: none;
}

.panel-card
{
    background-color: white;
    border-radius: 32px;
    padding: 40px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    margin-bottom: 28px;
}

.panel-card-title
{
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.panel-card-subtitle
{
    font-size: 30px;
    color: rgb(150, 155, 168);
    margin-top: 8px;
    margin-bottom: 32px;
    white-space: normal;
}

.section-title
{
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 8px;
}

.section-subtitle
{
    font-size: 30px;
    color: rgb(150, 155, 168);
    margin-bottom: 26px;
}

/* ---------- Empty States (shared) ---------- */

.empty-state
{
    align-items: center;
    padding-top: 66px;
    padding-bottom: 66px;
}

.empty-state-inline
{
    padding-top: 36px;
    padding-bottom: 24px;
}

.empty-icon
{
    width: 85px;
    height: 85px;
    margin-bottom: 26px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.icon-users-gray
{
    background-image: url("project://database/Assets/UI/Icons/empty-icon.png");
    -unity-background-image-tint-color: rgb(190, 194, 204);
}

.icon-quiz-gray
{
    background-image: url("project://database/Assets/UI/Icons/empty-icon.png");
    -unity-background-image-tint-color: rgb(190, 194, 204);
}

.icon-lock-gray
{
    background-image: url("project://database/Assets/UI/Icons/lock-icon.png");
    -unity-background-image-tint-color: rgb(190, 194, 204);
}

.icon-announce-gray
{
    background-image: url("project://database/Assets/UI/Icons/empty-icon.png");
    -unity-background-image-tint-color: rgb(190, 194, 204);
}

.icon-history-gray
{
    background-image: url("project://database/Assets/UI/Icons/empty-icon.png");
    -unity-background-image-tint-color: rgb(190, 194, 204);
}

.empty-title
{
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 12px;
}

.empty-subtitle
{
    font-size: 32px;
    color: rgb(150, 155, 168);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 590px;
}

/* ---------- Overview: Classroom Info ---------- */

.info-row
{
    flex-direction: column;
    padding-top: 20px;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(238, 239, 244);
}

.info-row-last
{
    border-bottom-width: 0;
    padding-bottom: 0;
}

.info-label
{
    font-size: 32px;
    color: rgb(150, 155, 168);
    margin-bottom: 8px;
}

.info-value
{
    font-size: 36px;
    color: var(--ink);
    white-space: normal;
}

.info-value-big
{
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}






/* ---------- Overview: Announcements ---------- */

.announcements-list
{
    flex-direction: column;
}

.announcement-card
{
    background-color: white;
    border-radius: 28px;
    padding: 38px;
    margin-bottom: 24px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.announcement-header-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.announcement-title-label
{
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    margin-right: 16px;
}

.announcement-date-label
{
    font-size: 28px;
    color: rgb(150, 155, 168);
    flex-shrink: 0;
}

.announcement-body-label
{
    font-size: 36px;
    color: rgb(80, 85, 100);
    white-space: normal;
}

/* ---------- Students: Peer rows ---------- */

.peers-list
{
    flex-direction: column;
}

.peer-row
{
    flex-direction: row;
    align-items: center;
    padding: 20px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(238, 239, 244);
}

.peer-row-last
{
    border-bottom-width: 0;
}

.peer-avatar
{
    width: 71px;
    height: 71px;
    border-radius: 36px;
    background-color: rgb(219, 234, 254);
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.peer-avatar-label
{
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
}

.peer-name-label
{
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.peer-level-badge
{
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(90, 95, 110);
    background-color: rgb(238, 239, 244);
    border-radius: 14px;
    padding: 8px 20px;
    flex-shrink: 0;
}

/* ---------- Available Quizzes ---------- */

.quizzes-list
{
    flex-direction: column;
}

.quiz-card
{
    background-color: white;
    border-radius: 22px;
    border-left-width: 6px;
    border-left-color: rgb(34, 197, 94);
    padding: 26px;
    margin-bottom: 20px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.06);
    border-right-color: rgba(0, 0, 0, 0.06);
    border-bottom-color: rgba(0, 0, 0, 0.06);
    transition-property: border-left-color, border-top-color, border-right-color, border-bottom-color, translate;
    transition-duration: 0.15s;
}

.quiz-card:hover
{
    border-top-color: rgba(0, 0, 0, 0.1);
    border-right-color: rgba(0, 0, 0, 0.1);
    border-bottom-color: rgba(0, 0, 0, 0.1);
    translate: 0 -3px;
}

.quiz-card-locked
{
    border-left-color: rgb(203, 206, 216);
}

.quiz-card-locked:hover
{
    translate: 0 0;
}

/* Eyebrow row: subject tag + availability pill, read before the title. */
.quiz-card-header-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
}

.quiz-subject-tag
{
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(21, 128, 61);
    background-color: rgb(220, 252, 231);
    border-radius: 12px;
    padding: 6px 14px;
    flex-shrink: 0;
}

.quiz-subject-tag-locked
{
    color: rgb(120, 123, 140);
    background-color: rgb(238, 239, 244);
}

.quiz-status-pill
{
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(21, 128, 61);
    background-color: rgb(220, 252, 231);
    border-radius: 14px;
    padding: 6px 16px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(21, 128, 61, 0.25);
}

.quiz-status-pill-locked
{
    color: rgb(120, 123, 140);
    background-color: rgb(238, 239, 244);
    border-color: rgba(120, 123, 140, 0.25);
}

.quiz-card-title
{
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
    margin-bottom: 16px;
}

/* Stat chips: one wrapping row replaces the old stacked key/value grid, so
   Questions / Points / Time / Attempts / Deadline / Difficulty all scan in
   a single glance instead of six separate lines. */
.quiz-meta-chips
{
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.quiz-meta-chip
{
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(90, 95, 110);
    background-color: rgb(244, 245, 248);
    border-radius: 12px;
    padding: 8px 16px;
    margin-right: 10px;
    margin-bottom: 10px;
}

.quiz-chip-easy
{
    color: rgb(21, 128, 61);
    background-color: rgb(220, 252, 231);
}

.quiz-chip-medium
{
    color: rgb(180, 83, 9);
    background-color: rgb(254, 243, 199);
}

.quiz-chip-hard
{
    color: rgb(185, 28, 28);
    background-color: rgb(254, 226, 226);
}

.quiz-chip-neutral
{
    color: rgb(55, 65, 150);
    background-color: rgb(224, 231, 255);
}

.quiz-card-bottom-row
{
    flex-direction: row;
    justify-content: flex-end;
}

/* Primary action: full-width accent pill, 96px touch target */
.anatomia-theme.theme-classroom-detail .quiz-start-button
{
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    height: 96px;
    margin: 0;
    padding-left: 40px;
    padding-right: 40px;
    border-width: 0;
    border-radius: 48px;
    background-color: var(--accent);
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.anatomia-theme.theme-classroom-detail .quiz-start-button:hover
{
    background-color: var(--accent-strong);
}

.anatomia-theme.theme-classroom-detail .quiz-start-button:active
{
    background-color: var(--accent-press);
}

.anatomia-theme.theme-classroom-detail .quiz-start-button-disabled,
.anatomia-theme.theme-classroom-detail .quiz-start-button-disabled:hover,
.anatomia-theme.theme-classroom-detail .quiz-start-button-disabled:active
{
    background-color: var(--sunken);
    color: var(--ink-3);
}

.quiz-start-play-icon
{
    width: 24px;
    height: 24px;
    margin-right: 14px;
    background-image: url("project://database/Assets/UI/Icons/play-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.quiz-start-button-disabled .quiz-start-play-icon
{
    -unity-background-image-tint-color: var(--ink-3);
}

.quiz-locked-badge
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(150, 155, 168);
    background-color: rgb(238, 239, 244);
    border-radius: 48px;
    height: 96px;
    padding: 0 40px;
    align-self: stretch;
    -unity-text-align: middle-center;
}

/* ---------- Leaderboard ---------- */

.top-performers-header-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
}

.trophy-icon-box
{
    width: 52px;
    height: 52px;
    margin-right: 16px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.trophy-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/reward-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(234, 179, 8);
}

.top-performers-empty-state
{
    align-items: center;
    padding-top: 36px;
    padding-bottom: 36px;
}

.top-performers-empty-text
{
    font-size: 38px;
    color: rgb(150, 155, 168);
}

.top-performers-list
{
    flex-direction: column;
}

/* Header count, right-aligned next to the title */
.lb-count-label
{
    font-size: 32px;
    color: rgb(150, 155, 168);
    margin-left: auto;
}

/* "Your rank" summary strip */
.lb-summary
{
    flex-direction: row;
    align-items: center;
    background-color: rgb(236, 253, 250);
    border-width: 2px;
    border-color: rgb(153, 246, 228);
    border-radius: 28px;
    padding: 30px 36px;
    margin-bottom: 28px;
}

.lb-summary-mid
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.lb-summary-left
{
    flex-direction: column;
}

.lb-summary-caption
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(15, 118, 110);
    letter-spacing: 2px;
}

.lb-summary-rank-row
{
    flex-direction: row;
    align-items: flex-end;
}

.lb-summary-rank
{
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(13, 148, 136);
}

.lb-summary-of
{
    font-size: 32px;
    color: rgb(90, 95, 110);
    margin-left: 12px;
    margin-bottom: 12px;
}

.lb-summary-hint
{
    font-size: 30px;
    color: rgb(15, 118, 110);
    white-space: normal;
    margin-top: 4px;
}

.lb-summary-right
{
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 24px;
}

.lb-summary-points
{
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.lb-summary-points-caption
{
    font-size: 26px;
    color: rgb(90, 95, 110);
}

/* Rows */
.performer-row
{
    flex-direction: row;
    align-items: center;
    padding: 24px 24px 24px 20px;
    border-radius: 24px;
    margin-bottom: 14px;
    background-color: rgb(248, 249, 251);
    border-left-width: 8px;
    border-left-color: rgba(0, 0, 0, 0);
}

.performer-row-default
{
    background-color: rgb(248, 249, 251);
}

.performer-row-gold
{
    background-color: rgb(254, 249, 224);
    border-left-color: rgb(234, 179, 8);
}

.performer-row-silver
{
    background-color: rgb(243, 244, 248);
    border-left-color: rgb(148, 163, 184);
}

.performer-row-bronze
{
    background-color: rgb(253, 237, 220);
    border-left-color: rgb(205, 127, 50);
}

.performer-row-you
{
    background-color: rgb(236, 253, 250);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(13, 148, 136);
    border-right-color: rgb(13, 148, 136);
    border-bottom-color: rgb(13, 148, 136);
    border-left-color: rgb(13, 148, 136);
}

/* Rank: solid medal for the podium, plain number below */
.performer-rank-badge
{
    width: 66px;
    height: 66px;
    border-radius: 34px;
    justify-content: center;
    align-items: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.performer-rank-badge-default
{
    background-color: rgba(0, 0, 0, 0);
}

.performer-rank-badge-gold
{
    background-color: rgb(234, 179, 8);
}

.performer-rank-badge-silver
{
    background-color: rgb(148, 163, 184);
}

.performer-rank-badge-bronze
{
    background-color: rgb(205, 127, 50);
}

.performer-rank-label
{
    font-size: 34px;
    -unity-font-style: bold;
}

.performer-rank-label-default
{
    color: rgb(150, 155, 168);
}

.performer-rank-label-gold,
.performer-rank-label-silver,
.performer-rank-label-bronze
{
    color: white;
}

/* Avatar with a rank-coloured ring */
.performer-avatar
{
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: rgb(219, 234, 254);
    justify-content: center;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
}

.performer-avatar-gold
{
    border-color: rgb(234, 179, 8);
}

.performer-avatar-silver
{
    border-color: rgb(148, 163, 184);
}

.performer-avatar-bronze
{
    border-color: rgb(205, 127, 50);
}

.performer-avatar-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
}

.performer-info
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.performer-name-row
{
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

/* One line, "..." when it doesn't fit, so a long name can't wrap or spill into the points. */
.performer-name-label
{
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.performer-you-badge
{
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(13, 148, 136);
    border-radius: 10px;
    padding: 4px 12px;
    margin-left: 12px;
    flex-shrink: 0;
}

.performer-meta-label
{
    font-size: 28px;
    color: rgb(150, 155, 168);
    margin-top: 4px;
    white-space: normal;
}

/* Points relative to the leader */
.performer-bar-track
{
    height: 10px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.07);
    margin-top: 14px;
    overflow: hidden;
}

.performer-bar-fill
{
    height: 100%;
    border-radius: 6px;
    background-color: rgb(96, 165, 250);
}

.performer-bar-fill-gold
{
    background-color: rgb(234, 179, 8);
}

.performer-bar-fill-silver
{
    background-color: rgb(148, 163, 184);
}

.performer-bar-fill-bronze
{
    background-color: rgb(205, 127, 50);
}

.performer-score-block
{
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 20px;
}

.performer-score-points
{
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
}

.performer-score-points-gold
{
    color: rgb(161, 98, 7);
}

.performer-score-points-silver
{
    color: rgb(75, 85, 99);
}

.performer-score-points-bronze
{
    color: rgb(194, 65, 12);
}

.performer-points-sub
{
    font-size: 26px;
    color: rgb(150, 155, 168);
    margin-top: 0;
}

/* ---------- Scores (Quiz History) ---------- */

.scores-list
{
    flex-direction: column;
}

.score-card
{
    background-color: white;
    border-radius: 28px;
    padding: 40px;
    margin-bottom: 26px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.score-top-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
}

.score-title-block
{
    flex-direction: column;
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 16px;
}

.score-title-label
{
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
}

.score-completed-label
{
    font-size: 32px;
    color: rgb(150, 155, 168);
    margin-top: 4px;
}

.score-status-pill
{
    font-size: 28px;
    -unity-font-style: bold;
    border-radius: 18px;
    padding: 8px 20px;
    flex-shrink: 0;
}

.score-status-pill-passed
{
    color: rgb(21, 128, 61);
    background-color: rgb(220, 252, 231);
}

.score-status-pill-failed
{
    color: rgb(185, 28, 28);
    background-color: rgb(254, 226, 226);
}

.score-mid-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
}

.score-fraction-label
{
    font-size: 38px;
    color: rgb(80, 85, 100);
}

.score-percent-label
{
    font-size: 50px;
    -unity-font-style: bold;
}

.score-percent-label-passed
{
    color: rgb(22, 163, 74);
}

.score-percent-label-failed
{
    color: rgb(220, 38, 38);
}

.score-bottom-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
    padding-top: 20px;
    border-top-width: 1px;
    border-top-color: rgb(238, 239, 244);
}

.score-meta-label
{
    font-size: 32px;
    color: rgb(150, 155, 168);
}

/* ---------- Badges ----------
   Mirrors the badge-card markup/classes used on StudentAchievements
   (same class names) - StudentClassroomDetailController.BuildBadgeCard()
   and StudentAchievementsController.BuildBadgeCard() both build against
   this same set, so a badge looks the same whether it's shown here (one
   teacher's config, per classroom) or on the student's overall
   Achievements screen. */

.badge-list
{
    flex-direction: column;
}

.badge-card
{
    flex-direction: row;
    align-items: flex-start;
    background-color: white;
    border-radius: 28px;
    padding: 40px;
    margin-bottom: 24px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.badge-card-locked
{
    background-color: rgb(248, 249, 251);
}

.badge-icon-box
{
    width: 110px;
    height: 110px;
    border-radius: 28px;
    justify-content: center;
    align-items: center;
    margin-right: 28px;
    flex-shrink: 0;
}

.badge-icon-gold
{
    background-color: rgb(254, 240, 138);
}

.badge-icon-locked
{
    background-color: rgb(232, 234, 240);
}

.badge-icon-emoji
{
    font-size: 54px;
    -unity-text-align: middle-center;
}

.badge-lock-icon
{
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/UI/Icons/lock-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(150, 155, 168);
}

.badge-info
{
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.badge-title
{
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
}

.badge-title-locked
{
    color: rgb(150, 155, 168);
}

.badge-status
{
    font-size: 30px;
    margin-top: 6px;
    margin-bottom: 20px;
    white-space: normal;
}

.badge-status-unlocked
{
    -unity-font-style: bold;
    color: rgb(21, 128, 61);
}

.badge-status-locked
{
    color: rgb(150, 155, 168);
}

.badge-progress-row
{
    flex-direction: row;
    align-items: center;
}

.progress-track
{
    flex-grow: 1;
    height: 16px;
    background-color: rgb(232, 234, 240);
    border-radius: 8px;
    overflow: hidden;
    margin-right: 16px;
}

.progress-fill
{
    height: 100%;
    border-radius: 8px;
}

.progress-fill-complete
{
    background-color: rgb(34, 197, 94);
}

.progress-fill-locked
{
    background-color: rgb(234, 179, 8);
}

.progress-label
{
    font-size: 26px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.progress-label-complete
{
    color: rgb(21, 128, 61);
}

.badge-progress-footer-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.progress-footer-label
{
    font-size: 26px;
    color: rgb(150, 155, 168);
}

.progress-footer-label-right
{
    -unity-font-style: bold;
    color: rgb(90, 95, 110);
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.anatomia-theme.theme-classroom-detail.compact .header
{
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 72px;
    padding-bottom: 16px;
}

.anatomia-theme.theme-classroom-detail.compact .back-button
{
    width: 76px;
    height: 76px;
    min-width: 76px;
    border-radius: 38px;
    margin-right: 22px;
}

.anatomia-theme.theme-classroom-detail.compact .header-title
{
    font-size: 34px;
}

.anatomia-theme.theme-classroom-detail.compact .header-subtitle
{
    font-size: 22px;
}





.compact .section-bar-title
{
    font-size: 44px;
}

.anatomia-theme.theme-classroom-detail.compact .menu-button
{
    width: 76px;
    height: 76px;
    min-width: 76px;
    border-radius: 38px;
}

.compact .drawer-panel
{
    width: 88%;
    padding-top: 72px;
}

.compact .drawer-item
{
    height: 96px;
}

.compact .drawer-item-tile
{
    width: 66px;
    height: 66px;
    border-radius: 21px;
    margin-right: 20px;
}

.compact .drawer-item-label
{
    font-size: 30px;
}

.anatomia-theme.theme-classroom-detail.compact .content-wrapper
{
    padding-left: 28px;
    padding-right: 28px;
}

.compact .panel-card
{
    padding: 28px;
    border-radius: 26px;
}



.compact .empty-title
{
    font-size: 26px;
}

.compact .empty-subtitle
{
    font-size: 22px;
}

.compact .quiz-card-title,
.compact .score-title-label
{
    font-size: 24px;
}

.anatomia-theme.theme-classroom-detail.compact .quiz-start-button,
.anatomia-theme.theme-classroom-detail.compact .material-open-button,
.anatomia-theme.theme-classroom-detail.compact .quiz-locked-badge
{
    height: 80px;
    font-size: 26px;
    border-radius: 40px;
}

.compact .quiz-meta-chip,
.compact .quiz-subject-tag,
.compact .quiz-status-pill
{
    font-size: 16px;
    padding: 4px 10px;
}

.compact .badge-card
{
    padding: 26px;
    border-radius: 22px;
}

.compact .badge-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 20px;
    margin-right: 18px;
}

.compact .badge-icon-emoji
{
    font-size: 36px;
}

.compact .badge-title
{
    font-size: 26px;
}

.compact .badge-status
{
    font-size: 20px;
    margin-bottom: 12px;
}

.compact .progress-track
{
    height: 11px;
}

.compact .progress-label,
.compact .progress-footer-label
{
    font-size: 18px;
}

/* =========================================================
   Materials tab (files uploaded by the teacher)
   ========================================================= */

.materials-list
{
    flex-direction: column;
}

.materials-error-label
{
    font-size: 28px;
    color: rgb(220, 38, 38);
    white-space: normal;
    margin-bottom: 20px;
}

.material-card
{
    background-color: white;
    border-radius: 28px;
    padding: 34px;
    margin-bottom: 24px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.material-card-header-row
{
    flex-direction: row;
    align-items: center;
}

.material-type-badge
{
    min-width: 96px;
    height: 96px;
    margin-right: 26px;
    background-color: rgb(240, 253, 244);
    border-radius: 24px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(22, 163, 74);
    -unity-text-align: middle-center;
}

.material-card-text
{
    flex-grow: 1;
    flex-shrink: 1;
}

.material-title-label
{
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
}

.material-meta-label
{
    font-size: 26px;
    color: rgb(150, 155, 168);
    margin-top: 6px;
    white-space: normal;
}

.material-description-label
{
    font-size: 32px;
    color: rgb(80, 85, 100);
    margin-top: 22px;
    white-space: normal;
}

/* Secondary action: same size/shape as the primary, quiet outline */
.anatomia-theme.theme-classroom-detail .material-open-button
{
    height: 96px;
    margin: 28px 0 0 0;
    padding: 0 40px;
    border-radius: 48px;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.anatomia-theme.theme-classroom-detail .material-open-button:active
{
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
}

.compact .material-title-label
{
    font-size: 28px;
}

.compact .material-description-label
{
    font-size: 24px;
}

.compact .material-type-badge
{
    min-width: 72px;
    height: 72px;
    font-size: 20px;
}

/* =========================================================
   SECTION REDESIGN (v3)
   Scoped under .anatomia-theme.theme-classroom-detail so it out-ranks both the base rules above
   and the shared Quiet Glass theme. Nothing here touches other screens.
   ========================================================= */

/* ---- shared ---- */

.anatomia-theme.theme-classroom-detail .section-title { font-size: 34px; color: var(--ink); margin: 8px 0 18px 4px; }
.anatomia-theme.theme-classroom-detail .section-title-first { margin-top: 12px; }
.anatomia-theme.theme-classroom-detail .section-subtitle { font-size: 26px; color: var(--ink-3); margin: -10px 0 22px 4px; }

.anatomia-theme.theme-classroom-detail .panel-card { padding: 36px; border-radius: 32px; margin-bottom: 24px; }
.anatomia-theme.theme-classroom-detail .panel-card-title { font-size: 36px; color: var(--ink); }
.anatomia-theme.theme-classroom-detail .panel-card-subtitle { font-size: 26px; color: var(--ink-3); margin-top: 4px; margin-bottom: 12px; }

.anatomia-theme.theme-classroom-detail .empty-state { padding: 56px 40px; }
.anatomia-theme.theme-classroom-detail .empty-icon { width: 72px; height: 72px; margin-bottom: 20px; }
.anatomia-theme.theme-classroom-detail .empty-title { font-size: 34px; }
.anatomia-theme.theme-classroom-detail .empty-subtitle { font-size: 28px; max-width: 560px; }
.anatomia-theme.theme-classroom-detail .empty-state-inline { padding: 24px 0 8px 0; background-color: rgba(0,0,0,0); border-width: 0; }

/* ---- Overview: info rows with icon tiles ---- */

.anatomia-theme.theme-classroom-detail .info-card { padding: 12px 36px; }

.anatomia-theme.theme-classroom-detail .info-row
{
    flex-direction: row;
    align-items: center;
    padding: 28px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.anatomia-theme.theme-classroom-detail .info-row-last { border-bottom-width: 0; }

.info-icon-box
{
    width: 84px;
    height: 84px;
    border-radius: 26px;
    background-color: var(--accent-soft);
    justify-content: center;
    align-items: center;
    margin-right: 28px;
    flex-shrink: 0;
}

.info-icon
{
    width: 40px;
    height: 40px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.icon-teacher { background-image: url("project://database/Assets/UI/Icons/user-icon.png"); }
.icon-description { background-image: url("project://database/Assets/UI/Icons/book-icon.png"); }

.info-text-col { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-classroom-detail .info-label { font-size: 24px; color: var(--ink-3); margin-bottom: 4px; }
.anatomia-theme.theme-classroom-detail .info-value { font-size: 34px; -unity-font-style: bold; color: var(--ink); white-space: normal; }

/* ---- Announcements ---- */

.anatomia-theme.theme-classroom-detail .announcement-card
{
    padding: 32px 32px 32px 36px;
    border-radius: 28px;
    margin-bottom: 18px;
    border-left-width: 8px;
    border-left-color: var(--accent);
}

.anatomia-theme.theme-classroom-detail .announcement-title-label { font-size: 34px; color: var(--ink); }

.anatomia-theme.theme-classroom-detail .announcement-date-label
{
    font-size: 22px;
    color: var(--ink-3);
    background-color: var(--sunken);
    border-radius: 100px;
    padding: 6px 18px;
}

.anatomia-theme.theme-classroom-detail .announcement-body-label { font-size: 30px; color: var(--ink-2); }

/* ---- Materials: file badge | title + meta | Open ---- */

.anatomia-theme.theme-classroom-detail .material-card { padding: 32px; border-radius: 30px; margin-bottom: 18px; }
.anatomia-theme.theme-classroom-detail .material-card-header-row { flex-direction: row; align-items: center; }

.anatomia-theme.theme-classroom-detail .material-type-badge
{
    min-width: 92px;
    width: 92px;
    height: 92px;
    margin-right: 24px;
    border-radius: 26px;
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 24px;
    flex-shrink: 0;
}

.anatomia-theme.theme-classroom-detail .material-card-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-classroom-detail .material-title-label { font-size: 34px; color: var(--ink); }
.anatomia-theme.theme-classroom-detail .material-meta-label { font-size: 24px; color: var(--ink-3); margin-top: 4px; white-space: normal; }

.anatomia-theme.theme-classroom-detail .material-description-label
{
    font-size: 28px;
    color: var(--ink-2);
    margin-top: 24px;
    padding-top: 22px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

/* Open now lives in the header row: compact tonal pill, 72px touch height */
.anatomia-theme.theme-classroom-detail .material-open-button
{
    height: 72px;
    min-width: 132px;
    margin: 0 0 0 20px;
    padding: 0 34px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 36px;
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 28px;
}

.anatomia-theme.theme-classroom-detail .material-open-button:hover { background-color: var(--accent); color: white; border-width: 0; }
.anatomia-theme.theme-classroom-detail .material-open-button:active { background-color: var(--accent-strong); color: white; border-width: 0; }

/* ---- Quizzes ---- */

.anatomia-theme.theme-classroom-detail .quiz-card
{
    padding: 34px 34px 34px 38px;
    border-radius: 30px;
    margin-bottom: 20px;
    border-left-width: 8px;
    border-left-color: var(--accent);
}

.anatomia-theme.theme-classroom-detail .quiz-card-locked { border-left-color: var(--ink-4); }

.anatomia-theme.theme-classroom-detail .quiz-card-header-row { align-items: center; margin-bottom: 14px; }

.anatomia-theme.theme-classroom-detail .quiz-subject-tag
{
    font-size: 24px;
    color: var(--accent);
    background-color: rgba(0,0,0,0);
    padding: 0;
    letter-spacing: 1.2px;
    border-radius: 0;
}

.anatomia-theme.theme-classroom-detail .quiz-subject-tag-locked { color: var(--ink-3); background-color: rgba(0,0,0,0); }

.anatomia-theme.theme-classroom-detail .quiz-status-pill
{
    font-size: 22px;
    color: var(--success);
    background-color: var(--success-soft);
    border-width: 0;
    border-radius: 100px;
    padding: 8px 20px;
}

.anatomia-theme.theme-classroom-detail .quiz-status-pill-locked { color: var(--ink-3); background-color: var(--sunken); }

.anatomia-theme.theme-classroom-detail .quiz-card-title { font-size: 38px; color: var(--ink); margin-bottom: 20px; }

.anatomia-theme.theme-classroom-detail .quiz-meta-chip
{
    font-size: 24px;
    color: var(--ink-2);
    background-color: var(--sunken);
    border-radius: 14px;
    padding: 10px 18px;
    margin: 0 10px 10px 0;
}

.anatomia-theme.theme-classroom-detail .quiz-chip-easy { color: var(--success); background-color: var(--success-soft); }
.anatomia-theme.theme-classroom-detail .quiz-chip-medium { color: var(--warn); background-color: var(--warn-soft); }
.anatomia-theme.theme-classroom-detail .quiz-chip-hard { color: var(--danger); background-color: var(--danger-soft); }
.anatomia-theme.theme-classroom-detail .quiz-chip-neutral { color: var(--accent); background-color: var(--accent-soft); }

.anatomia-theme.theme-classroom-detail .quiz-card-bottom-row
{
    margin-top: 6px;
    padding-top: 26px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

/* ---- Students ---- */

.anatomia-theme.theme-classroom-detail .peer-row { padding: 24px 0; border-bottom-color: var(--line); }

.anatomia-theme.theme-classroom-detail .peer-avatar
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: var(--accent-soft);
    margin-right: 26px;
}

.anatomia-theme.theme-classroom-detail .peer-avatar-label { font-size: 32px; color: var(--accent); }
.anatomia-theme.theme-classroom-detail .peer-name-label { font-size: 34px; color: var(--ink); }

.anatomia-theme.theme-classroom-detail .peer-level-badge
{
    font-size: 24px;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-radius: 100px;
    padding: 8px 22px;
}

/* ---- Leaderboard ---- */

.anatomia-theme.theme-classroom-detail .lb-count-label { font-size: 26px; color: var(--ink-3); background-color: rgba(0,0,0,0); }
.anatomia-theme.theme-classroom-detail .top-performers-header-row { margin-bottom: 24px; }

/* "Your rank" becomes a solid accent banner */
.anatomia-theme.theme-classroom-detail .lb-summary
{
    background-color: var(--accent);
    border-width: 0;
    border-radius: 32px;
    padding: 34px 36px;
    margin-bottom: 24px;
}

.anatomia-theme.theme-classroom-detail .lb-summary-caption { color: rgba(255,255,255,0.75); font-size: 22px; }
.anatomia-theme.theme-classroom-detail .lb-summary-rank { color: white; font-size: 76px; background-color: rgba(0,0,0,0); }
.anatomia-theme.theme-classroom-detail .lb-summary-of { color: rgba(255,255,255,0.8); }
.anatomia-theme.theme-classroom-detail .lb-summary-hint { color: white; font-size: 28px; }
.anatomia-theme.theme-classroom-detail .lb-summary-points { color: white; font-size: 52px; background-color: rgba(0,0,0,0); }
.anatomia-theme.theme-classroom-detail .lb-summary-points-caption { color: rgba(255,255,255,0.75); }

.anatomia-theme.theme-classroom-detail .performer-row
{
    padding: 22px 26px 22px 18px;
    border-radius: 28px;
    margin-bottom: 12px;
    border-left-width: 0;
}

.anatomia-theme.theme-classroom-detail .performer-row-default { background-color: var(--sunken); }
.anatomia-theme.theme-classroom-detail .performer-row-gold { background-color: rgb(254, 247, 214); }
.anatomia-theme.theme-classroom-detail .performer-row-silver { background-color: rgb(238, 241, 246); }
.anatomia-theme.theme-classroom-detail .performer-row-bronze { background-color: rgb(252, 238, 224); }

.anatomia-theme.theme-classroom-detail .performer-row-you
{
    background-color: var(--accent-soft);
    border-width: 2px;
    border-color: var(--accent);
}

.anatomia-theme.theme-classroom-detail .performer-rank-badge { width: 60px; height: 60px; border-radius: 30px; margin-right: 12px; }
.anatomia-theme.theme-classroom-detail .performer-rank-label { font-size: 30px; }
.anatomia-theme.theme-classroom-detail .performer-rank-label-default { color: var(--ink-3); }
.anatomia-theme.theme-classroom-detail .performer-avatar { width: 80px; height: 80px; border-radius: 40px; background-color: var(--surface-solid); }
.anatomia-theme.theme-classroom-detail .performer-avatar-label { color: var(--accent); }
.anatomia-theme.theme-classroom-detail .performer-name-label { font-size: 34px; color: var(--ink); }
.anatomia-theme.theme-classroom-detail .performer-you-badge { background-color: var(--accent); border-radius: 100px; padding: 4px 16px; }
.anatomia-theme.theme-classroom-detail .performer-meta-label { font-size: 24px; color: var(--ink-3); }
.anatomia-theme.theme-classroom-detail .performer-bar-track { height: 8px; background-color: var(--track); }
.anatomia-theme.theme-classroom-detail .performer-bar-fill { background-color: var(--accent); }
.anatomia-theme.theme-classroom-detail .performer-bar-fill-gold { background-color: rgb(234, 179, 8); }
.anatomia-theme.theme-classroom-detail .performer-bar-fill-silver { background-color: rgb(148, 163, 184); }
.anatomia-theme.theme-classroom-detail .performer-bar-fill-bronze { background-color: rgb(205, 127, 50); }
.anatomia-theme.theme-classroom-detail .performer-score-points { font-size: 40px; color: var(--accent); }
.anatomia-theme.theme-classroom-detail .performer-score-points-gold { color: rgb(161, 98, 7); }
.anatomia-theme.theme-classroom-detail .performer-score-points-silver { color: rgb(75, 85, 99); }
.anatomia-theme.theme-classroom-detail .performer-score-points-bronze { color: rgb(194, 65, 12); }
.anatomia-theme.theme-classroom-detail .performer-points-sub { font-size: 22px; }

/* ---- Scores: status strip on the left, % as the hero number ---- */

.anatomia-theme.theme-classroom-detail .score-card
{
    padding: 32px 32px 28px 36px;
    border-radius: 30px;
    margin-bottom: 18px;
    border-left-width: 8px;
    border-left-color: var(--ink-4);
}

.anatomia-theme.theme-classroom-detail .score-card-passed { border-left-color: var(--success); }
.anatomia-theme.theme-classroom-detail .score-card-failed { border-left-color: var(--danger); }

.anatomia-theme.theme-classroom-detail .score-title-label { font-size: 34px; color: var(--ink); }
.anatomia-theme.theme-classroom-detail .score-completed-label { font-size: 24px; color: var(--ink-3); }
.anatomia-theme.theme-classroom-detail .score-status-pill { font-size: 22px; border-radius: 100px; padding: 8px 20px; }
.anatomia-theme.theme-classroom-detail .score-status-pill-passed { color: var(--success); background-color: var(--success-soft); }
.anatomia-theme.theme-classroom-detail .score-status-pill-failed { color: var(--danger); background-color: var(--danger-soft); }
.anatomia-theme.theme-classroom-detail .score-mid-row { margin-top: 20px; }
.anatomia-theme.theme-classroom-detail .score-fraction-label { font-size: 28px; color: var(--ink-2); }
.anatomia-theme.theme-classroom-detail .score-percent-label { font-size: 60px; letter-spacing: -1px; }
.anatomia-theme.theme-classroom-detail .score-percent-label-passed { color: var(--success); }
.anatomia-theme.theme-classroom-detail .score-percent-label-failed { color: var(--danger); }
.anatomia-theme.theme-classroom-detail .score-bottom-row { margin-top: 18px; padding-top: 18px; border-top-color: var(--line); }
.anatomia-theme.theme-classroom-detail .score-meta-label { font-size: 24px; color: var(--ink-3); }

/* ---- Badges ---- */

.anatomia-theme.theme-classroom-detail .badge-card
{
    padding: 32px;
    border-radius: 30px;
    margin-bottom: 18px;
    align-items: center;
}

.anatomia-theme.theme-classroom-detail .badge-card-locked { background-color: var(--sunken); }

.anatomia-theme.theme-classroom-detail .badge-icon-box { width: 112px; height: 112px; border-radius: 32px; margin-right: 28px; }
.anatomia-theme.theme-classroom-detail .badge-icon-gold { background-color: rgb(254, 243, 176); }
.anatomia-theme.theme-classroom-detail .badge-icon-locked { background-color: var(--surface-solid); }
.anatomia-theme.theme-classroom-detail .badge-icon-emoji { font-size: 56px; }
.anatomia-theme.theme-classroom-detail .badge-title { font-size: 34px; color: var(--ink); }
.anatomia-theme.theme-classroom-detail .badge-title-locked { color: var(--ink-2); }
.anatomia-theme.theme-classroom-detail .badge-status { font-size: 26px; margin-top: 4px; margin-bottom: 16px; }
.anatomia-theme.theme-classroom-detail .badge-status-unlocked { color: var(--success); }
.anatomia-theme.theme-classroom-detail .badge-status-locked { color: var(--ink-3); }
.anatomia-theme.theme-classroom-detail .progress-track { height: 14px; border-radius: 7px; background-color: var(--track); }
.anatomia-theme.theme-classroom-detail .progress-fill { border-radius: 7px; }
.anatomia-theme.theme-classroom-detail .progress-fill-locked { background-color: var(--accent); }
.anatomia-theme.theme-classroom-detail .progress-label { font-size: 24px; }
.anatomia-theme.theme-classroom-detail .progress-label-complete { color: var(--success); }
.anatomia-theme.theme-classroom-detail .progress-footer-label { font-size: 24px; color: var(--ink-3); }
.anatomia-theme.theme-classroom-detail .progress-footer-label-right { color: var(--accent); }
