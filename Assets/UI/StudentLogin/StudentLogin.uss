/* =========================================================
   Anatomia 3D - Student Login & Create Account (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   All px values below are sized against that 1080-wide canvas
   (Panel Settings should reference 1080x1920 in "Scale With
   Screen Size" mode so this scales correctly to other devices).
   ========================================================= */

/* ---------- Full Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;

    flex-grow: 1;

    justify-content: center;
    align-items: center;

}

/* ---------- Center Container ---------- */

.screen-container
{
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding-left: 80px;
    padding-right: 80px;
    padding-top: 100px;
    padding-bottom: 100px;
}

/* ---------- Scroll View ---------- */

.scroll-view
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.scroll-view > #unity-content-container
{
    /* min-height (not height) is the trick: when the content is shorter
       than the viewport, this forces the container to fill it so
       justify-content can center the content-wrapper inside. When the
       content is taller than the viewport, min-height is simply
       satisfied by the content itself, so it lays out from the top and
       scrolls normally instead of being clipped/centered off-screen. */
    min-height: 100%;
    width: 100%;

    justify-content: center;
    align-items: center;
}

.scroll-view > .unity-scroller--vertical,
.scroll-view > #unity-scroller
{
    width: 0;
    opacity: 0;
}

.scroll-view > .unity-scroller--vertical > .unity-tracker,
.scroll-view > .unity-scroller--vertical > .unity-dragger,
.scroll-view > #unity-scroller > #unity-tracker,
.scroll-view > #unity-scroller > #unity-dragger
{
    display: none;
    opacity: 0;
    width: 0;
}

/* ---------- Main Column ---------- */

.content-wrapper
{
    width: 100%;
    max-width: 900px;
    flex-grow: 1;
    justify-content: center;
    align-items: stretch;
    align-self: center;
    flex-direction: column;
}

/* ---------- Fit-to-screen (login screens: no scrolling) ----------
   The screen root carries .fit-screen. Content is centered by flex and scaled
   down in code (FitToScreen.cs) if it doesn't fit, so it never scrolls.
   Scoped with .fit-screen so screens that share this file and still use a
   ScrollView (e.g. create account) are not affected. */

.fit-screen .scroll-view
{
    justify-content: center;
    align-items: center;
}

.fit-screen .content-wrapper
{
    flex-grow: 0;
    flex-shrink: 0;
}

/* =========================================================
   REDESIGN: shared by Student Login, Create Account and Forgot Password.
   Rules are scoped as ".anatomia-theme.screen-root .x" so they out-rank
   the generic theme rules (AnatomiaTheme.uss loads after this file).
   Each text field is the visible box (so :focus can outline it); its icon
   and the eye button float over the box. No emoji or glyph characters.
   ========================================================= */

/* ---------- Logo + titles ---------- */
.anatomia-theme.screen-root .logo-circle
{
    width: 168px;
    height: 168px;
    border-radius: 84px;
    align-self: center;
    margin-bottom: 26px;
    border-width: 4px;
    border-color: var(--surface-solid);
    background-image: url("project://database/Assets/UI/Icons/Anatomia-logo.png");
    background-position: center;
    background-size: cover;
}

.anatomia-theme.screen-root .app-title
{
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: -1px;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.anatomia-theme.screen-root .app-subtitle
{
    font-size: 28px;
    color: var(--ink-3);
    -unity-text-align: middle-center;
    margin-bottom: 44px;
    white-space: normal;
}

/* ---------- Card ---------- */
.anatomia-theme.screen-root .login-card,
.anatomia-theme.screen-root .create-account-card
{
    width: 100%;
    padding: 52px;
    margin-bottom: 36px;
    border-radius: 48px;
}

/* ---------- Labels / errors ---------- */
.anatomia-theme.screen-root .field-label
{
    font-size: 25px;
    -unity-font-style: bold;
    color: var(--ink-2);
    margin: 0 0 12px 4px;
}
.anatomia-theme.screen-root .field-label-spaced { margin-top: 30px; }

.anatomia-theme.screen-root .field-error
{
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--danger);
    margin: 10px 0 0 6px;
    white-space: normal;
}

/* ---------- Inputs ---------- */
.anatomia-theme.screen-root .input-container
{
    position: relative;
    width: 100%;
    height: auto;
    flex-direction: row;
    align-items: center;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: visible;
}

.anatomia-theme.screen-root .input-icon
{
    position: absolute;
    left: 30px;
    top: 34px;
    width: 44px;
    height: 44px;
    margin: 0;
    flex-shrink: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink-3);
}

.anatomia-theme.screen-root .icon-email { background-image: url("project://database/Assets/UI/Icons/email-icon.png"); }
.anatomia-theme.screen-root .icon-lock { background-image: url("project://database/Assets/UI/Icons/lock-icon.png"); }
.anatomia-theme.screen-root .icon-google { background-image: url("project://database/Assets/UI/Icons/google-icon.png"); background-size: contain; background-position: center; background-repeat: no-repeat; }
.anatomia-theme.screen-root .icon-fingerprint { background-image: url("project://database/Assets/UI/Icons/fingerprint-icon.png"); background-size: contain; background-position: center; background-repeat: no-repeat; }
.anatomia-theme.screen-root .icon-user { background-image: url("project://database/Assets/UI/Icons/user-icon.png"); }

.anatomia-theme.screen-root .input-field
{
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 33px;
    color: var(--ink);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.anatomia-theme.screen-root .input-field-with-right-icon { margin-right: 0; }

.anatomia-theme.screen-root .input-field > #unity-text-input
{
    height: 112px;
    padding-left: 92px;
    padding-right: 28px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    background-color: var(--sunken);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 30px;
    color: var(--ink);
    font-size: 33px;
    -unity-text-align: middle-left;
}
.anatomia-theme.screen-root .input-field-with-right-icon > #unity-text-input { padding-right: 100px; }
.anatomia-theme.screen-root .input-field > #unity-text-input:hover { border-color: var(--line-strong); }
.anatomia-theme.screen-root .input-field > #unity-text-input:focus { background-color: var(--surface-solid); border-color: var(--accent); }

/* Eye button floats over the right edge of the field */
.anatomia-theme.screen-root .input-icon-button
{
    position: absolute;
    right: 16px;
    top: 22px;
    width: 68px;
    height: 68px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--ink-3);
}
.anatomia-theme.screen-root .input-icon-button.icon-eye,
.anatomia-theme.screen-root .input-icon-button.icon-eye-off
{
    width: 68px;
    height: 68px;
    background-size: 40px 40px;
    background-position: center;
    background-repeat: no-repeat;
}
.anatomia-theme.screen-root .input-icon-button .icon-eye,
.anatomia-theme.screen-root .input-icon-button .icon-eye-off
{
    position: relative;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    -unity-background-image-tint-color: var(--ink-3);
}
.anatomia-theme.screen-root .icon-eye { background-image: url("project://database/Assets/UI/Icons/eye.png"); }
.anatomia-theme.screen-root .icon-eye.icon-eye-off,
.anatomia-theme.screen-root .icon-eye-off { background-image: url("project://database/Assets/UI/Icons/eye-off.png"); }
.anatomia-theme.screen-root .input-icon-button:hover { background-color: var(--sunken); border-radius: 34px; }

/* Icons that live inside buttons (not floating) */
.anatomia-theme.screen-root .icon-google,
.anatomia-theme.screen-root .icon-fingerprint
{
    position: relative;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    margin: 0 16px 0 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.anatomia-theme.screen-root .icon-google { -unity-background-image-tint-color: rgb(255, 255, 255); }
.anatomia-theme.screen-root .icon-fingerprint { -unity-background-image-tint-color: var(--accent); }

.anatomia-theme.screen-root #biometric-icon
{
    position: relative;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    margin: 0 16px 0 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

/* ---------- Links ---------- */
.anatomia-theme.screen-root .forgot-password-link
{
    align-self: flex-end;
    margin: 16px 0 0 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ---------- Primary button ---------- */
.anatomia-theme.screen-root .sign-in-button,
.anatomia-theme.screen-root .create-account-button
{
    width: 100%;
    height: 112px;
    margin: 36px 0 0 0;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
    border-width: 0;
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}

/* ---------- Biometric (outlined) ---------- */
.anatomia-theme.screen-root .biometric-button
{
    width: 100%;
    height: 112px;
    margin: 28px 0 0 0;
    padding: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-faint);
    border-width: 2px;
    border-color: var(--accent);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}
.anatomia-theme.screen-root .biometric-button:hover { background-color: var(--accent-soft); }
.anatomia-theme.screen-root .biometric-button-text { font-size: 32px; -unity-font-style: bold; color: var(--accent); }

/* ---------- Divider ---------- */
.anatomia-theme.screen-root .divider-row { flex-direction: row; align-items: center; margin: 34px 0; }
.anatomia-theme.screen-root .divider-line { flex-grow: 1; height: 1px; background-color: var(--line-strong); }
.anatomia-theme.screen-root .divider-text { margin: 0 22px; font-size: 24px; color: var(--ink-3); }

/* ---------- Google ---------- */
.anatomia-theme.screen-root .google-button
{
    width: 100%;
    height: 112px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line-strong);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}
.anatomia-theme.screen-root .google-button:hover { background-color: var(--sunken); }
.anatomia-theme.screen-root .google-button-text { font-size: 32px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.screen-root .google-button .icon-google { -unity-background-image-tint-color: rgb(255, 255, 255); }

/* ---------- Bottom links ---------- */
.anatomia-theme.screen-root .create-account-row,
.anatomia-theme.screen-root .bottom-links { flex-direction: row; justify-content: center; align-items: center; margin-top: 4px; }
.anatomia-theme.screen-root .create-account-text,
.anatomia-theme.screen-root .bottom-link-text { font-size: 27px; color: var(--ink-3); margin-right: 8px; }
.anatomia-theme.screen-root .create-account-link,
.anatomia-theme.screen-root .bottom-link-button
{
    padding: 0;
    margin: 0;
    font-size: 27px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.anatomia-theme.screen-root .admin-login-link
{
    align-self: center;
    margin-top: 22px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 34px;
    padding-right: 34px;
    font-size: 25px;
    -unity-font-style: bold;
    color: var(--ink-2);
    background-color: var(--sunken);
    border-width: 0;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
}
.anatomia-theme.screen-root .admin-login-link:hover { background-color: var(--track); }

/* Forgot password: back link with icon */
.anatomia-theme.screen-root .back-login-link
{
    position: relative;
    align-self: center;
    margin-top: 22px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 54px;
    padding-right: 20px;
    font-size: 27px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.anatomia-theme.screen-root .back-link-icon
{
    position: absolute;
    left: 6px;
    top: 14px;
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

/* ---------- Status ---------- */
.anatomia-theme.screen-root .status-label
{
    margin-top: 22px;
    font-size: 26px;
    color: var(--danger);
    -unity-text-align: middle-center;
    white-space: normal;
}
.anatomia-theme.screen-root .success-message
{
    margin-top: 24px;
    padding: 20px 26px;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--success);
    background-color: var(--success-soft);
    border-radius: 28px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Terms (create account, if present) ---------- */
.anatomia-theme.screen-root .terms-row { flex-direction: row; align-items: flex-start; margin: 30px 0 10px 0; width: 100%; }
.anatomia-theme.screen-root .terms-checkbox { width: 40px; height: 40px; min-width: 40px; margin: 2px 16px 0 0; border-radius: 12px; align-self: flex-start; }
.anatomia-theme.screen-root .terms-label-container { flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-items: center; }
.anatomia-theme.screen-root .terms-text { font-size: 25px; padding: 0; margin: 0; }
.anatomia-theme.screen-root .terms-link-button { font-size: 25px; -unity-font-style: bold; color: var(--accent); background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; margin: 0; height: auto; min-height: 0; }

/* ---------- Hover ---------- */
.anatomia-theme.screen-root .forgot-password-link:hover,
.anatomia-theme.screen-root .create-account-link:hover,
.anatomia-theme.screen-root .bottom-link-button:hover,
.anatomia-theme.screen-root .back-login-link:hover,
.anatomia-theme.screen-root .terms-link-button:hover { opacity: 0.8; }

/* =========================================================
   LAYOUT V2 - "open form": left-aligned brand block, no card around
   the form (fields sit directly on the ambient background), white
   bordered inputs, rounded-rectangle buttons. Placed before the
   compact/landscape blocks, whose selectors are more specific, so
   those still shrink things on small screens.
   ========================================================= */
.anatomia-theme.screen-root .content-wrapper { align-items: stretch; }

.anatomia-theme.screen-root .logo-circle
{
    width: 120px;
    height: 120px;
    border-radius: 36px;
    align-self: flex-start;
    margin-bottom: 34px;
    border-width: 0;
    background-color: var(--surface-solid);
}

.anatomia-theme.screen-root .app-title
{
    font-size: 62px;
    letter-spacing: -1.5px;
    -unity-text-align: middle-left;
    margin-bottom: 8px;
}

.anatomia-theme.screen-root .app-subtitle
{
    font-size: 30px;
    -unity-text-align: middle-left;
    margin-bottom: 52px;
}

.anatomia-theme.screen-root .login-card,
.anatomia-theme.screen-root .create-account-card
{
    padding: 0;
    margin-bottom: 34px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.anatomia-theme.screen-root .field-label { font-size: 24px; margin-left: 2px; }
.anatomia-theme.screen-root .field-label-spaced { margin-top: 28px; }
.anatomia-theme.screen-root .field-error { margin-left: 2px; }

.anatomia-theme.screen-root .input-icon { top: 32px; }
.anatomia-theme.screen-root .input-icon-button { top: 20px; }

.anatomia-theme.screen-root .input-field > #unity-text-input
{
    height: 108px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 28px;
}
.anatomia-theme.screen-root .input-field > #unity-text-input:hover { border-color: var(--ink-4); }
.anatomia-theme.screen-root .input-field > #unity-text-input:focus { background-color: var(--surface-solid); border-width: 2px; border-color: var(--accent); }

.anatomia-theme.screen-root .forgot-password-link { margin-top: 18px; }

.anatomia-theme.screen-root .sign-in-button,
.anatomia-theme.screen-root .create-account-button
{
    height: 108px;
    margin-top: 40px;
    border-radius: 32px;
}

.anatomia-theme.screen-root .biometric-button
{
    height: 108px;
    border-radius: 32px;
}

.anatomia-theme.screen-root .google-button
{
    height: 108px;
    border-radius: 32px;
}

.anatomia-theme.screen-root .divider-row { margin: 36px 0; }

.anatomia-theme.screen-root .create-account-row,
.anatomia-theme.screen-root .bottom-links
{
    justify-content: center;
    margin-top: 6px;
    padding-top: 26px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.anatomia-theme.screen-root .admin-login-link { margin-top: 26px; }

/* =========================================================
   Compact (narrow / short) - stacks with landscape and ultra-compact
   ========================================================= */
.compact .screen-container { padding-left: 40px; padding-right: 40px; padding-top: 60px; padding-bottom: 60px; }
.compact .content-wrapper { max-width: 100%; }
.anatomia-theme.screen-root.compact .logo-circle { width: 100px; height: 100px; border-radius: 30px; margin-bottom: 24px; }
.anatomia-theme.screen-root.compact .app-title { font-size: 50px; }
.anatomia-theme.screen-root.compact .app-subtitle { font-size: 24px; margin-bottom: 32px; }
.anatomia-theme.screen-root.compact .login-card,
.anatomia-theme.screen-root.compact .create-account-card { padding: 0; border-radius: 0; }
.anatomia-theme.screen-root.compact .field-label { font-size: 22px; }
.anatomia-theme.screen-root.compact .field-label-spaced { margin-top: 24px; }
.anatomia-theme.screen-root.compact .input-icon { left: 26px; top: 29px; width: 38px; height: 38px; }
.anatomia-theme.screen-root.compact .input-field > #unity-text-input { height: 100px; padding-left: 80px; font-size: 29px; border-radius: 26px; }
.anatomia-theme.screen-root.compact .input-field-with-right-icon > #unity-text-input { padding-right: 88px; }
.anatomia-theme.screen-root.compact .input-icon-button { top: 16px; right: 12px; }
.anatomia-theme.screen-root.compact .sign-in-button,
.anatomia-theme.screen-root.compact .create-account-button,
.anatomia-theme.screen-root.compact .google-button,
.anatomia-theme.screen-root.compact .biometric-button { height: 98px; margin-top: 28px; }
.anatomia-theme.screen-root.compact .google-button { margin-top: 0; }
.anatomia-theme.screen-root.compact .sign-in-button,
.anatomia-theme.screen-root.compact .create-account-button { font-size: 30px; }
.anatomia-theme.screen-root.compact .google-button-text,
.anatomia-theme.screen-root.compact .biometric-button-text { font-size: 28px; }
.anatomia-theme.screen-root.compact .divider-row { margin: 26px 0; }
.anatomia-theme.screen-root.compact .create-account-text,
.anatomia-theme.screen-root.compact .bottom-link-text,
.anatomia-theme.screen-root.compact .create-account-link,
.anatomia-theme.screen-root.compact .bottom-link-button { font-size: 24px; }
.anatomia-theme.screen-root.compact .terms-text,
.anatomia-theme.screen-root.compact .terms-link-button { font-size: 22px; }

.landscape .screen-container { padding-top: 24px; padding-bottom: 24px; }
.anatomia-theme.screen-root.landscape .logo-circle { width: 72px; height: 72px; border-radius: 22px; margin-bottom: 10px; }
.anatomia-theme.screen-root.landscape .app-title { font-size: 36px; }
.anatomia-theme.screen-root.landscape .app-subtitle { font-size: 22px; margin-bottom: 18px; }
.anatomia-theme.screen-root.landscape .login-card,
.anatomia-theme.screen-root.landscape .create-account-card { padding: 0; margin-bottom: 18px; }
.anatomia-theme.screen-root.landscape .field-label-spaced { margin-top: 16px; }
.anatomia-theme.screen-root.landscape .input-icon { top: 22px; }
.anatomia-theme.screen-root.landscape .input-field > #unity-text-input { height: 82px; }
.anatomia-theme.screen-root.landscape .input-icon-button { top: 7px; }
.anatomia-theme.screen-root.landscape .sign-in-button,
.anatomia-theme.screen-root.landscape .create-account-button,
.anatomia-theme.screen-root.landscape .google-button,
.anatomia-theme.screen-root.landscape .biometric-button { height: 80px; margin-top: 20px; }
.anatomia-theme.screen-root.landscape .google-button { margin-top: 0; }
.anatomia-theme.screen-root.landscape .divider-row { margin: 16px 0; }

.ultra-compact .screen-container { padding-left: 24px; padding-right: 24px; }
.anatomia-theme.screen-root.ultra-compact .login-card,
.anatomia-theme.screen-root.ultra-compact .create-account-card { padding: 0; }
.anatomia-theme.screen-root.ultra-compact .app-title { font-size: 38px; }
.anatomia-theme.screen-root.ultra-compact .field-label { font-size: 20px; }
.anatomia-theme.screen-root.ultra-compact .input-field > #unity-text-input { font-size: 26px; padding-left: 70px; }
.anatomia-theme.screen-root.ultra-compact .input-icon { left: 22px; width: 34px; height: 34px; }
.anatomia-theme.screen-root.ultra-compact .sign-in-button,
.anatomia-theme.screen-root.ultra-compact .create-account-button { font-size: 28px; }
.anatomia-theme.screen-root.ultra-compact .google-button-text,
.anatomia-theme.screen-root.ultra-compact .biometric-button-text { font-size: 25px; }
