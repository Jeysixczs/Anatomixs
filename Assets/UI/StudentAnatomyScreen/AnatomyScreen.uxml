<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StudentAnatomyScreen/AnatomyScreen.uss?fileID=7433441132597879392&amp;guid=62dedd22c8859834da2c5fc911aaa7ba&amp;type=3#AnatomyScreen"/>
    <ui:VisualElement name="Screen" class="screen">
        <ui:VisualElement name="TopBar" class="top-bar">
            <ui:Button name="BackButton" text="‹" class="back-button"/>
            <ui:VisualElement name="TitleBlock" class="title-block">
                <ui:Label text="&lt;color=#22C582&gt;Anatomia&lt;/color&gt;&lt;color=#3B82F6&gt;Learn 3D&lt;/color&gt;" name="AppTitle" enable-rich-text="true" class="app-title"/>
                <ui:Label text="SKELETAL SYSTEM" name="AppSubtitle" class="app-subtitle"/>
            </ui:VisualElement>
            <ui:VisualElement name="TopBarTrailing" class="top-bar-trailing">
                <ui:Label name="PlayModeProgressLabel" text="" class="play-mode-progress-label"/>
                <ui:Label name="TeacherSelectionModeLabel" text="SELECT A STRUCTURE FOR YOUR QUESTION" class="teacher-selection-mode-label hidden"/>
                <ui:Button name="BaselineFinishButton" text="Finish" class="baseline-finish-button hidden"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SearchBar" class="search-bar">
            <ui:Label text="🔍" name="SearchIcon" class="search-icon" style="-unity-font-definition: initial; background-image: url(&quot;project://database/Assets/UI/Icons/search-icon.png?fileID=2800000&amp;guid=46917629dafc20049adaebe048c8263a&amp;type=3#search-icon&quot;); height: 51px; width: 48px;"/>
            <ui:TextField name="SearchField" placeholder-text="Search bones..." class="search-field"/>
            <ui:Button name="SearchClearButton" text="✕" class="search-clear-button hidden"/>
        </ui:VisualElement>
        <ui:VisualElement name="BodyArea" class="body-area">
            <ui:Button name="ControlsGuideButton" class="controls-guide-fab">
                <ui:Label text="?" class="controls-guide-fab-icon"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="InfoPanel" class="info-panel hidden">
            <ui:VisualElement name="Header" class="header">
                <ui:VisualElement name="DragIndicator" picking-mode="Ignore" class="drag-indicator"/>
                <ui:VisualElement name="HeaderLeft" class="header-left">
                    <ui:VisualElement name="InfoIcon" class="info-icon">
                        <ui:Label text="i" name="InfoIconLabel" class="info-icon-label"/>
                    </ui:VisualElement>
                    <ui:Label text="Thoracic Cage (Ribs)" name="TitleLabel" class="title-label"/>
                </ui:VisualElement>
                <ui:Button name="MinimizeButton" text="−" class="minimize-button"/>
                <ui:Button name="CloseButton" text="✕" class="close-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="BodyWrapper" class="body-wrapper">
                <ui:ScrollView name="Body" mode="Vertical" class="body">
                    <ui:Label name="DescriptionLabel" text="The rib cage protects the heart and lungs. It consists of 12 pairs of ribs, the sternum (breastbone), and the thoracic vertebrae. The ribs are curved bones that articulate with the spine at the back." class="description-label"/>
                    <ui:VisualElement name="PlayModeLetterRow" class="play-mode-letter-row"/>
                </ui:ScrollView>
                <ui:VisualElement name="ScrollHint" picking-mode="Ignore" class="scroll-hint hidden">
                    <ui:Label text="⌄ Scroll for more" name="ScrollHintLabel" class="scroll-hint-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PlayModeControls" class="play-mode-controls hidden">
                <ui:Button name="PlayModeHintButton" class="play-mode-hint-btn">
                    <ui:Label text="💡" class="play-mode-btn-icon"/>
                    <ui:Label text="Hint" class="play-mode-btn-label"/>
                </ui:Button>
                <ui:Button name="PlayModeSubmitButton" class="play-mode-submit-btn">
                    <ui:Label text="SUBMIT" class="play-mode-btn-label"/>
                    <ui:Label text="→" class="play-mode-btn-icon"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="TeacherSelectionControls" class="teacher-selection-controls hidden">
                <ui:Button name="TeacherSelectStructureButton" class="teacher-select-structure-btn">
                    <ui:Label text="SELECT THIS STRUCTURE" class="teacher-select-structure-btn-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="QuizHighlightControls" class="quiz-highlight-controls hidden">
                <ui:Button name="LocateStructureButton" class="locate-structure-btn">
                    <ui:Label text="🎯" class="locate-structure-btn-icon"/>
                    <ui:Label text="LOCATE STRUCTURE" class="locate-structure-btn-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="AudioRow" class="audio-row">
                <ui:VisualElement name="AudioLabelGroup" picking-mode="Ignore" class="audio-label-group">
                    <ui:Label text="AUDIO GUIDE" name="AudioLabel" class="audio-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="AudioControls" class="audio-controls">
                    <ui:Button name="PlayButton" text="▶" class="audio-btn play-btn"/>
                    <ui:Button name="StopButton" text="■" class="audio-btn stop-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ResizeHandle" picking-mode="Position" class="resize-handle">
                <ui:Label text="⤡" name="ResizeHandleIcon" picking-mode="Ignore" class="resize-handle-icon"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomToolbar" class="bottom-toolbar" style="margin-right: 50px; margin-bottom: 50px; margin-left: 50px; border-bottom-right-radius: 48px; border-bottom-left-radius: 48px;">
            <ui:VisualElement name="AnatomyControlsSection" class="toolbar-section">
                <ui:Label text="ANATOMY CONTROLS" class="toolbar-section-label"/>
                <ui:VisualElement name="AnatomyControlsRow" class="toolbar-row">
                    <ui:Button name="ResetButton" class="toolbar-btn">
                        <ui:Label text="↺" class="toolbar-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/reset-icon.png?fileID=2800000&amp;guid=e7a8a30d7164699418de34067dd22b69&amp;type=3#reset-icon&quot;); -unity-background-image-tint-color: rgb(34, 160, 110); border-left-color: rgb(34, 160, 110); border-right-color: rgb(34, 160, 110); border-top-color: rgb(34, 160, 110); border-bottom-color: rgb(34, 160, 110); -unity-font-definition: initial; height: 52px; width: 54px; background-color: rgba(55, 55, 55, 0);"/>
                        <ui:Label text="Reset" class="toolbar-label"/>
                    </ui:Button>
                    <ui:Button name="IsolateButton" class="toolbar-btn">
                        <ui:Label text="◎" class="toolbar-icon" style="-unity-font-style: bold; background-image: url(&quot;project://database/Assets/UI/Icons/Isolate-icon.png?fileID=2800000&amp;guid=96c3718f85fbb3642aa083033ca8dc42&amp;type=3#Isolate-icon&quot;); -unity-font-definition: initial; color: rgb(55, 55, 55); height: 67px; width: 62px;"/>
                        <ui:Label text="Isolate" class="toolbar-label"/>
                    </ui:Button>
                    <ui:Button name="HideButton" class="toolbar-btn">
                        <ui:Label text="👁" class="toolbar-icon hide-button" style="display: flex; -unity-background-image-tint-color: rgb(55, 55, 55); -unity-font-style: bold; -unity-font-definition: initial; background-image: url(&quot;project://database/Assets/UI/Icons/hide-icon.png?fileID=2800000&amp;guid=e906549f2d19035478ae238930b629f0&amp;type=3#hide-icon&quot;); height: 60px; width: 62px;"/>
                        <ui:Label text="Hide" name="unity-hidelabel" class="toolbar-label"/>
                    </ui:Button>
                    <ui:Button name="UndoButton" class="toolbar-btn toolbar-btn-disabled">
                        <ui:Label text="↶" class="toolbar-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/undo-icon.png?fileID=2800000&amp;guid=3afd37646364bc1438477ec32824e233&amp;type=3#undo-icon&quot;); height: 54px; width: 49px; -unity-font-definition: initial;"/>
                        <ui:Label text="Undo" class="toolbar-label"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="QuestionControlsSection" class="toolbar-section toolbar-section-divider" style="display: none;">
                <ui:Label text="QUESTION CONTROLS" class="toolbar-section-label"/>
                <ui:VisualElement name="QuestionControlsRow" class="toolbar-row">
                    <ui:Button name="IsolateAnsweredButton" class="toolbar-btn">
                        <ui:Label text="✓" class="toolbar-icon" style="-unity-font-style: bold; -unity-font-definition: initial; color: rgb(55, 55, 55); font-size: 40px; background-image: url(&quot;project://database/Assets/UI/Icons/check-icon.png?fileID=2800000&amp;guid=06723f7d3e12a85439ab9da9bbcf3a33&amp;type=3#check-icon&quot;); background-size: 100% 100%; width: 62px; height: 67px;"/>
                        <ui:Label text="Answered" class="toolbar-label"/>
                    </ui:Button>
                    <ui:Button name="UnansweredButton" class="toolbar-btn">
                        <ui:Label text="" class="toolbar-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/ex-icon.png?fileID=2800000&amp;guid=ca0f94c61f80e3c4194692be403e874c&amp;type=3#ex-icon&quot;); width: 62px; height: 67px;"/>
                        <ui:Label text="Unanswered" class="toolbar-label"/>
                    </ui:Button>
                    <ui:Button name="RandomButton" class="toolbar-btn">
                        <ui:Label text="" class="toolbar-icon" style="background-image: url(&quot;project://database/Assets/UI/Icons/random-icon.png?fileID=2800000&amp;guid=25cdf87d28c14ea4fb4503785b6832aa&amp;type=3#random-icon&quot;); width: 62px; height: 67px;"/>
                        <ui:Label text="Random" class="toolbar-label"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="SearchResults" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="search-results hidden"/>
        <ui:VisualElement name="PlayModeCompletionPanel" class="play-mode-completion-panel hidden">
            <ui:Label name="PlayModeCompletionLabel" text="" class="play-mode-completion-label"/>
            <ui:Button name="PlayModeCompletionCloseButton" text="Continue" class="audio-btn play-mode-completion-close-btn"/>
        </ui:VisualElement>
        <ui:VisualElement name="NoHintsPanel" class="no-hints-overlay hidden">
            <ui:VisualElement name="NoHintsCard" class="no-hints-card">
                <ui:VisualElement class="no-hints-icon-circle">
                    <ui:Label text="&#9203;" class="no-hints-icon"/>
                </ui:VisualElement>
                <ui:Label text="No More Hints Today" class="no-hints-title"/>
                <ui:Label name="NoHintsLabel" text="" class="no-hints-message"/>
                <ui:Button name="NoHintsCloseButton" text="Got it" class="no-hints-close-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ControlsGuideOverlay" class="controls-guide-overlay hidden">
            <ui:VisualElement name="ControlsGuideBackdrop" class="controls-guide-backdrop"/>
            <ui:VisualElement name="ControlsGuideCard" class="controls-guide-card">
                <ui:VisualElement name="ControlsGuideHeader" class="controls-guide-header">
                    <ui:Label text="How to Use the Toolbar" class="controls-guide-title"/>
                    <ui:Button name="ControlsGuideCloseButton" text="✕" class="controls-guide-close-button"/>
                </ui:VisualElement>
                <ui:ScrollView name="ControlsGuideBody" mode="Vertical" class="controls-guide-body">
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/reset-icon.png?fileID=2800000&amp;guid=e7a8a30d7164699418de34067dd22b69&amp;type=3#reset-icon&quot;); -unity-background-image-tint-color: rgb(34, 160, 110); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Reset" class="controls-guide-row-title"/>
                            <ui:Label text="Puts the model and camera back to their starting position and rotation, and clears the current selection." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/Isolate-icon.png?fileID=2800000&amp;guid=96c3718f85fbb3642aa083033ca8dc42&amp;type=3#Isolate-icon&quot;); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Isolate" class="controls-guide-row-title"/>
                            <ui:Label text="Hides every other structure so only the one you've selected stays visible - useful for studying a single part on its own." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/hide-icon.png?fileID=2800000&amp;guid=e906549f2d19035478ae238930b629f0&amp;type=3#hide-icon&quot;); -unity-background-image-tint-color: rgb(55, 55, 55); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Hide" class="controls-guide-row-title"/>
                            <ui:Label text="Toggles the selected structure's visibility on and off, so you can see what's underneath or behind it." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/undo-icon.png?fileID=2800000&amp;guid=3afd37646364bc1438477ec32824e233&amp;type=3#undo-icon&quot;); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Undo" class="controls-guide-row-title"/>
                            <ui:Label text="Steps back through your last Isolate/Hide changes, one at a time." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-guide-divider"/>
                    <ui:Label text="During a quiz, these also appear:" class="controls-guide-note"/>
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/check-icon.png?fileID=2800000&amp;guid=06723f7d3e12a85439ab9da9bbcf3a33&amp;type=3#check-icon&quot;); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Answered" class="controls-guide-row-title"/>
                            <ui:Label text="Shows only the structures you've already identified correctly." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/ex-icon.png?fileID=2800000&amp;guid=ca0f94c61f80e3c4194692be403e874c&amp;type=3#ex-icon&quot;); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Unanswered" class="controls-guide-row-title"/>
                            <ui:Label text="Shows only the structures you haven't identified yet." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="controls-guide-row">
                        <ui:VisualElement class="controls-guide-row-icon">
                            <ui:VisualElement class="controls-guide-row-icon-img" style="background-image: url(&quot;project://database/Assets/UI/Icons/random-icon.png?fileID=2800000&amp;guid=25cdf87d28c14ea4fb4503785b6832aa&amp;type=3#random-icon&quot;); width: 44px; height: 44px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="controls-guide-row-text">
                            <ui:Label text="Random" class="controls-guide-row-title"/>
                            <ui:Label text="Jumps you to a random structure you haven't answered yet." class="controls-guide-row-desc"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Button name="ControlsGuideGotItButton" text="Got it" class="controls-guide-gotit-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BaselineFinishConfirmPanel" class="baseline-confirm-overlay hidden">
            <ui:VisualElement name="BaselineFinishConfirmCard" class="baseline-confirm-card">
                <ui:VisualElement class="baseline-confirm-icon-circle">
                    <ui:Label text="&#9888;" class="baseline-confirm-icon"/>
                </ui:VisualElement>
                <ui:Label text="Finish Now?" class="baseline-confirm-title"/>
                <ui:Label name="BaselineFinishConfirmMessage" text="" class="baseline-confirm-message"/>
                <ui:VisualElement name="BaselineFinishConfirmActions" class="baseline-confirm-actions">
                    <ui:Button name="BaselineFinishConfirmCancelButton" text="Keep Going" class="baseline-confirm-cancel-btn"/>
                    <ui:Button name="BaselineFinishConfirmYesButton" text="Finish Now" class="baseline-confirm-yes-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
