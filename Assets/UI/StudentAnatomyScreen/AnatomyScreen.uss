    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 12px;
    -unity-text-align: middle-left;
}

.play-mode-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    flex-grow: 0;
    padding-left: 26px;
    padding-right: 30px;
    padding-top: 14px;
    padding-bottom: 30px;
    background-color: rgb(244, 249, 247);
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0.06);
}

.play-mode-hint-btn,
.play-mode-submit-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: auto;
    padding: 12px 22px;
    margin: 0;
    border-radius: 28px;
    flex-shrink: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.play-mode-hint-btn {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.1);
}

.play-mode-hint-btn:hover {
    background-color: rgb(237, 245, 242);
}

.play-mode-submit-btn {
    background-color: rgb(34, 197, 130);
    border-width: 0;
}

.play-mode-submit-btn:hover {
    background-color: rgb(30, 178, 116);
    scale: 1.03 1.03;
}

.play-mode-btn-icon {
    font-size: 20px;
    -unity-text-align: middle-center;
}

.play-mode-hint-btn .play-mode-btn-icon {
    margin-right: 8px;
}

.play-mode-submit-btn .play-mode-btn-icon {
    color: rgb(255, 255, 255);
    margin-left: 8px;
    -unity-font-style: bold;
}

.play-mode-btn-label {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.play-mode-hint-btn .play-mode-btn-label {
    color: rgb(60, 70, 68);
}

.play-mode-submit-btn .play-mode-btn-label {
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

/* ===== Teacher Selection Mode (Admin Quiz Management's Image-Based picker) ===== */

.teacher-selection-mode-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 12px;
    -unity-text-align: middle-left;
}

.teacher-selection-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-grow: 0;
    padding-left: 26px;
    padding-right: 30px;
    padding-top: 14px;
    padding-bottom: 30px;
    background-color: rgb(244, 247, 252);
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0.06);
}

.teacher-select-structure-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 22px;
    margin: 0;
    border-radius: 28px;
    flex-shrink: 0;
    background-color: rgb(37, 99, 235);
    border-width: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.teacher-select-structure-btn:hover {
    background-color: rgb(29, 82, 199);
    scale: 1.02 1.02;
}

.teacher-select-structure-btn:disabled {
    background-color: rgb(180, 190, 210);
}

.teacher-select-structure-btn-label {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

/* ===== Quiz Highlight Mode (student Image-Based "View on 3D Model") ===== */

.quiz-highlight-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-grow: 0;
    padding-left: 26px;
    padding-right: 30px;
    padding-top: 14px;
    padding-bottom: 30px;
    background-color: rgb(244, 247, 252);
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0.06);
}

.locate-structure-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 22px;
    margin: 0;
    border-radius: 28px;
    flex-shrink: 0;
    background-color: rgb(16, 137, 118);
    border-width: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.locate-structure-btn:hover {
    background-color: rgb(12, 110, 95);
    scale: 1.02 1.02;
}

.locate-structure-btn:disabled {
    background-color: rgb(180, 190, 210);
}

.locate-structure-btn-icon {
    font-size: 20px;
    margin-right: 8px;
}

.locate-structure-btn-label {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

/* Wraps whole word-groups (.letter-word-group), not individual letter
   boxes - each group is laid out with flex-wrap: nowrap so a word's own
   boxes never split across lines (see .letter-word-group below), while
   this row's flex-wrap: wrap lets a whole group drop to the next line
   once it no longer fits. Long answers grow the row downward instead of
   shrinking anything - the parent .body ScrollView already scrolls
   vertically, so there's nothing extra to do for very long names. */
.play-mode-letter-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    margin-top: 22px;
    margin-left: 8px;
    margin-right: 8px;
}

/* One word of the answer - its letter boxes stay glued together
   (flex-wrap: nowrap) and the group itself is the atomic unit that
   .play-mode-letter-row wraps by. The right/bottom margins are what
   create the "gap instead of a box" look for spaces between words. */
.letter-word-group {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    margin-right: 18px;
    margin-bottom: 14px;
}

.letter-box {
    width: 42px;
    height: 52px;
    margin-right: 6px;
    flex-shrink: 0;
}

.letter-box > .unity-text-field__input {
    /* Unity's default text-field theme adds its own padding/margin,
       which was eating into this already-small 42x52 box and could
       clip or off-center a bold 22px character. Zeroing those out and
       stretching the input to fill the box exactly makes
       -unity-text-align: middle-center actually center within the
       full box instead of a smaller, unpredictable inner area. */
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(34, 160, 110, 0.35);
    background-color: rgb(247, 250, 249);
}

.letter-box-revealed > .unity-text-field__input {
    color: rgb(34, 160, 110);
    background-color: rgba(34, 160, 110, 0.12);
    border-color: rgb(34, 160, 110);
}

/* The box currently focused for typing - a stronger version of the
   default green so it's easy to spot at a glance which letter is
   active, especially once the answer spans several wrapped rows. */
.letter-box-active > .unity-text-field__input {
    border-color: rgb(34, 197, 130);
    border-width: 3px;
    background-color: rgba(34, 197, 130, 0.08);
}

/* The box the player just tapped directly, armed to have its letter
   overwritten by the very next keystroke - see
   AnatomyPlayModeController.SelectBoxForEdit. Placed after
   .letter-box-active so a tapped box reads as "selected" (blue) rather
   than "next in line" (green) even if both classes are present at once. */
.letter-box-selected > .unity-text-field__input {
    border-color: rgb(59, 130, 246);
    border-width: 3px;
    background-color: rgba(59, 130, 246, 0.12);
}

/* The single real (hidden) input every Play Mode keystroke goes to - see
   the comment above AnatomyPlayModeController.BuildLetterBoxes. Can't use
   display: none (an element with display: none can't receive focus or
   keyboard input at all) - instead it stays in the layout at a
   near-zero, fully transparent size, tucked off to the side. */
.letter-master-input {
    position: absolute;
    left: -1000px;
    top: 0;
    width: 4px;
    height: 4px;
    opacity: 0;
}

.play-mode-completion-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
}

.play-mode-completion-label {
    background-color: rgb(255, 255, 255);
    border-radius: 24px;
    padding: 32px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 560px;
}

.play-mode-completion-close-btn {
    margin-top: 20px;
    width: auto;
    padding-left: 24px;
    padding-right: 24px;
}

/* ===== No Hints Left popup (daily per-system hint limit reached) =====
   Deliberately distinct from .play-mode-completion-panel above: that one
   is a celebration (quiz finished), this one is a "come back later"
   notice, so it gets its own amber/hourglass identity instead of
   borrowing the completion panel's plain white celebratory card. The
   close button still uses the app's primary green so it reads as the
   one clear action, consistent with play-btn/letter-box-active elsewhere. */
.no-hints-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(20, 30, 28, 0.55);
    justify-content: center;
    align-items: center;
}

.no-hints-card {
    background-color: rgb(255, 255, 255);
    border-radius: 28px;
    padding: 36px 32px 28px 32px;
    max-width: 420px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
}

.no-hints-icon-circle {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgba(255, 176, 32, 0.16);
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
}

.no-hints-icon {
    font-size: 32px;
    -unity-text-align: middle-center;
}

.no-hints-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(40, 50, 48);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.no-hints-message {
    font-size: 15px;
    color: rgb(110, 120, 118);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 340px;
    margin-bottom: 24px;
}

.no-hints-close-btn {
    width: auto;
    min-width: 140px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(34, 197, 130);
    color: rgb(255, 255, 255);
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
    padding-left: 28px;
    padding-right: 28px;
    margin: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.no-hints-close-btn:hover {
    background-color: rgb(30, 178, 116);
    scale: 1.03 1.03;
}

/* ===== Controls Guide (floating "how to use the controls" help) ===== */

/* Floating "?" button, pinned to BodyArea's own bottom-right corner
   (BodyArea is position:relative) so it sits directly above
   BottomToolbar - the guide it opens explains that toolbar specifically. */
.controls-guide-fab {
    position: absolute;
    bottom: 24px;
    right: 24px;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    padding: 0;
    margin: 0;
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
    justify-content: center;
    align-items: center;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.controls-guide-fab:hover {
    background-color: rgb(255, 255, 255);
    scale: 1.05 1.05;
}

.controls-guide-fab-icon {
    color: rgb(34, 160, 110);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Full-screen dimmed backdrop + centered floating card, same stacking
   trick as .play-mode-completion-panel: this is the LAST child of
   Screen in the UXML, so it draws above everything else, including the
   bottom toolbar and info panel. */
.controls-guide-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    padding: 48px;
}

.controls-guide-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.controls-guide-card {
    width: 100%;
    max-width: 640px;
    max-height: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    overflow: hidden;
}

.controls-guide-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 32px;
    padding-right: 20px;
    padding-top: 26px;
    padding-bottom: 26px;
    background-color: rgb(34, 197, 130);
    flex-shrink: 0;
}

.controls-guide-title {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.controls-guide-close-button {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.controls-guide-close-button:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

.controls-guide-body {
    flex-shrink: 1;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 28px;
    padding-bottom: 12px;
}

.controls-guide-row {
    flex-direction: row;
    margin-bottom: 26px;
}

.controls-guide-row-icon {
    width: 64px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 2px;
}

.controls-guide-row-icon-img {
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}

.controls-guide-row-text {
    flex-direction: column;
    flex-shrink: 1;
}

.controls-guide-row-title {
    color: rgb(30, 40, 38);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.controls-guide-row-desc {
    color: rgb(110, 120, 118);
    font-size: 24px;
    white-space: normal;
    -unity-paragraph-spacing: 6px;
}

.controls-guide-divider {
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.08);
    margin-top: 4px;
    margin-bottom: 22px;
    padding-top: 22px;
}

.controls-guide-note {
    color: rgb(150, 160, 158);
    font-size: 21px;
    white-space: normal;
    margin-bottom: 22px;
}

.controls-guide-gotit-button {
    align-self: stretch;
    margin: 24px 32px 32px 32px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-radius: 24px;
    background-color: rgb(34, 197, 130);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.controls-guide-gotit-button:hover {
    background-color: rgb(30, 178, 116);
}

/* ===== Baseline Assessment (Pretest/Posttest) - Finish button ===== */
/* Pinned to the far right of TopBar regardless of title/subtitle length,
   at the same height as the mode badge next to it - no longer stretched
   full-height using the modal "Got it" button style. */

.top-bar-trailing {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
}

.baseline-finish-button {
    width: auto;
    height: 66px;
    padding: 0 32px;
    margin: 0;
    border-radius: 33px;
    background-color: rgb(59, 130, 246);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.baseline-finish-button:hover {
    background-color: rgb(37, 99, 235);
    scale: 1.03 1.03;
}

/* ===== Baseline Assessment - "Finish Now?" confirmation ===== */
/* Dedicated, full-scale dialog (matches the rest of the 1080x1920 canvas,
   e.g. QuizScreen's .blocked-* overlay) instead of reusing the much
   smaller .no-hints-* tooltip styles. Cancel/confirm sit side by side
   with distinct weight so the safe choice ("Keep Going") doesn't look
   identical to the destructive one ("Finish Now"). */

.baseline-confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 18, 28, 0.72);
    justify-content: center;
    align-items: center;
    padding: 53px;
}

.baseline-confirm-card {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 54px 42px 42px 42px;
    align-items: center;
    max-width: 720px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
}

.baseline-confirm-icon-circle {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgba(255, 176, 32, 0.16);
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
}

.baseline-confirm-icon {
    font-size: 44px;
    -unity-text-align: middle-center;
}

.baseline-confirm-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(17, 24, 39);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
}

.baseline-confirm-message {
    font-size: 26px;
    color: rgb(107, 114, 128);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 560px;
    margin-bottom: 36px;
}

.baseline-confirm-actions {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.baseline-confirm-cancel-btn {
    flex-grow: 1;
    height: 90px;
    border-radius: 24px;
    background-color: rgb(243, 244, 246);
    color: rgb(31, 36, 48);
    border-width: 0;
    font-size: 26px;
    -unity-font-style: bold;
    margin-right: 12px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.baseline-confirm-cancel-btn:hover {
    background-color: rgb(229, 231, 235);
}

.baseline-confirm-yes-btn {
    flex-grow: 1;
    height: 90px;
    border-radius: 24px;
    background-color: rgb(239, 68, 68);
    color: rgb(255, 255, 255);
    border-width: 0;
    font-size: 26px;
    -unity-font-style: bold;
    margin-left: 12px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.baseline-confirm-yes-btn:hover {
    background-color: rgb(220, 38, 38);
    scale: 1.03 1.03;
}

/* ---------------- COMPACT BREAKPOINT (narrow / small devices) ---------------- */

.compact .baseline-confirm-card {
    padding: 42px 30px 30px 30px;
}

.compact .baseline-confirm-title {
    font-size: 28px;
}

.compact .baseline-confirm-message {
    font-size: 22px;
}

.compact .baseline-confirm-actions {
    flex-direction: column;
}

.compact .baseline-confirm-cancel-btn,
.compact .baseline-confirm-yes-btn {
    margin: 0 0 16px 0;
    height: 78px;
}

.compact .baseline-finish-button {
    height: 58px;
    font-size: 22px;
    padding: 0 24px;
}


/* ---------------- BASELINE SAVING OVERLAY (saving pretest/posttest result) ----------------
   Shown while OnAssessmentCompleted is recording the finished session via
   BaselineAssessmentService (Firebase write) and about to navigate away. Same
   pattern as StudentEditProfile's loading overlay: a ring spinner rotated
   continuously from the controller via schedule.Execute (UI Toolkit has no USS
   keyframe animation), plus a delayed "still working" hint for slow connections. */

.baseline-saving-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 18, 28, 0.72);
    justify-content: center;
    align-items: center;
    padding: 60px;
}

.baseline-saving-card {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 54px 48px;
    align-items: center;
    max-width: 620px;
}

.baseline-saving-spinner {
    width: 64px;
    height: 64px;
    border-width: 6px;
    border-radius: 32px;
    border-top-color: rgb(136, 45, 226);
    border-left-color: rgb(136, 45, 226);
    border-right-color: rgb(136, 45, 226);
    border-bottom-color: rgba(136, 45, 226, 0.15);
    margin-bottom: 28px;
}

.baseline-saving-message {
    font-size: 30px;
    color: rgb(31, 36, 48);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
}

.baseline-saving-submessage {
    font-size: 22px;
    color: rgb(107, 114, 128);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 12px;
}

.baseline-saving-submessage.hidden {
    display: none;
}

.compact .baseline-saving-overlay {
    padding: 30px;
}
