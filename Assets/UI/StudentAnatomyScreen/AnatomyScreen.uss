}

.resize-handle-icon {
    font-size: 16px;
    color: rgb(150, 160, 158);
    -unity-text-align: middle-center;
    rotate: 90deg;
}

.hidden {
    display: none;
}

/* ===== Play Mode ===== */

.play-mode-progress-label {
