/* =========================================================
   Anatomia 3D - Forgot Password (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   All px values below are sized against that 1080-wide canvas
   (Panel Settings should reference 1080x1920 in "Scale With
   Screen Size" mode so this scales correctly to other devices).
   ========================================================= */

/* ---------- Full Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;

    flex-grow: 1;

    justify-content: center;
    align-items: center;

    background-color: rgb(234,243,251);
}

/* ---------- Center Container ---------- */

.screen-container
{
    width: 100%;
    height: 100%;

    justify-content: center;
    align-items: center;

    flex-direction: column;

    padding-left: 80px;
    padding-right: 80px;
    padding-top: 100px;
    padding-bottom: 100px;
}

/* ---------- Main Column ---------- */

.content-wrapper
{
    width: 100%;
    max-width: 900px;

    flex-grow: 1;

    justify-content: center;

    align-items: stretch;

    flex-direction: column;
}

/* ---------- Logo ---------- */

.logo-circle
{
    width: 220px;
    height: 220px;

    align-self: center;

    border-radius: 110px;

    background-image: url("project://database/Assets/UI/Icons/Anatomia-logo.png");

    background-position: center;

    margin-bottom: 30px;
}

/* ---------- Title ---------- */

.app-title
{
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(31,36,48);
    -unity-text-align: middle-center;

    margin-bottom: 10px;
}

.app-subtitle
{
    font-size: 34px;
    color: rgb(138,143,163);
    -unity-text-align: middle-center;

    margin-bottom: 60px;
}

/* ---------- Card ---------- */

.login-card
{
    width: 100%;

    background-color: white;

    border-radius: 48px;

    padding-left: 60px;
    padding-right: 60px;
    padding-top: 60px;
    padding-bottom: 60px;

    margin-bottom: 50px;
}

/* ---------- Labels ---------- */

.field-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(31,36,48);

    margin-bottom: 14px;
}

.field-label-spaced
{
    margin-top: 34px;
}

.field-error
{
    font-size: 26px;
    color: rgb(224,33,138);

    margin-top: 10px;
}

.hidden
{
    display: none;
}

/* ---------- Input Container ---------- */

.input-container
{
    width: 100%;

    height: 118px;

    flex-direction: row;

    align-items: center;

    background-color: rgb(244,245,247);

    border-radius: 28px;

    border-width: 2px;
    border-color: rgb(231,232,237);

    padding-left: 30px;
    padding-right: 20px;
}

/* ---------- Icons ---------- */

.input-icon
{
    width: 44px;
    height: 44px;

    margin-right: 20px;
}

.icon-email
{
    background-image: url("project://database/Assets/UI/Icons/email-icon.png");
}

.icon-lock
{
    background-image: url("project://database/Assets/UI/Icons/lock-icon.png");
}

.icon-eye
{
    background-image: url("project://database/Assets/UI/Icons/eye.png");
}

.icon-google
{
    width: 44px;
    height: 44px;

    margin-right: 20px;

    background-image: url("project://database/Assets/UI/Icons/google-icon.png");
}

/* ---------- TextField ---------- */

.input-field
{
    flex-grow: 1;

    font-size: 34px;

    color: rgb(31,36,48);

    background-color: transparent;

    border-width: 0;
}

.input-field > #unity-text-input
{
    background-color: transparent;
    border-width: 0;
}

.input-field-with-right-icon
{
    margin-right: 10px;
}

/* ---------- Eye Button ---------- */

.input-icon-button
{
    width: 68px;
    height: 68px;

    background-color: transparent;

    border-width: 0;
}

/* ---------- Sign In ---------- */

.sign-in-button
{
    width: 100%;
    height: 118px;

    margin-top: 48px;

    background-color: rgb(142,45,226);

    color: white;

    border-radius: 28px;

    border-width: 0;

    font-size: 36px;
    -unity-font-style: bold;
}

/* ---------- Divider ---------- */

.divider-row
{
    flex-direction: row;

    align-items: center;

    margin-top: 48px;
    margin-bottom: 48px;
}

.divider-line
{
    flex-grow: 1;

    height: 2px;

    background-color: rgb(231,232,237);
}

.divider-text
{
    margin-left: 24px;
    margin-right: 24px;

    font-size: 28px;

    color: rgb(138,143,163);
}

/* ---------- Google Button ---------- */

.google-button
{
    width: 100%;
    height: 118px;

    flex-direction: row;

    justify-content: center;
    align-items: center;

    background-color: white;

    border-width: 2px;
    border-color: rgb(231,232,237);

    border-radius: 28px;
}

.google-button-text
{
    font-size: 34px;
    -unity-font-style: bold;

    color: rgb(31,36,48);
}

/* ---------- Admin Link ---------- */

.admin-login-link
{
    align-self: center;

    background-color: transparent;

    border-width: 0;

    color: rgb(142,45,226);

    font-size: 34px;

    -unity-font-style: bold;
}

/* ---------- Status ---------- */

.status-label
{
    margin-top: 28px;

    font-size: 28px;

    color: rgb(224,33,138);

    -unity-text-align: middle-center;
}

/* ---------- Success Message ---------- */

.success-message
{
    margin-top: 20px;
    margin-bottom: 10px;
    padding: 16px;
    
    background-color: rgba(34, 197, 94, 0.1);
    
    border-radius: 12px;
    
    font-size: 28px;
    color: rgb(34, 197, 94);
    
    -unity-text-align: middle-center;
}

/* ---------- Forgot Password ---------- */

.forgot-password-link
{
    align-self: flex-end;

    background-color: transparent;

    border-width: 0;

    color: rgb(142,45,226);

    font-size: 26px;

    margin-top: 16px;
    margin-bottom: 24px;

    -unity-font-style: bold;
}

/* ---------- Create Account ---------- */

.create-account-row
{
    flex-direction: row;

    justify-content: center;

    align-items: center;

    margin-top: 20px;
}

.create-account-text
{
    font-size: 28px;

    color: rgb(138,143,163);

    margin-right: 10px;
}

.create-account-link
{
    background-color: transparent;

    border-width: 0;

    color: rgb(142,45,226);

    font-size: 28px;

    -unity-font-style: bold;
}

/* ---------- Small / Narrower Phones ----------
   Kicks in below ~900px logical width (e.g. narrower devices or a
   panel that isn't matching the 1080 reference 1:1). Update the
   matching threshold in ForgotPasswordController.cs if you change this. */

.compact .content-wrapper
{
    max-width: 760px;
}

.compact .logo-circle
{
    width: 170px;
    height: 170px;

    border-radius: 85px;
}

.compact .app-title
{
    font-size: 46px;
}

.compact .login-card
{
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 42px;
    padding-bottom: 42px;
}