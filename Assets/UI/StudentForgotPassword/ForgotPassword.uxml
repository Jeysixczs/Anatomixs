<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd">
    <Style src="project://database/Assets/UI/StudentLogin/StudentLogin.uss?fileID=7433441132597879392&amp;guid=e188d20bee8fcba44a3b70d245d72c03&amp;type=3#StudentLogin"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="screen-container" class="screen-container">
            <ui:ScrollView name="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="scroll-view">
                <ui:VisualElement name="content-wrapper" class="content-wrapper">
                    <ui:VisualElement name="logo-circle" class="logo-circle" style="background-image: url(&quot;project://database/Assets/Sprite/Anatomia-logo.png?fileID=2800000&amp;guid=31a97ab8e70a6184f9b8d05c71d9233b&amp;type=3#Anatomia-logo&quot;);"/>
                    <ui:Label text="Forgot Password" class="app-title"/>
                    <ui:Label text="Enter your email to reset your password" class="app-subtitle"/>
                    <ui:VisualElement name="login-card" class="login-card">
                        <ui:Label text="EMAIL" class="field-label"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-email"/>
                            <ui:TextField name="email-field" class="input-field"/>
                        </ui:VisualElement>
                        <ui:Label name="email-error" class="field-error hidden"/>
                        <ui:Label name="status-label" class="status-label hidden"/>
                        <ui:Label name="success-message-label" class="success-message hidden">
                            <ui:Label text="✓ Password reset link sent to your email." style="color: rgb(34, 197, 94); font-size: 28px; -unity-text-align: middle-center; margin-top: 20px;"/>
                        </ui:Label>
                        <ui:Button name="send-reset-link-button" text="SEND RESET LINK" class="sign-in-button"/>
                        <ui:Button name="back-to-login-button" text="← Back to Login" class="admin-login-link" style="margin-top: 20px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
