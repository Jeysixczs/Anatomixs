<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss?fileID=7433441132597879392&amp;guid=f3df4a0ff9d42424986b13ce625d35c9&amp;type=3#AnatomiaTheme"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaAuth.uss?fileID=7433441132597879392&amp;guid=7b1848b4e2e9bc34fbd3c5e0e140870d&amp;type=3#AnatomiaAuth"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme auth-root theme-forgot-password screen-root">
        <ui:VisualElement name="screen-container" class="screen-container">
            <ui:ScrollView name="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="scroll-view">
                <ui:VisualElement name="content-wrapper" class="content-wrapper">
                    <ui:VisualElement class="auth-hero">
                        <ui:VisualElement class="auth-hero-inner">
                            <ui:VisualElement class="auth-topbar">
                                <ui:Button name="back-to-login-button" class="auth-back-pill">
                                    <ui:VisualElement picking-mode="Ignore" class="back-link-icon"/>
                                    <ui:Label text="Back to login" picking-mode="Ignore" class="auth-back-label"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="auth-badge">
                                <ui:VisualElement picking-mode="Ignore" class="auth-badge-icon"/>
                            </ui:VisualElement>
                            <ui:Label text="Reset your password" class="auth-headline"/>
                            <ui:Label text="Enter the email linked to your account and we will send you a link to reset it." class="app-subtitle"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="auth-card-wrap">
                        <ui:VisualElement name="login-card" class="auth-card">
                            <ui:Label text="Email" class="field-label"/>
                            <ui:VisualElement class="input-container">
                                <ui:TextField name="email-field" placeholder-text="Enter your email" hide-placeholder-on-focus="true" class="input-field"/>
                                <ui:VisualElement picking-mode="Ignore" class="input-icon icon-email"/>
                            </ui:VisualElement>
                            <ui:Label name="email-error" class="field-error hidden"/>
                            <ui:Label name="status-label" class="status-label hidden"/>
                            <ui:Label name="success-message-label" text="Reset link sent. Check your email inbox." class="success-message hidden"/>
                            <ui:Button name="send-reset-link-button" text="Send reset link" class="sign-in-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
