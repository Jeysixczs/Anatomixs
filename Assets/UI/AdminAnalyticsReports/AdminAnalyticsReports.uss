/* =========================================================
   Anatomia 3D - Admin Analytics & Reports (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient. The selected tab pill and any
   accent bars are flat colors here; if you want the header or a
   button to match the green->blue gradient used elsewhere, apply a
   Texture2D at runtime from AdminAnalyticsReportsController the
   same way AdminDashboardController does it.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header ---------- */

.header
{
    width: 100%;
    padding-left: 47px;
    padding-right: 47px;
    padding-top: 118px;
    padding-bottom: 39px;
    flex-shrink: 0;
    background-color: rgb(243, 244, 248);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
}

.back-button
{
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: white;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    justify-content: center;
    align-items: center;
    margin-right: 21px;
    flex-shrink: 0;
    padding: 0;
}

.back-button:hover
{
    background-color: rgb(248, 249, 251);
}

.back-icon
{
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(31, 36, 48);
}

.header-text
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.header-title
{
    font-size: 39px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
}

.header-actions
{
    flex-direction: row;
    flex-shrink: 0;
}

/* Inserted at runtime by AdminAnalyticsReportsController.BuildClassroomPicker() -
   there's no element for it in this .uxml, so it's styled here to match the
   export-button pills next to it. */
.classroom-picker-dropdown
{
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-width: 1px;
    border-color: rgb(224, 226, 232);
    border-radius: 18px;
    padding: 0 8px;
    margin: 0;
    margin-right: 14px;
    min-width: 180px;
}

.classroom-picker-dropdown .unity-base-field__label
{
    display: none;
}

.classroom-picker-dropdown > .unity-base-popup-field__text
{
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(90, 95, 112);
}

.export-button
{
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: white;
    border-width: 1px;
    border-color: rgb(224, 226, 232);
    border-radius: 18px;
    padding: 12px 16px;
    margin: 0;
    margin-left: 14px;
}

.export-button:hover
{
    background-color: rgb(248, 249, 251);
}

.export-icon
{
    font-size: 24px;
    margin-right: 10px;
    -unity-text-align: middle-center;
}

.export-label
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(90, 95, 112);
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
}

.screen-scroll .unity-scroller--vertical
{
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 28px 32px 60px 32px;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
}

/* ---------- Date filter ---------- */

.date-filter-button
{
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    border-radius: 26px;
    padding: 18px 24px;
    margin: 0;
    margin-bottom: 32px;
    align-self: flex-start;
}

.date-filter-button:hover
{
    background-color: rgb(248, 249, 251);
}

.date-filter-icon
{
    font-size: 26px;
    margin-right: 16px;
    -unity-text-align: middle-center;
}

.date-filter-label
{
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-right: 18px;
}

.date-filter-chevron
{
    font-size: 18px;
    color: rgb(150, 155, 168);
}

/* ---------- Overview stat cards (2x2 grid) ---------- */

.stats-grid
{
    width: 100%;
    flex-direction: column;
    margin-bottom: 34px;
}

.stats-grid-row
{
    flex-direction: row;
    margin-bottom: 21px;
}

.overview-card
{
    flex-grow: 1;
    flex-basis: 0;
    background-color: white;
    border-radius: 32px;
    padding: 34px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.overview-card-left
{
    margin-right: 10px;
}

.overview-card-right
{
    margin-left: 10px;
}

.overview-card-header
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.overview-icon-circle
{
    width: 53px;
    height: 53px;
    border-radius: 26px;
    justify-content: center;
    align-items: center;
    margin-right: 14px;
    flex-shrink: 0;
}

.overview-icon-blue
{
    background-color: rgb(219, 234, 254);
}

.overview-icon-green
{
    background-color: rgb(209, 250, 229);
}

.overview-icon-purple
{
    background-color: rgb(237, 220, 253);
}

.overview-icon-orange
{
    background-color: rgb(254, 235, 200);
}

.overview-icon
{
    font-size: 24px;
    -unity-text-align: middle-center;
}

.overview-card-title
{
    font-size: 25px;
    color: rgb(90, 95, 112);
    white-space: normal;
    flex-shrink: 1;
}

.overview-card-value
{
    font-size: 53px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 10px;
}

.overview-card-delta
{
    font-size: 23px;
    color: rgb(5, 150, 105);
}

.overview-card-delta-negative
{
    color: rgb(220, 38, 38);
}

/* ---------- Segmented tab control ---------- */

.tabs-row
{
    flex-direction: row;
    background-color: rgb(233, 235, 240);
    border-radius: 24px;
    padding: 8px;
    margin-bottom: 32px;
}

.tab-button
{
    flex-grow: 1;
    flex-basis: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 18px;
    padding: 16px 10px;
    margin: 0;
    justify-content: center;
    align-items: center;
}

.tab-button-label
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(120, 123, 140);
    -unity-text-align: middle-center;
}

.tab-button-active
{
    background-color: white;
}

.tab-button-active .tab-button-label
{
    color: rgb(31, 36, 48);
}

/* ---------- Shared report card ---------- */

.report-card
{
    width: 100%;
    background-color: white;
    border-radius: 34px;
    padding: 39px;
    margin-bottom: 26px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.report-card-title
{
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.report-card-subtitle
{
    font-size: 25px;
    color: rgb(150, 155, 168);
    margin-top: 6px;
    margin-bottom: 29px;
    white-space: normal;
}

.tab-panel
{
    width: 100%;
    flex-direction: column;
}

/* ---------- Students tab: Top Performers ---------- */

.top-performers-list
{
    width: 100%;
    flex-direction: column;
}

.performer-row
{
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding-top: 18px;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.performer-row-last
{
    border-bottom-width: 0;
    padding-bottom: 0;
}

.performer-rank-badge
{
    width: 63px;
    height: 63px;
    border-radius: 32px;
    justify-content: center;
    align-items: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.performer-rank-gold
{
    background-color: rgb(254, 243, 199);
}

.performer-rank-silver
{
    background-color: rgb(229, 231, 235);
}

.performer-rank-bronze
{
    background-color: rgb(254, 215, 170);
}

.performer-rank-default
{
    background-color: rgb(219, 234, 254);
}

.performer-rank-label
{
    font-size: 26px;
    -unity-font-style: bold;
}

.performer-rank-gold .performer-rank-label
{
    color: rgb(161, 98, 7);
}

.performer-rank-silver .performer-rank-label
{
    color: rgb(75, 85, 99);
}

.performer-rank-bronze .performer-rank-label
{
    color: rgb(194, 65, 12);
}

.performer-rank-default .performer-rank-label
{
    color: rgb(37, 99, 235);
}

.performer-info
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.performer-name-label
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
}

.performer-quizzes-label
{
    font-size: 24px;
    color: rgb(150, 155, 168);
    margin-top: 3px;
}

.performer-stats
{
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 16px;
}

.performer-points-label
{
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.performer-level-label
{
    font-size: 23px;
    color: rgb(150, 155, 168);
    margin-top: 3px;
}

/* ---------- Students tab: Student Activity ---------- */

.student-activity-list
{
    width: 100%;
    flex-direction: column;
}

.student-activity-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 21px;
    padding-bottom: 21px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.student-activity-row-last
{
    border-bottom-width: 0;
    padding-bottom: 0;
}

.student-activity-label
{
    font-size: 28px;
    color: rgb(90, 95, 112);
}

.student-activity-value
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

/* ---------- Mistakes tab: Common Incorrect Answers ---------- */

.common-mistakes-list
{
    width: 100%;
    flex-direction: column;
}

.mistake-row
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background-color: rgb(254, 242, 242);
    border-left-width: 5px;
    border-left-color: rgb(220, 38, 38);
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 18px;
}

.mistake-info
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 18px;
}

.mistake-question-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
}

.mistake-category-label
{
    font-size: 23px;
    color: rgb(150, 155, 168);
    margin-top: 6px;
}

.mistake-count-col
{
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
}

.mistake-count-value
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(220, 38, 38);
}

.mistake-count-label
{
    font-size: 20px;
    color: rgb(190, 100, 100);
}

/* ---------- Mistakes tab: Recommendations ---------- */

.recommendations-list
{
    width: 100%;
    flex-direction: column;
}

.recommendation-item
{
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    background-color: rgb(219, 234, 254);
    border-radius: 24px;
    padding: 26px;
}

.recommendation-icon-circle
{
    width: 53px;
    height: 53px;
    border-radius: 26px;
    background-color: rgb(37, 99, 235);
    justify-content: center;
    align-items: center;
    margin-right: 21px;
    flex-shrink: 0;
}

.recommendation-icon
{
    font-size: 24px;
    -unity-text-align: middle-center;
}

.recommendation-text-col
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.recommendation-title-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(30, 64, 175);
    white-space: normal;
}

.recommendation-description-label
{
    font-size: 24px;
    color: rgb(59, 90, 168);
    margin-top: 6px;
    white-space: normal;
}

/* ---------- Performance tab: Score Trend ---------- */

.score-trend-list
{
    width: 100%;
    flex-direction: column;
}

.score-trend-row
{
    width: 100%;
    margin-bottom: 24px;
}

.score-trend-row-last
{
    margin-bottom: 0;
}

.score-trend-top-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.score-trend-name-label
{
    font-size: 26px;
    color: rgb(31, 36, 48);
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    margin-right: 14px;
}

.score-trend-value-label
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    flex-shrink: 0;
}

.score-trend-bar-track
{
    width: 100%;
    height: 16px;
    background-color: rgb(240, 241, 245);
    border-radius: 8px;
    overflow: hidden;
}

.score-trend-bar-fill
{
    height: 100%;
    background-color: rgb(37, 99, 235);
    border-radius: 8px;
}

/* ---------- Performance tab: Performance by Topic ---------- */

.topic-performance-list
{
    width: 100%;
    flex-direction: column;
}

.topic-row
{
    width: 100%;
    margin-bottom: 24px;
}

.topic-row-last
{
    margin-bottom: 0;
}

.topic-top-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.topic-name-label
{
    font-size: 26px;
    color: rgb(31, 36, 48);
    flex-shrink: 1;
    flex-grow: 1;
    white-space: normal;
    margin-right: 14px;
}

.topic-value-label
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    flex-shrink: 0;
}

.topic-bar-track
{
    width: 100%;
    height: 16px;
    background-color: rgb(240, 241, 245);
    border-radius: 8px;
    overflow: hidden;
}

.topic-bar-fill
{
    height: 100%;
    background-color: rgb(5, 150, 105);
    border-radius: 8px;
}

/* ---------- Utility ---------- */

.hidden
{
    display: none;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 87px;
    padding-bottom: 32px;
}

.compact .header-title
{
    font-size: 33px;
}

.compact .export-label
{
    display: none;
}

.compact .export-button
{
    padding: 16px;
}

.compact .export-icon
{
    margin-right: 0;
}

.compact .content-wrapper
{
    padding: 22px 22px 48px 22px;
}

.compact .stats-grid-row
{
    margin-bottom: 16px;
}

.compact .overview-card
{
    padding: 26px;
}

.compact .overview-card-value
{
    font-size: 43px;
}

.compact .overview-card-title
{
    font-size: 21px;
}

.compact .overview-card-delta
{
    font-size: 20px;
}

.compact .tab-button-label
{
    font-size: 23px;
}

.compact .report-card
{
    padding: 29px;
}

.compact .report-card-title
{
    font-size: 29px;
}

.compact .performer-name-label
{
    font-size: 26px;
}

.compact .mistake-question-label
{
    font-size: 25px;
}
