/* =========================================================
   Anatomia 3D - Admin Analytics & Reports (redesign, student-style)
   Reference canvas: 1080 x 1920 (portrait phone).
   Layout mirrors Student Progress: fixed slim header | scroll: filters,
   hero card, stat tiles, pill tabs, glass report cards.
   Everything is scoped under .anatomia-theme.theme-analytics so it out-ranks
   the shared Quiet Glass theme and affects no other screen.
   Element names and the classes the controller builds at runtime
   (performer-*, mistake-*, recommendation-*, score-trend-*, dropdown-field,
   classroom-picker-dropdown, tab-button-active, hidden, compact) are unchanged.
   ========================================================= */

.anatomia-theme.theme-analytics.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

.hidden { display: none; }

/* ---------- Header (fixed) ---------- */

.anatomia-theme.theme-analytics .header
{
    flex-shrink: 0;
    flex-direction: column;
    padding: 84px 40px 12px 40px;
}

.anatomia-theme.theme-analytics .header-top-row { flex-direction: row; align-items: center; margin-bottom: 8px; }

.anatomia-theme.theme-analytics .back-button
{
    width: 88px;
    height: 88px;
    min-width: 88px;
    border-radius: 44px;
    margin: 0 28px 0 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.theme-analytics .back-icon
{
    width: 36px;
    height: 36px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.theme-analytics .header-text { flex-direction: column; justify-content: center; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-analytics .header-title { font-size: 50px; white-space: nowrap; }
.anatomia-theme.theme-analytics .header-subtitle { font-size: 26px; margin-top: 2px; white-space: nowrap; }

.theme-analytics .header-actions { flex-direction: row; flex-shrink: 0; margin-left: 16px; }

/* PDF export: soft accent pill */
.anatomia-theme.theme-analytics .export-button
{
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 84px;
    margin: 0;
    padding: 0 32px;
    border-width: 0;
    border-radius: 42px;
    background-color: var(--accent-soft);
}

.anatomia-theme.theme-analytics .export-button:hover { background-color: rgba(91, 76, 219, 0.2); }
.anatomia-theme.theme-analytics .export-button:active { background-color: rgba(91, 76, 219, 0.28); }

.theme-analytics .export-icon
{
    width: 36px;
    height: 36px;
    margin-right: 12px;
    background-image: url("project://database/Assets/UI/Icons/pdf-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.anatomia-theme.theme-analytics .export-label { font-size: 28px; -unity-font-style: bold; color: var(--accent); }

/* ---------- Scroll ---------- */

.theme-analytics .screen-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; -unity-overflow-scrolling: touch; }
.theme-analytics .screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.theme-analytics .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport { flex-grow: 1; min-height: 0; height: 100%; }
.theme-analytics .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    position: relative;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

.anatomia-theme.theme-analytics .content-wrapper
{
    flex-direction: column;
    flex-shrink: 0;
    padding: 16px 40px 100px 40px;
}

.anatomia-theme.theme-analytics .section-title { font-size: 36px; -unity-font-style: bold; color: var(--ink); margin: 0 0 4px 0; }
.anatomia-theme.theme-analytics .section-subtitle { font-size: 26px; color: var(--ink-3); margin: 0 0 28px 0; white-space: normal; }

/* ---------- Filters: two glass pills ---------- */

.anatomia-theme.theme-analytics .filters-row
{
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.theme-analytics .dropdown-field
{
    font-size: 28px;
    color: var(--ink);
    margin: 0 16px 12px 0;
    min-width: 300px;
    max-width: 520px;
    min-height: 0;
    align-self: flex-start;
    justify-content: center;
}

/* Closed field: solid white pill. Border width is constant (2px) and only its colour
   changes, so hover / open never shifts the layout. */
.theme-analytics .dropdown-field > .unity-base-popup-field__input
{
    min-height: 96px;
    background-color: var(--surface-solid);
    border-width: 2px;
    border-color: var(--line-strong);
    border-radius: 48px;
    padding: 0 26px 0 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.theme-analytics .dropdown-field > .unity-base-popup-field__input:hover
{
    background-color: var(--surface-solid);
    border-color: var(--ink-4);
}

.theme-analytics .dropdown-field:focus > .unity-base-popup-field__input,
.theme-analytics .dropdown-field > .unity-base-popup-field__input:active
{
    background-color: var(--surface-solid);
    border-color: var(--accent);
}

.theme-analytics .dropdown-field > .unity-base-popup-field__input > .unity-base-popup-field__text
{
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-overflow-position: end;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

/* Chevron sits in a soft accent disc so it reads as a control, not decoration. */
.theme-analytics .dropdown-field > .unity-base-popup-field__input > .unity-base-popup-field__arrow
{
    -unity-background-image-tint-color: var(--accent);
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    margin: 0 0 0 16px;
    border-radius: 26px;
    background-color: var(--accent-soft);
    background-size: 26px 26px;
    background-position: center;
    background-repeat: no-repeat;
}

.theme-analytics .dropdown-field.unity-disabled > .unity-base-popup-field__input { opacity: 0.5; }

/* ---------- Dropdown choices popup ----------
   Unity attaches the choices list to panel.visualTree, OUTSIDE .anatomia-theme, so the
   --tokens above do not resolve here: literal colours only, and the selectors are
   unscoped on purpose. AdminAnalyticsReportsController copies this sheet onto the
   panel root while the screen is active (and removes it again on disable). */

.unity-base-dropdown__container-outer
{
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(22, 24, 38, 0.14);
    border-radius: 32px;
    padding: 12px;
    margin-top: 10px;
    min-width: 420px;
    max-height: 784px;
    overflow: hidden;
    flex-shrink: 0;
}

.unity-base-dropdown__container-outer .unity-scroll-view
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
}

.unity-base-dropdown__container-outer .unity-scroll-view__content-viewport,
.unity-base-dropdown__container-outer .unity-scroll-view__content-viewport--vertical-horizontal
{
    max-height: 760px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-base-dropdown__container-outer .unity-scroller--vertical
{
    width: 10px;
    margin-left: auto;
    margin-right: 0;
    align-self: stretch;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__drag-container { padding: 0; margin: 0; border-width: 0; }
.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__tracker { width: 100%; right: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; left: 2px; border-width: 0; border-radius: 3px; background-color: rgba(91, 76, 219, 0.28); }
.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: rgba(91, 76, 219, 0.5); }
.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-scroller__low-button,
.unity-base-dropdown__container-outer .unity-scroller--vertical .unity-scroller__high-button { display: none; }

/* Fixed row height so "8 rows then scroll" is exact. */
.unity-base-dropdown__item
{
    height: 92px;
    margin: 2px 0;
    padding: 0 28px;
    border-radius: 24px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.unity-base-dropdown__item:hover { background-color: rgb(244, 245, 250); }
.unity-base-dropdown__item:active { background-color: rgba(91, 76, 219, 0.16); }

.unity-base-dropdown__item--selected { background-color: rgba(91, 76, 219, 0.11); }

.unity-base-dropdown__label
{
    margin: 0;
    font-size: 30px;
    color: rgb(22, 24, 38);
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-base-dropdown__item--selected .unity-base-dropdown__label
{
    color: rgb(76, 62, 199);
    -unity-font-style: bold;
}

.unity-base-dropdown__checkmark
{
    -unity-background-image-tint-color: rgb(91, 76, 219);
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    margin-left: 16px;
}

/* ---------- Hero: total students (solid accent card) ---------- */

.anatomia-theme.theme-analytics .stats-grid { flex-direction: column; margin: 12px 0 0 0; }

.anatomia-theme.theme-analytics .overview-hero
{
    flex-direction: column;
    padding: 40px;
    margin-bottom: 24px;
    border-radius: 40px;
    background-color: var(--accent);
    border-width: 0;
}

.anatomia-theme.theme-analytics .overview-hero:hover { background-color: var(--accent-strong); }
.anatomia-theme.theme-analytics .overview-hero:active { background-color: var(--accent-press); }

.anatomia-theme.theme-analytics .hero-caption { font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; color: rgba(255,255,255,0.7); }

.theme-analytics .hero-row { flex-direction: row; justify-content: space-between; align-items: flex-end; margin: 6px 0 14px 0; }

.anatomia-theme.theme-analytics .hero-value { font-size: 96px; -unity-font-style: bold; color: white; letter-spacing: -2px; }

.anatomia-theme.theme-analytics .hero-pill
{
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(255,255,255,0.2);
    border-radius: 100px;
    padding: 8px 26px;
    margin-bottom: 16px;
}

.anatomia-theme.theme-analytics .hero-footnote { font-size: 26px; color: rgba(255,255,255,0.8); }

/* ---------- Stat tiles: three equal columns ---------- */

.theme-analytics .stats-grid-row { flex-direction: row; margin-bottom: 8px; }

.anatomia-theme.theme-analytics .overview-card
{
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
    border-radius: 30px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

.theme-analytics .overview-card-first { margin-right: 8px; }
.theme-analytics .overview-card-mid { margin-left: 8px; margin-right: 8px; }
.theme-analytics .overview-card-last { margin-left: 8px; }

.theme-analytics .overview-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 24px;
    background-color: var(--accent-soft);
    justify-content: center;
    align-items: center;
    margin-bottom: 22px;
    flex-shrink: 0;
}

.theme-analytics .overview-icon
{
    width: 40px;
    height: 40px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.theme-analytics .icon-target { background-image: url("project://database/Assets/UI/Icons/target-iconss.png"); }
.theme-analytics .icon-participated { background-image: url("project://database/Assets/UI/Icons/trophy-black-icon.png"); }
.theme-analytics .icon-completion { background-image: url("project://database/Assets/UI/Icons/check-icon.png"); }

.anatomia-theme.theme-analytics .overview-card-value { font-size: 44px; -unity-font-style: bold; color: var(--ink); letter-spacing: -0.5px; margin: 0; }
.anatomia-theme.theme-analytics .overview-card-title { font-size: 22px; color: var(--ink-3); white-space: nowrap; margin: 0; }

/* ---------- Tabs: 3 equal pills ---------- */

.anatomia-theme.theme-analytics .tabs-row
{
    flex-direction: row;
    margin: 24px 0 28px 0;
    padding: 0;
    background-color: rgba(0,0,0,0);
    border-radius: 0;
}

.anatomia-theme.theme-analytics .tab-button
{
    flex-grow: 1;
    flex-basis: 0;
    height: 84px;
    margin: 0 6px;
    padding: 0 8px;
    border-radius: 42px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    justify-content: center;
    align-items: center;
}

.anatomia-theme.theme-analytics .tab-button:hover { background-color: var(--surface-hover); }

.anatomia-theme.theme-analytics .tab-button-label { font-size: 28px; -unity-font-style: bold; color: var(--ink-2); -unity-text-align: middle-center; }

.anatomia-theme.theme-analytics .tab-button-active,
.anatomia-theme.theme-analytics .tab-button-active:hover
{
    background-color: var(--accent);
    border-color: var(--accent);
}

.anatomia-theme.theme-analytics .tab-button-active .tab-button-label { color: white; }

.theme-analytics .tab-panel { width: 100%; flex-direction: column; }

/* ---------- Shared report card ---------- */

.anatomia-theme.theme-analytics .report-card
{
    width: 100%;
    padding: 40px;
    margin-bottom: 24px;
    border-radius: 36px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
}

/* ---------- Performance tab: Score trend ---------- */

.theme-analytics .score-trend-list { width: 100%; flex-direction: column; }
.theme-analytics .score-trend-row { width: 100%; margin-bottom: 26px; }
.theme-analytics .score-trend-row-last { margin-bottom: 0; }
.theme-analytics .score-trend-top-row { flex-direction: row; justify-content: space-between; margin-bottom: 12px; }

.anatomia-theme.theme-analytics .score-trend-name-label { font-size: 26px; color: var(--ink-2); flex-shrink: 1; flex-grow: 1; white-space: normal; margin-right: 14px; }
.anatomia-theme.theme-analytics .score-trend-value-label { font-size: 28px; -unity-font-style: bold; color: var(--accent); flex-shrink: 0; }

.theme-analytics .score-trend-bar-track { width: 100%; height: 18px; background-color: var(--track); border-radius: 9px; overflow: hidden; }
.theme-analytics .score-trend-bar-fill { height: 100%; background-color: var(--accent); border-radius: 9px; }

/* ---------- Students tab: Top performers ---------- */

.theme-analytics .top-performers-list { width: 100%; flex-direction: column; }

.theme-analytics .performer-row
{
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 22px 24px;
    margin-bottom: 12px;
    border-radius: 28px;
    background-color: var(--sunken);
}

.theme-analytics .performer-row-last { margin-bottom: 0; }

.theme-analytics .performer-rank-badge
{
    width: 64px;
    height: 64px;
    border-radius: 32px;
    justify-content: center;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
    background-color: var(--track);
}

.theme-analytics .performer-rank-gold { background-color: var(--warn-soft); }
.theme-analytics .performer-rank-silver { background-color: var(--track); }
.theme-analytics .performer-rank-bronze { background-color: rgba(194, 100, 40, 0.14); }
.theme-analytics .performer-rank-default { background-color: var(--accent-soft); }

.theme-analytics .performer-rank-label { font-size: 28px; -unity-font-style: bold; color: var(--ink-2); }
.theme-analytics .performer-rank-gold .performer-rank-label { color: var(--warn); }
.theme-analytics .performer-rank-silver .performer-rank-label { color: var(--ink-2); }
.theme-analytics .performer-rank-bronze .performer-rank-label { color: rgb(176, 90, 34); }
.theme-analytics .performer-rank-default .performer-rank-label { color: var(--accent); }

.theme-analytics .performer-avatar
{
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: var(--accent);
    justify-content: center;
    align-items: center;
    margin-right: 22px;
    flex-shrink: 0;
}

.theme-analytics .performer-avatar-label { font-size: 26px; -unity-font-style: bold; color: white; }

.theme-analytics .performer-info { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-analytics .performer-name-label { font-size: 30px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-analytics .performer-quizzes-label { font-size: 23px; color: var(--ink-3); margin-top: 2px; }

.theme-analytics .performer-stats { flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: 16px; }
.anatomia-theme.theme-analytics .performer-points-label { font-size: 32px; -unity-font-style: bold; color: var(--accent); }
.anatomia-theme.theme-analytics .performer-level-label { font-size: 22px; color: var(--ink-3); margin-top: 2px; }

/* ---------- Students tab: Student activity (2x2 tiles) ---------- */

.theme-analytics .student-activity-list { width: 100%; flex-direction: column; }
.theme-analytics .student-activity-row { flex-direction: row; margin-bottom: 16px; }
.theme-analytics .student-activity-row-last { margin-bottom: 0; }

.theme-analytics .activity-tile
{
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    padding: 28px;
    border-radius: 28px;
    background-color: var(--sunken);
}

.theme-analytics .activity-tile-left { margin-right: 8px; }
.theme-analytics .activity-tile-right { margin-left: 8px; }
.theme-analytics .activity-tile-accent { background-color: var(--accent-soft); }

.anatomia-theme.theme-analytics .activity-caption { font-size: 21px; -unity-font-style: bold; letter-spacing: 2px; color: var(--ink-3); margin-bottom: 8px; }
.anatomia-theme.theme-analytics .activity-tile-accent .activity-caption { color: var(--accent); }
.anatomia-theme.theme-analytics .activity-value { font-size: 44px; -unity-font-style: bold; color: var(--ink); letter-spacing: -0.5px; }

/* ---------- Mistakes tab ---------- */

.theme-analytics .common-mistakes-list { width: 100%; flex-direction: column; }

.theme-analytics .mistake-row
{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background-color: var(--sunken);
    border-radius: 28px;
    padding: 24px 26px;
    margin-bottom: 12px;
}

.theme-analytics .mistake-info { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 18px; }
.anatomia-theme.theme-analytics .mistake-question-label { font-size: 28px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.theme-analytics .mistake-meta-row { flex-direction: row; align-items: center; margin-top: 8px; }
.anatomia-theme.theme-analytics .mistake-category-label { font-size: 23px; color: var(--ink-3); }

.anatomia-theme.theme-analytics .mistake-type-label
{
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-radius: 100px;
    padding: 4px 16px;
    margin-left: 12px;
}

.theme-analytics .mistake-count-col
{
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    min-width: 96px;
    padding: 10px 20px;
    border-radius: 22px;
    background-color: var(--danger-soft);
}

.anatomia-theme.theme-analytics .mistake-count-value { font-size: 34px; -unity-font-style: bold; color: var(--danger); }
.anatomia-theme.theme-analytics .mistake-count-label { font-size: 20px; color: var(--danger); }

/* Recommendations */

.theme-analytics .recommendations-list { width: 100%; flex-direction: column; }

.theme-analytics .recommendation-item
{
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    background-color: var(--accent-soft);
    border-radius: 28px;
    padding: 26px;
    margin-bottom: 12px;
}

.theme-analytics .recommendation-icon-circle
{
    width: 60px;
    height: 60px;
    border-radius: 20px;
    background-color: var(--accent);
    justify-content: center;
    align-items: center;
    margin-right: 22px;
    flex-shrink: 0;
}

.theme-analytics .recommendation-icon { font-size: 26px; -unity-text-align: middle-center; }
.theme-analytics .recommendation-text-col { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-analytics .recommendation-title-label { font-size: 28px; -unity-font-style: bold; color: var(--accent-press); white-space: normal; }
.anatomia-theme.theme-analytics .recommendation-description-label { font-size: 24px; color: var(--ink-2); margin-top: 6px; white-space: normal; }

/* =========================================================
   Compact (narrow phones) - toggled by the controller
   ========================================================= */

.anatomia-theme.theme-analytics.compact .header { padding: 72px 32px 8px 32px; }
.anatomia-theme.theme-analytics.compact .back-button { width: 76px; height: 76px; min-width: 76px; border-radius: 38px; margin-right: 22px; }
.anatomia-theme.theme-analytics.compact .header-title { font-size: 40px; }
.anatomia-theme.theme-analytics.compact .header-subtitle { font-size: 22px; }
.anatomia-theme.theme-analytics.compact .export-button { height: 72px; padding: 0 24px; border-radius: 36px; }
.anatomia-theme.theme-analytics.compact .export-label { font-size: 24px; }
.anatomia-theme.theme-analytics.compact .content-wrapper { padding: 12px 28px 90px 28px; }
.anatomia-theme.theme-analytics.compact .dropdown-field { min-width: 220px; max-width: 360px; margin-right: 12px; }
.anatomia-theme.theme-analytics.compact .dropdown-field > .unity-base-popup-field__input { min-height: 80px; border-radius: 40px; padding: 0 20px 0 26px; }
.anatomia-theme.theme-analytics.compact .dropdown-field > .unity-base-popup-field__input > .unity-base-popup-field__text { font-size: 23px; }
.anatomia-theme.theme-analytics.compact .dropdown-field > .unity-base-popup-field__input > .unity-base-popup-field__arrow { width: 44px; height: 44px; border-radius: 22px; background-size: 22px 22px; margin-left: 12px; }
.anatomia-theme.theme-analytics.compact .overview-hero { padding: 30px; border-radius: 32px; }
.anatomia-theme.theme-analytics.compact .hero-value { font-size: 76px; }
.anatomia-theme.theme-analytics.compact .overview-card { padding: 20px; }
.anatomia-theme.theme-analytics.compact .overview-icon-box { width: 62px; height: 62px; border-radius: 20px; margin-bottom: 16px; }
.anatomia-theme.theme-analytics.compact .overview-card-value { font-size: 36px; }
.anatomia-theme.theme-analytics.compact .overview-card-title { font-size: 19px; }
.anatomia-theme.theme-analytics.compact .tab-button { height: 72px; }
.anatomia-theme.theme-analytics.compact .tab-button-label { font-size: 24px; }
.anatomia-theme.theme-analytics.compact .report-card { padding: 28px; border-radius: 28px; }
.anatomia-theme.theme-analytics.compact .performer-name-label { font-size: 26px; }
.anatomia-theme.theme-analytics.compact .performer-avatar { width: 60px; height: 60px; margin-right: 16px; }
.anatomia-theme.theme-analytics.compact .activity-value { font-size: 36px; }
.anatomia-theme.theme-analytics.compact .mistake-question-label { font-size: 25px; }
.anatomia-theme.theme-analytics.compact .mistake-type-label { font-size: 18px; padding: 3px 12px; }

/* Close icon inside the student stats modal (built in AdminStudentStatsModal.cs) */
.stats-modal-close-icon
{
    width: 32px;
    height: 32px;
    background-image: url("project://database/Assets/UI/Icons/close-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(31, 36, 48);
}
