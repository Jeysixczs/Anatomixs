<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminAnalyticsReports/AdminAnalyticsReports.uss?fileID=7433441132597879392&amp;guid=f982bf7d701eb514882762c85b6badfa&amp;type=3#AdminAnalyticsReports"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <ui:VisualElement name="content-wrapper" class="content-wrapper" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:VisualElement name="header" class="header">
                    <ui:VisualElement name="header-top-row" class="header-top-row">
                        <ui:Button name="back-button" class="back-button">
                            <ui:VisualElement name="back-icon" class="back-icon"/>
                        </ui:Button>
                        <ui:VisualElement name="header-text" class="header-text">
                            <ui:Label text="Analytics &amp; Reports" class="header-title"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="header-actions" class="header-actions">
                            <ui:Button name="export-excel-button" class="export-button">
                                <ui:Label text="📄" class="export-icon"/>
                                <ui:Label text="Excel" class="export-label"/>
                            </ui:Button>
                            <ui:Button name="export-pdf-button" class="export-button">
                                <ui:Label text="⬇" class="export-icon"/>
                                <ui:Label text="PDF" class="export-label"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="filters-row" class="filters-row">
                    <!-- classroom-picker-wrapper is inserted here at runtime, before the
                         quiz export picker, by AdminAnalyticsReportsController.BuildClassroomPicker() -->
                    <ui:DropdownField name="quiz-export-picker" class="dropdown-field quiz-export-picker"/>
                </ui:VisualElement>
                <ui:VisualElement name="stats-grid" class="stats-grid">
                    <ui:VisualElement name="stats-row-1" class="stats-grid-row">
                        <ui:VisualElement name="active-users-card" class="overview-card overview-card-left">
                            <ui:VisualElement class="overview-card-header">
                                <ui:VisualElement class="overview-icon-circle overview-icon-blue">
                                    <ui:Label text="👥" class="overview-icon"/>
                                </ui:VisualElement>
                                <ui:Label text="Active Users" class="overview-card-title"/>
                            </ui:VisualElement>
                            <ui:Label name="active-users-value-label" text="0" class="overview-card-value"/>
                            <ui:Label name="active-users-delta-label" text="+0% from last month" class="overview-card-delta"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="avg-score-card" class="overview-card overview-card-right">
                            <ui:VisualElement class="overview-card-header">
                                <ui:VisualElement class="overview-icon-circle overview-icon-green">
                                    <ui:Label text="🎯" class="overview-icon"/>
                                </ui:VisualElement>
                                <ui:Label text="Avg Score" class="overview-card-title"/>
                            </ui:VisualElement>
                            <ui:Label name="avg-score-value-label" text="0%" class="overview-card-value"/>
                            <ui:Label name="avg-score-delta-label" text="+0% from last month" class="overview-card-delta"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="stats-row-2" class="stats-grid-row">
                        <ui:VisualElement name="quizzes-done-card" class="overview-card overview-card-left">
                            <ui:VisualElement class="overview-card-header">
                                <ui:VisualElement class="overview-icon-circle overview-icon-purple">
                                    <ui:Label text="🏆" class="overview-icon"/>
                                </ui:VisualElement>
                                <ui:Label text="Quizzes Done" class="overview-card-title"/>
                            </ui:VisualElement>
                            <ui:Label name="quizzes-done-value-label" text="0" class="overview-card-value"/>
                            <ui:Label name="quizzes-done-delta-label" text="+0% from last month" class="overview-card-delta"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="completion-card" class="overview-card overview-card-right">
                            <ui:VisualElement class="overview-card-header">
                                <ui:VisualElement class="overview-icon-circle overview-icon-orange">
                                    <ui:Label text="📈" class="overview-icon"/>
                                </ui:VisualElement>
                                <ui:Label text="Completion" class="overview-card-title"/>
                            </ui:VisualElement>
                            <ui:Label name="completion-value-label" text="0%" class="overview-card-value"/>
                            <ui:Label name="completion-delta-label" text="+0% from last month" class="overview-card-delta"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="tabs-row" class="tabs-row">
                    <ui:Button name="performance-tab-button" class="tab-button">
                        <ui:Label text="Performance" class="tab-button-label"/>
                    </ui:Button>
                    <ui:Button name="students-tab-button" class="tab-button">
                        <ui:Label text="Students" class="tab-button-label"/>
                    </ui:Button>
                    <ui:Button name="mistakes-tab-button" class="tab-button">
                        <ui:Label text="Mistakes" class="tab-button-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="performance-panel" class="tab-panel hidden">
                    <ui:VisualElement name="score-trend-card" class="report-card">
                        <ui:Label text="Score Trend" class="report-card-title"/>
                        <ui:Label text="Average quiz score over recent attempts" class="report-card-subtitle"/>
                        <ui:VisualElement name="score-trend-list" class="score-trend-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="students-panel" class="tab-panel">
                    <ui:VisualElement name="top-performers-card" class="report-card">
                        <ui:Label text="Top Performers" class="report-card-title"/>
                        <ui:Label text="Students with highest points this period" class="report-card-subtitle"/>
                        <ui:VisualElement name="top-performers-list" class="top-performers-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="student-activity-card" class="report-card">
                        <ui:Label text="Student Activity" class="report-card-title"/>
                        <ui:Label text="Overview of student engagement" class="report-card-subtitle"/>
                        <ui:VisualElement name="student-activity-list" class="student-activity-list">
                            <ui:VisualElement class="student-activity-row">
                                <ui:Label text="Total Students" class="student-activity-label"/>
                                <ui:Label name="total-students-value-label" text="0" class="student-activity-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="student-activity-row">
                                <ui:Label text="Active This Month" class="student-activity-label"/>
                                <ui:Label name="active-this-month-value-label" text="0" class="student-activity-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="student-activity-row">
                                <ui:Label text="Average Level" class="student-activity-label"/>
                                <ui:Label name="average-level-value-label" text="0" class="student-activity-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="student-activity-row student-activity-row-last">
                                <ui:Label text="Average Points" class="student-activity-label"/>
                                <ui:Label name="average-points-value-label" text="0" class="student-activity-value"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="mistakes-panel" class="tab-panel hidden">
                    <ui:VisualElement name="common-mistakes-card" class="report-card">
                        <ui:Label text="Common Incorrect Answers" class="report-card-title"/>
                        <ui:Label text="Questions with highest error rates" class="report-card-subtitle"/>
                        <ui:VisualElement name="common-mistakes-list" class="common-mistakes-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="recommendations-card" class="report-card">
                        <ui:Label text="Recommendations" class="report-card-title"/>
                        <ui:Label text="Areas that need improvement" class="report-card-subtitle"/>
                        <ui:VisualElement name="recommendations-list" class="recommendations-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
