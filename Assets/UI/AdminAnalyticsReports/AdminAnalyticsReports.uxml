<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminAnalyticsReports/AdminAnalyticsReports.uss?fileID=7433441132597879392&amp;guid=f982bf7d701eb514882762c85b6badfa&amp;type=3#AdminAnalyticsReports"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme theme-analytics screen-root">

        <!-- Fixed slim header (same pattern as Student Progress) -->
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement name="header-top-row" class="header-top-row">
                <ui:Button name="back-button" class="back-button">
                    <ui:VisualElement name="back-icon" class="back-icon"/>
                </ui:Button>
                <ui:VisualElement name="header-text" class="header-text">
                    <ui:Label text="Analytics" class="header-title"/>
                    <ui:Label text="Class performance and reports" class="header-subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement name="header-actions" class="header-actions">
                    <ui:Button name="export-pdf-button" class="export-button">
                        <ui:VisualElement class="export-icon" picking-mode="Ignore"/>
                        <ui:Label text="PDF" class="export-label" picking-mode="Ignore"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView name="screen-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <ui:VisualElement name="content-wrapper" class="content-wrapper">

                <!-- Classroom picker is inserted at index 0 by the controller -->
                <ui:VisualElement name="filters-row" class="filters-row">
                    <ui:DropdownField name="quiz-export-picker" class="dropdown-field quiz-export-picker"/>
                </ui:VisualElement>

                <!-- Hero: total students (tappable, opens the student list) -->
                <ui:VisualElement name="stats-grid" class="stats-grid">
                    <ui:VisualElement name="active-users-card" class="overview-hero">
                        <ui:Label text="TOTAL STUDENTS" class="hero-caption"/>
                        <ui:VisualElement class="hero-row">
                            <ui:Label name="active-users-value-label" text="0" class="hero-value"/>
                            <ui:Label text="View list" class="hero-pill"/>
                        </ui:VisualElement>
                        <ui:Label text="Across the selected classroom" class="hero-footnote"/>
                    </ui:VisualElement>

                    <ui:VisualElement name="stats-row-1" class="stats-grid-row">
                        <ui:VisualElement name="avg-score-card" class="overview-card overview-card-first">
                            <ui:VisualElement class="overview-icon-box">
                                <ui:VisualElement class="overview-icon icon-target"/>
                            </ui:VisualElement>
                            <ui:Label name="avg-score-value-label" text="0%" class="overview-card-value"/>
                            <ui:Label text="Avg. score" class="overview-card-title"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="quizzes-done-card" class="overview-card overview-card-mid">
                            <ui:VisualElement class="overview-icon-box">
                                <ui:VisualElement class="overview-icon icon-participated"/>
                            </ui:VisualElement>
                            <ui:Label name="quizzes-done-value-label" text="0" class="overview-card-value"/>
                            <ui:Label text="Participated" class="overview-card-title"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="completion-card" class="overview-card overview-card-last">
                            <ui:VisualElement class="overview-icon-box">
                                <ui:VisualElement class="overview-icon icon-completion"/>
                            </ui:VisualElement>
                            <ui:Label name="completion-value-label" text="0%" class="overview-card-value"/>
                            <ui:Label text="Completion" class="overview-card-title"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tabs: 3 equal pills -->
                <ui:VisualElement name="tabs-row" class="tabs-row">
                    <ui:Button name="performance-tab-button" class="tab-button">
                        <ui:Label text="Performance" class="tab-button-label" picking-mode="Ignore"/>
                    </ui:Button>
                    <ui:Button name="students-tab-button" class="tab-button">
                        <ui:Label text="Students" class="tab-button-label" picking-mode="Ignore"/>
                    </ui:Button>
                    <ui:Button name="mistakes-tab-button" class="tab-button">
                        <ui:Label text="Mistakes" class="tab-button-label" picking-mode="Ignore"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="performance-panel" class="tab-panel hidden">
                    <ui:VisualElement name="score-trend-card" class="report-card">
                        <ui:Label text="Score trend" class="section-title"/>
                        <ui:Label text="Average quiz score over recent attempts" class="section-subtitle"/>
                        <ui:VisualElement name="score-trend-list" class="score-trend-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="students-panel" class="tab-panel">
                    <ui:VisualElement name="top-performers-card" class="report-card">
                        <ui:Label text="Top performers" class="section-title"/>
                        <ui:Label text="Highest scorers on the selected quiz" class="section-subtitle"/>
                        <ui:VisualElement name="top-performers-list" class="top-performers-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="student-activity-card" class="report-card">
                        <ui:Label text="Student activity" class="section-title"/>
                        <ui:Label text="Overview of student engagement" class="section-subtitle"/>
                        <ui:VisualElement name="student-activity-list" class="student-activity-list">
                            <ui:VisualElement class="student-activity-row">
                                <ui:VisualElement class="activity-tile activity-tile-left">
                                    <ui:Label text="TOTAL STUDENTS" class="activity-caption"/>
                                    <ui:Label name="total-students-value-label" text="0" class="activity-value"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="activity-tile activity-tile-right activity-tile-accent">
                                    <ui:Label text="ACTIVE STUDENTS" class="activity-caption"/>
                                    <ui:Label name="active-this-month-value-label" text="0" class="activity-value"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="student-activity-row student-activity-row-last">
                                <ui:VisualElement class="activity-tile activity-tile-left">
                                    <ui:Label text="AVERAGE LEVEL" class="activity-caption"/>
                                    <ui:Label name="average-level-value-label" text="0" class="activity-value"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="activity-tile activity-tile-right">
                                    <ui:Label text="AVERAGE POINTS" class="activity-caption"/>
                                    <ui:Label name="average-points-value-label" text="0" class="activity-value"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="mistakes-panel" class="tab-panel hidden">
                    <ui:VisualElement name="common-mistakes-card" class="report-card">
                        <ui:Label text="Common incorrect answers" class="section-title"/>
                        <ui:Label text="Questions with the highest error rates on the selected quiz" class="section-subtitle"/>
                        <ui:VisualElement name="common-mistakes-list" class="common-mistakes-list"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="recommendations-card" class="report-card">
                        <ui:Label text="Recommendations" class="section-title"/>
                        <ui:Label text="Areas that need improvement" class="section-subtitle"/>
                        <ui:VisualElement name="recommendations-list" class="recommendations-list"/>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
