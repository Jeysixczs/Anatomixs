/* ==========================================================
   Student Explore 3D - redesign
   Reference resolution: 1080 x 1920 (Scale With Screen Size)
   Element names / class hooks used by StudentExplore3dController
   are unchanged: .card, .icon-skeletal/.icon-muscular/.icon-cardio,
   .card-image-fade, .hidden, .card-play-armed,
   .play-mode-entry-button-active, .sync-status-icon-*.
   ========================================================== */

.screen-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(238, 242, 249);
    overflow: hidden;
}

/* ---------------- HEADER ---------------- */

.header {
    width: 100%;
    border-bottom-left-radius: 64px;
    border-bottom-right-radius: 64px;
    padding: 100px 50px 46px 50px;
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row { flex-direction: row; align-items: center; }

.back-button {
    width: 88px; height: 88px; border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 0;
    justify-content: center; align-items: center;
    margin: 0 30px 0 0;
    flex-shrink: 0;
}
.back-button:hover { background-color: rgba(255, 255, 255, 0.3); }
.back-button:active { background-color: rgba(255, 255, 255, 0.4); }

.back-icon {
    width: 40px; height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }

.header-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.header-subtitle {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
}

/* ---------------- PLAY BUTTON (white pill, stands out from header) ---------------- */

.play-mode-entry-button {
    flex-shrink: 0;
    align-self: center;
    width: auto;
    height: 72px;
    padding: 0 34px;
    margin: 0 0 0 12px;
    border-width: 0;
    border-radius: 36px;
    background-color: white;
    color: rgb(37, 99, 235);
    font-size: 28px;
    -unity-font-style: bold;
}
.play-mode-entry-button:hover { background-color: rgb(240, 245, 255); }
.play-mode-entry-button:active { background-color: rgb(225, 235, 255); }

.play-mode-entry-button-active { background-color: rgb(34, 160, 110); color: white; }
.play-mode-entry-button-active:hover { background-color: rgb(30, 145, 100); }

/* ---------------- SYNC ROW ---------------- */

/* Frosted-glass row that belongs to the header: translucent white over the
   blue->green gradient with a soft light edge, white text, and white circle
   badges - the same white-on-gradient language as the back button and the
   Play pill. Icon PNGs are single-color black, so their color comes from
   -unity-background-image-tint-color. */
.sync-progress-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: auto;
    min-height: 116px;
    margin: 34px 0 0 0;
    padding: 20px 26px 20px 20px;
    box-sizing: border-box;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.32);
    border-radius: 34px;
    -unity-font-style: normal;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}
.sync-progress-row:hover { background-color: rgba(255, 255, 255, 0.26); }
.sync-progress-row:active { background-color: rgba(255, 255, 255, 0.34); scale: 0.985 0.985; }
.sync-progress-row:disabled { opacity: 0.85; }
.sync-progress-row:focus { border-width: 2px; border-color: rgba(255, 255, 255, 0.32); }

/* Left badge: white circle, blue cloud (same blue as the Play pill text) */
.sync-icon-box {
    width: 76px; height: 76px; border-radius: 38px;
    background-color: rgb(255, 255, 255);
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-right: 22px;
}
.sync-icon {
    width: 40px; height: 40px;
    -unity-background-image-tint-color: rgb(37, 99, 235);
}

.sync-text-col { flex-grow: 1; flex-shrink: 1; flex-direction: column; min-width: 0; }
.sync-title-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: normal;
}
.sync-status-label {
    font-size: 23px;
    color: rgba(255, 255, 255, 0.88);
    margin-top: 4px;
    white-space: normal;
}

/* Right badge: white circle; only the icon carries the state color */
.sync-status-icon-box {
    width: 64px; height: 64px; border-radius: 32px;
    background-color: rgb(255, 255, 255);
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-left: 18px;
}
.sync-status-icon {
    width: 34px; height: 34px;
    -unity-background-image-tint-color: rgb(22, 150, 95);
}

.sync-status-icon-synced  .sync-status-icon { -unity-background-image-tint-color: rgb(22, 150, 95); }
.sync-status-icon-pending .sync-status-icon { -unity-background-image-tint-color: rgb(217, 119, 6); }
.sync-status-icon-syncing .sync-status-icon { -unity-background-image-tint-color: rgb(37, 99, 235); }
.sync-status-icon-failed  .sync-status-icon { -unity-background-image-tint-color: rgb(220, 38, 38); }
.sync-status-icon-offline .sync-status-icon { -unity-background-image-tint-color: rgb(107, 114, 128); }

/* ---------------- SCROLL VIEW (unchanged fixes) ---------------- */

.screen-scroll {
    flex-grow: 1; width: 100%; height: 100%;
    padding: 0; margin: 0;
    justify-content: flex-start; align-items: flex-start;
}

.screen-scroll .unity-scroller--vertical,
.screen-scroll #unity-scroller { width: 0; display: none; }

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport {
    padding: 0; margin: 0; flex-grow: 1; height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    padding: 0; margin: 0;
    translate: none;
    transform-origin: center;
    position: relative; top: 0; left: 0;
    justify-content: flex-start; align-items: stretch;
    flex-grow: 0;
    height: auto; min-height: 100%;
}

/* ---------------- CONTENT ---------------- */

.content-wrapper {
    width: 100%;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0; margin: 0;
}

/* Play Mode banner */
.play-mode-picker-banner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(225, 246, 237);
    border-radius: 28px;
    border-width: 2px;
    border-color: rgb(120, 205, 165);
    padding: 22px 26px;
    margin: 34px 50px 0 50px;
    box-sizing: border-box;
}
.play-mode-picker-banner.hidden { display: none; }

.play-mode-picker-banner-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(20, 110, 75);
    white-space: normal;
    flex-grow: 1; flex-shrink: 1;
    margin-right: 16px;
}

.play-mode-picker-cancel {
    align-self: center; flex-shrink: 0;
    width: auto; height: 54px;
    padding: 0 26px;
    border-width: 0; border-radius: 27px;
    background-color: white;
    color: rgb(20, 110, 75);
    font-size: 24px;
    -unity-font-style: bold;
}
.play-mode-picker-cancel:hover { background-color: rgb(245, 245, 245); }

/* ---------------- CARD LIST ---------------- */

.card-list {
    flex-direction: column;
    padding: 40px 50px 70px 50px;
    width: 100%;
    box-sizing: border-box;
}

.section-label {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(120, 128, 150);
    margin: 0 0 22px 8px;
}

/* ---------------- CARD ---------------- */

.card {
    flex-direction: row;
    align-items: stretch;
    background-color: white;
    border-radius: 40px;
    padding: 0;
    margin: 0 0 32px 0;
    width: 100%;
    min-height: 310px;
    box-sizing: border-box;
    overflow: hidden;
}

.card-button {
    border-width: 0;
    -unity-font-style: normal;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}
.card-button:hover { background-color: rgb(250, 251, 255); }
.card-button:active { background-color: rgb(238, 242, 252); scale: 0.985 0.985; }
.card-button:focus { border-width: 0; }

/* Armed for Play Mode: colored ring (declared after .card-button so it wins) */
.card-play-armed {
    border-width: 4px;
    border-color: rgb(34, 160, 110);
}
.card-play-armed:focus { border-width: 4px; }

/* Thin colored spine on the left edge */
.card-accent { width: 14px; flex-shrink: 0; }
.accent-skeletal { background-color: rgb(41, 98, 224); }
.accent-muscular { background-color: rgb(224, 49, 63); }
.accent-cardio   { background-color: rgb(224, 41, 130); }

.card-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    padding: 34px 10px 34px 34px;
}

.icon-box {
    width: 96px; height: 96px;
    border-radius: 30px;
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-bottom: 22px;
}
.icon-skeletal { background-color: rgb(41, 98, 224); }
.icon-muscular { background-color: rgb(224, 49, 63); }
.icon-cardio   { background-color: rgb(224, 41, 130); }

.icon-emoji {
    width: 54px; height: 54px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.icon-skeletal .icon-emoji { background-image: url("project://database/Assets/UI/Icons/skull-white.png"); }
.icon-muscular .icon-emoji { background-image: url("project://database/Assets/UI/Icons/muscular-white.png"); }
.icon-cardio   .icon-emoji { background-image: url("project://database/Assets/UI/Icons/cardio-white.png"); }

.card-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(24, 27, 44);
    white-space: normal;
}

.card-subtitle {
    font-size: 26px;
    color: rgb(112, 118, 140);
    margin-top: 6px;
    white-space: normal;
}

.card-cta {
    margin-top: 22px;
    padding: 10px 26px;
    border-radius: 26px;
    align-self: flex-start;
}
.cta-skeletal { background-color: rgb(228, 237, 255); }
.cta-muscular { background-color: rgb(255, 230, 233); }
.cta-cardio   { background-color: rgb(255, 228, 241); }

.card-cta-label { font-size: 24px; -unity-font-style: bold; }
.cta-label-skeletal { color: rgb(41, 98, 224); }
.cta-label-muscular { color: rgb(200, 35, 50); }
.cta-label-cardio   { color: rgb(200, 25, 110); }

/* Body-system picture: fills the full right side of the card, tinted panel,
   left edge dissolves into the white card via the runtime-generated fade. */
.card-image {
    width: 330px;
    flex-shrink: 0;
    position: relative;
    background-size: contain;
    background-position: center bottom;
    background-repeat: no-repeat;
}
.image-skeletal { background-color: rgb(232, 240, 255); background-image: url("project://database/Assets/UI/Icons/skeletal-body.png"); }
.image-muscular { background-color: rgb(255, 236, 239); background-image: url("project://database/Assets/UI/Icons/muscular-body.png"); }
.image-cardio   { background-color: rgb(253, 233, 244); background-image: url("project://database/Assets/UI/Icons/cardio-body.png"); }

.card-image-fade {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* Must stay transparent - gradient texture is assigned in
       StudentExplore3dController.ApplyCardImageFades(). */
    background-color: rgba(255, 255, 255, 0);
    background-repeat: no-repeat;
}

/* ---------------- PRO TIP ---------------- */

.pro-tip-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(240, 234, 253);
    border-radius: 36px;
    padding: 28px 30px;
    margin-top: 6px;
    width: 100%;
    box-sizing: border-box;
}

.pro-tip-icon-box {
    width: 84px; height: 84px; border-radius: 42px;
    background-color: rgba(255, 255, 255, 0.75);
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.pro-tip-icon { font-size: 40px; -unity-text-align: middle-center; }

.pro-tip-text-col { flex-grow: 1; flex-shrink: 1; flex-direction: column; min-width: 0; }
.pro-tip-title { font-size: 30px; -unity-font-style: bold; color: rgb(90, 60, 160); margin-bottom: 6px; }
.pro-tip-text { font-size: 24px; color: rgb(95, 85, 125); white-space: normal; }
