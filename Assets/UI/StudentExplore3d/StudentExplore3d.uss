/* ==========================================================
   Student Explore 3D - redesign
   Reference resolution: 1080 x 1920 (Scale With Screen Size)
   Element names / class hooks used by StudentExplore3dController
   are unchanged: .card, .icon-skeletal/.icon-muscular/.icon-cardio,
   .card-image-fade, .hidden, .card-play-armed,
   .play-mode-entry-button-active, .sync-status-icon-*.
   ========================================================== */

.screen-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(238, 242, 249);
    overflow: hidden;
}

/* ---------------- HEADER ---------------- */

.header {
    width: 100%;
    border-bottom-left-radius: 64px;
    border-bottom-right-radius: 64px;
    padding: 100px 50px 46px 50px;
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row { flex-direction: row; align-items: center; }

.back-button {
    width: 88px; height: 88px; border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 0;
    justify-content: center; align-items: center;
    margin: 0 30px 0 0;
    flex-shrink: 0;
}
.back-button:hover { background-color: rgba(255, 255, 255, 0.3); }
.back-button:active { background-color: rgba(255, 255, 255, 0.4); }

.back-icon {
    width: 40px; height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }

.header-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.header-subtitle {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
}

/* ---------------- PLAY BUTTON (white pill, stands out from header) ---------------- */

.play-mode-entry-button {
    flex-shrink: 0;
    align-self: center;
    width: auto;
    height: 72px;
    padding: 0 34px;
    margin: 0 0 0 12px;
    border-width: 0;
    border-radius: 36px;
    background-color: white;
    color: rgb(37, 99, 235);
    font-size: 28px;
    -unity-font-style: bold;
}
.play-mode-entry-button:hover { background-color: rgb(240, 245, 255); }
.play-mode-entry-button:active { background-color: rgb(225, 235, 255); }

.play-mode-entry-button-active { background-color: rgb(34, 160, 110); color: white; }
.play-mode-entry-button-active:hover { background-color: rgb(30, 145, 100); }

/* ---------------- SYNC PROGRESS BUTTON (redesign) ---------------- */
/* A light card that sits under the title row:
     (cloud badge)  Title / status text          [state pill]
     ------------- progress bar (only while syncing) -------------
   Hooks kept for the controller: sync-progress-button, sync-icon,
   sync-title-label, sync-status-label, sync-status-icon-box (+ .sync-status-icon-*),
   sync-status-icon, sync-chip-label, sync-bar-track / sync-bar-fill,
   .sync-row-syncing (on the button), .sync-bar-fill-end (sweep toggle). */
.anatomia-theme.theme-explore .sync-progress-row
{
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: auto;
    min-height: 120px;
    margin: 30px 0 0 0;
    padding: 20px 24px 26px 20px;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 36px;
    -unity-font-style: normal;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}
.anatomia-theme.theme-explore .sync-progress-row:hover { background-color: var(--surface-hover); }
.anatomia-theme.theme-explore .sync-progress-row:active { background-color: var(--sunken); scale: 0.985 0.985; }
.anatomia-theme.theme-explore .sync-progress-row:disabled { opacity: 1; }
.anatomia-theme.theme-explore .sync-progress-row:focus { border-width: 1px; border-color: var(--line); }

.anatomia-theme.theme-explore .sync-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 38px;
    flex-shrink: 0;
    margin-right: 22px;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
}
.anatomia-theme.theme-explore .sync-icon { width: 40px; height: 40px; -unity-background-image-tint-color: var(--accent); }

.anatomia-theme.theme-explore .sync-text-col { flex-grow: 1; flex-shrink: 1; flex-direction: column; min-width: 0; }
.anatomia-theme.theme-explore .sync-title-label { font-size: 29px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-explore .sync-status-label { font-size: 23px; color: var(--ink-3); margin-top: 3px; white-space: normal; }

.anatomia-theme.theme-explore .sync-status-icon-box
{
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 58px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 18px;
    padding-right: 22px;
    margin-left: 16px;
    flex-shrink: 0;
    background-color: var(--accent-soft);
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
    border-bottom-left-radius: 29px;
    border-bottom-right-radius: 29px;
}
.anatomia-theme.theme-explore .sync-status-icon { width: 28px; height: 28px; margin-right: 8px; -unity-background-image-tint-color: var(--accent); }
.anatomia-theme.theme-explore .sync-chip-label { font-size: 23px; -unity-font-style: bold; color: var(--accent); }

.anatomia-theme.theme-explore .sync-status-icon-synced  { background-color: var(--success-soft); }
.anatomia-theme.theme-explore .sync-status-icon-pending { background-color: var(--warn-soft); }
.anatomia-theme.theme-explore .sync-status-icon-syncing { background-color: var(--accent-soft); }
.anatomia-theme.theme-explore .sync-status-icon-failed  { background-color: var(--danger-soft); }
.anatomia-theme.theme-explore .sync-status-icon-offline { background-color: var(--sunken); }

.anatomia-theme.theme-explore .sync-status-icon-synced  .sync-status-icon { -unity-background-image-tint-color: var(--success); }
.anatomia-theme.theme-explore .sync-status-icon-pending .sync-status-icon { -unity-background-image-tint-color: var(--warn); }
.anatomia-theme.theme-explore .sync-status-icon-syncing .sync-status-icon { -unity-background-image-tint-color: var(--accent); }
.anatomia-theme.theme-explore .sync-status-icon-failed  .sync-status-icon { -unity-background-image-tint-color: var(--danger); }
.anatomia-theme.theme-explore .sync-status-icon-offline .sync-status-icon { -unity-background-image-tint-color: var(--ink-3); }

.anatomia-theme.theme-explore .sync-status-icon-synced  .sync-chip-label { color: var(--success); }
.anatomia-theme.theme-explore .sync-status-icon-pending .sync-chip-label { color: var(--warn); }
.anatomia-theme.theme-explore .sync-status-icon-syncing .sync-chip-label { color: var(--accent); }
.anatomia-theme.theme-explore .sync-status-icon-failed  .sync-chip-label { color: var(--danger); }
.anatomia-theme.theme-explore .sync-status-icon-offline .sync-chip-label { color: var(--ink-3); }

/* Indeterminate bar along the bottom edge (syncing only) */
.anatomia-theme.theme-explore .sync-bar-track
{
    position: absolute;
    left: 28px; right: 28px; bottom: 12px;
    height: 7px;
    border-radius: 4px;
    background-color: var(--track);
    overflow: hidden;
    display: none;
}
.anatomia-theme.theme-explore .sync-row-syncing .sync-bar-track { display: flex; }
.anatomia-theme.theme-explore .sync-bar-fill
{
    position: absolute;
    top: 0; bottom: 0;
    left: 0%;
    width: 34%;
    border-radius: 4px;
    background-color: var(--accent);
    transition-property: left;
    transition-duration: 0.9s;
    transition-timing-function: ease-in-out;
}
.anatomia-theme.theme-explore .sync-bar-fill.sync-bar-fill-end { left: 66%; }

/* ---------------- ICONS INSTEAD OF EMOJI ---------------- */
/* Play pill: icon inside, text is plain "Play" / "Cancel" */
.anatomia-theme.theme-explore .play-mode-entry-button
{
    position: relative;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: center;
    width: 220px;
    height: 76px;
    margin: 0 0 0 16px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 62px;
    padding-right: 26px;
    font-size: 28px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-left-radius: 38px;
    border-bottom-right-radius: 38px;
}
.anatomia-theme.theme-explore .play-btn-icon
{
    position: absolute;
    left: 30px;
    top: 23px;
    width: 30px;
    height: 30px;
    background-image: url("project://database/Assets/UI/Icons/play-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-explore .play-mode-entry-button-active .play-btn-icon
{
    background-image: url("project://database/Assets/UI/Icons/ex-icon.png");
    -unity-background-image-tint-color: white;
}

.anatomia-theme.theme-explore .banner-icon
{
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 16px;
    background-image: url("project://database/Assets/UI/Icons/targets-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.anatomia-theme.theme-explore .pro-tip-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/lock-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

/* ---------------- SCROLL VIEW (unchanged fixes) ---------------- */

.screen-scroll {
    flex-grow: 1; width: 100%; height: 100%;
    padding: 0; margin: 0;
    justify-content: flex-start; align-items: flex-start;
}

.screen-scroll .unity-scroller--vertical,
.screen-scroll #unity-scroller { width: 0; display: none; }

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport {
    padding: 0; margin: 0; flex-grow: 1; height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    padding: 0; margin: 0;
    translate: none;
    transform-origin: center;
    position: relative; top: 0; left: 0;
    justify-content: flex-start; align-items: stretch;
    flex-grow: 0;
    height: auto; min-height: 100%;
}

/* ---------------- CONTENT ---------------- */

.content-wrapper {
    width: 100%;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0; margin: 0;
}

/* Play Mode banner */
.play-mode-picker-banner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(225, 246, 237);
    border-radius: 28px;
    border-width: 2px;
    border-color: rgb(120, 205, 165);
    padding: 22px 26px;
    margin: 34px 50px 0 50px;
}
.play-mode-picker-banner.hidden { display: none; }

.play-mode-picker-banner-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(20, 110, 75);
    white-space: normal;
    flex-grow: 1; flex-shrink: 1;
    margin-right: 16px;
}

.play-mode-picker-cancel {
    align-self: center; flex-shrink: 0;
    width: auto; height: 54px;
    padding: 0 26px;
    border-width: 0; border-radius: 27px;
    background-color: white;
    color: rgb(20, 110, 75);
    font-size: 24px;
    -unity-font-style: bold;
}
.play-mode-picker-cancel:hover { background-color: rgb(245, 245, 245); }

/* ---------------- CARD LIST ---------------- */

.card-list {
    flex-direction: column;
    padding: 40px 50px 70px 50px;
    width: 100%;
}

.section-label {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(120, 128, 150);
    margin: 0 0 22px 8px;
}

/* ---------------- CARD ---------------- */

.card {
    flex-direction: row;
    align-items: stretch;
    background-color: white;
    border-radius: 40px;
    padding: 0;
    margin: 0 0 32px 0;
    width: 100%;
    min-height: 310px;
    overflow: hidden;
}

.card-button {
    border-width: 0;
    -unity-font-style: normal;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}
.card-button:hover { background-color: rgb(250, 251, 255); }
.card-button:active { background-color: rgb(238, 242, 252); scale: 0.985 0.985; }
.card-button:focus { border-width: 0; }

/* Armed for Play Mode: colored ring (declared after .card-button so it wins) */
.card-play-armed {
    border-width: 4px;
    border-color: rgb(34, 160, 110);
}
.card-play-armed:focus { border-width: 4px; }

/* Thin colored spine on the left edge */
.card-accent { width: 14px; flex-shrink: 0; }
.accent-skeletal { background-color: rgb(41, 98, 224); }
.accent-muscular { background-color: rgb(224, 49, 63); }
.accent-cardio   { background-color: rgb(224, 41, 130); }

.card-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    padding: 34px 10px 34px 34px;
}

.icon-box {
    width: 96px; height: 96px;
    border-radius: 30px;
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-bottom: 22px;
}
.icon-skeletal { background-color: rgb(41, 98, 224); }
.icon-muscular { background-color: rgb(224, 49, 63); }
.icon-cardio   { background-color: rgb(224, 41, 130); }

.icon-emoji {
    width: 54px; height: 54px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.icon-skeletal .icon-emoji { background-image: url("project://database/Assets/UI/Icons/skull-white.png"); }
.icon-muscular .icon-emoji { background-image: url("project://database/Assets/UI/Icons/muscular-white.png"); }
.icon-cardio   .icon-emoji { background-image: url("project://database/Assets/UI/Icons/cardio-white.png"); }

.card-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(24, 27, 44);
    white-space: normal;
}

.card-subtitle {
    font-size: 26px;
    color: rgb(112, 118, 140);
    margin-top: 6px;
    white-space: normal;
}

.card-cta {
    margin-top: 22px;
    padding: 10px 26px;
    border-radius: 26px;
    align-self: flex-start;
}
.cta-skeletal { background-color: rgb(228, 237, 255); }
.cta-muscular { background-color: rgb(255, 230, 233); }
.cta-cardio   { background-color: rgb(255, 228, 241); }

.card-cta-label { font-size: 24px; -unity-font-style: bold; }
.cta-label-skeletal { color: rgb(41, 98, 224); }
.cta-label-muscular { color: rgb(200, 35, 50); }
.cta-label-cardio   { color: rgb(200, 25, 110); }

/* Body-system picture: fills the full right side of the card, tinted panel,
   left edge dissolves into the white card via the runtime-generated fade. */
.card-image {
    width: 330px;
    flex-shrink: 0;
    position: relative;
    background-size: contain;
    background-position: center bottom;
    background-repeat: no-repeat;
}
.image-skeletal { background-color: rgb(232, 240, 255); background-image: url("project://database/Assets/UI/Icons/skeletal-body.png"); }
.image-muscular { background-color: rgb(255, 236, 239); background-image: url("project://database/Assets/UI/Icons/muscular-body.png"); }
.image-cardio   { background-color: rgb(253, 233, 244); background-image: url("project://database/Assets/UI/Icons/cardio-body.png"); }

.card-image-fade {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* Must stay transparent - gradient texture is assigned in
       StudentExplore3dController.ApplyCardImageFades(). */
    background-color: rgba(255, 255, 255, 0);
    background-repeat: no-repeat;
}

/* ---------------- PRO TIP ---------------- */

.pro-tip-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(240, 234, 253);
    border-radius: 36px;
    padding: 28px 30px;
    margin-top: 6px;
    width: 100%;
}

.pro-tip-icon-box {
    width: 84px; height: 84px; border-radius: 42px;
    background-color: rgba(255, 255, 255, 0.75);
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.pro-tip-icon { font-size: 40px; -unity-text-align: middle-center; }

.pro-tip-text-col { flex-grow: 1; flex-shrink: 1; flex-direction: column; min-width: 0; }
.pro-tip-title { font-size: 30px; -unity-font-style: bold; color: rgb(90, 60, 160); margin-bottom: 6px; }
.pro-tip-text { font-size: 24px; color: rgb(95, 85, 125); white-space: normal; }
