<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StudentExplore3d/StudentExplore3d.uss"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <!-- ===================== SCROLLABLE CONTENT ===================== -->
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <!-- ===================== HEADER ===================== -->
            <ui:VisualElement name="header" class="header">
                <ui:VisualElement name="header-top-row" class="header-top-row">
                    <ui:Button name="back-button" class="back-button">
                        <ui:VisualElement name="back-icon" class="back-icon"/>
                    </ui:Button>
                    <ui:VisualElement name="header-text" class="header-text">
                        <ui:Label name="header-title" text="Anatomy Systems" class="header-title"/>
                        <ui:Label name="header-subtitle" text="Explore human body in 3D" class="header-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="content-wrapper" class="content-wrapper">
                <ui:VisualElement name="card-list" class="card-list">
                    <ui:Button name="card-skeletal" class="card card-button">
                        <ui:VisualElement class="icon-box icon-skeletal" picking-mode="Ignore">
                            <ui:Label text="" class="icon-emoji" picking-mode="Ignore"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="card-info" picking-mode="Ignore">
                            <ui:Label text="Skeletal System" class="card-title" picking-mode="Ignore"/>
                            <ui:Label text="206 structures" class="card-subtitle" picking-mode="Ignore"/>
                            <ui:VisualElement class="progress-row" picking-mode="Ignore">
                                <ui:VisualElement class="progress-track" picking-mode="Ignore">
                                    <ui:VisualElement class="progress-fill fill-skeletal" picking-mode="Ignore"/>
                                </ui:VisualElement>
                                <ui:Label text="75%" class="progress-label" picking-mode="Ignore"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="card-muscular" class="card card-button">
                        <ui:VisualElement class="icon-box icon-muscular" picking-mode="Ignore">
                            <ui:Label text="" class="icon-emoji" picking-mode="Ignore"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="card-info" picking-mode="Ignore">
                            <ui:Label text="Muscular System" class="card-title" picking-mode="Ignore"/>
                            <ui:Label text="640 structures" class="card-subtitle" picking-mode="Ignore"/>
                            <ui:VisualElement class="progress-row" picking-mode="Ignore">
                                <ui:VisualElement class="progress-track" picking-mode="Ignore">
                                    <ui:VisualElement class="progress-fill fill-muscular" picking-mode="Ignore"/>
                                </ui:VisualElement>
                                <ui:Label text="45%" class="progress-label" picking-mode="Ignore"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="card-cardio" class="card card-button">
                        <ui:VisualElement class="icon-box icon-cardio" picking-mode="Ignore">
                            <ui:Label text="" class="icon-emoji" picking-mode="Ignore"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="card-info" picking-mode="Ignore">
                            <ui:Label text="Cardiovascular System" class="card-title" picking-mode="Ignore"/>
                            <ui:Label text="124 structures" class="card-subtitle" picking-mode="Ignore"/>
                            <ui:VisualElement class="progress-row" picking-mode="Ignore">
                                <ui:VisualElement class="progress-track" picking-mode="Ignore">
                                    <ui:VisualElement class="progress-fill fill-cardio" picking-mode="Ignore"/>
                                </ui:VisualElement>
                                <ui:Label text="30%" class="progress-label" picking-mode="Ignore"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:VisualElement class="pro-tip-card">
                        <ui:Label text="💡 Pro Tip" class="pro-tip-title"/>
                        <ui:Label text="Use pinch to zoom, rotate with two fingers, and tap on structures to learn more!" class="pro-tip-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>