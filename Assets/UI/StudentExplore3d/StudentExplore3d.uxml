<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StudentExplore3d/StudentExplore3d.uss?fileID=7433441132597879392&amp;guid=743ca842e0d65074d907c76c9ffa0cb1&amp;type=3#StudentExplore3d"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme theme-explore screen-root">
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">

            <!-- ============ HEADER (gradient applied at runtime by controller) ============ -->
            <ui:VisualElement name="header" class="header">
                <ui:VisualElement name="header-top-row" class="header-top-row">
                    <ui:Button name="back-button" class="back-button">
                        <ui:VisualElement name="back-icon" class="back-icon"/>
                    </ui:Button>
                    <ui:VisualElement name="header-text" class="header-text">
                        <ui:Label name="header-title" text="Explore 3D" class="header-title"/>
                        <ui:Label name="header-subtitle" text="Pick a body system to study" class="header-subtitle"/>
                    </ui:VisualElement>
                    <ui:Button name="play-mode-entry-button" text="Play" class="play-mode-entry-button">
                        <ui:VisualElement name="play-btn-icon" picking-mode="Ignore" class="play-btn-icon"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:Button name="sync-progress-button" class="sync-progress-row">
                    <ui:VisualElement picking-mode="Ignore" class="sync-icon-box">
                        <ui:Image name="sync-icon" scale-mode="ScaleToFit" picking-mode="Ignore" class="sync-icon"/>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="sync-text-col">
                        <ui:Label name="sync-title-label" text="Sync Progress" picking-mode="Ignore" class="sync-title-label"/>
                        <ui:Label name="sync-status-label" text="Checking sync status..." picking-mode="Ignore" class="sync-status-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="sync-status-icon-box" picking-mode="Ignore" class="sync-status-icon-box sync-status-icon-syncing">
                        <ui:Image name="sync-status-icon" scale-mode="ScaleToFit" picking-mode="Ignore" class="sync-status-icon"/>
                        <ui:Label name="sync-chip-label" text="Syncing" picking-mode="Ignore" class="sync-chip-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="sync-bar-track" picking-mode="Ignore" class="sync-bar-track">
                        <ui:VisualElement name="sync-bar-fill" picking-mode="Ignore" class="sync-bar-fill"/>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>

            <!-- ============ CONTENT ============ -->
            <ui:VisualElement name="content-wrapper" class="content-wrapper">

                <ui:VisualElement name="play-mode-picker-banner" class="play-mode-picker-banner hidden">
                    <ui:VisualElement picking-mode="Ignore" class="banner-icon"/>
                    <ui:Label text="Play Mode: tap a system to start" class="play-mode-picker-banner-label"/>
                    <ui:Button name="play-mode-picker-cancel" text="Cancel" class="play-mode-picker-cancel"/>
                </ui:VisualElement>

                <ui:VisualElement name="card-list" class="card-list">

                    <ui:Label text="BODY SYSTEMS" class="section-label"/>

                    <!-- Skeletal -->
                    <ui:Button name="card-skeletal" class="card card-button">
                        <ui:VisualElement picking-mode="Ignore" class="card-accent accent-skeletal"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-body">
                            <ui:VisualElement picking-mode="Ignore" class="icon-box icon-skeletal">
                                <ui:VisualElement picking-mode="Ignore" class="icon-emoji"/>
                            </ui:VisualElement>
                            <ui:Label text="Skeletal System" picking-mode="Ignore" class="card-title"/>
                            <ui:Label text="Bones &amp; structure" picking-mode="Ignore" class="card-subtitle"/>
                            <ui:VisualElement picking-mode="Ignore" class="card-cta cta-skeletal">
                                <ui:Label text="Explore  ›" picking-mode="Ignore" class="card-cta-label cta-label-skeletal"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="skeletal-image" picking-mode="Ignore" class="card-image image-skeletal">
                            <ui:VisualElement name="skeletal-image-fade" picking-mode="Ignore" class="card-image-fade"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <!-- Muscular -->
                    <ui:Button name="card-muscular" class="card card-button">
                        <ui:VisualElement picking-mode="Ignore" class="card-accent accent-muscular"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-body">
                            <ui:VisualElement picking-mode="Ignore" class="icon-box icon-muscular">
                                <ui:VisualElement picking-mode="Ignore" class="icon-emoji"/>
                            </ui:VisualElement>
                            <ui:Label text="Muscular System" picking-mode="Ignore" class="card-title"/>
                            <ui:Label text="Muscles &amp; movement" picking-mode="Ignore" class="card-subtitle"/>
                            <ui:VisualElement picking-mode="Ignore" class="card-cta cta-muscular">
                                <ui:Label text="Explore  ›" picking-mode="Ignore" class="card-cta-label cta-label-muscular"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="muscular-image" picking-mode="Ignore" class="card-image image-muscular">
                            <ui:VisualElement name="muscular-image-fade" picking-mode="Ignore" class="card-image-fade"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <!-- Cardiovascular -->
                    <ui:Button name="card-cardio" class="card card-button">
                        <ui:VisualElement picking-mode="Ignore" class="card-accent accent-cardio"/>
                        <ui:VisualElement picking-mode="Ignore" class="card-body">
                            <ui:VisualElement picking-mode="Ignore" class="icon-box icon-cardio">
                                <ui:VisualElement picking-mode="Ignore" class="icon-emoji"/>
                            </ui:VisualElement>
                            <ui:Label text="Cardiovascular System" picking-mode="Ignore" class="card-title"/>
                            <ui:Label text="Heart &amp; blood vessels" picking-mode="Ignore" class="card-subtitle"/>
                            <ui:VisualElement picking-mode="Ignore" class="card-cta cta-cardio">
                                <ui:Label text="Explore  ›" picking-mode="Ignore" class="card-cta-label cta-label-cardio"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="cardiovascular-image" picking-mode="Ignore" class="card-image image-cardio">
                            <ui:VisualElement name="cardiovascular-image-fade" picking-mode="Ignore" class="card-image-fade"/>
                        </ui:VisualElement>
                    </ui:Button>

                    <!-- Pro tip -->
                    <ui:VisualElement class="pro-tip-card">
                        <ui:VisualElement picking-mode="Ignore" class="pro-tip-icon-box">
                            <ui:VisualElement picking-mode="Ignore" class="pro-tip-icon"/>
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="pro-tip-text-col">
                            <ui:Label text="Pro Tip" picking-mode="Ignore" class="pro-tip-title"/>
                            <ui:Label text="To use Offline Mode, please set a security password on your device." picking-mode="Ignore" class="pro-tip-text"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
