/* =========================================================
   Anatomia 3D - Admin Profile (Unity 6 UI Toolkit)  -- redesign
   Reference canvas: 1080 x 1920 (portrait phone).

   Layout (top to bottom):
     header      : back chip + "Profile" title (sits on the ambient background)
     hero card   : avatar on the left, name / email / role pill on the right
     stat tiles  : three separate tiles (classrooms, students, quizzes)
     Account     : edit profile, notifications
     About       : about Anatomia 3D
     Log out     : quiet destructive row
   All rules are scoped under .anatomia-theme.theme-adminprofile so they out-rank
   the generic theme rules in AnatomiaTheme.uss (which loads after this file).
   USS has no sibling combinator, so spacing uses explicit margins.
   ========================================================= */

/* ---------- Screen ---------- */
.anatomia-theme.theme-adminprofile.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- ScrollView ---------- */
.anatomia-theme.theme-adminprofile .screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.anatomia-theme.theme-adminprofile .screen-scroll .unity-scroller--vertical { width: 0; display: none; }

.anatomia-theme.theme-adminprofile .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.anatomia-theme.theme-adminprofile .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Header: just back chip + title ---------- */
.anatomia-theme.theme-adminprofile .header
{
    width: 100%;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 96px;
    padding-bottom: 8px;
}

.anatomia-theme.theme-adminprofile .header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 0;
}

.anatomia-theme.theme-adminprofile .back-button
{
    margin: 0 28px 0 0;
    padding: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.anatomia-theme.theme-adminprofile .back-icon
{
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}

.anatomia-theme.theme-adminprofile .header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.anatomia-theme.theme-adminprofile .header-title { white-space: normal; word-wrap: break-word; }
.anatomia-theme.theme-adminprofile .header-subtitle { margin-top: 4px; white-space: normal; word-wrap: break-word; }

/* ---------- Content ---------- */
.anatomia-theme.theme-adminprofile .content-wrapper
{
    flex-direction: column;
    flex-shrink: 0;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 20px;
    padding-bottom: 72px;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Hero card ---------- */
.anatomia-theme.theme-adminprofile .profile-summary-card
{
    flex-direction: row;
    align-items: center;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 44px;
    padding: 36px;
    margin: 0;
}

.anatomia-theme.theme-adminprofile .avatar
{
    width: 188px;
    height: 188px;
    border-radius: 94px;
    flex-shrink: 0;
    margin: 0 36px 0 0;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
    border-width: 5px;
    border-color: var(--surface-solid);
}

.anatomia-theme.theme-adminprofile .avatar-initials
{
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--accent);
}

.anatomia-theme.theme-adminprofile .profile-info
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-items: flex-start;
}

.anatomia-theme.theme-adminprofile .profile-name
{
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: -0.6px;
    -unity-text-align: middle-left;
    white-space: normal;
    word-wrap: break-word;
    max-width: 100%;
}

.anatomia-theme.theme-adminprofile .profile-email
{
    font-size: 27px;
    -unity-text-align: middle-left;
    margin-top: 4px;
    white-space: normal;
    word-wrap: break-word;
    max-width: 100%;
}

.anatomia-theme.theme-adminprofile .role-badge
{
    align-self: flex-start;
    margin-top: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 28px;
    padding-right: 28px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    border-width: 0;
    background-color: var(--accent-soft);
}

.anatomia-theme.theme-adminprofile .role-badge-label
{
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--accent);
}

/* ---------- Stat tiles (three separate cards) ---------- */
.anatomia-theme.theme-adminprofile .stats-row
{
    flex-direction: row;
    margin: 24px 0 0 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.anatomia-theme.theme-adminprofile .stat-card
{
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 24px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 36px;
}

.anatomia-theme.theme-adminprofile .stat-card-left { margin-right: 10px; }
.anatomia-theme.theme-adminprofile .stat-card-mid { margin-left: 10px; margin-right: 10px; }
.anatomia-theme.theme-adminprofile .stat-card-right { margin-left: 10px; }

.anatomia-theme.theme-adminprofile .stat-icon
{
    width: 68px;
    height: 68px;
    border-radius: 22px;
    margin-bottom: 22px;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
}

.anatomia-theme.theme-adminprofile .stat-icon-glyph { width: 38px; height: 38px; -unity-background-image-tint-color: var(--accent); background-size: contain; background-position: center; background-repeat: no-repeat; }

.anatomia-theme.theme-adminprofile .stat-value
{
    font-size: 52px;
    -unity-font-style: bold;
    letter-spacing: -0.8px;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.anatomia-theme.theme-adminprofile .stat-label
{
    font-size: 24px;
    -unity-text-align: middle-left;
    white-space: normal;
}

/* ---------- Menu groups ---------- */
.anatomia-theme.theme-adminprofile .section-title
{
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink-3);
    padding: 0 12px;
    margin: 44px 0 16px 0;
    -unity-text-align: middle-left;
}

.anatomia-theme.theme-adminprofile .menu-card
{
    margin: 0;
    padding: 8px 12px;
    border-radius: 40px;
}

.anatomia-theme.theme-adminprofile .menu-item
{
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 30px;
    padding: 22px;
    margin: 0;
}

.anatomia-theme.theme-adminprofile .menu-divider { height: 1px; margin: 0 24px 0 122px; }

.anatomia-theme.theme-adminprofile .menu-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 24px;
    margin-right: 26px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
}

.anatomia-theme.theme-adminprofile .menu-icon-glyph { width: 40px; height: 40px; background-size: contain; background-position: center; background-repeat: no-repeat; }

.anatomia-theme.theme-adminprofile .menu-item-label
{
    font-size: 33px;
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.anatomia-theme.theme-adminprofile .menu-chevron
{
    width: 20px;
    height: 20px;
    border-top-width: 4px;
    border-right-width: 4px;
    rotate: 45deg;
    flex-shrink: 0;
    margin-right: 12px;
}

/* ---------- Log out ---------- */
.anatomia-theme.theme-adminprofile .logout-button
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin: 44px 0 0 0;
    padding: 24px;
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
    border-width: 0;
    background-color: var(--danger-soft);
}

.anatomia-theme.theme-adminprofile .logout-button:hover { background-color: rgba(204, 64, 64, 0.16); }
.anatomia-theme.theme-adminprofile .logout-button:active { background-color: rgba(204, 64, 64, 0.22); }

.anatomia-theme.theme-adminprofile .logout-button .menu-icon-box
{
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 16px;
    background-color: rgba(0, 0, 0, 0);
}

.anatomia-theme.theme-adminprofile .logout-button .menu-icon-glyph
{
    width: 36px;
    height: 36px;
    -unity-background-image-tint-color: var(--danger);
}

.anatomia-theme.theme-adminprofile .logout-label { font-size: 32px; -unity-font-style: bold; }

.anatomia-theme.theme-adminprofile .version-label
{
    font-size: 23px;
    -unity-text-align: middle-center;
    margin: 36px 0 0 0;
}

/* =========================================================
   Compact layout (toggled by C# when the panel is narrow)
   ========================================================= */
.anatomia-theme.theme-adminprofile.compact .back-icon { width: 32px; height: 32px; }
.anatomia-theme.theme-adminprofile.compact .header { padding-left: 40px; padding-right: 40px; padding-top: 80px; }
.anatomia-theme.theme-adminprofile.compact .content-wrapper { padding-left: 40px; padding-right: 40px; }

.anatomia-theme.theme-adminprofile.compact .profile-summary-card { padding: 28px; border-radius: 38px; }
.anatomia-theme.theme-adminprofile.compact .avatar { width: 148px; height: 148px; border-radius: 74px; margin-right: 26px; }
.anatomia-theme.theme-adminprofile.compact .avatar-initials { font-size: 56px; }
.anatomia-theme.theme-adminprofile.compact .profile-name { font-size: 38px; }
.anatomia-theme.theme-adminprofile.compact .profile-email { font-size: 23px; }
.anatomia-theme.theme-adminprofile.compact .role-badge
{
    margin-top: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 22px;
    padding-right: 22px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}
.anatomia-theme.theme-adminprofile.compact .role-badge-label { font-size: 22px; }

.anatomia-theme.theme-adminprofile.compact .stat-card { padding: 22px 18px; border-radius: 30px; }
.anatomia-theme.theme-adminprofile.compact .stat-icon { width: 56px; height: 56px; border-radius: 18px; margin-bottom: 16px; }
.anatomia-theme.theme-adminprofile.compact .stat-icon-glyph { width: 32px; height: 32px; }
.anatomia-theme.theme-adminprofile.compact .stat-value { font-size: 42px; }
.anatomia-theme.theme-adminprofile.compact .stat-label { font-size: 20px; }

.anatomia-theme.theme-adminprofile.compact .section-title { font-size: 21px; margin-top: 34px; }
.anatomia-theme.theme-adminprofile.compact .menu-item { padding: 18px; }
.anatomia-theme.theme-adminprofile.compact .menu-icon-box { width: 64px; height: 64px; border-radius: 20px; margin-right: 20px; }
.anatomia-theme.theme-adminprofile.compact .menu-icon-glyph { width: 34px; height: 34px; }
.anatomia-theme.theme-adminprofile.compact .menu-divider { margin-left: 102px; }
.anatomia-theme.theme-adminprofile.compact .menu-item-label { font-size: 29px; }
.anatomia-theme.theme-adminprofile.compact .logout-label { font-size: 28px; }
.anatomia-theme.theme-adminprofile.compact .version-label { font-size: 20px; }
