/* =========================================================
   Anatomia 3D - Join Classroom (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 100px;
    padding-bottom: 50px;
    flex-shrink: 0;
    flex-direction: column;
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
}

.back-button
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 30px;
    flex-shrink: 0;
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 50px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
    word-wrap: break-word;
}

.header-subtitle
{
    font-size: 30px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
    word-wrap: break-word;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 44px;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
    box-sizing: border-box;
}

/* ---------- Classroom Card ---------- */

.classroom-card
{
    background-color: white;
    border-radius: 32px;
    padding: 50px;
    width: 100%;
    box-sizing: border-box;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    margin-bottom: 34px;
}

.card-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.card-subtitle
{
    font-size: 30px;
    color: rgb(138, 143, 163);
    margin-top: 8px;
    margin-bottom: 34px;
    white-space: normal;
}

/* ---------- Labels ---------- */

.field-label
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 14px;
}

.field-label-spaced
{
    margin-top: 0;
}

.field-error
{
    font-size: 28px;
    color: rgb(224, 33, 138);
    margin-top: 10px;
    white-space: normal;
}

.hidden
{
    display: none;
}

/* ---------- Input Container ---------- */

.input-container
{
    width: 100%;
    height: 128px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(244, 245, 247);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(231, 232, 237);
    padding-left: 30px;
    padding-right: 20px;
}

.input-container-focused
{
    border-color: rgb(37, 99, 235);
}

.input-icon
{
    width: 40px;
    height: 40px;
    margin-right: 20px;
    flex-shrink: 0;
}

.icon-key
{
    background-image: url("project://database/Assets/UI/Icons/key-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.input-field
{
    flex-grow: 1;
    font-size: 36px;
    color: rgb(31, 36, 48);
    background-color: transparent;
    border-width: 0;
}

.input-field > #unity-text-input
{
    background-color: transparent;
    border-width: 0;
}

.code-input-field > #unity-text-input
{
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.helper-text
{
    font-size: 26px;
    color: rgb(160, 165, 178);
    margin-top: 12px;
}

/* ---------- Info Box ---------- */

.info-box
{
    background-color: rgb(244, 246, 251);
    border-radius: 24px;
    padding: 30px;
    margin-top: 34px;
}

.info-title
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 18px;
}

.info-list
{
    flex-direction: column;
}

.info-item
{
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 10px;
}

.info-item-last
{
    margin-bottom: 0;
}

.info-bullet
{
    font-size: 28px;
    color: rgb(90, 96, 112);
    margin-right: 14px;
    -unity-font-style: bold;
}

.info-text
{
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 28px;
    color: rgb(90, 96, 112);
    white-space: normal;
    word-wrap: break-word;
}

/* ---------- Status ---------- */

.status-label
{
    margin-top: 24px;
    font-size: 30px;
    color: rgb(224, 33, 138);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Join Button (gradient applied at runtime via C#) ---------- */

.join-submit-button
{
    width: 100%;
    height: 132px;
    margin-top: 34px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: rgb(37, 99, 235);
    color: white;
    border-radius: 28px;
    border-width: 0;
}

.join-submit-button:hover
{
    opacity: 0.92;
}

.join-submit-icon
{
    width: 38px;
    height: 38px;
    margin-right: 16px;
    -unity-background-image-tint-color: white;
    background-image: url("project://database/Assets/UI/Icons/people-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.join-submit-label
{
    font-size: 40px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- Tip Card ---------- */

.tip-card
{
    flex-direction: row;
    align-items: flex-start;
    background-color: rgb(235, 243, 255);
    border-radius: 28px;
    border-width: 1px;
    border-color: rgb(210, 226, 253);
    padding: 34px;
    margin-bottom: 40px;
}

.tip-icon-box
{
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.7);
    justify-content: center;
    align-items: center;
    margin-right: 22px;
    flex-shrink: 0;
}

.tip-icon-emoji
{
    font-size: 34px;
    -unity-text-align: middle-center;
}

.tip-text-block
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.tip-title
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(31, 65, 138);
}

.tip-subtitle
{
    font-size: 28px;
    color: rgb(59, 92, 158);
    margin-top: 6px;
    white-space: normal;
    word-wrap: break-word;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 70px;
    padding-bottom: 40px;
}

.compact .header-title
{
    font-size: 36px;
}

.compact .header-subtitle
{
    font-size: 22px;
}

.compact .back-button
{
    width: 68px;
    height: 68px;
    border-radius: 34px;
    margin-right: 20px;
}

.compact .back-icon
{
    width: 32px;
    height: 32px;
}

.compact .content-wrapper
{
    padding: 26px;
}

.compact .classroom-card
{
    padding: 30px;
    border-radius: 26px;
}

.compact .card-title
{
    font-size: 32px;
}

.compact .card-subtitle
{
    font-size: 22px;
    margin-bottom: 26px;
}

.compact .input-container
{
    height: 96px;
    border-radius: 20px;
}

.compact .input-field
{
    font-size: 28px;
}

.compact .info-box
{
    padding: 22px;
    border-radius: 20px;
}

.compact .info-title
{
    font-size: 24px;
}

.compact .info-text,
.compact .info-bullet
{
    font-size: 21px;
}

.compact .join-submit-button
{
    height: 100px;
}

.compact .join-submit-label
{
    font-size: 28px;
}

.compact .tip-card
{
    padding: 22px;
    border-radius: 22px;
}

.compact .tip-icon-box
{
    width: 52px;
    height: 52px;
    margin-right: 16px;
}

.compact .tip-title
{
    font-size: 24px;
}

.compact .tip-subtitle
{
    font-size: 21px;
}
