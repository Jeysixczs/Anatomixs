/* =========================================================
   Anatomia 3D - Join Classroom (redesign)
   Reference canvas: 1080 x 1920 (portrait phone).
   Layout: back chip + title | code card (icon, title, big code field) |
   "What is a classroom code?" checklist | tip | fixed bottom bar with
   status + Join Classroom.
   Scoped under .anatomia-theme.theme-classroom so it out-ranks the generic
   theme rules. Controller hooks kept: classroom-code-field, code-error,
   status-label, join-classroom-submit-button, .hidden, .compact.
   ========================================================= */

.anatomia-theme.theme-classroom.screen-root { width: 100%; height: 100%; flex-grow: 1; padding: 0; margin: 0; overflow: hidden; justify-content: flex-start; align-items: stretch; }

/* ---------- Header ---------- */
.anatomia-theme.theme-classroom .header
{
    width: 100%;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 96px;
    padding-bottom: 8px;
}
.anatomia-theme.theme-classroom .header-top-row { flex-direction: row; align-items: center; margin-bottom: 0; }
.anatomia-theme.theme-classroom .back-button { margin: 0 28px 0 0; padding: 0; flex-shrink: 0; justify-content: center; align-items: center; }
.anatomia-theme.theme-classroom .back-icon
{
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}
.anatomia-theme.theme-classroom .header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }
.anatomia-theme.theme-classroom .header-title { white-space: normal; word-wrap: break-word; }
.anatomia-theme.theme-classroom .header-subtitle { margin-top: 4px; white-space: normal; word-wrap: break-word; }

/* ---------- ScrollView ---------- */
.anatomia-theme.theme-classroom .screen-scroll { flex-grow: 1; width: 100%; height: 100%; padding: 0; margin: 0; justify-content: flex-start; align-items: flex-start; -unity-overflow-scrolling: touch; }
.anatomia-theme.theme-classroom .screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.anatomia-theme.theme-classroom .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport { padding: 0; margin: 0; flex-grow: 1; height: 100%; }
.anatomia-theme.theme-classroom .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0; margin: 0;
    translate: none; transform-origin: center;
    position: relative; top: 0; left: 0;
    justify-content: flex-start; align-items: stretch;
    flex-grow: 0; height: auto; min-height: 100%;
}

/* ---------- Content (room at the bottom for the fixed bar) ---------- */
.anatomia-theme.theme-classroom .content-wrapper
{
    flex-direction: column;
    flex-shrink: 0;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 20px;
    padding-bottom: 300px;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Code card ---------- */
.anatomia-theme.theme-classroom .classroom-card
{
    width: 100%;
    align-items: center;
    padding: 48px 44px 44px 44px;
    margin: 0 0 24px 0;
    border-radius: 44px;
}

.anatomia-theme.theme-classroom .hero-icon-ring
{
    width: 132px;
    height: 132px;
    border-radius: 66px;
    margin-bottom: 28px;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
}
.anatomia-theme.theme-classroom .hero-icon
{
    width: 66px;
    height: 66px;
    background-image: url("project://database/Assets/UI/Icons/classroom-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}

.anatomia-theme.theme-classroom .card-title { font-size: 42px; -unity-font-style: bold; letter-spacing: -0.5px; color: var(--ink); -unity-text-align: middle-center; white-space: normal; }
.anatomia-theme.theme-classroom .card-subtitle { font-size: 27px; color: var(--ink-3); margin: 8px 0 36px 0; -unity-text-align: middle-center; white-space: normal; }

.anatomia-theme.theme-classroom .field-label { align-self: flex-start; font-size: 23px; letter-spacing: 3px; margin: 0 0 14px 6px; }
.anatomia-theme.theme-classroom .field-label-spaced { margin-top: 0; }

/* The text field itself is the box so :focus can highlight it. The key icon
   floats over its left edge. */
.anatomia-theme.theme-classroom .input-container
{
    position: relative;
    width: 100%;
    height: auto;
    flex-direction: row;
    align-items: center;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.anatomia-theme.theme-classroom .input-icon
{
    position: absolute;
    left: 30px;
    top: 41px;
    width: 40px;
    height: 40px;
    margin: 0;
    background-image: url("project://database/Assets/UI/Icons/key-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.anatomia-theme.theme-classroom .input-field
{
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: var(--ink);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.anatomia-theme.theme-classroom .input-field > #unity-text-input
{
    height: 122px;
    padding-left: 92px;
    padding-right: 28px;
    background-color: var(--sunken);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 30px;
    color: var(--ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-left;
}
.anatomia-theme.theme-classroom .input-field > #unity-text-input:hover { border-color: var(--line-strong); }
.anatomia-theme.theme-classroom .input-field > #unity-text-input:focus { background-color: var(--surface-solid); border-color: var(--accent); }

.anatomia-theme.theme-classroom .helper-text { align-self: flex-start; font-size: 24px; margin: 14px 0 0 6px; }
.anatomia-theme.theme-classroom .field-error { align-self: flex-start; font-size: 25px; -unity-font-style: bold; margin: 10px 0 0 6px; white-space: normal; }
.anatomia-theme.theme-classroom .hidden { display: none; }

/* ---------- What is a code ---------- */
.anatomia-theme.theme-classroom .info-box
{
    padding: 34px;
    margin: 0 0 24px 0;
    border-radius: 40px;
}
.anatomia-theme.theme-classroom .info-title { font-size: 31px; -unity-font-style: bold; letter-spacing: -0.2px; color: var(--ink); margin-bottom: 20px; }
.anatomia-theme.theme-classroom .info-list { flex-direction: column; }
.anatomia-theme.theme-classroom .info-item { flex-direction: row; align-items: center; margin-bottom: 16px; }
.anatomia-theme.theme-classroom .info-item-last { margin-bottom: 0; }
.anatomia-theme.theme-classroom .info-check
{
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 18px;
    border-radius: 20px;
    background-color: var(--accent-soft);
    background-image: url("project://database/Assets/UI/Icons/check-icon.png");
    background-size: 24px 24px;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-classroom .info-text { flex-grow: 1; flex-shrink: 1; font-size: 27px; color: var(--ink-2); white-space: normal; word-wrap: break-word; }

/* ---------- Tip ---------- */
.anatomia-theme.theme-classroom .tip-card
{
    flex-direction: row;
    align-items: center;
    padding: 30px;
    margin: 0;
    border-radius: 40px;
    border-width: 1px;
    border-color: var(--accent-soft);
    background-color: var(--accent-faint);
}
.anatomia-theme.theme-classroom .tip-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 38px;
    flex-shrink: 0;
    margin-right: 24px;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-solid);
}
.anatomia-theme.theme-classroom .tip-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/identification-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-classroom .tip-text-block { flex-grow: 1; flex-shrink: 1; flex-direction: column; min-width: 0; }
.anatomia-theme.theme-classroom .tip-title { font-size: 29px; -unity-font-style: bold; color: var(--accent); }
.anatomia-theme.theme-classroom .tip-subtitle { font-size: 25px; color: var(--ink-2); margin-top: 4px; white-space: normal; word-wrap: break-word; }

/* ---------- Fixed bottom bar ---------- */
.anatomia-theme.theme-classroom .join-bar
{
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    padding: 24px 52px 44px 52px;
    background-color: var(--surface-solid);
    border-top-width: 1px;
    border-top-color: var(--line);
}
.anatomia-theme.theme-classroom .status-label { margin: 0 0 16px 0; font-size: 26px; color: var(--ink-2); -unity-text-align: middle-center; white-space: normal; }
.anatomia-theme.theme-classroom .join-submit-button
{
    width: 100%;
    height: 112px;
    margin: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-width: 0;
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}
.anatomia-theme.theme-classroom .join-submit-icon
{
    width: 42px;
    height: 42px;
    margin-right: 16px;
    background-image: url("project://database/Assets/UI/Icons/users-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}
.anatomia-theme.theme-classroom .join-submit-label { font-size: 36px; -unity-font-style: bold; color: white; }

/* =========================================================
   Compact layout
   ========================================================= */
.anatomia-theme.theme-classroom.compact .header { padding-left: 40px; padding-right: 40px; padding-top: 80px; }
.anatomia-theme.theme-classroom.compact .back-icon { width: 32px; height: 32px; }
.anatomia-theme.theme-classroom.compact .content-wrapper { padding-left: 40px; padding-right: 40px; padding-bottom: 270px; }
.anatomia-theme.theme-classroom.compact .classroom-card { padding: 36px 30px 32px 30px; border-radius: 38px; }
.anatomia-theme.theme-classroom.compact .hero-icon-ring { width: 108px; height: 108px; border-radius: 54px; margin-bottom: 22px; }
.anatomia-theme.theme-classroom.compact .hero-icon { width: 54px; height: 54px; }
.anatomia-theme.theme-classroom.compact .card-title { font-size: 34px; }
.anatomia-theme.theme-classroom.compact .card-subtitle { font-size: 23px; margin-bottom: 28px; }
.anatomia-theme.theme-classroom.compact .input-icon { left: 24px; top: 32px; width: 34px; height: 34px; }
.anatomia-theme.theme-classroom.compact .input-field { font-size: 30px; }
.anatomia-theme.theme-classroom.compact .input-field > #unity-text-input { height: 100px; padding-left: 76px; border-radius: 26px; }
.anatomia-theme.theme-classroom.compact .helper-text { font-size: 21px; }
.anatomia-theme.theme-classroom.compact .info-box { padding: 26px; border-radius: 34px; }
.anatomia-theme.theme-classroom.compact .info-title { font-size: 26px; }
.anatomia-theme.theme-classroom.compact .info-text { font-size: 23px; }
.anatomia-theme.theme-classroom.compact .info-check { width: 34px; height: 34px; border-radius: 17px; margin-right: 14px; background-size: 20px 20px; }
.anatomia-theme.theme-classroom.compact .tip-card { padding: 24px; border-radius: 34px; }
.anatomia-theme.theme-classroom.compact .tip-icon-box { width: 62px; height: 62px; border-radius: 31px; margin-right: 18px; }
.anatomia-theme.theme-classroom.compact .tip-icon { width: 32px; height: 32px; }
.anatomia-theme.theme-classroom.compact .tip-title { font-size: 25px; }
.anatomia-theme.theme-classroom.compact .tip-subtitle { font-size: 22px; }
.anatomia-theme.theme-classroom.compact .join-bar { padding: 20px 40px 36px 40px; }
.anatomia-theme.theme-classroom.compact .join-submit-button { height: 96px; }
.anatomia-theme.theme-classroom.compact .join-submit-label { font-size: 30px; }
.anatomia-theme.theme-classroom.compact .status-label { font-size: 22px; }
