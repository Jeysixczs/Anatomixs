/* =========================================================
   Anatomia 3D - Student File Submission
   Reference canvas: 1080 x 1920 (portrait), same scale as
   QuizScreen.uss / StudentClassroomDetail.uss.
   The header gradient is painted at runtime by
   StudentFileSubmissionController (USS has no linear-gradient).
   ========================================================= */

.fs-root {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(234, 240, 241);
}

.hidden {
    display: none;
}

/* ---------------- HEADER ---------------- */

.fs-header {
    padding: 60px 48px 48px 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
}

.fs-header-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.fs-icon-button {
    width: 66px;
    height: 66px;
    border-radius: 33px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-text-align: middle-center;
    padding: 0;
}

.fs-icon-button:hover {
    background-color: rgba(255, 255, 255, 0.28);
}

.fs-pill {
    background-color: rgba(255, 255, 255, 0.22);
    border-radius: 40px;
    padding: 14px 30px;
}

.fs-pill-label {
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
}

.fs-title {
    color: rgb(255, 255, 255);
    font-size: 46px;
    -unity-font-style: bold;
    white-space: normal;
}

.fs-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: 28px;
    margin-top: 8px;
}

/* ---------------- CONTENT ---------------- */

.fs-scroll {
    flex-grow: 1;
}

.fs-content {
    padding: 36px 40px 60px 40px;
}

.fs-card {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 36px;
    margin-bottom: 30px;
}

.fs-card-title {
    color: rgb(31, 41, 55);
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.fs-instructions-text {
    color: rgb(75, 85, 99);
    font-size: 28px;
    white-space: normal;
}

.fs-meta-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(238, 241, 245);
}

.fs-meta-row-last {
    border-bottom-width: 0;
    padding-bottom: 0;
    margin-bottom: 0;
}

.fs-meta-label {
    color: rgb(107, 114, 128);
    font-size: 27px;
}

.fs-meta-value {
    color: rgb(31, 41, 55);
    font-size: 28px;
    -unity-font-style: bold;
}

.fs-accepted-text {
    color: rgb(75, 85, 99);
    font-size: 27px;
    white-space: normal;
}

/* ---------------- FILE PICK / SUBMIT ---------------- */

.fs-choose-button {
    height: 110px;
    border-radius: 26px;
    border-width: 3px;
    border-color: rgb(59, 130, 246);
    background-color: rgba(59, 130, 246, 0.08);
    color: rgb(37, 99, 235);
    font-size: 30px;
    -unity-font-style: bold;
}

.fs-choose-button:hover {
    background-color: rgba(59, 130, 246, 0.16);
}

.fs-choose-button:disabled {
    opacity: 0.45;
}

.fs-selected-panel {
    margin-top: 28px;
}

.fs-selected-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(246, 248, 251);
    border-radius: 24px;
    padding: 24px;
}

.fs-file-icon {
    width: 56px;
    height: 56px;
    margin-right: 22px;
    background-color: rgb(209, 213, 219);
    border-radius: 12px;
}

.fs-selected-text-col {
    flex-grow: 1;
    flex-shrink: 1;
}

.fs-selected-file-name {
    color: rgb(31, 41, 55);
    font-size: 28px;
    -unity-font-style: bold;
    white-space: normal;
}

.fs-selected-file-size {
    color: rgb(107, 114, 128);
    font-size: 24px;
    margin-top: 6px;
}

.fs-clear-button {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 0;
    background-color: rgba(220, 38, 38, 0.1);
    color: rgb(185, 28, 28);
    font-size: 26px;
    padding: 0;
    margin-left: 16px;
}

.fs-submit-button {
    height: 118px;
    border-radius: 28px;
    border-width: 0;
    margin-top: 32px;
    background-color: rgb(37, 99, 235);
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-font-style: bold;
}

.fs-submit-button:hover {
    background-color: rgb(29, 78, 216);
}

.fs-submit-button:disabled {
    background-color: rgb(203, 213, 225);
    color: rgb(255, 255, 255);
    opacity: 1;
}

.fs-error {
    color: rgb(220, 38, 38);
    font-size: 26px;
    margin-top: 22px;
    white-space: normal;
}

/* ---------------- BLOCKED ---------------- */

.fs-blocked-card {
    background-color: rgb(254, 242, 242);
    border-width: 2px;
    border-color: rgb(252, 205, 205);
}

.fs-blocked-text {
    color: rgb(153, 27, 27);
    font-size: 28px;
    white-space: normal;
}

/* ---------------- SUBMITTED HISTORY ---------------- */

.fs-submitted-list {
    flex-direction: column;
}

.fs-submitted-row {
    background-color: rgb(246, 248, 251);
    border-radius: 24px;
    padding: 26px;
    margin-bottom: 18px;
}

.fs-submitted-row-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.fs-submitted-file {
    color: rgb(31, 41, 55);
    font-size: 28px;
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.fs-submitted-meta {
    color: rgb(107, 114, 128);
    font-size: 24px;
    margin-top: 4px;
}

.fs-submitted-feedback {
    color: rgb(55, 65, 81);
    font-size: 25px;
    margin-top: 14px;
    white-space: normal;
}

.fs-status-tag {
    border-radius: 30px;
    padding: 10px 24px;
    font-size: 22px;
    -unity-font-style: bold;
    margin-left: 16px;
}

.fs-status-tag--submitted {
    background-color: rgba(59, 130, 246, 0.14);
    color: rgb(29, 78, 216);
}

.fs-status-tag--reviewed {
    background-color: rgba(16, 185, 129, 0.16);
    color: rgb(4, 120, 87);
}

.fs-download-button {
    height: 84px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(203, 213, 225);
    background-color: rgb(255, 255, 255);
    color: rgb(55, 65, 81);
    font-size: 25px;
    margin-top: 18px;
}

/* ---------------- WORKING OVERLAY ---------------- */

.fs-working-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.55);
    align-items: center;
    justify-content: center;
}

.fs-working-card {
    background-color: rgb(255, 255, 255);
    border-radius: 30px;
    padding: 48px 56px;
}

.fs-working-label {
    color: rgb(31, 41, 55);
    font-size: 30px;
    -unity-font-style: bold;
    white-space: normal;
}

/* ---------------- COMPACT ---------------- */

.compact .fs-content {
    padding: 28px 28px 48px 28px;
}

.compact .fs-title {
    font-size: 40px;
}
