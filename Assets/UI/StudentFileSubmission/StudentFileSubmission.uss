/* =========================================================
   Anatomia 3D - Student File Submission v2 "Drop Zone"
   Reference canvas: 1080 x 1920 (portrait).
   Loaded BEFORE AnatomiaTheme.uss, so every rule is scoped under
   .anatomia-theme.theme-file-submission to out-rank the theme's shared fs-* rules.

   LAYOUT
     header : back button + status pill, small "File Submission" kicker,
              big assignment title - flat on the ambient background
     tiles  : Due / Points / Attempts / Max file size as a 2 x 2 grid
     cards  : Instructions, Accepted files, then the upload card with a big
              soft-accent drop zone, selected-file row and a pill Submit
     blocked: red-tinted card replaces the upload card
     history: one soft row per submission with status tag + Open button
   All element names the controller queries are unchanged.
   ========================================================= */

.anatomia-theme.theme-file-submission
{
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}
.anatomia-theme.theme-file-submission .hidden { display: none; }
.hidden { display: none; }

/* ---------------- HEADER ---------------- */
.anatomia-theme.theme-file-submission .fs-header
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-shrink: 0;
    padding: 84px 48px 20px 48px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}
.anatomia-theme.theme-file-submission .fs-header-top-row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 40px; }
.anatomia-theme.theme-file-submission .fs-icon-button
{
    width: 84px;
    height: 84px;
    border-radius: 42px;
    font-size: 36px;
    padding: 0;
    -unity-text-align: middle-center;
}
.anatomia-theme.theme-file-submission .fs-pill { padding: 0 30px; min-height: 68px; justify-content: center; border-radius: 34px; background-color: var(--accent-soft); }
.anatomia-theme.theme-file-submission .fs-pill-label { margin: 0; font-size: 26px; -unity-font-style: bold; color: var(--accent); }
.anatomia-theme.theme-file-submission .fs-subtitle { margin: 0 0 10px 4px; font-size: 24px; -unity-font-style: bold; letter-spacing: 2.5px; color: var(--accent); -unity-text-align: middle-left; }
.anatomia-theme.theme-file-submission .fs-title { margin: 0; font-size: 58px; -unity-font-style: bold; letter-spacing: -1.5px; color: var(--ink); white-space: normal; }

/* ---------------- CONTENT ---------------- */
.anatomia-theme.theme-file-submission .fs-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.anatomia-theme.theme-file-submission .fs-scroll .unity-scroll-view__content-viewport
{
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
}
.anatomia-theme.theme-file-submission .fs-scroll .unity-scroll-view__content-viewport > .unity-scroll-view__content-container
{
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    width: 100%;
    justify-content: flex-start;
    align-items: stretch;
    margin: 0;
    padding: 0;
}
.anatomia-theme.theme-file-submission .fs-content
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    justify-content: flex-start;
    padding: 20px 48px 80px 48px;
}

/* ---------------- META TILES (2 x 2) ---------------- */
.anatomia-theme.theme-file-submission .fs-meta-grid { flex-direction: column; margin-bottom: 24px; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.anatomia-theme.theme-file-submission .fs-meta-pair { flex-direction: row; margin-bottom: 24px; }
.anatomia-theme.theme-file-submission .fs-meta-pair-last { margin-bottom: 0; }
.anatomia-theme.theme-file-submission .fs-meta-row
{
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 30px 32px;
    margin: 0;
    border-width: 1px;
    border-color: var(--line);
    border-bottom-color: var(--line-strong);
    border-radius: 36px;
    background-color: var(--surface);
}
.anatomia-theme.theme-file-submission .fs-meta-left { margin-right: 12px; }
.anatomia-theme.theme-file-submission .fs-meta-right { margin-left: 12px; }
.anatomia-theme.theme-file-submission .fs-meta-row-last { border-width: 1px; padding: 30px 32px; margin-bottom: 0; }
.anatomia-theme.theme-file-submission .fs-meta-label { margin: 0 0 8px 0; font-size: 23px; -unity-font-style: bold; color: var(--ink-3); }
.anatomia-theme.theme-file-submission .fs-meta-value { margin: 0; font-size: 33px; -unity-font-style: bold; letter-spacing: -0.4px; color: var(--ink); white-space: normal; }

/* ---------------- CARDS ---------------- */
.anatomia-theme.theme-file-submission .fs-card
{
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 0 24px 0;
    padding: 38px;
    border-radius: 44px;
}
.anatomia-theme.theme-file-submission .fs-card-title { margin: 0 0 16px 0; font-size: 31px; -unity-font-style: bold; letter-spacing: -0.3px; color: var(--ink); }
.anatomia-theme.theme-file-submission .fs-instructions-text { margin: 0; font-size: 28px; color: var(--ink-2); white-space: normal; }
.anatomia-theme.theme-file-submission .fs-accepted-text { margin: 0; font-size: 28px; -unity-font-style: bold; color: var(--accent); white-space: normal; }

/* ---------------- FILE PICK / SUBMIT ---------------- */
.anatomia-theme.theme-file-submission .fs-choose-button
{
    height: 190px;
    margin: 0;
    padding: 0;
    border-width: 3px;
    border-radius: 40px;
    border-color: var(--accent);
    background-color: var(--accent-faint);
    color: var(--accent);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.anatomia-theme.theme-file-submission .fs-choose-button:hover { background-color: var(--accent-soft); }
.anatomia-theme.theme-file-submission .fs-choose-button:disabled { opacity: 0.45; }

.anatomia-theme.theme-file-submission .fs-selected-panel { margin: 28px 0 0 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.anatomia-theme.theme-file-submission .fs-selected-caption { margin: 0 0 14px 6px; font-size: 23px; -unity-font-style: bold; letter-spacing: 1px; color: var(--ink-3); }
.anatomia-theme.theme-file-submission .fs-selected-row
{
    flex-direction: row;
    align-items: center;
    padding: 24px 24px 24px 26px;
    border-radius: 32px;
    background-color: var(--sunken);
}
.anatomia-theme.theme-file-submission .fs-file-icon
{
    width: 76px;
    height: 76px;
    margin: 0 24px 0 0;
    flex-shrink: 0;
    border-radius: 24px;
    background-color: var(--accent-soft);
    background-image: url("project://database/Assets/UI/Icons/pdf-icon.png");
    background-size: 44px 44px;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-file-submission .fs-selected-text-col { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-file-submission .fs-selected-file-name { margin: 0; font-size: 28px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-file-submission .fs-selected-file-size { margin: 6px 0 0 0; font-size: 24px; color: var(--ink-3); }
.anatomia-theme.theme-file-submission .fs-clear-button
{
    width: 64px;
    height: 64px;
    margin: 0 0 0 16px;
    padding: 0;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 32px;
    background-color: var(--danger-soft);
    color: var(--danger);
    font-size: 26px;
    -unity-text-align: middle-center;
}
.anatomia-theme.theme-file-submission .fs-clear-button:hover { background-color: var(--danger); color: white; }

.anatomia-theme.theme-file-submission .fs-error { margin: 22px 0 0 6px; font-size: 26px; -unity-font-style: bold; color: var(--danger); white-space: normal; }

.anatomia-theme.theme-file-submission .fs-submit-button
{
    height: 116px;
    margin: 34px 0 0 0;
    padding: 0;
    border-width: 0;
    border-radius: 58px;
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
}
.anatomia-theme.theme-file-submission .fs-submit-button:disabled { background-color: var(--track); color: var(--ink-3); opacity: 1; }

/* ---------------- BLOCKED ---------------- */
.anatomia-theme.theme-file-submission .fs-blocked-card { background-color: var(--danger-soft); border-width: 2px; border-color: var(--danger); }
.anatomia-theme.theme-file-submission .fs-blocked-text { margin: 0; font-size: 28px; -unity-font-style: bold; color: var(--danger); white-space: normal; }

/* ---------------- SUBMITTED HISTORY ---------------- */
.anatomia-theme.theme-file-submission .fs-submitted-list { flex-direction: column; flex-grow: 0; flex-shrink: 0; min-height: 0; align-self: stretch; }
.anatomia-theme.theme-file-submission .fs-submitted-row
{
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 0 18px 0;
    padding: 30px;
    border-radius: 34px;
    background-color: var(--sunken);
}
.anatomia-theme.theme-file-submission .fs-submitted-row-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.anatomia-theme.theme-file-submission .fs-submitted-file { margin: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 29px; -unity-font-style: bold; color: var(--ink); white-space: normal; }
.anatomia-theme.theme-file-submission .fs-submitted-meta { margin: 4px 0 0 0; font-size: 24px; color: var(--ink-3); white-space: normal; }
.anatomia-theme.theme-file-submission .fs-submitted-feedback
{
    margin: 18px 0 0 0;
    padding: 22px 26px;
    border-radius: 26px;
    font-size: 26px;
    color: var(--ink-2);
    background-color: var(--surface-solid);
    white-space: normal;
}
.anatomia-theme.theme-file-submission .fs-status-tag { margin: 0 0 0 16px; padding: 9px 24px; border-radius: 100px; font-size: 22px; -unity-font-style: bold; }
.anatomia-theme.theme-file-submission .fs-download-button
{
    height: 88px;
    margin: 20px 0 0 0;
    padding: 0;
    border-radius: 44px;
    font-size: 27px;
    -unity-text-align: middle-center;
}

/* ---------------- WORKING OVERLAY ---------------- */
.anatomia-theme.theme-file-submission .fs-working-overlay
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 52px;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 18, 28, 0.6);
}
.anatomia-theme.theme-file-submission .fs-working-card { padding: 52px 60px; border-radius: 48px; }
.anatomia-theme.theme-file-submission .fs-working-label { margin: 0; font-size: 31px; -unity-font-style: bold; color: var(--ink); -unity-text-align: middle-center; white-space: normal; }

/* =========================================================
   COMPACT (toggled by the controller below 900 px width)
   ========================================================= */
.anatomia-theme.theme-file-submission.compact .fs-header { padding: 64px 28px 16px 28px; }
.anatomia-theme.theme-file-submission.compact .fs-header-top-row { margin-bottom: 28px; }
.anatomia-theme.theme-file-submission.compact .fs-icon-button { width: 70px; height: 70px; border-radius: 35px; font-size: 30px; }
.anatomia-theme.theme-file-submission.compact .fs-pill { min-height: 58px; padding: 0 24px; }
.anatomia-theme.theme-file-submission.compact .fs-pill-label { font-size: 23px; }
.anatomia-theme.theme-file-submission.compact .fs-subtitle { font-size: 21px; }
.anatomia-theme.theme-file-submission.compact .fs-title { font-size: 46px; }
.anatomia-theme.theme-file-submission.compact .fs-content { padding: 16px 28px 56px 28px; }
.anatomia-theme.theme-file-submission.compact .fs-meta-pair { margin-bottom: 16px; }
.anatomia-theme.theme-file-submission.compact .fs-meta-row,
.anatomia-theme.theme-file-submission.compact .fs-meta-row-last { padding: 22px 22px; border-radius: 30px; }
.anatomia-theme.theme-file-submission.compact .fs-meta-left { margin-right: 8px; }
.anatomia-theme.theme-file-submission.compact .fs-meta-right { margin-left: 8px; }
.anatomia-theme.theme-file-submission.compact .fs-meta-label { font-size: 20px; }
.anatomia-theme.theme-file-submission.compact .fs-meta-value { font-size: 28px; }
.anatomia-theme.theme-file-submission.compact .fs-card { padding: 28px; border-radius: 36px; margin-bottom: 18px; }
.anatomia-theme.theme-file-submission.compact .fs-card-title { font-size: 28px; }
.anatomia-theme.theme-file-submission.compact .fs-instructions-text,
.anatomia-theme.theme-file-submission.compact .fs-accepted-text { font-size: 25px; }
.anatomia-theme.theme-file-submission.compact .fs-choose-button { height: 150px; border-radius: 34px; font-size: 28px; }
.anatomia-theme.theme-file-submission.compact .fs-file-icon { width: 64px; height: 64px; border-radius: 20px; margin-right: 18px; }
.anatomia-theme.theme-file-submission.compact .fs-selected-file-name { font-size: 25px; }
.anatomia-theme.theme-file-submission.compact .fs-submit-button { height: 100px; border-radius: 50px; font-size: 30px; margin-top: 26px; }
.anatomia-theme.theme-file-submission.compact .fs-submitted-row { padding: 24px; border-radius: 28px; }
.anatomia-theme.theme-file-submission.compact .fs-submitted-file { font-size: 26px; }
.anatomia-theme.theme-file-submission.compact .fs-download-button { height: 76px; border-radius: 38px; font-size: 24px; }
