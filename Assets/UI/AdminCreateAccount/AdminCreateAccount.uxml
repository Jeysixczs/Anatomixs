<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminCreateAccount/AdminCreateAccount.uss"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="screen-container" class="screen-container">
            <ui:ScrollView name="scroll-view" class="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement name="content-wrapper" class="content-wrapper">
                    <ui:VisualElement name="logo-circle" class="logo-circle">
                        <ui:VisualElement name="logo-icon" class="logo-icon icon-shield"/>
                    </ui:VisualElement>
                    <ui:Label name="app-title" text="Administrator Access" class="app-title"/>
                    <ui:Label name="app-subtitle" text="Create your admin account" class="app-subtitle"/>

                    <ui:VisualElement name="create-account-card" class="create-account-card">
                        <ui:Label text="First Name" class="field-label"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-user"/>
                            <ui:TextField name="firstname-field" placeholder-text="John" hide-placeholder-on-focus="true" class="input-field"/>
                        </ui:VisualElement>
                        <ui:Label name="firstname-error" class="field-error hidden"/>

                        <ui:Label text="Last Name" class="field-label field-label-spaced"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-user"/>
                            <ui:TextField name="lastname-field" placeholder-text="Doe" hide-placeholder-on-focus="true" class="input-field"/>
                        </ui:VisualElement>
                        <ui:Label name="lastname-error" class="field-error hidden"/>

                        <ui:Label text="Admin Email" class="field-label field-label-spaced"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-email"/>
                            <ui:TextField name="email-field" placeholder-text="admin@anatomylearn.com" hide-placeholder-on-focus="true" class="input-field"/>
                        </ui:VisualElement>
                        <ui:Label name="email-error" class="field-error hidden"/>

                        <ui:Label text="Password" class="field-label field-label-spaced"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-lock"/>
                            <ui:TextField name="password-field" password="true" placeholder-text="Enter password" hide-placeholder-on-focus="true" class="input-field input-field-with-right-icon"/>
                            <ui:Button name="toggle-password-button" class="input-icon-button icon-eye"/>
                        </ui:VisualElement>
                        <ui:Label name="password-error" class="field-error hidden"/>

                        <ui:Label text="Confirm Password" class="field-label field-label-spaced"/>
                        <ui:VisualElement class="input-container">
                            <ui:VisualElement class="input-icon icon-lock"/>
                            <ui:TextField name="confirm-password-field" password="true" placeholder-text="Confirm password" hide-placeholder-on-focus="true" class="input-field input-field-with-right-icon"/>
                            <ui:Button name="toggle-confirm-password-button" class="input-icon-button icon-eye"/>
                        </ui:VisualElement>
                        <ui:Label name="confirm-password-error" class="field-error hidden"/>

                        <ui:VisualElement name="terms-row" class="terms-row">
                            <ui:Button name="terms-checkbox" class="terms-checkbox"/>
                            <ui:VisualElement class="terms-label-container">
                                <ui:Label text="I agree to the " class="terms-text"/>
                                <ui:Button text="Terms of Service" class="terms-link-button"/>
                                <ui:Label text=" and " class="terms-text"/>
                                <ui:Button text="Privacy Policy" class="terms-link-button"/>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:Button name="create-account-button" text="Create Admin Account" class="create-account-button"/>

                        <ui:VisualElement class="divider-row">
                            <ui:VisualElement class="divider-line"/>
                            <ui:Label text="Or continue with" class="divider-text"/>
                            <ui:VisualElement class="divider-line"/>
                        </ui:VisualElement>
                        <ui:Button name="google-signup-button" class="google-button">
                            <ui:VisualElement class="icon-google"/>
                            <ui:Label text="Continue with Google" class="google-button-text"/>
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:VisualElement class="bottom-links">
                        <ui:Label text="Already have an admin account?" class="bottom-link-text"/>
                        <ui:Button name="back-to-admin-login-button" text="Sign In" class="bottom-link-button"/>
                    </ui:VisualElement>

                    <ui:Label name="status-label" text="" class="status-label hidden"/>
                    <ui:Label name="footer-warning-label" text="This is a restricted area. All access attempts are logged and monitored." class="footer-warning-label"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
