<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss?fileID=7433441132597879392&amp;guid=f3df4a0ff9d42424986b13ce625d35c9&amp;type=3#AnatomiaTheme"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaAuth.uss?fileID=7433441132597879392&amp;guid=7b1848b4e2e9bc34fbd3c5e0e140870d&amp;type=3#AnatomiaAuth"/>
    <Style src="project://database/Assets/UI/AdminLogin/AdminLogin.uss?fileID=7433441132597879392&amp;guid=44e0350b50f34f64993663515ae5925d&amp;type=3#AdminLogin"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme auth-root theme-admin-auth screen-root">
        <ui:VisualElement picking-mode="Ignore" class="auth-top-gradient"/>
        <ui:VisualElement name="screen-container" class="screen-container">
            <ui:ScrollView name="scroll-view" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="scroll-view">
                <ui:VisualElement name="content-wrapper" class="content-wrapper">
                    <ui:VisualElement class="auth-hero">
                        <ui:VisualElement class="auth-hero-inner">
                            <ui:VisualElement class="auth-brand auth-brand-small">
                                <ui:VisualElement name="logo-circle" class="logo-circle">
                                    <ui:VisualElement name="logo-icon" picking-mode="Ignore" class="logo-icon icon-shield"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label text="TEACHER ACCOUNT" class="admin-chip"/>
                            <ui:Label name="app-title" text="Create account" class="auth-headline"/>
                            <ui:Label name="app-subtitle" text="Set up your teacher account and start managing classrooms." class="app-subtitle"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="auth-card-wrap">
                        <ui:VisualElement name="create-account-card" class="auth-card">
                            <ui:VisualElement class="field-row">
                                <ui:VisualElement class="field-col">
                                    <ui:Label text="First name" class="field-label"/>
                                    <ui:VisualElement class="input-container">
                                        <ui:TextField name="firstname-field" placeholder-text="Jane" hide-placeholder-on-focus="true" class="input-field input-field-plain"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="field-col field-col-gap">
                                    <ui:Label text="Last name" class="field-label"/>
                                    <ui:VisualElement class="input-container">
                                        <ui:TextField name="lastname-field" placeholder-text="Doe" hide-placeholder-on-focus="true" class="input-field input-field-plain"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label name="firstname-error" class="field-error hidden"/>
                            <ui:Label name="lastname-error" class="field-error hidden"/>
                            <ui:Label text="Admin email" class="field-label field-label-spaced"/>
                            <ui:VisualElement class="input-container">
                                <ui:TextField name="email-field" placeholder-text="Enter your email" hide-placeholder-on-focus="true" class="input-field"/>
                            </ui:VisualElement>
                            <ui:Label name="email-error" class="field-error hidden"/>
                            <ui:Label text="Password" class="field-label field-label-spaced"/>
                            <ui:VisualElement class="input-container">
                                <ui:TextField name="password-field" password="true" placeholder-text="Create a password" hide-placeholder-on-focus="true" class="input-field input-field-with-right-icon"/>
                                <ui:Button name="toggle-password-button" class="input-icon-button icon-eye"/>
                            </ui:VisualElement>
                            <ui:Label text="Use 8+ characters with upper and lower case letters and a number." class="field-hint"/>
                            <ui:Label name="password-error" class="field-error hidden"/>
                            <ui:Label text="Confirm password" class="field-label field-label-spaced"/>
                            <ui:VisualElement class="input-container">
                                <ui:TextField name="confirm-password-field" password="true" placeholder-text="Re-enter your password" hide-placeholder-on-focus="true" class="input-field input-field-with-right-icon"/>
                                <ui:Button name="toggle-confirm-password-button" class="input-icon-button icon-eye"/>
                            </ui:VisualElement>
                            <ui:Label name="confirm-password-error" class="field-error hidden"/>
                            <ui:Button name="create-account-button" text="Create account" class="create-account-button"/>
                            <ui:VisualElement class="divider-row">
                                <ui:VisualElement class="divider-line"/>
                                <ui:Label text="Or" class="divider-text"/>
                                <ui:VisualElement class="divider-line"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="social-row">
                                <ui:Button name="google-signup-button" class="google-button">
                                    <ui:VisualElement picking-mode="Ignore" class="icon-google"/>
                                    <ui:Label text="Continue with Google" picking-mode="Ignore" class="google-button-text"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:Label name="status-label" text="" class="status-label hidden"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="auth-foot">
                        <ui:VisualElement class="auth-foot-row">
                            <ui:Label text="Already have an admin account?" class="auth-foot-text"/>
                            <ui:Button name="back-to-admin-login-button" text="Sign in" class="auth-foot-link"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
