<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AdminEditProfile/AdminEditProfile.uss"/>
    <ui:VisualElement name="screen-root" class="screen-root">

        <!-- ===================== SCROLLABLE CONTENT ===================== -->
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">

            <!-- ===================== HEADER ===================== -->
            <ui:VisualElement name="header" class="header">
                <ui:VisualElement name="header-top-row" class="header-top-row">
                    <ui:Button name="back-button" class="back-button">
                        <ui:VisualElement name="back-icon" class="back-icon"/>
                    </ui:Button>
                    <ui:VisualElement name="header-text" class="header-text">
                        <ui:Label text="Edit Profile" class="header-title"/>
                        <ui:Label text="Update your information" class="header-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="content-wrapper" class="content-wrapper">

                <ui:VisualElement name="profile-info-card" class="form-card">
                    <ui:Label text="Profile Information" class="card-title"/>

                    <ui:Label text="Full Name" class="field-label"/>
                    <ui:TextField name="full-name-field" class="text-field"/>
                    <ui:Label name="full-name-error" text="" class="field-error hidden"/>

                    <ui:Label text="Email Address" class="field-label field-label-spaced"/>
                    <ui:TextField name="email-field" class="text-field"/>
                    <ui:Label name="email-error" text="" class="field-error hidden"/>
                </ui:VisualElement>

                <ui:VisualElement name="password-card" class="form-card">
                    <ui:VisualElement name="password-card-header-row" class="card-header-row">
                        <ui:Label text="Change Password" class="card-title"/>
                        <ui:Button name="toggle-password-visibility-button" text="Show" class="toggle-visibility-button"/>
                    </ui:VisualElement>
                    <ui:Label text="Leave blank to keep your current password" class="card-subtitle"/>

                    <ui:Label text="Current Password" class="field-label field-label-spaced"/>
                    <ui:TextField name="current-password-field" class="text-field" password="true"/>
                    <ui:Label name="current-password-error" text="" class="field-error hidden"/>

                    <ui:Label text="New Password" class="field-label field-label-spaced"/>
                    <ui:TextField name="new-password-field" class="text-field" password="true"/>
                    <ui:Label name="new-password-error" text="" class="field-error hidden"/>

                    <ui:Label text="Confirm New Password" class="field-label field-label-spaced"/>
                    <ui:TextField name="confirm-password-field" class="text-field" password="true"/>
                    <ui:Label name="confirm-password-error" text="" class="field-error hidden"/>
                </ui:VisualElement>

                <ui:Label name="status-label" text="" class="status-label hidden"/>

                <ui:Button name="save-changes-button" class="save-changes-submit-button">
                    <ui:VisualElement name="save-changes-icon" class="save-changes-icon"/>
                    <ui:Label text="Save Changes" class="save-changes-label"/>
                </ui:Button>

            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
