/* =========================================================
   Anatomia 3D - Admin Edit Profile (redesign)
   Reference canvas: 1080 x 1920. Header and Save-button gradients
   are generated at runtime by the controller; colors here are
   fallbacks. Accent: green -> blue (same as Admin Profile / Dashboard gradient).
   Element names/classes used by the controller are unchanged:
   .hidden, .compact, .verify-status-verified/-unverified.
   ========================================================= */

.screen-root {
    width: 100%; height: 100%; flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0; margin: 0;
    overflow: hidden;
    justify-content: flex-start; align-items: stretch;
}

/* ---------- Header ---------- */

.header {
    width: 100%;
    border-bottom-left-radius: 79px;
    border-bottom-right-radius: 79px;
    padding: 100px 50px 140px 50px;   /* extra bottom room: photo card overlaps it */
    flex-shrink: 0;
    background-color: rgb(22, 188, 118);
}

.header-top-row { flex-direction: row; align-items: center; }

.back-button {
    width: 88px; height: 88px; border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 0;
    justify-content: center; align-items: center;
    margin: 0 30px 0 0;
    flex-shrink: 0;
}
.back-button:hover { background-color: rgba(255, 255, 255, 0.3); }
.back-button:active { background-color: rgba(255, 255, 255, 0.4); }

.back-icon {
    width: 40px; height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain; background-position: center; background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }
.header-title { font-size: 52px; -unity-font-style: bold; color: white; white-space: normal; }
.header-subtitle { font-size: 26px; color: rgba(255, 255, 255, 0.88); margin-top: 6px; white-space: normal; }

/* ---------- ScrollView ---------- */

.screen-scroll {
    flex-grow: 1; width: 100%; height: 100%;
    padding: 0; margin: 0;
    justify-content: flex-start; align-items: flex-start;
    -unity-overflow-scrolling: touch;
}
.screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport {
    padding: 0; margin: 0; flex-grow: 1; height: 100%;
}
.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    padding: 0; margin: 0;
    translate: none; transform-origin: center;
    position: relative; top: 0; left: 0;
    justify-content: flex-start; align-items: stretch;
    flex-grow: 0; height: auto; min-height: 100%;
}

/* ---------- Content ---------- */

.content-wrapper {
    width: 100%;
    flex-direction: column;
    padding: 0 50px 70px 50px;
    max-width: 100%;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- Cards ---------- */

.form-card {
    width: 100%;
    background-color: white;
    border-radius: 44px;
    padding: 44px;
    margin-bottom: 34px;
    border-width: 2px;
    border-color: rgb(233, 236, 245);
}

/* Photo card: pulled up over the gradient header */
.photo-card {
    margin-top: -84px;
    padding: 44px 44px 40px 44px;
    align-items: center;
}

.card-header-row { flex-direction: row; justify-content: space-between; align-items: center; }
.card-title-group { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; min-width: 0; }

.card-icon-box {
    width: 74px; height: 74px; border-radius: 24px;
    background-color: rgb(221, 246, 234);
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin-right: 22px;
}
.card-icon {
    width: 40px; height: 40px;
    background-size: contain; background-position: center; background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(22, 188, 118);
}
.icon-profile { background-image: url("project://database/Assets/UI/Icons/profile-icon.png"); }
.icon-email   { background-image: url("project://database/Assets/UI/Icons/email-white.png"); }
.icon-lock    { background-image: url("project://database/Assets/UI/Icons/lock-white.png"); }

.card-title { font-size: 36px; -unity-font-style: bold; color: rgb(31, 36, 48); white-space: normal; flex-shrink: 1; }
.card-subtitle { font-size: 26px; color: rgb(138, 143, 163); margin-top: 18px; white-space: normal; }

.toggle-visibility-button {
    background-color: rgb(221, 246, 234);
    border-width: 0; border-radius: 22px;
    padding: 12px 26px; margin: 0 0 0 12px;
    font-size: 26px; -unity-font-style: bold;
    color: rgb(22, 188, 118);
    flex-shrink: 0;
}
.toggle-visibility-button:hover { background-color: rgb(197, 238, 219); }

/* ---------- Fields ---------- */

.field-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin: 34px 0 12px 4px;
}

.text-field { font-size: 32px; color: rgb(31, 36, 48); margin: 0; }

.text-field > .unity-text-field__input {
    background-color: rgb(244, 246, 251);
    border-width: 2px;
    border-color: rgb(230, 233, 243);
    border-radius: 26px;
    padding: 24px 26px;
}
.text-field .unity-base-text-field__input:focus {
    background-color: white;
    border-color: rgb(22, 188, 118);
}

.field-error { font-size: 25px; -unity-font-style: bold; color: rgb(220, 38, 38); margin: 10px 0 0 6px; white-space: normal; }
.field-hint { font-size: 22px; color: rgb(138, 143, 163); margin: 10px 0 0 6px; white-space: normal; }
.field-hint-pending { color: rgb(180, 83, 9); -unity-font-style: bold; }
.hint-centered { -unity-text-align: middle-center; margin-left: 0; }

/* ---------- Photo ---------- */

.avatar-picker-row,
.avatar-photo-row { flex-direction: column; align-items: center; margin-top: 0; }

.avatar-preview {
    width: 210px; height: 210px; border-radius: 105px;
    background-color: rgb(22, 188, 118);
    border-width: 8px;
    border-color: rgb(37, 99, 235);
    justify-content: center; align-items: center;
    flex-shrink: 0;
    margin: 0 0 30px 0;
    overflow: hidden;
    background-size: cover; background-position: center; background-repeat: no-repeat;
}
.avatar-preview-initials { font-size: 78px; -unity-font-style: bold; color: white; }

.avatar-picker-actions,
.avatar-photo-actions { flex-direction: column; align-items: center; flex-grow: 0; min-width: 0; }

.change-photo-button {
    align-self: center;
    background-color: rgb(221, 246, 234);
    border-width: 0; border-radius: 30px;
    padding: 20px 42px; margin: 0;
    font-size: 28px; -unity-font-style: bold;
    color: rgb(22, 188, 118);
}
.change-photo-button:hover { background-color: rgb(197, 238, 219); }
.change-photo-button:active { background-color: rgb(197, 238, 219); scale: 0.98 0.98; }
.change-photo-button:disabled { color: rgb(163, 167, 183); background-color: rgb(238, 240, 246); }

/* ---------- Verification badge ---------- */

.verify-status-badge {
    font-size: 22px; -unity-font-style: bold;
    padding: 9px 20px; border-radius: 22px;
    flex-shrink: 0; margin-left: 12px;
    -unity-text-align: middle-center;
}
.verify-status-unverified { color: rgb(180, 83, 9); background-color: rgb(254, 243, 199); }
.verify-status-verified   { color: rgb(6, 95, 70);  background-color: rgb(209, 250, 229); }

/* ---------- Secondary action buttons (full width) ---------- */

.action-button {
    margin: 28px 0 0 0;
    align-self: stretch;
    background-color: rgb(221, 246, 234);
    border-width: 0; border-radius: 28px;
    padding: 26px 30px;
    font-size: 30px; -unity-font-style: bold;
    color: rgb(22, 188, 118);
}
.action-button:hover { background-color: rgb(197, 238, 219); }
.action-button:active { background-color: rgb(197, 238, 219); scale: 0.985 0.985; }
.action-button:disabled { color: rgb(163, 167, 183); background-color: rgb(238, 240, 246); }

.warning-box {
    margin-top: 28px;
    padding: 26px 28px;
    border-radius: 26px;
    background-color: rgb(255, 247, 237);
    border-width: 2px;
    border-color: rgb(253, 224, 176);
    border-left-width: 8px;
    border-left-color: rgb(245, 158, 11);
}
.warning-text { font-size: 25px; color: rgb(154, 74, 5); white-space: normal; }

/* ---------- Password overlay ---------- */

.password-overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    justify-content: center; align-items: center;
    padding: 60px;
}
.password-overlay-backdrop {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    background-color: rgba(17, 19, 26, 0.6);
}
.password-card-floating { width: 100%; max-width: 860px; max-height: 100%; margin-bottom: 0; border-width: 0; }

.close-password-card-button {
    align-self: stretch;
    margin: 40px 0 0 0;
    background-color: rgb(22, 188, 118);
    border-width: 0; border-radius: 28px;
    padding: 26px 60px;
    font-size: 30px; -unity-font-style: bold;
    color: white;
}
.close-password-card-button:hover { background-color: rgb(16, 150, 94); }
.close-password-card-button:active { background-color: rgb(16, 150, 94); scale: 0.985 0.985; }

/* ---------- Status + Save ---------- */

.status-label {
    font-size: 28px; color: rgb(138, 143, 163);
    margin: 0 0 22px 0;
    -unity-text-align: middle-center; white-space: normal;
}

.save-changes-submit-button {
    flex-direction: row; justify-content: center; align-items: center;
    border-radius: 38px; border-width: 0;
    padding: 36px 30px; margin: 6px 0 0 0;
    background-color: rgb(22, 188, 118);
    transition-property: scale;
    transition-duration: 0.12s;
}
.save-changes-submit-button:active { scale: 0.985 0.985; }

.save-changes-icon {
    width: 46px; height: 46px;
    margin-right: 20px;
    background-image: url("project://database/Assets/UI/Icons/save-icon.png");
    background-size: contain; background-position: center; background-repeat: no-repeat;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: white;
}
.save-changes-label { font-size: 38px; -unity-font-style: bold; color: white; }

/* ---------- Utility ---------- */

.hidden { display: none; }

/* =========================================================
   Compact layout (toggled by C# on narrow panels)
   ========================================================= */

.compact .header { padding: 92px 40px 124px 40px; }
.compact .header-title { font-size: 46px; }
.compact .header-subtitle { font-size: 24px; }
.compact .back-button { width: 76px; height: 76px; border-radius: 38px; margin-right: 24px; }
.compact .back-icon { width: 34px; height: 34px; }

.compact .content-wrapper { padding-left: 36px; padding-right: 36px; }
.compact .form-card { padding: 34px; border-radius: 38px; margin-bottom: 28px; }
.compact .photo-card { margin-top: -74px; }

.compact .card-icon-box { width: 62px; height: 62px; border-radius: 20px; margin-right: 18px; }
.compact .card-icon { width: 34px; height: 34px; }
.compact .card-title { font-size: 30px; }
.compact .card-subtitle { font-size: 23px; }
.compact .toggle-visibility-button { font-size: 22px; padding: 10px 20px; }

.compact .field-label { font-size: 23px; margin-top: 28px; }
.compact .text-field { font-size: 28px; }
.compact .text-field > .unity-text-field__input { padding: 20px 22px; border-radius: 22px; }
.compact .field-error { font-size: 22px; }
.compact .field-hint { font-size: 20px; }

.compact .avatar-preview { width: 170px; height: 170px; border-radius: 85px; margin-bottom: 24px; }
.compact .avatar-preview-initials { font-size: 62px; }
.compact .change-photo-button { font-size: 24px; padding: 16px 32px; }

.compact .verify-status-badge { font-size: 19px; padding: 7px 16px; }
.compact .action-button { font-size: 26px; padding: 22px 24px; border-radius: 24px; }
.compact .warning-text { font-size: 22px; }

.compact .password-overlay { padding: 30px; }
.compact .close-password-card-button { font-size: 26px; padding: 22px 40px; }

.compact .save-changes-submit-button { padding: 28px 24px; border-radius: 32px; }
.compact .save-changes-icon { width: 38px; height: 38px; margin-right: 16px; }
.compact .save-changes-label { font-size: 32px; }
.compact .status-label { font-size: 24px; }
