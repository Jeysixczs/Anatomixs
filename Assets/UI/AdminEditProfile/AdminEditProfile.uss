/* =========================================================
   Anatomia 3D - Admin Edit Profile (redesign)
   Reference canvas: 1080 x 1920.
   Layout: back chip + title | photo card (avatar left, actions right) |
   Profile Information (names side by side) | Email Verification |
   Security row | fixed bottom bar with status + Save Changes.
   All rules are scoped under .anatomia-theme.theme-admin-edit-profile so they
   out-rank the generic theme rules (AnatomiaTheme.uss loads after this file).
   Controller-toggled classes kept: .hidden, .compact,
   .verify-status-verified / .verify-status-unverified.
   Pill shapes use exact corner radii (half the element height).
   ========================================================= */

/* ---------- Screen ---------- */
.anatomia-theme.theme-admin-edit-profile.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- ScrollView ---------- */
.anatomia-theme.theme-admin-edit-profile .screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}
.anatomia-theme.theme-admin-edit-profile .screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.anatomia-theme.theme-admin-edit-profile .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0; margin: 0; flex-grow: 1; height: 100%;
}
.anatomia-theme.theme-admin-edit-profile .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0; margin: 0;
    translate: none; transform-origin: center;
    position: relative; top: 0; left: 0;
    justify-content: flex-start; align-items: stretch;
    flex-grow: 0; height: auto; min-height: 100%;
}

/* ---------- Header ---------- */
.anatomia-theme.theme-admin-edit-profile .header
{
    width: 100%;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 96px;
    padding-bottom: 8px;
}

.anatomia-theme.theme-admin-edit-profile .header-top-row { flex-direction: row; align-items: center; margin-bottom: 0; }

.anatomia-theme.theme-admin-edit-profile .back-button
{
    margin: 0 28px 0 0;
    padding: 0;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.anatomia-theme.theme-admin-edit-profile .back-icon
{
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--ink);
}

.anatomia-theme.theme-admin-edit-profile .header-text { flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; }
.anatomia-theme.theme-admin-edit-profile .header-title { white-space: normal; word-wrap: break-word; }
.anatomia-theme.theme-admin-edit-profile .header-subtitle { margin-top: 4px; white-space: normal; word-wrap: break-word; }

/* ---------- Content (extra bottom room for the fixed save bar) ---------- */
.anatomia-theme.theme-admin-edit-profile .content-wrapper
{
    flex-direction: column;
    flex-shrink: 0;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 20px;
    padding-bottom: 300px;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Cards ---------- */
.anatomia-theme.theme-admin-edit-profile .form-card
{
    width: 100%;
    padding: 40px;
    margin: 0 0 24px 0;
    border-radius: 40px;
}

.anatomia-theme.theme-admin-edit-profile .card-header-row { flex-direction: row; justify-content: space-between; align-items: center; }
.anatomia-theme.theme-admin-edit-profile .card-title-group { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; min-width: 0; }

.anatomia-theme.theme-admin-edit-profile .card-icon-box
{
    width: 68px;
    height: 68px;
    border-radius: 22px;
    margin-right: 20px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
}

.anatomia-theme.theme-admin-edit-profile .card-icon
{
    width: 36px;
    height: 36px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-admin-edit-profile .icon-profile { background-image: url("project://database/Assets/UI/Icons/profile-icon.png"); }
.anatomia-theme.theme-admin-edit-profile .icon-email   { background-image: url("project://database/Assets/UI/Icons/email-white.png"); }
.anatomia-theme.theme-admin-edit-profile .icon-lock    { background-image: url("project://database/Assets/UI/Icons/lock-white.png"); }

.anatomia-theme.theme-admin-edit-profile .card-title { font-size: 34px; -unity-font-style: bold; letter-spacing: -0.2px; white-space: normal; flex-shrink: 1; }
.anatomia-theme.theme-admin-edit-profile .card-subtitle { font-size: 25px; margin-top: 16px; white-space: normal; }

/* ---------- Photo card: avatar left, actions right ---------- */
.anatomia-theme.theme-admin-edit-profile .photo-card { flex-direction: row; align-items: center; padding: 36px; }

.anatomia-theme.theme-admin-edit-profile .avatar-picker-row
{
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.anatomia-theme.theme-admin-edit-profile .avatar-preview
{
    width: 176px;
    height: 176px;
    border-radius: 88px;
    flex-shrink: 0;
    margin: 0 34px 0 0;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    background-color: var(--accent-soft);
    border-width: 5px;
    border-color: var(--surface-solid);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.anatomia-theme.theme-admin-edit-profile .avatar-preview-initials { font-size: 68px; -unity-font-style: bold; color: var(--accent); }

.anatomia-theme.theme-admin-edit-profile .avatar-picker-actions
{
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.anatomia-theme.theme-admin-edit-profile .photo-title { font-size: 34px; -unity-font-style: bold; color: var(--ink); letter-spacing: -0.2px; }
.anatomia-theme.theme-admin-edit-profile .photo-caption { font-size: 24px; color: var(--ink-3); margin-top: 4px; white-space: normal; }

.anatomia-theme.theme-admin-edit-profile .change-photo-button
{
    align-self: flex-start;
    margin: 20px 0 0 0;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 34px;
    padding-right: 34px;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-width: 0;
    border-top-left-radius: 33px;
    border-top-right-radius: 33px;
    border-bottom-left-radius: 33px;
    border-bottom-right-radius: 33px;
}
.anatomia-theme.theme-admin-edit-profile .change-photo-button:hover { background-color: rgba(91, 76, 219, 0.18); border-width: 0; }
.anatomia-theme.theme-admin-edit-profile .change-photo-button:active { background-color: rgba(91, 76, 219, 0.26); }
.anatomia-theme.theme-admin-edit-profile .change-photo-button:disabled { color: var(--ink-4); background-color: var(--sunken); }

.anatomia-theme.theme-admin-edit-profile .hint-start { margin: 12px 0 0 0; -unity-text-align: middle-left; }

/* ---------- Fields ---------- */
.anatomia-theme.theme-admin-edit-profile .name-row { flex-direction: row; align-items: flex-start; }
.anatomia-theme.theme-admin-edit-profile .name-col { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-admin-edit-profile .name-col-first { margin-right: 10px; }
.anatomia-theme.theme-admin-edit-profile .name-col-last { margin-left: 10px; }

.anatomia-theme.theme-admin-edit-profile .field-label
{
    font-size: 24px;
    margin: 30px 0 10px 4px;
}

.anatomia-theme.theme-admin-edit-profile .text-field
{
    font-size: 31px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.anatomia-theme.theme-admin-edit-profile .text-field > .unity-base-text-field__input
{
    background-color: var(--sunken);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 26px;
    padding: 22px 26px;
    color: var(--ink);
}

.anatomia-theme.theme-admin-edit-profile .text-field > .unity-base-text-field__input:hover { border-color: var(--line-strong); }

.anatomia-theme.theme-admin-edit-profile .text-field > .unity-base-text-field__input:focus
{
    background-color: var(--surface-solid);
    border-color: var(--accent);
    border-width: 2px;
}

.anatomia-theme.theme-admin-edit-profile .field-error { font-size: 23px; -unity-font-style: bold; margin: 10px 0 0 6px; white-space: normal; }
.anatomia-theme.theme-admin-edit-profile .field-hint { font-size: 22px; margin: 10px 0 0 6px; white-space: normal; }
.anatomia-theme.theme-admin-edit-profile .field-hint-pending { color: var(--warn); -unity-font-style: bold; }

/* ---------- Verification ---------- */
.anatomia-theme.theme-admin-edit-profile .verify-status-badge
{
    font-size: 21px;
    -unity-font-style: bold;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 20px;
    padding-right: 20px;
    margin-left: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}
.anatomia-theme.theme-admin-edit-profile .verify-status-unverified { color: var(--warn); background-color: var(--warn-soft); }
.anatomia-theme.theme-admin-edit-profile .verify-status-verified { color: var(--success); background-color: var(--success-soft); }

.anatomia-theme.theme-admin-edit-profile .warning-box
{
    margin-top: 24px;
    padding: 24px 26px;
    border-radius: 26px;
    border-width: 0;
    background-color: var(--warn-soft);
}
.anatomia-theme.theme-admin-edit-profile .warning-text { font-size: 24px; color: var(--warn); white-space: normal; }

/* ---------- Action buttons ---------- */
.anatomia-theme.theme-admin-edit-profile .action-button
{
    align-self: stretch;
    margin: 26px 0 0 0;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 30px;
    padding-right: 30px;
    font-size: 29px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-width: 0;
    border-top-left-radius: 42px;
    border-top-right-radius: 42px;
    border-bottom-left-radius: 42px;
    border-bottom-right-radius: 42px;
}
.anatomia-theme.theme-admin-edit-profile .action-button:hover { background-color: rgba(91, 76, 219, 0.18); }
.anatomia-theme.theme-admin-edit-profile .action-button:active { background-color: rgba(91, 76, 219, 0.26); }
.anatomia-theme.theme-admin-edit-profile .action-button:disabled { color: var(--ink-4); background-color: var(--sunken); }

/* Security: text left, button right */
.anatomia-theme.theme-admin-edit-profile .security-card { flex-direction: row; align-items: center; }
.anatomia-theme.theme-admin-edit-profile .security-text { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: column; }
.anatomia-theme.theme-admin-edit-profile .action-button-inline
{
    align-self: center;
    flex-shrink: 0;
    margin: 0 0 0 20px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 34px;
    padding-right: 34px;
    font-size: 26px;
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
}

/* ---------- Fixed bottom bar: status + Save ---------- */
.anatomia-theme.theme-admin-edit-profile .save-bar
{
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    padding: 24px 52px 44px 52px;
    background-color: var(--surface-solid);
    border-top-width: 1px;
    border-top-color: var(--line);
}

.anatomia-theme.theme-admin-edit-profile .status-label
{
    font-size: 25px;
    color: var(--ink-2);
    margin: 0 0 16px 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.anatomia-theme.theme-admin-edit-profile .save-changes-submit-button
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    padding-right: 30px;
    border-width: 0;
    border-top-left-radius: 54px;
    border-top-right-radius: 54px;
    border-bottom-left-radius: 54px;
    border-bottom-right-radius: 54px;
}

.anatomia-theme.theme-admin-edit-profile .save-changes-icon
{
    width: 42px;
    height: 42px;
    margin-right: 18px;
    background-image: url("project://database/Assets/UI/Icons/save-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: white;
}
.anatomia-theme.theme-admin-edit-profile .save-changes-label { font-size: 34px; -unity-font-style: bold; color: white; }

/* ---------- Password overlay ---------- */
.anatomia-theme.theme-admin-edit-profile .password-overlay
{
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    justify-content: center; align-items: center;
    padding: 60px;
}
.anatomia-theme.theme-admin-edit-profile .password-overlay-backdrop
{
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    background-color: rgba(17, 19, 26, 0.6);
}
.anatomia-theme.theme-admin-edit-profile .password-card-floating { width: 100%; max-width: 860px; max-height: 100%; margin-bottom: 0; border-width: 0; }

.anatomia-theme.theme-admin-edit-profile .toggle-visibility-button
{
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 26px;
    padding-right: 26px;
    font-size: 25px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
    border-width: 0;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
}
.anatomia-theme.theme-admin-edit-profile .toggle-visibility-button:hover { background-color: rgba(91, 76, 219, 0.18); }

.anatomia-theme.theme-admin-edit-profile .close-password-card-button
{
    align-self: stretch;
    margin: 36px 0 0 0;
    padding-top: 26px;
    padding-bottom: 26px;
    padding-left: 60px;
    padding-right: 60px;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    background-color: var(--accent);
    border-width: 0;
    border-top-left-radius: 46px;
    border-top-right-radius: 46px;
    border-bottom-left-radius: 46px;
    border-bottom-right-radius: 46px;
}
.anatomia-theme.theme-admin-edit-profile .close-password-card-button:hover { background-color: var(--accent-strong); }
.anatomia-theme.theme-admin-edit-profile .close-password-card-button:active { background-color: var(--accent-press); }

/* ---------- Utility ---------- */
.anatomia-theme.theme-admin-edit-profile .hidden { display: none; }

/* =========================================================
   Compact layout (toggled by C# on narrow panels)
   ========================================================= */
.anatomia-theme.theme-admin-edit-profile.compact .header { padding-left: 40px; padding-right: 40px; padding-top: 80px; }
.anatomia-theme.theme-admin-edit-profile.compact .back-icon { width: 32px; height: 32px; }
.anatomia-theme.theme-admin-edit-profile.compact .content-wrapper { padding-left: 40px; padding-right: 40px; padding-bottom: 270px; }
.anatomia-theme.theme-admin-edit-profile.compact .form-card { padding: 32px; border-radius: 34px; margin-bottom: 20px; }
.anatomia-theme.theme-admin-edit-profile.compact .photo-card { padding: 28px; }

.anatomia-theme.theme-admin-edit-profile.compact .card-icon-box { width: 58px; height: 58px; border-radius: 18px; margin-right: 16px; }
.anatomia-theme.theme-admin-edit-profile.compact .card-icon { width: 32px; height: 32px; }
.anatomia-theme.theme-admin-edit-profile.compact .card-title { font-size: 30px; }
.anatomia-theme.theme-admin-edit-profile.compact .card-subtitle { font-size: 22px; }

.anatomia-theme.theme-admin-edit-profile.compact .avatar-preview { width: 140px; height: 140px; border-radius: 70px; margin-right: 24px; }
.anatomia-theme.theme-admin-edit-profile.compact .avatar-preview-initials { font-size: 54px; }
.anatomia-theme.theme-admin-edit-profile.compact .photo-title { font-size: 30px; }
.anatomia-theme.theme-admin-edit-profile.compact .photo-caption { font-size: 21px; }
.anatomia-theme.theme-admin-edit-profile.compact .change-photo-button { font-size: 23px; padding-left: 26px; padding-right: 26px; padding-top: 13px; padding-bottom: 13px; }

.anatomia-theme.theme-admin-edit-profile.compact .field-label { font-size: 22px; margin-top: 24px; }
.anatomia-theme.theme-admin-edit-profile.compact .text-field { font-size: 27px; }
.anatomia-theme.theme-admin-edit-profile.compact .text-field > .unity-base-text-field__input { padding: 18px 20px; border-radius: 22px; }
.anatomia-theme.theme-admin-edit-profile.compact .field-error { font-size: 21px; }
.anatomia-theme.theme-admin-edit-profile.compact .field-hint { font-size: 20px; }

.anatomia-theme.theme-admin-edit-profile.compact .verify-status-badge { font-size: 19px; padding-left: 16px; padding-right: 16px; }
.anatomia-theme.theme-admin-edit-profile.compact .warning-text { font-size: 21px; }
.anatomia-theme.theme-admin-edit-profile.compact .action-button { font-size: 26px; padding-top: 20px; padding-bottom: 20px; }
.anatomia-theme.theme-admin-edit-profile.compact .action-button-inline { font-size: 23px; padding-left: 26px; padding-right: 26px; }

.anatomia-theme.theme-admin-edit-profile.compact .save-bar { padding: 20px 40px 36px 40px; }
.anatomia-theme.theme-admin-edit-profile.compact .save-changes-submit-button { padding-top: 26px; padding-bottom: 26px; }
.anatomia-theme.theme-admin-edit-profile.compact .save-changes-icon { width: 36px; height: 36px; margin-right: 14px; }
.anatomia-theme.theme-admin-edit-profile.compact .save-changes-label { font-size: 30px; }
.anatomia-theme.theme-admin-edit-profile.compact .status-label { font-size: 22px; }

.anatomia-theme.theme-admin-edit-profile.compact .password-overlay { padding: 30px; }
.anatomia-theme.theme-admin-edit-profile.compact .close-password-card-button { font-size: 26px; padding-top: 22px; padding-bottom: 22px; }
.anatomia-theme.theme-admin-edit-profile.compact .toggle-visibility-button { font-size: 22px; }
