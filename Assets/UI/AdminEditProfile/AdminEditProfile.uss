/* =========================================================
   Anatomia 3D - Admin Edit Profile (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient, so the header and submit
   button gradients are generated as Texture2D at runtime from
   AdminEditProfileController. The colors below are flat
   fallbacks.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 79px;
    border-bottom-right-radius: 79px;
    padding-left: 66px;
    padding-right: 66px;
    padding-top: 132px;
    padding-bottom: 79px;
    flex-shrink: 0;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
}

.back-button
{
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 39px;
    flex-shrink: 0;
}

.back-button:hover
{
    background-color: rgba(255, 255, 255, 0.28);
}

.back-icon
{
    width: 53px;
    height: 53px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
}

.header-title
{
    font-size: 59px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.header-subtitle
{
    font-size: 34px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 8px;
    white-space: normal;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 34px 50px 60px 50px;
    max-width: 100%;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- Form Cards ---------- */

.form-card
{
    width: 100%;
    background-color: white;
    border-radius: 43px;
    padding: 47px;
    margin-bottom: 39px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.card-title
{
    font-size: 37px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.card-header-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card-subtitle
{
    font-size: 28px;
    color: rgb(138, 143, 163);
    margin-top: 8px;
    white-space: normal;
}

.toggle-visibility-button
{
    background-color: transparent;
    border-width: 0px;
    padding: 0;
    margin: 0;
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(16, 185, 129);
}

.toggle-visibility-button:hover
{
    color: rgb(13, 148, 108);
}

.field-label
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-top: 32px;
    margin-bottom: 14px;
}

.field-label-spaced
{
    margin-top: 37px;
}

.text-field
{
    font-size: 34px;
    color: rgb(31, 36, 48);
    margin: 0;
}

.text-field > .unity-text-field__input
{
    background-color: rgb(240, 241, 245);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    border-radius: 21px;
    padding: 20px 22px;
}

.field-error
{
    font-size: 28px;
    color: rgb(220, 38, 38);
    margin-top: 10px;
}

.field-hint
{
    font-size: 24px;
    color: rgb(138, 143, 163);
    margin-top: 8px;
    white-space: normal;
}

/* ---------- Email verification card ---------- */

.verify-status-badge
{
    font-size: 24px;
    -unity-font-style: bold;
    padding: 8px 18px;
    border-radius: 20px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.verify-status-unverified
{
    color: rgb(180, 83, 9);
    background-color: rgb(254, 243, 199);
}

.verify-status-verified
{
    color: rgb(6, 95, 70);
    background-color: rgb(209, 250, 229);
}

.verify-email-button
{
    margin-top: 28px;
    align-self: flex-start;
    background-color: rgb(240, 241, 245);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
    border-radius: 21px;
    padding: 18px 30px;
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(16, 185, 129);
}

.verify-email-button:hover
{
    background-color: rgb(230, 231, 236);
}

.verify-email-button:disabled
{
    color: rgb(163, 167, 183);
}

.warning-box
{
    margin-top: 28px;
    padding: 24px;
    border-radius: 21px;
    background-color: rgb(255, 247, 237);
    border-width: 1px;
    border-color: rgb(253, 224, 176);
}

.warning-text
{
    font-size: 26px;
    color: rgb(154, 74, 5);
    white-space: normal;
}

/* ---------- Change Password button (opens the floating overlay) ---------- */

.change-password-button
{
    margin-top: 28px;
    align-self: flex-start;
    background-color: rgb(240, 241, 245);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
    border-radius: 21px;
    padding: 18px 30px;
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(16, 185, 129);
}

.change-password-button:hover
{
    background-color: rgb(230, 231, 236);
}

/* ---------- Password overlay (floats the password-card over screen-root) ---------- */

.password-overlay
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    padding: 60px;
}

.password-overlay-backdrop
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 19, 26, 0.55);
}

.password-card-floating
{
    width: 100%;
    max-width: 820px;
    max-height: 100%;
    margin-bottom: 0;
}

.close-password-card-button
{
    align-self: center;
    margin-top: 39px;
    background-color: rgb(16, 185, 129);
    border-width: 0px;
    border-radius: 21px;
    padding: 20px 60px;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
}

.close-password-card-button:hover
{
    background-color: rgb(13, 148, 108);
}

/* ---------- Profile photo card ---------- */

.avatar-photo-row
{
    flex-direction: row;
    align-items: center;
    margin-top: 24px;
}

.avatar-preview
{
    width: 159px;
    height: 159px;
    border-radius: 79px;
    background-color: rgb(240, 241, 245);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.08);
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 37px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.avatar-preview-initials
{
    font-size: 61px;
    -unity-font-style: bold;
    color: rgb(138, 143, 163);
}

.avatar-photo-actions
{
    flex-direction: column;
    flex-grow: 1;
}

.change-photo-button
{
    align-self: flex-start;
    background-color: rgb(240, 241, 245);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
    border-radius: 21px;
    padding: 18px 30px;
    font-size: 29px;
    -unity-font-style: bold;
    color: rgb(16, 185, 129);
}

.change-photo-button:hover
{
    background-color: rgb(230, 231, 236);
}

.change-photo-button:disabled
{
    color: rgb(163, 167, 183);
}

/* ---------- Status label ---------- */

.status-label
{
    font-size: 29px;
    color: rgb(120, 123, 140);
    margin-bottom: 21px;
    -unity-text-align: middle-center;
}

/* ---------- Submit Button (gradient applied at runtime via C#) ---------- */

.save-changes-submit-button
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 32px;
    border-width: 0px;
    padding-top: 34px;
    padding-bottom: 34px;
    margin: 0;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
}

.save-changes-icon
{
    width: 37px;
    height: 37px;
    margin-right: 18px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
}

.save-changes-label
{
    font-size: 37px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- Utility ---------- */

.hidden
{
    display: none;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 45px;
    padding-right: 45px;
    padding-top: 92px;
    padding-bottom: 59px;
}

.compact .header-title
{
    font-size: 47px;
}

.compact .header-subtitle
{
    font-size: 29px;
}

.compact .back-button
{
    width: 104px;
    height: 104px;
    border-radius: 52px;
    margin-right: 26px;
}

.compact .back-icon
{
    width: 43px;
    height: 43px;
}

.compact .content-wrapper
{
    padding-left: 45px;
    padding-right: 45px;
}

.compact .form-card
{
    padding: 34px;
}

.compact .avatar-preview
{
    width: 110px;
    height: 110px;
    border-radius: 55px;
    margin-right: 24px;
}

.compact .avatar-preview-initials
{
    font-size: 42px;
}

.compact .change-photo-button
{
    font-size: 24px;
    padding: 14px 24px;
}

.compact .card-title
{
    font-size: 32px;
}

.compact .card-subtitle,
.compact .toggle-visibility-button
{
    font-size: 24px;
}

.compact .field-label
{
    font-size: 25px;
}

.compact .text-field
{
    font-size: 29px;
}

.compact .field-error
{
    font-size: 24px;
}

.compact .field-hint
{
    font-size: 20px;
}

.compact .save-changes-label
{
    font-size: 32px;
}

.compact .verify-status-badge
{
    font-size: 20px;
}

.compact .verify-email-button
{
    font-size: 24px;
    padding: 14px 24px;
}

.compact .warning-text
{
    font-size: 21px;
}

.compact .save-changes-submit-button
{
    padding-top: 26px;
    padding-bottom: 26px;
}

.compact .change-password-button
{
    font-size: 24px;
    padding: 14px 24px;
}

.compact .password-overlay
{
    padding: 30px;
}

.compact .close-password-card-button
{
    font-size: 25px;
    padding: 16px 45px;
}

/* ---------------- LOADING OVERLAY (saving profile changes) ----------------
   Shown while Save Changes is in flight (profile/password update + optional
   photo upload). Same pattern as StudentQuizScreen's loading overlay: a ring
   spinner rotated continuously from the controller via schedule.Execute,
   since USS keyframe animation isn't supported by UI Toolkit, plus a delayed
   "still working" hint for slow connections. */

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(15, 18, 28, 0.72);
    justify-content: center;
    align-items: center;
    padding: 60px;
}

.loading-card {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 54px 48px;
    align-items: center;
    max-width: 620px;
}

.loading-spinner {
    width: 64px;
    height: 64px;
    border-width: 6px;
    border-radius: 32px;
    border-top-color: rgb(22, 188, 118);
    border-left-color: rgb(22, 188, 118);
    border-right-color: rgb(22, 188, 118);
    border-bottom-color: rgba(22, 188, 118, 0.15);
    margin-bottom: 28px;
}

.loading-message {
    font-size: 30px;
    color: rgb(31, 36, 48);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
}

.loading-submessage {
    font-size: 22px;
    color: rgb(107, 114, 128);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 12px;
}

.loading-submessage.hidden {
    display: none;
}

.compact .loading-overlay {
    padding: 30px;
}
