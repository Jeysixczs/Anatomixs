<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StudentQuizResult/StudentQuizResult.uss?fileID=7433441132597879392&amp;guid=bd735ff159359cd4ab349c8a69a6aa02&amp;type=3#StudentQuizResult"/>
    <Style src="project://database/Assets/UI/Theme/AnatomiaTheme.uss?fileID=7433441132597879392&amp;guid=f3df4a0ff9d42424986b13ce625d35c9&amp;type=3#AnatomiaTheme"/>
    <ui:VisualElement name="screen-root" class="anatomia-theme theme-quiz-result screen-root">
        <ui:ScrollView name="screen-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="screen-scroll">
            <ui:VisualElement name="content-wrapper" class="content-wrapper" style="height: 1815px; width: 856px;">
                <ui:VisualElement name="header" class="header">
                    <ui:VisualElement name="trophy-icon-box" class="trophy-icon-box">
                        <ui:VisualElement name="trophy-icon" picking-mode="Ignore" class="trophy-icon"/>
                    </ui:VisualElement>
                    <ui:Label name="result-title-label" text="Keep Practicing!" class="result-title"/>
                    <ui:Label name="quiz-name-label" text="Skeletal System Basics" class="quiz-name"/>
                </ui:VisualElement>
                <ui:VisualElement name="score-card" class="score-card">
                    <ui:VisualElement name="score-ring" class="score-ring">
                        <ui:Label name="score-percent-label" text="50%" class="score-percent"/>
                        <ui:Label text="YOUR SCORE" class="score-caption"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="score-stats-row">
                        <ui:VisualElement class="score-stat-item stat-correct">
                            <ui:Label name="correct-count-label" text="1" class="score-stat-value"/>
                            <ui:Label text="Correct" class="score-stat-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="score-stat-item stat-incorrect">
                            <ui:Label name="incorrect-count-label" text="1" class="score-stat-value"/>
                            <ui:Label text="Incorrect" class="score-stat-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="score-stat-item score-stat-item-last">
                            <ui:Label name="total-count-label" text="2" class="score-stat-value"/>
                            <ui:Label text="Total" class="score-stat-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="score-divider"/>
                    <ui:VisualElement class="points-earned-row">
                        <ui:Label text="Points earned" class="points-earned-label"/>
                        <ui:Label name="points-earned-value-label" text="10 / 20" class="points-earned-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="points-progress-track">
                        <ui:VisualElement name="points-progress-fill" class="points-progress-fill" style="width: 50%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="mini-stats-row" class="mini-stats-row">
                    <ui:VisualElement name="points-mini-card" class="mini-card mini-card-left">
                        <ui:VisualElement class="mini-icon-box mini-icon-blue">
                            <ui:VisualElement picking-mode="Ignore" class="mini-icon icon-trend-up"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="mini-text">
                            <ui:Label name="points-mini-value-label" text="+10" class="mini-value"/>
                            <ui:Label text="Points" class="mini-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="time-mini-card" class="mini-card mini-card-right">
                        <ui:VisualElement class="mini-icon-box mini-icon-gold">
                            <ui:VisualElement picking-mode="Ignore" class="mini-icon icon-clock"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="mini-text">
                            <ui:Label name="time-mini-value-label" text="0:00" class="mini-value"/>
                            <ui:Label text="Time" class="mini-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="actions" class="result-actions">
                    <ui:Button name="back-to-dashboard-button" class="back-to-dashboard-button">
                        <ui:VisualElement picking-mode="Ignore" class="back-to-dashboard-icon icon-home"/>
                        <ui:Label text="Back to Dashboard" picking-mode="Ignore" class="back-to-dashboard-label"/>
                    </ui:Button>
                    <ui:VisualElement name="secondary-actions-row" class="secondary-actions-row">
                        <ui:Button name="back-to-classroom-button" class="secondary-action-button">
                            <ui:VisualElement picking-mode="Ignore" class="secondary-action-icon icon-classroom"/>
                            <ui:Label text="Back to Classroom Hub" picking-mode="Ignore" class="secondary-action-label"/>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
