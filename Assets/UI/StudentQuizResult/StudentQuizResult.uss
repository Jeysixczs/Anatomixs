/* =========================================================
   Anatomia 3D - Quiz Result (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 90px;
    padding-bottom: 70px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
}

.trophy-icon-box
{
    width: 150px;
    height: 150px;
    border-radius: 75px;
    background-color: rgba(255, 255, 255, 0.22);
    justify-content: center;
    align-items: center;
    margin-bottom: 30px;
}

.trophy-icon
{
    width: 70px;
    height: 70px;
    background-image: url("project://database/Assets/UI/Icons/trophy-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.result-title
{
    font-size: 46px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
}

.quiz-name
{
    font-size: 28px;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 40px;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-shrink: 0;
    box-sizing: border-box;
}

/* ---------- Score Card ---------- */

.score-card
{
    background-color: white;
    border-radius: 32px;
    padding: 46px;
    width: 100%;
    box-sizing: border-box;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    margin-top: -60px;
    margin-bottom: 30px;
    align-items: center;
}

.score-percent
{
    font-size: 88px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
    -unity-text-align: middle-center;
}

.score-caption
{
    font-size: 28px;
    color: rgb(138, 143, 163);
    margin-top: 6px;
    margin-bottom: 40px;
}

.score-stats-row
{
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 34px;
}

.score-stat-item
{
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    margin-right: 10px;
}

.score-stat-item-last
{
    margin-right: 0;
}

.score-stat-value
{
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.score-stat-label
{
    font-size: 22px;
    color: rgb(150, 155, 168);
    margin-top: 6px;
}

.score-divider
{
    height: 1px;
    width: 100%;
    background-color: rgb(235, 236, 241);
    margin-bottom: 30px;
}

.points-earned-row
{
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
}

.points-earned-label
{
    font-size: 26px;
    color: rgb(90, 96, 112);
}

.points-earned-value
{
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
}

.points-progress-track
{
    width: 100%;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(228, 229, 235);
    overflow: hidden;
    position: relative;
}

.points-progress-fill
{
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    border-radius: 8px;
    background-color: rgb(31, 36, 48);
}

/* ---------- Mini Stat Cards ---------- */

.mini-stats-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 30px;
}

.mini-card
{
    background-color: white;
    border-radius: 26px;
    padding: 30px;
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.mini-card-left
{
    margin-right: 16px;
}

.mini-card-right
{
    margin-left: 16px;
}

.mini-icon-box
{
    width: 76px;
    height: 76px;
    border-radius: 38px;
    justify-content: center;
    align-items: center;
    margin-bottom: 18px;
}

.mini-icon-blue
{
    background-color: rgb(219, 234, 254);
}

.mini-icon-gold
{
    background-color: rgb(254, 243, 199);
}

.mini-icon
{
    width: 36px;
    height: 36px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.icon-trend-up
{
    background-image: url("project://database/Assets/UI/Icons/trend-up-icon.png");
    -unity-background-image-tint-color: rgb(37, 99, 235);
}

.icon-target
{
    background-image: url("project://database/Assets/UI/Icons/target-icon.png");
    -unity-background-image-tint-color: rgb(217, 119, 6);
}

.icon-clock
{
    background-image: url("project://database/Assets/UI/Icons/time-icon.png");
    -unity-background-image-tint-color: rgb(217, 119, 6);
}

.mini-value
{
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.mini-label
{
    font-size: 22px;
    color: rgb(150, 155, 168);
    margin-top: 4px;
}

/* ---------- Back to Dashboard (gradient applied at runtime via C#) ---------- */

.back-to-dashboard-button
{
    width: 100%;
    height: 118px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: rgb(37, 99, 235);
    color: white;
    border-radius: 28px;
    border-width: 0;
    margin-bottom: 24px;
}

.back-to-dashboard-button:hover
{
    opacity: 0.92;
}

.back-to-dashboard-icon
{
    width: 34px;
    height: 34px;
    margin-right: 16px;
    background-image: url("project://database/Assets/UI/Icons/home-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.back-to-dashboard-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- Secondary Actions (Retry / Share) ---------- */

.secondary-actions-row
{
    flex-direction: row;
    margin-bottom: 40px;
}

.secondary-action-button
{
    flex-grow: 1;
    flex-basis: 0;
    height: 104px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: white;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(231, 232, 237);
}

.secondary-action-button:hover
{
    background-color: rgb(244, 245, 247);
}

.secondary-action-button-left
{
    margin-right: 14px;
}

.secondary-action-button-right
{
    margin-left: 14px;
}

.secondary-action-icon
{
    width: 30px;
    height: 30px;
    margin-right: 14px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(31, 36, 48);
}

.icon-retry
{
    background-image: url("project://database/Assets/UI/Icons/retry-icon.png");
}

.icon-share
{
    background-image: url("project://database/Assets/UI/Icons/share-icon.png");
}

.secondary-action-label
{
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 60px;
    padding-bottom: 50px;
}

.compact .trophy-icon-box
{
    width: 110px;
    height: 110px;
    border-radius: 55px;
    margin-bottom: 22px;
}

.compact .trophy-icon
{
    width: 52px;
    height: 52px;
}

.compact .result-title
{
    font-size: 36px;
}

.compact .quiz-name
{
    font-size: 24px;
}

.compact .content-wrapper
{
    padding: 26px;
}

.compact .score-card
{
    padding: 30px;
    border-radius: 26px;
    margin-top: -40px;
}

.compact .score-percent
{
    font-size: 64px;
}

.compact .score-caption
{
    font-size: 22px;
    margin-bottom: 28px;
}

.compact .score-stat-value
{
    font-size: 28px;
}

.compact .score-stat-label
{
    font-size: 19px;
}

.compact .points-earned-label,
.compact .points-earned-value
{
    font-size: 22px;
}

.compact .mini-card
{
    padding: 22px;
    border-radius: 20px;
}

.compact .mini-icon-box
{
    width: 60px;
    height: 60px;
    border-radius: 30px;
    margin-bottom: 14px;
}

.compact .mini-icon
{
    width: 28px;
    height: 28px;
}

.compact .mini-value
{
    font-size: 28px;
}

.compact .mini-label
{
    font-size: 19px;
}

.compact .back-to-dashboard-button
{
    height: 96px;
}

.compact .back-to-dashboard-label
{
    font-size: 26px;
}

.compact .secondary-action-button
{
    height: 88px;
}

.compact .secondary-action-label
{
    font-size: 24px;
}
