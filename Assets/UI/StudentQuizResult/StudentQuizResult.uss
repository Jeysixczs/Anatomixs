/* =========================================================
   Anatomia 3D - Quiz Result v2 "Scorecard"
   Reference canvas: 1080 x 1920 (portrait phone).
   Loaded BEFORE AnatomiaTheme.uss, so every rule is scoped under
   .anatomia-theme.theme-quiz-result to out-rank the theme's shared rules.

   LAYOUT
     header : trophy badge, headline, quiz name (centred, on the ambient bg)
     card   : big score ring -> Correct / Incorrect / Total tiles -> points bar
     mini   : Points + Time as two horizontal cards
     actions: full-width pill primary + outlined secondary

   Score tier colours: the controller adds tier-low / tier-mid / tier-high
   to screen-root. Without that, everything falls back to the accent colour.
   ========================================================= */

.anatomia-theme.theme-quiz-result
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;

    --tier: var(--accent);
    --tier-soft: var(--accent-soft);
}
.anatomia-theme.theme-quiz-result.tier-low  { --tier: var(--danger);  --tier-soft: var(--danger-soft); }
.anatomia-theme.theme-quiz-result.tier-mid  { --tier: var(--warn);    --tier-soft: var(--warn-soft); }
.anatomia-theme.theme-quiz-result.tier-high { --tier: var(--success); --tier-soft: var(--success-soft); }

/* ---------- ScrollView ---------- */
.anatomia-theme.theme-quiz-result .screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    -unity-overflow-scrolling: touch;
}
.anatomia-theme.theme-quiz-result .screen-scroll .unity-scroller--vertical { width: 0; display: none; }
.anatomia-theme.theme-quiz-result .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}
.anatomia-theme.theme-quiz-result .screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

.anatomia-theme.theme-quiz-result .content-wrapper
{
    width: 100%;
    max-width: 860px;
    align-self: center;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0 48px 72px 48px;
    margin: 0;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header ---------- */
.anatomia-theme.theme-quiz-result .header
{
    width: 100%;
    max-width: none;
    padding: 110px 0 52px 0;
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-radius: 0;
}

.anatomia-theme.theme-quiz-result .trophy-icon-box
{
    width: 132px;
    height: 132px;
    margin-bottom: 36px;
    border-radius: 66px;
    justify-content: center;
    align-items: center;
    background-color: var(--tier-soft);
}
.anatomia-theme.theme-quiz-result .trophy-icon
{
    width: 64px;
    height: 64px;
    background-image: url("project://database/Assets/UI/Icons/trophy-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--tier);
}

.anatomia-theme.theme-quiz-result .result-title
{
    margin: 0;
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
}
.anatomia-theme.theme-quiz-result .quiz-name
{
    margin: 14px 0 0 0;
    font-size: 28px;
    color: var(--ink-3);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Score card ---------- */
.anatomia-theme.theme-quiz-result .score-card
{
    width: 100%;
    margin: 0 0 24px 0;
    padding: 56px 40px 44px 40px;
    align-items: stretch;
    border-radius: 48px;
}

.anatomia-theme.theme-quiz-result .score-ring
{
    width: 340px;
    height: 340px;
    align-self: center;
    justify-content: center;
    align-items: center;
    margin-bottom: 52px;
    border-width: 18px;
    border-color: var(--tier);
    border-radius: 170px;
    background-color: var(--tier-soft);
}
.anatomia-theme.theme-quiz-result .score-percent
{
    margin: 0;
    font-size: 92px;
    -unity-font-style: bold;
    letter-spacing: -3px;
    color: var(--tier);
    -unity-text-align: middle-center;
}
.anatomia-theme.theme-quiz-result .score-caption
{
    margin: 2px 0 0 0;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: var(--ink-3);
}

/* Correct / Incorrect / Total tiles */
.anatomia-theme.theme-quiz-result .score-stats-row
{
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 40px;
}
.anatomia-theme.theme-quiz-result .score-stat-item
{
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 14px 0 0;
    padding: 26px 8px 24px 8px;
    border-radius: 28px;
    background-color: var(--sunken);
}
.anatomia-theme.theme-quiz-result .score-stat-item-last { margin-right: 0; }
.anatomia-theme.theme-quiz-result .score-stat-value { margin: 0; font-size: 46px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-quiz-result .score-stat-label { margin: 6px 0 0 0; font-size: 22px; color: var(--ink-3); }
.anatomia-theme.theme-quiz-result .stat-correct   .score-stat-value { color: var(--success); }
.anatomia-theme.theme-quiz-result .stat-incorrect .score-stat-value { color: var(--danger); }

.anatomia-theme.theme-quiz-result .score-divider { height: 1px; width: 100%; margin-bottom: 36px; background-color: var(--line-strong); }

/* Points bar */
.anatomia-theme.theme-quiz-result .points-earned-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 18px;
}
.anatomia-theme.theme-quiz-result .points-earned-label { margin: 0; font-size: 26px; color: var(--ink-2); }
.anatomia-theme.theme-quiz-result .points-earned-value { margin: 0; font-size: 28px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-quiz-result .points-progress-track
{
    width: 100%;
    height: 20px;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    background-color: var(--track);
}
.anatomia-theme.theme-quiz-result .points-progress-fill
{
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    border-radius: 10px;
    background-color: var(--tier);
}

/* ---------- Mini cards (horizontal) ---------- */
.anatomia-theme.theme-quiz-result .mini-stats-row { flex-direction: row; margin: 0 0 40px 0; }
.anatomia-theme.theme-quiz-result .mini-card
{
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    padding: 26px 28px;
    border-radius: 36px;
}
.anatomia-theme.theme-quiz-result .mini-card-left  { margin-right: 12px; }
.anatomia-theme.theme-quiz-result .mini-card-right { margin-left: 12px; }

.anatomia-theme.theme-quiz-result .mini-icon-box
{
    width: 80px;
    height: 80px;
    margin: 0 22px 0 0;
    flex-shrink: 0;
    border-radius: 40px;
    justify-content: center;
    align-items: center;
}
.anatomia-theme.theme-quiz-result .mini-icon-blue { background-color: var(--accent-soft); }
.anatomia-theme.theme-quiz-result .mini-icon-gold { background-color: var(--warn-soft); }
.anatomia-theme.theme-quiz-result .mini-icon
{
    width: 38px;
    height: 38px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.anatomia-theme.theme-quiz-result .icon-trend-up
{
    background-image: url("project://database/Assets/UI/Icons/beat-icon.png");
    -unity-background-image-tint-color: var(--accent);
}
.anatomia-theme.theme-quiz-result .icon-clock
{
    background-image: url("project://database/Assets/UI/Icons/time-icon.png");
    -unity-background-image-tint-color: var(--warn);
}
.anatomia-theme.theme-quiz-result .mini-text { flex-direction: column; flex-shrink: 1; min-width: 0; }
.anatomia-theme.theme-quiz-result .mini-value { margin: 0; font-size: 38px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-quiz-result .mini-label { margin: 2px 0 0 0; font-size: 22px; color: var(--ink-3); }

/* ---------- Actions ---------- */
.anatomia-theme.theme-quiz-result .result-actions { width: 100%; flex-direction: column; }

.anatomia-theme.theme-quiz-result .back-to-dashboard-button
{
    width: 100%;
    height: 116px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 58px;
}
.anatomia-theme.theme-quiz-result .back-to-dashboard-icon
{
    width: 40px;
    height: 40px;
    margin: 0 16px 0 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}
.anatomia-theme.theme-quiz-result .icon-home { background-image: url("project://database/Assets/UI/Icons/home-icon.png"); }
.anatomia-theme.theme-quiz-result .back-to-dashboard-label { margin: 0; font-size: 33px; -unity-font-style: bold; color: white; }

.anatomia-theme.theme-quiz-result .secondary-actions-row { flex-direction: column; margin: 20px 0 0 0; }
.anatomia-theme.theme-quiz-result .secondary-action-button
{
    width: 100%;
    height: 108px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 54px;
}
.anatomia-theme.theme-quiz-result .secondary-action-icon
{
    width: 38px;
    height: 38px;
    margin: 0 14px 0 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.anatomia-theme.theme-quiz-result .icon-classroom { background-image: url("project://database/Assets/UI/Icons/classroom-icon.png"); }
.anatomia-theme.theme-quiz-result .secondary-action-label { margin: 0; font-size: 30px; -unity-font-style: bold; color: var(--ink); }
.anatomia-theme.theme-quiz-result .secondary-action-button:hover .secondary-action-label { color: var(--accent); }

/* =========================================================
   Compact (toggled by the controller below 900 px width)
   ========================================================= */
.anatomia-theme.theme-quiz-result.compact .content-wrapper { padding: 0 32px 56px 32px; }
.anatomia-theme.theme-quiz-result.compact .header { padding: 84px 0 40px 0; }
.anatomia-theme.theme-quiz-result.compact .trophy-icon-box { width: 108px; height: 108px; border-radius: 54px; margin-bottom: 28px; }
.anatomia-theme.theme-quiz-result.compact .trophy-icon { width: 52px; height: 52px; }
.anatomia-theme.theme-quiz-result.compact .result-title { font-size: 52px; }
.anatomia-theme.theme-quiz-result.compact .quiz-name { font-size: 25px; }
.anatomia-theme.theme-quiz-result.compact .score-card { padding: 40px 26px 34px 26px; border-radius: 40px; }
.anatomia-theme.theme-quiz-result.compact .score-ring { width: 280px; height: 280px; border-radius: 140px; border-width: 15px; margin-bottom: 40px; }
.anatomia-theme.theme-quiz-result.compact .score-percent { font-size: 74px; }
.anatomia-theme.theme-quiz-result.compact .score-caption { font-size: 19px; }
.anatomia-theme.theme-quiz-result.compact .score-stats-row { margin-bottom: 30px; }
.anatomia-theme.theme-quiz-result.compact .score-stat-item { margin-right: 10px; padding: 20px 6px 18px 6px; border-radius: 24px; }
.anatomia-theme.theme-quiz-result.compact .score-stat-value { font-size: 38px; }
.anatomia-theme.theme-quiz-result.compact .score-stat-label { font-size: 20px; }
.anatomia-theme.theme-quiz-result.compact .score-divider { margin-bottom: 28px; }
.anatomia-theme.theme-quiz-result.compact .points-earned-label { font-size: 23px; }
.anatomia-theme.theme-quiz-result.compact .points-earned-value { font-size: 25px; }
.anatomia-theme.theme-quiz-result.compact .mini-stats-row { margin-bottom: 30px; }
.anatomia-theme.theme-quiz-result.compact .mini-card { padding: 20px 20px; border-radius: 30px; }
.anatomia-theme.theme-quiz-result.compact .mini-card-left  { margin-right: 8px; }
.anatomia-theme.theme-quiz-result.compact .mini-card-right { margin-left: 8px; }
.anatomia-theme.theme-quiz-result.compact .mini-icon-box { width: 64px; height: 64px; border-radius: 32px; margin-right: 16px; }
.anatomia-theme.theme-quiz-result.compact .mini-icon { width: 30px; height: 30px; }
.anatomia-theme.theme-quiz-result.compact .mini-value { font-size: 32px; }
.anatomia-theme.theme-quiz-result.compact .mini-label { font-size: 20px; }
.anatomia-theme.theme-quiz-result.compact .back-to-dashboard-button { height: 100px; border-radius: 50px; }
.anatomia-theme.theme-quiz-result.compact .back-to-dashboard-label { font-size: 29px; }
.anatomia-theme.theme-quiz-result.compact .secondary-action-button { height: 94px; border-radius: 47px; }
.anatomia-theme.theme-quiz-result.compact .secondary-action-label { font-size: 26px; }
