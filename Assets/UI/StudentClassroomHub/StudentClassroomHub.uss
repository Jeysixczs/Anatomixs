/* =========================================================
   Anatomia 3D - Student Classroom Hub (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   Mirrors AdminDashboard's visual language (glass stat cards in
   the header, header CTA button, classroom-card list) so the
   student-side "My Classrooms" screen matches the teacher-side
   dashboard.

   NOTE: USS has no linear-gradient, so the header gradient is
   generated as a Texture2D at runtime from
   StudentClassroomHubController (see BuildGradientTexture). The
   color below is a flat fallback.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 100px;
    padding-bottom: 50px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(16, 185, 129); /* fallback, overridden by gradient texture */
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 40px;
}

.header-icon-circle
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-right: 30px;
}

.back-button-circle:hover
{
    background-color: rgba(255, 255, 255, 0.3);
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.header-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.header-subtitle
{
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
}

/* ---------- Header Glass Stat Cards ---------- */

.header-stats-row
{
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 32px;
}

.glass-stat-card
{
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(255, 255, 255, 0.16);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 28px;
    padding-top: 26px;
    padding-bottom: 24px;
    align-items: center;
}

.glass-stat-card-left
{
    margin-right: 12px;
}

.glass-stat-card-mid
{
    margin-right: 12px;
}

.glass-stat-value
{
    font-size: 42px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

.glass-stat-label
{
    font-size: 22px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Join a Classroom (header button) ---------- */

.create-classroom-header-button
{
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.16);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 26px;
    padding-top: 26px;
    padding-bottom: 26px;
    margin: 0;
}

.create-classroom-header-button:hover
{
    background-color: rgba(255, 255, 255, 0.24);
}

.create-classroom-plus
{
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    margin-right: 14px;
}

.create-classroom-header-label
{
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding-left: 52px;
    padding-right: 52px;
    padding-top: 42px;
    padding-bottom: 72px;
    max-width: 100%;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- Section titles ---------- */

.section-title
{
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 24px;
}

/* ---------- My Classrooms: search + filter button + filter modal ---------- */

.hub-search-row
{
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 26px;
}

.hub-search-wrapper
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-radius: 30px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    padding-left: 26px;
    padding-right: 20px;
}

.hub-search-icon
{
    width: 32px;
    height: 32px;
    margin-right: 16px;
    opacity: 0.4;
    background-image: url("project://database/Assets/UI/Icons/search-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}

.hub-search-field
{
    flex-grow: 1;
    font-size: 28px;
    -unity-text-align: middle-left;
    margin: 0;
}

.hub-search-field > TextInput
{
    background-color: transparent;
    border-width: 0;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 0;
    font-size: 28px;
    color: rgb(31, 36, 48);
}

.hub-filter-button
{
    flex-shrink: 0;
    margin: 0;
    margin-left: 16px;
    padding: 0 34px;
    border-radius: 30px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    background-color: white;
    color: rgb(31, 36, 48);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hub-filter-button:hover
{
    background-color: rgb(244, 246, 251);
}

.hub-filter-button-active
{
    background-color: rgb(37, 99, 235);
    border-color: rgb(37, 99, 235);
    color: white;
}

.hub-filter-button-active:hover
{
    background-color: rgb(29, 78, 216);
}

.hub-filter-empty
{
    background-color: white;
    border-radius: 34px;
    padding: 52px 36px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

/* ----- Modal (bottom sheet) ----- */

.hub-filter-overlay
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(17, 20, 28, 0.55);
    justify-content: flex-end;
    align-items: stretch;
}

.hub-filter-sheet
{
    background-color: white;
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    padding: 44px 50px 60px 50px;
}

.hub-filter-sheet-header
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.hub-filter-sheet-title
{
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.hub-filter-close-button
{
    margin: 0;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 0;
    background-color: rgb(240, 242, 247);
    color: rgb(90, 96, 112);
    font-size: 28px;
    -unity-text-align: middle-center;
    padding: 0;
}

.hub-filter-section-label
{
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(138, 143, 163);
    margin-top: 22px;
    margin-bottom: 14px;
}

.hub-filter-option
{
    flex-direction: row;
    align-items: center;
    padding: 24px 26px;
    margin-bottom: 14px;
    border-radius: 28px;
    border-width: 2px;
    border-color: rgb(232, 236, 244);
    background-color: rgb(248, 249, 252);
}

.hub-filter-option-selected
{
    border-color: rgb(37, 99, 235);
    background-color: rgba(37, 99, 235, 0.07);
}

.hub-filter-radio
{
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgb(190, 197, 212);
    background-color: white;
    margin-right: 22px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.hub-filter-radio-dot
{
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(37, 99, 235);
    display: none;
}

.hub-filter-option-selected .hub-filter-radio
{
    border-color: rgb(37, 99, 235);
}

.hub-filter-option-selected .hub-filter-radio-dot
{
    display: flex;
}

.hub-filter-option-label
{
    flex-grow: 1;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
}

.hub-filter-option-count
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(90, 96, 112);
    background-color: rgb(236, 239, 246);
    border-radius: 24px;
    padding: 4px 18px;
}

.hub-filter-footer
{
    flex-direction: row;
    margin-top: 24px;
}

.hub-filter-reset-button
{
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    margin-right: 16px;
    padding: 26px 0;
    border-radius: 30px;
    border-width: 2px;
    border-color: rgb(226, 231, 240);
    background-color: white;
    color: rgb(90, 96, 112);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hub-filter-apply-button
{
    flex-grow: 2;
    flex-basis: 0;
    margin: 0;
    padding: 26px 0;
    border-radius: 30px;
    border-width: 0;
    background-color: rgb(37, 99, 235);
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hub-filter-apply-button:hover
{
    background-color: rgb(29, 78, 216);
}

.compact .hub-search-field,
.compact .hub-search-field > TextInput
{
    font-size: 24px;
}

.compact .hub-filter-button
{
    font-size: 24px;
    padding: 0 26px;
}

.compact .hub-filter-sheet
{
    padding: 36px 36px 50px 36px;
}

/* ---------- My Classrooms: empty state ---------- */

.classrooms-section
{
    width: 100%;
}

.classrooms-empty-state
{
    background-color: white;
    border-radius: 34px;
    padding-top: 66px;
    padding-bottom: 52px;
    padding-left: 36px;
    padding-right: 36px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.empty-state-icon-box
{
    width: 127px;
    height: 127px;
    border-radius: 64px;
    background-color: rgb(240, 253, 244);
    justify-content: center;
    align-items: center;
    margin-bottom: 26px;
}

.empty-state-icon
{
    width: 61px;
    height: 61px;
    background-image: url("project://database/Assets/UI/Icons/userclassroom-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(13, 148, 136);
}

.empty-state-text
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 12px;
}

.empty-state-subtext
{
    font-size: 26px;
    color: rgb(138, 143, 163);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 566px;
    margin-bottom: 36px;
}

.empty-state-button
{
    background-color: rgb(13, 148, 136);
    border-width: 0;
    border-radius: 22px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 24px;
    padding-bottom: 24px;
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
    margin: 0;
}

.empty-state-button:hover
{
    background-color: rgb(11, 128, 118);
}

/* ---------- My Classrooms: populated list ---------- */

.classrooms-list
{
    width: 100%;
    flex-direction: column;
}

.classroom-card
{
    width: 100%;
    background-color: white;
    border-radius: 34px;
    padding: 36px;
    margin-bottom: 26px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.classroom-card-top-row
{
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
}

/* Rounded icon tile (classroom-icon.png, tinted green) */
.classroom-card-icon-tile
{
    width: 104px;
    height: 104px;
    border-radius: 30px;
    background-color: rgb(209, 250, 229);
    justify-content: center;
    align-items: center;
    margin-right: 28px;
    flex-shrink: 0;
}

.classroom-card-icon
{
    width: 56px;
    height: 56px;
    background-image: url("project://database/Assets/UI/Icons/classroom-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(5, 150, 105);
}

.classroom-card-text
{
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 20px;
}

.classroom-name-label
{
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    white-space: normal;
    margin-bottom: 6px;
}

.classroom-card-side
{
    flex-shrink: 0;
    align-items: flex-end;
    align-self: flex-start;
}

.classroom-code-badge
{
    background-color: rgb(209, 250, 229);
    border-radius: 18px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-shrink: 0;
}

.classroom-code-badge-label
{
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(5, 122, 85);
    letter-spacing: 1px;
}

.classroom-teacher-row
{
    flex-direction: row;
    align-items: center;
}

.classroom-teacher-icon
{
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/student-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(150, 155, 168);
}

.classroom-teacher-label
{
    font-size: 26px;
    color: rgb(138, 143, 163);
    white-space: normal;
    flex-shrink: 1;
}

.classroom-card-divider
{
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
    margin-bottom: 26px;
}

.classroom-card-bottom-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* Students chip (users-icon.png) */
.classroom-students-row
{
    flex-direction: row;
    align-items: center;
    background-color: rgb(243, 246, 250);
    border-radius: 26px;
    padding: 10px 22px 10px 18px;
}

.classroom-students-icon
{
    width: 30px;
    height: 30px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Icons/users-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(37, 99, 235);
}

.classroom-students-label
{
    font-size: 26px;
    color: rgb(75, 85, 99);
}

/* Pill button with a chevron (back-icon.png rotated 180deg) */
/* Pill button: label + chevron laid out in a row (no overlap at any width) */
.view-classroom-button
{
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: rgb(239, 246, 255);
    border-width: 0;
    border-radius: 28px;
    padding: 16px 26px 16px 32px;
    margin: 0;
}

.view-classroom-button:hover
{
    background-color: rgb(219, 234, 254);
}

.classroom-card-button-label
{
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(37, 99, 235);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.view-classroom-button:hover .classroom-card-button-label
{
    color: rgb(29, 78, 216);
}

/* back-icon.png rotated 180deg = right-pointing chevron, sits after the label */
.classroom-card-chevron
{
    width: 24px;
    height: 24px;
    margin-left: 14px;
    flex-shrink: 0;
    rotate: 180deg;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(37, 99, 235);
}

.compact .classroom-card-icon-tile
{
    width: 84px;
    height: 84px;
    border-radius: 24px;
    margin-right: 20px;
}

.compact .classroom-card-icon
{
    width: 44px;
    height: 44px;
}

.view-classroom-button-disabled
{
    background-color: rgb(243, 244, 246);
    padding-right: 32px;
}

.view-classroom-button-disabled .classroom-card-button-label
{
    color: rgb(156, 163, 175);
}

.view-classroom-button-disabled .classroom-card-chevron
{
    display: none;
}

/* ---------- Utility ---------- */

.hidden
{
    display: none;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 78px;
    padding-bottom: 38px;
}

.compact .header-top-row
{
    margin-bottom: 28px;
}

.compact .header-icon-circle
{
    width: 71px;
    height: 71px;
    border-radius: 36px;
    margin-right: 20px;
}

.compact .back-icon
{
    width: 31px;
    height: 31px;
}

.compact .header-title
{
    font-size: 36px;
}

.compact .header-subtitle
{
    font-size: 22px;
}

.compact .glass-stat-value
{
    font-size: 34px;
}

.compact .glass-stat-label
{
    font-size: 18px;
}

.compact .create-classroom-header-label
{
    font-size: 26px;
}

.compact .content-wrapper
{
    padding-left: 32px;
    padding-right: 32px;
}

.compact .section-title
{
    font-size: 28px;
}

.compact .classroom-name-label
{
    font-size: 28px;
}

.compact .classroom-teacher-label,
.compact .classroom-students-label,
.compact .empty-state-subtext
{
    font-size: 22px;
}

.compact .empty-state-text
{
    font-size: 26px;
}
