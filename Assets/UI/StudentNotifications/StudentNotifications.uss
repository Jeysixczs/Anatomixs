/* =========================================================
   Anatomia 3D - Student Notifications (Unity 6 UI Toolkit)
   Reference canvas: 1080 x 1920 (portrait phone).

   NOTE: USS has no linear-gradient, so the header gradient is
   generated as a Texture2D at runtime from
   StudentNotificationsController. The color below is a flat
   fallback.
   ========================================================= */

/* ---------- Screen ---------- */

.screen-root
{
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(243, 244, 248);
    padding: 0;
    margin: 0;
    overflow: hidden;
    justify-content: flex-start;
    align-items: stretch;
}

/* ---------- Header (gradient applied at runtime via C#) ---------- */

.header
{
    width: 100%;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
    padding-left: 50px;
    padding-right: 50px;
    padding-top: 100px;
    padding-bottom: 50px;
    flex-shrink: 0;
    background-color: rgb(142, 45, 226); /* fallback, overridden by gradient texture */
}

.header-top-row
{
    flex-direction: row;
    align-items: center;
}

.back-button
{
    width: 88px;
    height: 88px;
    border-radius: 44px;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 0px;
    justify-content: center;
    align-items: center;
    margin-right: 30px;
    flex-shrink: 0;
}

.back-button:hover
{
    background-color: rgba(255, 255, 255, 0.28);
}

.back-icon
{
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/UI/Icons/back-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.header-text
{
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.header-title
{
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.header-subtitle
{
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 6px;
    white-space: normal;
}

.mark-all-read-button
{
    background-color: rgba(255, 255, 255, 0.16);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.24);
    border-radius: 22px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    margin: 0;
    flex-shrink: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    white-space: normal;
}

.mark-all-read-button:hover
{
    background-color: rgba(255, 255, 255, 0.26);
}

/* ---------- ScrollView ---------- */

.screen-scroll
{
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-overflow-scrolling: touch;
}

.screen-scroll .unity-scroller--vertical {
    width: 0;
    display: none;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport
{
    padding: 0;
    margin: 0;
    flex-grow: 1;
    height: 100%;
}

.screen-scroll > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container
{
    padding: 0;
    margin: 0;
    translate: none;
    transform-origin: center;
    position: relative;
    top: 0;
    left: 0;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 0;
    height: auto;
    min-height: 100%;
}

/* ---------- Content Wrapper ---------- */

.content-wrapper
{
    width: 100%;
    flex-direction: column;
    padding: 34px 44px 60px 44px;
    max-width: 100%;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- Empty state ---------- */

.notifications-empty-state
{
    width: 100%;
    background-color: white;
    border-radius: 38px;
    padding-top: 80px;
    padding-bottom: 66px;
    padding-left: 40px;
    padding-right: 40px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

.empty-state-icon-box
{
    width: 150px;
    height: 150px;
    border-radius: 75px;
    background-color: rgb(243, 234, 253);
    justify-content: center;
    align-items: center;
    margin-bottom: 30px;
}

.empty-state-icon
{
    width: 72px;
    height: 72px;
    background-image: url("project://database/Assets/UI/Icons/notification-icon.png");
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: rgb(142, 45, 226);
}

.empty-state-text
{
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(31, 36, 48);
    margin-bottom: 14px;
}

.empty-state-subtext
{
    font-size: 28px;
    color: rgb(138, 143, 163);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Notifications list ---------- */

.notifications-list
{
    width: 100%;
    flex-direction: column;
}

.notification-row
{
    width: 100%;
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-radius: 36px;
    padding: 30px 32px 30px 30px;
    margin-bottom: 22px;
    border-width: 2px;
    border-color: rgb(236, 238, 245);
}

.notification-row:hover { background-color: rgb(250, 251, 255); }
.notification-row:active { background-color: rgb(241, 244, 252); }

/* Unread: soft lilac card with a purple edge (dot on the right also shows) */
.notification-row-unread
{
    background-color: rgb(249, 244, 255);
    border-color: rgb(214, 190, 246);
}

/* Solid colored badge + white glyph. Colors here; the picture for each
   type is chosen in the glyph rules below from the same color class the
   controller already assigns (GetIconColorClass). */
.notification-icon-box
{
    width: 96px;
    height: 96px;
    border-radius: 30px;
    justify-content: center;
    align-items: center;
    margin-right: 26px;
    flex-shrink: 0;
}

.notification-icon-purple { background-color: rgb(142, 45, 226); }   /* Quiz */
.notification-icon-green  { background-color: rgb(22, 163, 100); }   /* Achievement */
.notification-icon-blue   { background-color: rgb(37, 99, 235); }    /* Classroom */
.notification-icon-orange { background-color: rgb(234, 138, 10); }   /* System */

.notification-icon-glyph
{
    width: 52px;
    height: 52px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: white;
}

.notification-icon-purple .notification-icon-glyph { background-image: url("project://database/Assets/UI/Icons/open-book.png"); }
.notification-icon-green  .notification-icon-glyph { background-image: url("project://database/Assets/UI/Icons/trophy-white-icon.png"); }
.notification-icon-blue   .notification-icon-glyph { background-image: url("project://database/Assets/UI/Icons/users-icon.png"); }
.notification-icon-orange .notification-icon-glyph { background-image: url("project://database/Assets/UI/Icons/notification-icon.png"); }

.notification-text
{
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.notification-top-row
{
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.notification-title
{
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(24, 27, 44);
    flex-shrink: 1;
    white-space: normal;
    margin-right: 14px;
}

.notification-unread-dot
{
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(142, 45, 226);
    flex-shrink: 0;
    margin-top: 8px;
}

.notification-message
{
    font-size: 28px;
    color: rgb(120, 123, 140);
    margin-top: 6px;
    white-space: normal;
}

.notification-time
{
    font-size: 24px;
    color: rgb(170, 174, 188);
    margin-top: 14px;
}

/* ---------- Utility ---------- */

.hidden
{
    display: none;
}

/* =========================================================
   Compact Layout (toggled by C# based on panel width)
   ========================================================= */

.compact .header
{
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 92px;
    padding-bottom: 52px;
}

.compact .header-title
{
    font-size: 44px;
}

.compact .header-subtitle
{
    font-size: 26px;
}

.compact .back-button
{
    width: 104px;
    height: 104px;
    border-radius: 52px;
    margin-right: 26px;
}

.compact .back-icon
{
    width: 43px;
    height: 43px;
}

.compact .mark-all-read-button
{
    font-size: 22px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.compact .content-wrapper
{
    padding-left: 36px;
    padding-right: 36px;
}

.compact .notification-title
{
    font-size: 26px;
}

.compact .notification-message
{
    font-size: 24px;
}

.compact .notification-time
{
    font-size: 20px;
}

.compact .notification-icon-box
{
    width: 80px;
    height: 80px;
    border-radius: 24px;
    margin-right: 20px;
}

.compact .notification-icon-glyph
{
    width: 42px;
    height: 42px;
}
